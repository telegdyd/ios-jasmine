From abaf037ccd12abbd2f333a905185755164fbaa41 Mon Sep 17 00:00:00 2001
From: telegdyd <telegdyd93@gmail.com>
Date: Thu, 29 Oct 2026 22:18:02 +0100
Subject: [PATCH] sweetgl: mode 2 glFlush without the threaded-context drain

CoreAnimation ends every frame with glFlush (IOMFBDisplay::finish_update).
Mesa makes that flush synchronous once an IOSurface is bound
(HasExternallySharedImages), so tc_sync runs the pending TC batch on
the render thread (~1.2 ms CPU per frame) and then waits for the
driver thread (~1.5 ms). In pipeline mode 2 every shared write already
holds a kernel render ticket that the driver thread seals after its own
flush, and the display waits for the seal, so the flush can go to the
driver thread like the ticket callback after it. SWEETCA_SYNC_FLUSH=1
keeps the old synchronous flush for comparisons.
---
 src/gallium/frontends/sweetgl/sweetca.c |  8 +++++++-
 src/gallium/frontends/sweetgl/sweetgl.c | 15 +++++++++++++++
 src/gallium/frontends/sweetgl/sweetgl.h |  1 +
 3 files changed, 23 insertions(+), 1 deletion(-)

diff --git a/src/gallium/frontends/sweetgl/sweetca.c b/src/gallium/frontends/sweetgl/sweetca.c
index 353054f..138d75f 100644
--- a/src/gallium/frontends/sweetgl/sweetca.c
+++ b/src/gallium/frontends/sweetgl/sweetca.c
@@ -501,6 +501,7 @@ flush_stats(double wait_ms)
 
 static int pipeline_mode = -1;
 static bool pipeline_tickets;
+static bool sync_flush; /* SWEETCA_SYNC_FLUSH=1: mode 2 drains the driver thread at w_Flush (comparison) */
 static unsigned pipeline_errors, pipeline_slow;
 static pthread_once_t pipeline_once = PTHREAD_ONCE_INIT;
 
@@ -510,6 +511,8 @@ pipeline_init(void)
    const char *v = getenv("SWEETCA_PIPELINE");
    pipeline_mode = v && !strcmp(v, "2") ? 2 : v && !strcmp(v, "1") ? 1 : 0;
    pipeline_tickets = pipeline_mode == 2;
+   v = getenv("SWEETCA_SYNC_FLUSH");
+   sync_flush = v && !strcmp(v, "1");
 }
 
 static bool
@@ -704,7 +707,10 @@ w_Flush(void *rctx)
    if (pipeline_tickets && mode != 2)
       (void)sgl_ticket_flush(c->gl); /* capability loss still resolves this frame's open set */
    if (mode == 2 && !c->ticket_sync_frame && !c->ticket_failed) {
-      glFlush();
+      if (sync_flush)
+         glFlush();
+      else
+         sgl_flush_async(c->gl);
       int error = sgl_ticket_flush(c->gl);
       if (error) {
          (void)ticket_resolve(c);
diff --git a/src/gallium/frontends/sweetgl/sweetgl.c b/src/gallium/frontends/sweetgl/sweetgl.c
index 62d13f9..7e2989e 100644
--- a/src/gallium/frontends/sweetgl/sweetgl.c
+++ b/src/gallium/frontends/sweetgl/sweetgl.c
@@ -24,6 +24,8 @@
 #include "drm-uapi/drm_fourcc.h"
 #include "state_tracker/st_context.h"
 #include "main/mtypes.h"
+#include "main/context.h"
+#include "state_tracker/st_cb_flush.h"
 #include "util/driconf.h"
 #include "util/simple_mtx.h"
 #include "util/sweet_profile.h"
@@ -529,6 +531,19 @@ sgl_kick(struct sgl_context *ctx)
    return true;
 }
 
+/* glFlush is synchronous once an IOSurface is bound (_mesa_flush checks
+ * HasExternallySharedImages): tc_sync runs the pending TC batch on the calling
+ * thread, then waits for the driver thread. Mode 2 does not need that: every
+ * shared write holds a kernel ticket that the driver thread seals after its own
+ * flush (sgl_render_driver), and readers wait for the seal. */
+void
+sgl_flush_async(struct sgl_context *ctx)
+{
+   struct gl_context *gl = ctx->st->ctx;
+   FLUSH_VERTICES(gl, 0, 0);
+   st_glFlush(gl, PIPE_FLUSH_ASYNC);
+}
+
 extern int darwin_pipeline_error(void);
 extern uint64_t darwin_pipeline_capability(void);
 
diff --git a/src/gallium/frontends/sweetgl/sweetgl.h b/src/gallium/frontends/sweetgl/sweetgl.h
index a1f9ee3..722518c 100644
--- a/src/gallium/frontends/sweetgl/sweetgl.h
+++ b/src/gallium/frontends/sweetgl/sweetgl.h
@@ -104,6 +104,7 @@ int sgl_flush_submit(struct sgl_context *ctx);
 bool sgl_tickets_available(struct sgl_context *ctx);
 int sgl_ticket_write(struct sgl_context *ctx, uint32_t surface);
 int sgl_ticket_flush(struct sgl_context *ctx); /* ordered callback, no drain wait */
+void sgl_flush_async(struct sgl_context *ctx); /* glFlush handed to the driver thread, no tc_sync */
 int sgl_ticket_finish(struct sgl_context *ctx); /* resolve own writes before CPU access */
 int sgl_ticket_error(struct sgl_context *ctx);
 void sgl_follow_thread(struct sgl_context *ctx);
-- 
