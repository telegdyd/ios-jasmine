diff --git a/src/util/sweet_pass_profile.h b/src/util/sweet_pass_profile.h
new file mode 100644
--- /dev/null
+++ b/src/util/sweet_pass_profile.h
@@ -0,0 +1,24 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef SWEET_PASS_PROFILE_H
+#define SWEET_PASS_PROFILE_H
+#include <stdint.h>
+#include <stdbool.h>
+#ifdef __APPLE__
+bool sweet_m5_enabled(void);
+bool sweet_m5_collecting(void);
+void sweet_m5_begin(void);
+void sweet_m5_end(void);
+void sweet_m5_pass(const uint64_t *v);
+void sweet_m5_work(unsigned kind);
+void sweet_m5_shader(const char *name, const uint64_t *textures);
+void sweet_m5_link(uintptr_t ctx, unsigned seq);
+unsigned sweet_m5_batch(uintptr_t ctx, unsigned seq, unsigned w, unsigned h,
+   unsigned samples, unsigned colors, unsigned fmt, unsigned zs, unsigned mode,
+   unsigned draws, unsigned clear, unsigned restore, unsigned resolve, unsigned fbk, unsigned pre);
+void sweet_m5_stamps(unsigned slot, uint64_t start, uint64_t end);
+void sweet_m5_drop(void);
+void sweet_m5_poll(void);
+#else
+#define sweet_m5_collecting() false
+#endif
+#endif
diff --git a/src/freedreno/drm/darwin/sweet_pass_profile.inc b/src/freedreno/drm/darwin/sweet_pass_profile.inc
new file mode 100644
--- /dev/null
+++ b/src/freedreno/drm/darwin/sweet_pass_profile.inc
@@ -0,0 +1,119 @@
+/* SPDX-License-Identifier: MIT */
+/* Inline Metal replay only, serialized by bg_lock. No fence wait, per-draw I/O,
+ * allocation or clock read. GPU stamps drain the pipeline; diagnostic only.
+ * One capture per process. Tail harvesting occurs on subsequent CB boundaries.
+ * Rows and timestamps are never recycled during a capture. */
+#define M5_ROWS 65536
+static struct { const char *event; unsigned cb, pass; uint64_t v[20]; } m5_rows[M5_ROWS];
+static unsigned m5_count, m5_cb, m5_pass, m5_lost, m5_pending;
+static int m5_enabled, m5_state;
+static uint64_t m5_deadline;
+static __thread bool m5_inline;
+bool sweet_m5_enabled(void)
+{
+   if (!m5_enabled) {
+      const char *v = getenv("BGMTL_PASS_PROFILE");
+      m5_enabled = v && !strcmp(v,"1") ? 1 : -1;
+   }
+   return m5_enabled == 1;
+}
+bool sweet_m5_collecting(void) { return m5_inline && m5_state == 1; }
+void sweet_m5_drop(void) { if (sweet_m5_collecting()) ++m5_lost; }
+static unsigned m5_row(const char *event)
+{
+   if (!sweet_m5_collecting()) return 0;
+   if (m5_count == M5_ROWS) { m5_lost++; return 0; }
+   unsigned i = ++m5_count;
+   m5_rows[i-1].event=event; m5_rows[i-1].cb=m5_cb; m5_rows[i-1].pass=m5_pass;
+   return i;
+}
+void sweet_m5_pass(const uint64_t *v)
+{
+   if (!sweet_m5_collecting()) return;
+   ++m5_pass;
+   unsigned i=m5_row("pass");
+   if(i) memcpy(m5_rows[i-1].v,v,20*sizeof(uint64_t));
+}
+void sweet_m5_work(unsigned kind)
+{
+   unsigned i=m5_row("work"); if(i) m5_rows[i-1].v[0]=kind;
+}
+void sweet_m5_shader(const char *name, const uint64_t *textures)
+{
+   if (!sweet_m5_collecting()) return;
+   /* Labels are diagnostic classes, not stable shader identities. Keep each
+    * distinct consecutive name/texture signature within the encoded pass. */
+   static unsigned last;
+   char label[96]={0}; snprintf(label,sizeof(label),"%s",name);
+   if(last && m5_rows[last-1].cb==m5_cb && m5_rows[last-1].pass==m5_pass &&
+      !memcmp(m5_rows[last-1].v,label,96) && !memcmp(m5_rows[last-1].v+13,textures,7*sizeof(uint64_t))) {
+      ++m5_rows[last-1].v[12]; return;
+   }
+   last=m5_row("shader");
+   if(last) {
+      memcpy(m5_rows[last-1].v,label,96); m5_rows[last-1].v[12]=1;
+      memcpy(m5_rows[last-1].v+13,textures,7*sizeof(uint64_t));
+   }
+}
+void sweet_m5_link(uintptr_t ctx, unsigned seq)
+{
+   /* One edge per distinct adjacent (CB, pass, context, batch), not per draw. */
+   if(m5_count) {
+      unsigned k=m5_count-1;
+      if(!strcmp(m5_rows[k].event,"link") && m5_rows[k].cb==m5_cb &&
+         m5_rows[k].pass==m5_pass && m5_rows[k].v[0]==ctx && m5_rows[k].v[1]==seq) return;
+   }
+   unsigned i=m5_row("link"); if(i) { m5_rows[i-1].v[0]=ctx; m5_rows[i-1].v[1]=seq; }
+}
+unsigned sweet_m5_batch(uintptr_t ctx, unsigned seq, unsigned w, unsigned h,
+   unsigned samples, unsigned colors, unsigned fmt, unsigned zs, unsigned mode,
+   unsigned draws, unsigned clear, unsigned restore, unsigned resolve, unsigned fbk, unsigned pre)
+{
+   unsigned i=m5_row("batch");
+   if(i) {
+      uint64_t v[20]={ctx,seq,w,h,samples,colors,fmt,zs,mode,draws,clear,restore,resolve,fbk,pre};
+      memcpy(m5_rows[i-1].v,v,sizeof(v)); ++m5_pending;
+   }
+   return i;
+}
+void sweet_m5_stamps(unsigned slot, uint64_t start, uint64_t end)
+{
+   if(!slot || slot>m5_count) return;
+   if(!m5_rows[slot-1].v[15]) {
+      m5_rows[slot-1].v[15]=start; m5_rows[slot-1].v[16]=end; --m5_pending;
+   }
+}
+void sweet_m5_begin(void)
+{
+   if(!sweet_m5_enabled() || m5_state==3) return;
+   if(!m5_state) {
+      if(access("/private/var/tmp/bgmtl-pass-start",F_OK)) return;
+      m5_state=1; m5_deadline=clock_gettime_nsec_np(CLOCK_MONOTONIC)+8000000000ull;
+   }
+   m5_inline=true;
+   if(m5_state==1) { ++m5_cb; m5_pass=0; m5_row("begin"); }
+}
+void sweet_m5_end(void)
+{
+   if(!m5_inline) return;
+   if(m5_state==1) {
+      m5_row("end");
+      if(m5_cb>=120 || clock_gettime_nsec_np(CLOCK_MONOTONIC)>=m5_deadline) m5_state=2;
+   }
+   m5_inline=false;
+   sweet_m5_poll();
+   if(m5_state!=2 || (m5_pending && clock_gettime_nsec_np(CLOCK_MONOTONIC)<m5_deadline+2000000000ull)) return;
+   char path[128]; snprintf(path,sizeof(path),"/private/var/tmp/bgmtl-pass-%d.csv",getpid());
+   FILE *f=fopen(path,"w");
+   if(f) {
+      fprintf(f,"# commits=%u dropped=%u pending=%u pid=%d; RB_DONE_TS 19200000 Hz; serialized diagnostic\n",m5_cb,m5_lost,m5_pending,getpid());
+      fprintf(f,"cb,pass,event"); for(unsigned j=0;j<20;j++) fprintf(f,",v%u",j); fputc('\n',f);
+      for(unsigned k=0;k<m5_count;k++) {
+         fprintf(f,"%u,%u,%s",m5_rows[k].cb,m5_rows[k].pass,m5_rows[k].event);
+         for(unsigned j=0;j<20;j++) fprintf(f,",%llu",(unsigned long long)m5_rows[k].v[j]);
+         fputc('\n',f);
+      }
+      fclose(f);
+   }
+   m5_state=3;
+}
