Subject: [PATCH] freedreno: bounded opt-in Metal pass/batch GPU attribution

diff --git a/src/gallium/drivers/freedreno/freedreno_gmem.c b/src/gallium/drivers/freedreno/freedreno_gmem.c
--- a/src/gallium/drivers/freedreno/freedreno_gmem.c
+++ b/src/gallium/drivers/freedreno/freedreno_gmem.c
@@ -724,6 +724,7 @@
  * libsweetca's 100-flush report harvests what the GPU has finished. The end
  * stamp drains the pipeline, so batches do not overlap while this is on.
  */
+#include "util/sweet_pass_profile.h"
 #define GP_SLOTS 4096
 #define GP_TOP   12
 #define GP_GAP   (100 * 19200)   /* longer gaps are the UI standing still */
@@ -734,6 +735,7 @@
    uint8_t mode;                 /* 0 nondraw, 1 sysmem, 2 gmem, 3 sysmem with retained feedback barriers */
    uint8_t trace;                /* task 28: listed by SWEETCA_GPUTRACE */
    uint32_t seqno, ctxid, clears;
+   unsigned m5_slot;
    uint64_t t, gap;
 };
 
@@ -805,6 +807,7 @@
       }
       gp.tail++;
       struct gp_pass *p = &gp.pass[i];
+      sweet_m5_stamps(p->m5_slot, s, e);
       if (e < s || e - s > 19200000)
          gp.bad++;
       else if (gp.niv < GP_IV) {
@@ -1007,6 +1010,13 @@
    simple_mtx_unlock(&gp.lock);
 }
 
+void sweet_m5_poll(void)
+{
+   simple_mtx_lock(&gp.lock);
+   if (gp.ts) gp_harvest();
+   simple_mtx_unlock(&gp.lock);
+}
+
 static void
 gp_stamp(struct fd_ringbuffer *ring, int slot, unsigned which)
 {
@@ -1024,7 +1034,7 @@
    simple_mtx_lock(&gp.lock);
    if (gp.enabled < 0) {
       const char *v = getenv("SWEETCA_GPUPROF");
-      gp.enabled = v && strcmp(v, "0") && is_a5xx(batch->ctx->screen);
+      gp.enabled = ((v && strcmp(v, "0")) || sweet_m5_enabled()) && is_a5xx(batch->ctx->screen);
       if (gp.enabled) {
          gp.bo = fd_bo_new(batch->ctx->screen->dev, 2 * 8 * GP_SLOTS, 0, "gpuprof");
          gp.ts = gp.bo ? fd_bo_map(gp.bo) : NULL;
@@ -1034,7 +1044,7 @@
       }
    }
    int slot = -1;
-   if (gp.enabled) {
+   if (gp.enabled && (sweet_m5_collecting() || (getenv("SWEETCA_GPUPROF") && strcmp(getenv("SWEETCA_GPUPROF"), "0")))) {
       gp_harvest();
       if (gp.head - gp.tail < GP_SLOTS) {
          slot = gp.head++ % GP_SLOTS;
@@ -1048,6 +1058,11 @@
             .seqno = batch->seqno, .ctxid = (uint32_t)(((uintptr_t)batch->ctx >> 4) & 0xfff),
             .clears = batch->sweet_clears,
          };
+         gp.pass[slot].m5_slot = sweet_m5_batch((uintptr_t)batch->ctx, batch->seqno,
+            pfb->width, pfb->height, pfb->samples, pfb->nr_cbufs,
+            gp.pass[slot].fmt, pfb->zsbuf.texture ? pfb->zsbuf.format : 0,
+            gp.pass[slot].mode, batch->num_draws, batch->cleared, batch->restore,
+            batch->resolve, batch->sweet_fb_barriers, batch->sweet_fb_pre);
          if (gt.left) {
             gp.pass[slot].trace = 1;
             if (!--gt.left)
@@ -1055,6 +1070,7 @@
          }
       } else {
          gp.dropped++;
+         sweet_m5_drop();
       }
    }
    simple_mtx_unlock(&gp.lock);
