 #define SWEET_PROFILE_H
 
+#include "sweet_state_profile.h"
 #include <stdbool.h>
 #include <stdint.h>
 
diff --git a/src/freedreno/drm/darwin/sweet_profile.c b/src/freedreno/drm/darwin/sweet_profile.c
--- a/src/freedreno/drm/darwin/sweet_profile.c
+++ b/src/freedreno/drm/darwin/sweet_profile.c
@@ -5,6 +5,7 @@
 #include <stdlib.h>
 #include <string.h>
 #include "sweet_batch_trace.inc"
+#include "sweet_state_profile.inc"
 
 static bool enabled;
 static __thread struct sweet_profile_scope *current;
@@ -55,6 +56,7 @@
 void
 sweet_profile_enter(struct sweet_profile_scope *s, enum sweet_profile_id id)
 {
+   if (sweet_m3_active) sweet_m3_active->scope[id]++;
    s->active = enabled;
    if (!s->active)
       return;
@@ -90,6 +92,11 @@
 void
 sweet_profile_batch(unsigned draws)
 {
+   if (sweet_m3_active) {
+      sweet_m3_active->batches++;
+      sweet_m3_active->batch_draws += draws;
+      sweet_m3_active->hist[draws < 8 ? draws : 8]++;
+   }
    if (!enabled)
       return;
    enum sweet_profile_event reason = SPE_FLUSH_OTHER;
