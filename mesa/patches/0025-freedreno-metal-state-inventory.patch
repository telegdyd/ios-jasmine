Subject: [PATCH] freedreno: bounded opt-in Metal state and resource inventory

diff --git a/src/util/sweet_profile.h b/src/util/sweet_profile.h
--- a/src/util/sweet_profile.h
+++ b/src/util/sweet_profile.h
@@ -8,6 +8,7 @@
