    uint8_t *req = calloc(1, 4096 > len ? 4096 : len);
@@ -212,12 +214,15 @@
    }
    if (hook == 2)
       ((uint32_t *)req)[1] = 0;
+   sweet_m4_record("kernel", fd_submit->base.fence, nr_submits, fd_submit->nr_bos,
+                   nr_cmds, len, 0, 0, 0);
    uint32_t nout = 1;
