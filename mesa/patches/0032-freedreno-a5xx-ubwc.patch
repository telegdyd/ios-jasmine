diff --git a/src/freedreno/fdl/fd5_ubwc_layout.h b/src/freedreno/fdl/fd5_ubwc_layout.h
new file mode 100644
index 0000000..d831630
--- /dev/null
+++ b/src/freedreno/fdl/fd5_ubwc_layout.h
@@ -0,0 +1,26 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef FD5_UBWC_LAYOUT_H
+#define FD5_UBWC_LAYOUT_H
+#include <stdint.h>
+
+/* cpp=4, single level/layer. a5xx.xml's 100x2000 blob trace has
+ * pitch=64, height=512, size=0x8000. Keep this helper host-testable. */
+static inline uint32_t
+fd5_ubwc_meta_pitch(uint32_t width)
+{
+   return ((width + 15) / 16 + 63) & ~63u;
+}
+
+static inline uint32_t
+fd5_ubwc_meta_height(uint32_t height)
+{
+   return ((height + 3) / 4 + 15) & ~15u;
+}
+
+static inline uint32_t
+fd5_ubwc_meta_size(uint32_t width, uint32_t height, uint32_t alignment)
+{
+   uint32_t size = fd5_ubwc_meta_pitch(width) * fd5_ubwc_meta_height(height);
+   return (size + alignment - 1) & ~(alignment - 1);
+}
+#endif
