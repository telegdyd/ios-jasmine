diff --git a/src/gallium/drivers/freedreno/a5xx/fd5_ubwc.h b/src/gallium/drivers/freedreno/a5xx/fd5_ubwc.h
new file mode 100644
index 0000000..28256a1
--- /dev/null
+++ b/src/gallium/drivers/freedreno/a5xx/fd5_ubwc.h
@@ -0,0 +1,49 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef FD5_UBWC_H
+#define FD5_UBWC_H
+#include "util/u_debug.h"
+#include "freedreno_resource.h"
+#include "fd5_hw.h"
+
+DEBUG_GET_ONCE_BOOL_OPTION(fd5_ubwc_mrts2, "FD5_UBWC_MRTS2", true)
+DEBUG_GET_ONCE_BOOL_OPTION(fd5_ubwc_sysmem, "FD5_UBWC_SYSMEM", true)
+DEBUG_GET_ONCE_BOOL_OPTION(fd5_ubwc_tileall, "FD5_UBWC_TILEALL", true)
+DEBUG_GET_ONCE_OPTION(fd5_ubwc_texbase, "FD5_UBWC_TEXBASE", "flags")
+
+static inline unsigned
+fd5_ubwc_mask(const struct pipe_framebuffer_state *pfb)
+{
+   unsigned mask = 0;
+   for (unsigned i = 0; i < pfb->nr_cbufs; i++) {
+      if (pfb->cbufs[i].texture &&
+          fd_resource_ubwc_enabled(fd_resource(pfb->cbufs[i].texture),
+                                   pfb->cbufs[i].level))
+         mask |= 1u << i;
+   }
+   return mask;
+}
+
+static inline uint32_t
+fd5_ubwc_render_flags(const struct pipe_framebuffer_state *pfb)
+{
+   unsigned mask = fd5_ubwc_mask(pfb);
+   return A5XX_RB_RENDER_CNTL_FLAG_MRTS(mask) |
+          (debug_get_option_fd5_ubwc_mrts2() ?
+           A5XX_RB_RENDER_CNTL_FLAG_MRTS2(mask) : 0);
+}
+
+static inline uint32_t
+fd5_ubwc_tex_flags(struct fd_resource *rsc)
+{
+   return rsc->layout.ubwc ? A5XX_TEX_CONST_3_FLAG |
+      (debug_get_option_fd5_ubwc_tileall() ? A5XX_TEX_CONST_3_TILE_ALL : 0) : 0;
+}
+
+static inline uint32_t
+fd5_ubwc_tex_offset(struct fd_resource *rsc, unsigned color_offset)
+{
+   return rsc->layout.ubwc &&
+          strcmp(debug_get_option_fd5_ubwc_texbase(), "color") ?
+          fd_resource_ubwc_offset(rsc, 0, 0) : color_offset;
+}
+#endif
diff --git a/src/gallium/drivers/freedreno/a5xx/fd5_ubwc_eligible.h b/src/gallium/drivers/freedreno/a5xx/fd5_ubwc_eligible.h
new file mode 100644
index 0000000..98366a1
--- /dev/null
+++ b/src/gallium/drivers/freedreno/a5xx/fd5_ubwc_eligible.h
@@ -0,0 +1,18 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef FD5_UBWC_ELIGIBLE_H
+#define FD5_UBWC_ELIGIBLE_H
+#include <stdbool.h>
+
+/* Gallium enum/flag translation stays at the call site; the policy itself
+ * is independent of generated headers and exercised by the host test. */
+static inline bool
+fd5_ubwc_eligible(bool explicit_compressed, bool is_2d, bool rgba8,
+                  unsigned depth, unsigned layers, unsigned last_level,
+                  unsigned samples, unsigned storage_samples,
+                  bool staging, bool forbidden_bind, bool persistent)
+{
+   return explicit_compressed && is_2d && rgba8 && depth == 1 && layers == 1 &&
+      last_level == 0 && samples <= 1 && storage_samples <= 1 &&
+      !staging && !forbidden_bind && !persistent;
+}
+#endif
