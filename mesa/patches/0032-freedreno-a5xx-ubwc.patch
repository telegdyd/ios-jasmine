+/* A CPU map can shadow a compressed allocation to linear. Views can outlive
+ * that transition (including unbound cached air views), so refresh them at
+ * emission, rather than only when the currently bound state is rebound. */
+static inline void
+fd5_sampler_view_update(struct fd5_pipe_sampler_view *view)
+{
+   if (!view->dynamic_layout)
+      return;
+   struct fd_resource *rsc = fd_resource(view->base.texture);
+   view->offset = fd_resource_offset(rsc, 0, 0);
+   view->texconst2 = A5XX_TEX_CONST_2_PITCHALIGN(rsc->layout.pitchalign - 6) |
+                     A5XX_TEX_CONST_2_PITCH(fd_resource_pitch(rsc, 0)) |
+                     A5XX_TEX_CONST_2_TYPE(A5XX_TEX_2D);
+   view->texconst3 = A5XX_TEX_CONST_3_ARRAY_PITCH(rsc->layout.layer_size);
+}
+
