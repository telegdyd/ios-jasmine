diff --git a/src/gallium/drivers/freedreno/sweetgpu_fdtest.c b/src/gallium/drivers/freedreno/sweetgpu_fdtest.c
new file mode 100644
index 0000000..6605dbb
--- /dev/null
+++ b/src/gallium/drivers/freedreno/sweetgpu_fdtest.c
@@ -0,0 +1,140 @@
+/*
+ * Copyright © 2026 ios-jasmine
+ * SPDX-License-Identifier: MIT
+ *
+ * sweetgpu_fdtest: the first test of Mesa freedreno on ios-jasmine's SweetGPU
+ * kernel driver (G2). Gallium only, no GL: creates the freedreno screen on
+ * the darwin backend, clears a 64x64 RGBA8 render target to a color on the
+ * GPU (a5xx: GMEM tiles, then a resolve to memory), waits for the fence and
+ * reads the pixels back. Prints PASS or FAIL and exits 0 or 1.
+ */
+
+#include <fcntl.h>
+#include <stdio.h>
+#include <unistd.h>
+
+#include "pipe/p_context.h"
+#include "pipe/p_defines.h"
+#include "pipe/p_screen.h"
+#include "pipe/p_state.h"
+#include "compiler/glsl_types.h"
+#include "frontend/drm_driver.h"
+#include "util/os_time.h"
+#include "util/driconf.h"
+#include "util/u_inlines.h"
+#include "util/xmlconfig.h"
+
+#include "freedreno_screen.h"
+
+/* the options the pipe-loader would give freedreno: gallium's, then its own */
+static const driOptionDescription fd_driconf[] = {
+#include "pipe-loader/driinfo_gallium.h"
+#include "driinfo_freedreno.h"
+};
+
+int
+main(void)
+{
+   /* unbuffered: whatever happens, the last step printed is the last one reached */
+   setvbuf(stdout, NULL, _IONBF, 0);
+   /* what a GL frontend does first: ir3 builds GLSL types (tgsi_to_nir, UBO lowering) */
+   glsl_type_singleton_init_or_ref();
+   printf("step: options\n");
+   driOptionCache options, options_info;
+   driParseOptionInfo(&options_info, fd_driconf, ARRAY_SIZE(fd_driconf));
+   driParseOptionInfo(&options, fd_driconf, ARRAY_SIZE(fd_driconf));
+   struct pipe_screen_config config = {
+      .options = &options,
+      .options_info = &options_info,
+   };
+
+   /* the darwin backend ignores the fd; fd_screen_create dup()s it */
+   int fd = open("/dev/null", O_RDWR);
+   printf("step: screen\n");
+   struct pipe_screen *screen = fd_screen_create(fd, &config, NULL);
+   if (!screen) {
+      printf("FAIL: no freedreno screen (is SweetGPU up? sweetgpu=4)\n");
+      return 1;
+   }
+   printf("screen: %s (%s)\n", screen->get_name(screen), screen->get_vendor(screen));
+
+   printf("step: context\n");
+   struct pipe_context *pipe = screen->context_create(screen, NULL, 0);
+   if (!pipe) {
+      printf("FAIL: no context\n");
+      return 1;
+   }
+
+   const unsigned w = 64, h = 64;
+   struct pipe_resource templ = {
+      .target = PIPE_TEXTURE_2D,
+      .format = PIPE_FORMAT_R8G8B8A8_UNORM,
+      .width0 = w,
+      .height0 = h,
+      .depth0 = 1,
+      .array_size = 1,
+      .bind = PIPE_BIND_RENDER_TARGET | PIPE_BIND_SAMPLER_VIEW,
+      .usage = PIPE_USAGE_DEFAULT,
+   };
+   printf("step: render target\n");
+   struct pipe_resource *rt = screen->resource_create(screen, &templ);
+   if (!rt) {
+      printf("FAIL: no render target\n");
+      return 1;
+   }
+
+   struct pipe_framebuffer_state fb = {
+      .width = w,
+      .height = h,
+      .layers = 1,
+      .nr_cbufs = 1,
+   };
+   fb.cbufs[0].format = templ.format;
+   fb.cbufs[0].texture = rt;
+   pipe->set_framebuffer_state(pipe, &fb);
+
+   /* RGBA (0.25, 0.5, 0.75, 1.0) -> bytes 0x40 0x80 0xbf 0xff */
+   union pipe_color_union color = { .f = { 0.25f, 0.5f, 0.75f, 1.0f } };
+   int64_t t0 = os_time_get_nano();
+   printf("step: clear\n");
+   pipe->clear(pipe, PIPE_CLEAR_COLOR0, 0xffffffff, 0, NULL, &color, 0.0, 0);
+
+   struct pipe_fence_handle *fence = NULL;
+   printf("step: flush\n");
+   pipe->flush(pipe, &fence, 0);
+   printf("step: fence\n");
+   bool done = screen->fence_finish(screen, NULL, fence, 5ull * 1000 * 1000 * 1000);
+   screen->fence_reference(screen, &fence, NULL);
+   int64_t t1 = os_time_get_nano();
+   printf("clear + flush + fence: %s after %.3f ms\n", done ? "done" : "TIMEOUT", (t1 - t0) / 1e6);
+
+   struct pipe_box box = { .width = w, .height = h, .depth = 1 };
+   struct pipe_transfer *xfer = NULL;
+   const uint8_t *px = pipe->texture_map(pipe, rt, 0, PIPE_MAP_READ, &box, &xfer);
+   if (!px) {
+      printf("FAIL: render target not mappable\n");
+      return 1;
+   }
+   unsigned bad = 0;
+   for (unsigned y = 0; y < h; y++) {
+      const uint8_t *row = px + y * xfer->stride;
+      for (unsigned x = 0; x < w; x++) {
+         const uint8_t *p = row + 4 * x;
+         if (p[0] != 0x40 || p[1] != 0x80 || p[2] != 0xbf || p[3] != 0xff)
+            bad++;
+      }
+   }
+   printf("pixel (0,0) %02x %02x %02x %02x, (63,63) %02x %02x %02x %02x, stride %u; %u of %u wrong\n",
+          px[0], px[1], px[2], px[3], px[63 * xfer->stride + 252], px[63 * xfer->stride + 253],
+          px[63 * xfer->stride + 254], px[63 * xfer->stride + 255], xfer->stride, bad, w * h);
+   pipe->texture_unmap(pipe, xfer);
+
+   pipe_resource_reference(&rt, NULL);
+   pipe->destroy(pipe);
+   screen->destroy(screen);
+   close(fd);
+   glsl_type_singleton_decref();
+
+   printf("%s\n", done && bad == 0 ? "PASS: the GPU cleared the render target" : "FAIL");
+   return done && bad == 0 ? 0 : 1;
+}
