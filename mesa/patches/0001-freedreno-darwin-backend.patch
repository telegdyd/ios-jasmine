diff --git a/src/gallium/frontends/sweetgl/sweetgl.c b/src/gallium/frontends/sweetgl/sweetgl.c
new file mode 100644
index 0000000..8293b2f
--- /dev/null
+++ b/src/gallium/frontends/sweetgl/sweetgl.c
@@ -0,0 +1,251 @@
+/*
+ * Copyright © 2026 ios-jasmine
+ * SPDX-License-Identifier: MIT
+ *
+ * sweetgl: GL ES contexts on the freedreno screen, without EGL or DRI (see
+ * sweetgl.h). The structure follows Haiku's hgl frontend: a
+ * pipe_frontend_screen for st/mesa, and surfaces that are
+ * pipe_frontend_drawables whose validate() hands st/mesa our textures.
+ */
+
+#include <fcntl.h>
+#include <stdio.h>
+#include <unistd.h>
+
+#include "pipe/p_screen.h"
+#include "pipe/p_state.h"
+#include "frontend/api.h"
+#include "frontend/drm_driver.h"
+#include "state_tracker/st_context.h"
+#include "util/driconf.h"
+#include "util/u_atomic.h"
+#include "util/u_inlines.h"
+#include "util/u_memory.h"
+#include "util/xmlconfig.h"
+#include "compiler/glsl_types.h"
+
+#include "sweetgl.h"
+
+struct renderonly;
+struct pipe_screen *fd_screen_create(int fd, const struct pipe_screen_config *config,
+                                     struct renderonly *ro);
+
+/* the options the pipe-loader would give freedreno: gallium's, then its own */
+static const driOptionDescription fd_driconf[] = {
+#include "pipe-loader/driinfo_gallium.h"
+#include "driinfo_freedreno.h"
+};
+
+struct sgl_display {
+   struct pipe_frontend_screen fscreen;
+   driOptionCache options, options_info;
+   int fd;
+};
+
+struct sgl_context {
+   struct sgl_display *dpy;
+   struct st_context *st;
+};
+
+struct sgl_surface {
+   struct pipe_frontend_drawable base;
+   struct st_visual visual;
+   struct sgl_display *dpy;
+   unsigned width, height;
+   struct pipe_resource *textures[ST_ATTACHMENT_COUNT];
+};
+
+static uint32_t sgl_drawable_id;
+
+static int
+sgl_get_param(struct pipe_frontend_screen *fscreen, enum st_manager_param param)
+{
+   return 0;
+}
+
+struct sgl_display *
+sgl_display_create(void)
+{
+   struct sgl_display *dpy = CALLOC_STRUCT(sgl_display);
+   if (!dpy)
+      return NULL;
+
+   /* ir3 and the GLSL compiler build GLSL types */
+   glsl_type_singleton_init_or_ref();
+
+   driParseOptionInfo(&dpy->options_info, fd_driconf, ARRAY_SIZE(fd_driconf));
+   driParseOptionInfo(&dpy->options, fd_driconf, ARRAY_SIZE(fd_driconf));
+   struct pipe_screen_config config = {
+      .options = &dpy->options,
+      .options_info = &dpy->options_info,
+   };
+
+#ifdef __APPLE__
+   /* the darwin backend talks to SweetGPU itself; fd_screen_create dup()s the fd */
+   dpy->fd = open("/dev/null", O_RDWR);
+#else
+   dpy->fd = open("/dev/dri/renderD128", O_RDWR | O_CLOEXEC);
+#endif
+   dpy->fscreen.screen = dpy->fd >= 0 ? fd_screen_create(dpy->fd, &config, NULL) : NULL;
+   if (!dpy->fscreen.screen) {
+      fprintf(stderr, "sweetgl: no freedreno screen\n");
+      if (dpy->fd >= 0)
+         close(dpy->fd);
+      driDestroyOptionCache(&dpy->options);
+      driDestroyOptionInfo(&dpy->options_info);
+      glsl_type_singleton_decref();
+      FREE(dpy);
+      return NULL;
+   }
+   dpy->fscreen.get_param = sgl_get_param;
+   return dpy;
+}
+
+void
+sgl_display_destroy(struct sgl_display *dpy)
+{
+   if (!dpy)
+      return;
+   st_screen_destroy(&dpy->fscreen);
+   dpy->fscreen.screen->destroy(dpy->fscreen.screen);
+   close(dpy->fd);
+   driDestroyOptionCache(&dpy->options);
+   driDestroyOptionInfo(&dpy->options_info);
+   glsl_type_singleton_decref();
+   FREE(dpy);
+}
+
+static void
+sgl_fill_visual(struct st_visual *visual, bool depth_stencil)
+{
+   memset(visual, 0, sizeof(*visual));
+   /* single-buffered: GL renders to the front buffer, which the caller reads */
+   visual->buffer_mask = ST_ATTACHMENT_FRONT_LEFT_MASK;
+   visual->color_format = PIPE_FORMAT_R8G8B8A8_UNORM;
+   visual->depth_stencil_format = depth_stencil ? PIPE_FORMAT_Z24_UNORM_S8_UINT : PIPE_FORMAT_NONE;
+   visual->accum_format = PIPE_FORMAT_NONE;
+   if (depth_stencil)
+      visual->buffer_mask |= ST_ATTACHMENT_DEPTH_STENCIL_MASK;
+}
+
+struct sgl_context *
+sgl_context_create(struct sgl_display *dpy, int es_major, struct sgl_context *share)
+{
+   struct sgl_context *ctx = CALLOC_STRUCT(sgl_context);
+   if (!ctx)
+      return NULL;
+   ctx->dpy = dpy;
+
+   struct st_context_attribs attribs;
+   memset(&attribs, 0, sizeof(attribs));
+   attribs.profile = API_OPENGLES2;
+   attribs.major = es_major >= 3 ? 3 : 2;
+   attribs.minor = 0;
+   /* the visual of the surfaces it will draw to */
+   sgl_fill_visual(&attribs.visual, true);
+
+   enum st_context_error error;
+   ctx->st = st_api_create_context(&dpy->fscreen, &attribs, &error, share ? share->st : NULL);
+   if (!ctx->st) {
+      fprintf(stderr, "sweetgl: st_api_create_context(ES %d) failed: %d\n", attribs.major, error);
+      FREE(ctx);
+      return NULL;
+   }
+   ctx->st->frontend_context = ctx;
+   return ctx;
+}
+
+void
+sgl_context_destroy(struct sgl_context *ctx)
+{
+   if (!ctx)
+      return;
+   if (st_api_get_current() == ctx->st)
+      st_api_make_current(NULL, NULL, NULL);
+   st_context_flush(ctx->st, 0, NULL, NULL, NULL);
+   st_destroy_context(ctx->st);
+   FREE(ctx);
+}
+
+static bool
+sgl_flush_front(struct st_context *st, struct pipe_frontend_drawable *drawable,
+                enum st_attachment_type statt)
+{
+   /* offscreen: nothing to present */
+   return true;
+}
+
+/* st/mesa asks for the attachments it renders to; create them on first use */
+static bool
+sgl_validate(struct st_context *st, struct pipe_frontend_drawable *drawable,
+             const enum st_attachment_type *statts, unsigned count,
+             struct pipe_resource **out, struct pipe_resource **resolve)
+{
+   struct sgl_surface *surf = (struct sgl_surface *)drawable;
+   struct pipe_screen *screen = surf->dpy->fscreen.screen;
+
+   for (unsigned i = 0; i < count; i++) {
+      enum st_attachment_type a = statts[i];
+      if (!surf->textures[a]) {
+         struct pipe_resource templ = {
+            .target = PIPE_TEXTURE_2D,
+            .width0 = surf->width,
+            .height0 = surf->height,
+            .depth0 = 1,
+            .array_size = 1,
+         };
+         if (a == ST_ATTACHMENT_DEPTH_STENCIL) {
+            templ.format = surf->visual.depth_stencil_format;
+            templ.bind = PIPE_BIND_DEPTH_STENCIL;
+         } else {
+            templ.format = surf->visual.color_format;
+            templ.bind = PIPE_BIND_RENDER_TARGET | PIPE_BIND_SAMPLER_VIEW;
+         }
+         if (templ.format == PIPE_FORMAT_NONE)
+            return false;
+         surf->textures[a] = screen->resource_create(screen, &templ);
+         if (!surf->textures[a])
+            return false;
+      }
+      pipe_resource_reference(&out[i], surf->textures[a]);
+   }
+   return true;
+}
+
+struct sgl_surface *
+sgl_surface_create(struct sgl_display *dpy, unsigned width, unsigned height, bool depth_stencil)
+{
+   struct sgl_surface *surf = CALLOC_STRUCT(sgl_surface);
+   if (!surf)
+      return NULL;
+   surf->dpy = dpy;
+   surf->width = width;
+   surf->height = height;
+   sgl_fill_visual(&surf->visual, depth_stencil);
+
+   surf->base.visual = &surf->visual;
+   surf->base.flush_front = sgl_flush_front;
+   surf->base.validate = sgl_validate;
+   surf->base.fscreen = &dpy->fscreen;
+   p_atomic_set(&surf->base.stamp, 1);
+   surf->base.ID = p_atomic_inc_return(&sgl_drawable_id);
+   return surf;
+}
+
+void
+sgl_surface_destroy(struct sgl_surface *surf)
+{
+   if (!surf)
+      return;
+   st_api_destroy_drawable(&surf->base);
+   for (unsigned i = 0; i < ST_ATTACHMENT_COUNT; i++)
+      pipe_resource_reference(&surf->textures[i], NULL);
+   FREE(surf);
+}
+
+bool
+sgl_make_current(struct sgl_context *ctx, struct sgl_surface *surf)
+{
+   return st_api_make_current(ctx ? ctx->st : NULL, surf ? &surf->base : NULL,
+                              surf ? &surf->base : NULL);
+}
diff --git a/src/gallium/frontends/sweetgl/sweetgl.h b/src/gallium/frontends/sweetgl/sweetgl.h
new file mode 100644
index 0000000..8c66598
--- /dev/null
+++ b/src/gallium/frontends/sweetgl/sweetgl.h
@@ -0,0 +1,46 @@
+/*
+ * Copyright © 2026 ios-jasmine
+ * SPDX-License-Identifier: MIT
+ *
+ * sweetgl: a small GL ES frontend for ios-jasmine. Mesa's GL (st/mesa) on the
+ * freedreno screen, without EGL or DRI: a display owns the GPU screen, a
+ * context is a GL ES 2/3 context, a surface is an offscreen framebuffer (color
+ * and optional depth/stencil) the context renders into. Modelled on Haiku's
+ * hgl frontend; the EAGL side (OpenGLES.framework) is meant to sit on top.
+ */
+
+#ifndef SWEETGL_H
+#define SWEETGL_H
+
+#include <stdbool.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+struct sgl_display;
+struct sgl_context;
+struct sgl_surface;
+
+/* the GPU screen (freedreno on SweetGPU); NULL if the GPU is not up */
+struct sgl_display *sgl_display_create(void);
+void sgl_display_destroy(struct sgl_display *dpy);
+
+/* a GL ES context: es_major 2 or 3 (3 gives the highest 3.x the driver has) */
+struct sgl_context *sgl_context_create(struct sgl_display *dpy, int es_major,
+                                       struct sgl_context *share);
+void sgl_context_destroy(struct sgl_context *ctx);
+
+/* an offscreen RGBA8 framebuffer, with a 24/8 depth/stencil buffer if asked */
+struct sgl_surface *sgl_surface_create(struct sgl_display *dpy, unsigned width,
+                                       unsigned height, bool depth_stencil);
+void sgl_surface_destroy(struct sgl_surface *surf);
+
+/* bind ctx and surf to the calling thread (NULL, NULL unbinds) */
+bool sgl_make_current(struct sgl_context *ctx, struct sgl_surface *surf);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* SWEETGL_H */
diff --git a/src/gallium/frontends/sweetgl/sweetgl_gles2.c b/src/gallium/frontends/sweetgl/sweetgl_gles2.c
new file mode 100644
index 0000000..2bc8126
--- /dev/null
+++ b/src/gallium/frontends/sweetgl/sweetgl_gles2.c
@@ -0,0 +1,14 @@
+/*
+ * Copyright © 2026 ios-jasmine
+ * SPDX-License-Identifier: MIT
+ *
+ * The public GL ES 2/3 entry points (glClear, ...) for sweetgl, as
+ * libGLESv2 has them: each one calls through the current context's dispatch
+ * table (C version; see src/mesa/glapi/es2api/libgles2_public.c).
+ */
+
+#include "glapi/glapi_priv.h"
+
+#define MAPI_TMP_DEFINES
+#define MAPI_TMP_PUBLIC_ENTRIES_NO_HIDDEN
+#include "es2_glapi_mapi_tmp.h"
diff --git a/src/gallium/frontends/sweetgl/sweetgpu_gltest.c b/src/gallium/frontends/sweetgl/sweetgpu_gltest.c
new file mode 100644
index 0000000..78cf27a
--- /dev/null
+++ b/src/gallium/frontends/sweetgl/sweetgpu_gltest.c
@@ -0,0 +1,408 @@
+/*
+ * Copyright © 2026 ios-jasmine
+ * SPDX-License-Identifier: MIT
+ *
+ * sweetgpu_gltest: OpenGL ES on the Adreno 512 through sweetgl (Mesa's GL on
+ * freedreno, ios-jasmine G2). Plain GL ES 2.0 calls into a 64x64 offscreen
+ * surface, each step checked with glReadPixels:
+ *
+ *  1. clear: glClearColor + glClear;
+ *  2. triangle: GLSL ES vertex and fragment shaders, a vertex buffer, varyings
+ *     and a uniform (red, green and blue corners, scaled by the uniform);
+ *  3. texture: a 2x2 texture (nearest) on a full-surface quad, blended at
+ *     alpha 0.5 over the clear color (what CoreAnimation does all day);
+ *  4. depth: two overlapping quads drawn far-after-near with GL_LESS.
+ *
+ * Prints PASS or FAIL per step and exits 0 when all pass.
+ */
+
+#include <math.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include <GLES2/gl2.h>
+
+#include "util/os_time.h"
+#include "sweetgl.h"
+
+#define W 64
+#define H 64
+
+static uint8_t px[W * H * 4];
+
+static const uint8_t clear_px[4] = { 0x40, 0x80, 0xbf, 0xff };
+
+static void
+gl_errors(const char *where)
+{
+   GLenum e;
+   while ((e = glGetError()) != GL_NO_ERROR)
+      printf("%s: GL error 0x%04x\n", where, e);
+}
+
+/* glReadPixels the surface into px (row 0 = bottom, GL window coordinates) */
+static void
+read_back(void)
+{
+   memset(px, 0x5a, sizeof(px));
+   glReadPixels(0, 0, W, H, GL_RGBA, GL_UNSIGNED_BYTE, px);
+   gl_errors("glReadPixels");
+}
+
+/* compare px against expect(x, y) (false = skip), each channel within tol */
+static bool
+check(const char *what, bool (*expect)(unsigned x, unsigned y, uint8_t out[4]), int tol)
+{
+   unsigned bad = 0, checked = 0;
+   for (unsigned y = 0; y < H; y++) {
+      for (unsigned x = 0; x < W; x++) {
+         const uint8_t *p = px + 4 * (y * W + x);
+         uint8_t e[4];
+         if (!expect(x, y, e))
+            continue;
+         checked++;
+         bool ok = true;
+         for (int i = 0; i < 4; i++)
+            ok &= abs((int)p[i] - (int)e[i]) <= tol;
+         if (!ok && bad++ < 4)
+            printf("%s: pixel (%u,%u) %02x %02x %02x %02x, expected %02x %02x %02x %02x\n", what,
+                   x, y, p[0], p[1], p[2], p[3], e[0], e[1], e[2], e[3]);
+      }
+   }
+   static const unsigned marks[][2] = { { 0, 0 }, { 63, 0 }, { 0, 63 }, { 63, 63 }, { 16, 16 }, { 48, 48 } };
+   printf("%s:", what);
+   for (unsigned i = 0; i < sizeof(marks) / sizeof(marks[0]); i++) {
+      const uint8_t *p = px + 4 * (marks[i][1] * W + marks[i][0]);
+      printf(" (%u,%u) %02x%02x%02x%02x", marks[i][0], marks[i][1], p[0], p[1], p[2], p[3]);
+   }
+   printf("; %u of %u checked wrong\n", bad, checked);
+   printf("%s %s\n", bad == 0 && checked ? "PASS:" : "FAIL:", what);
+   return bad == 0 && checked;
+}
+
+static GLuint
+shader(GLenum type, const char *src)
+{
+   GLuint s = glCreateShader(type);
+   glShaderSource(s, 1, &src, NULL);
+   glCompileShader(s);
+   GLint ok = 0;
+   glGetShaderiv(s, GL_COMPILE_STATUS, &ok);
+   if (!ok) {
+      char log[1024] = "";
+      glGetShaderInfoLog(s, sizeof(log), NULL, log);
+      printf("shader compile failed: %s\n", log);
+   }
+   return s;
+}
+
+static GLuint
+program(const char *vs, const char *fs)
+{
+   GLuint p = glCreateProgram();
+   glAttachShader(p, shader(GL_VERTEX_SHADER, vs));
+   glAttachShader(p, shader(GL_FRAGMENT_SHADER, fs));
+   glBindAttribLocation(p, 0, "pos");
+   glBindAttribLocation(p, 1, "attr");
+   glLinkProgram(p);
+   GLint ok = 0;
+   glGetProgramiv(p, GL_LINK_STATUS, &ok);
+   if (!ok) {
+      char log[1024] = "";
+      glGetProgramInfoLog(p, sizeof(log), NULL, log);
+      printf("program link failed: %s\n", log);
+   }
+   return p;
+}
+
+/* --- 1. clear */
+
+static bool
+clear_expected(unsigned x, unsigned y, uint8_t out[4])
+{
+   memcpy(out, clear_px, 4);
+   return true;
+}
+
+static void
+clear(void)
+{
+   glClearColor(0.25f, 0.5f, 0.75f, 1.0f);
+   glClear(GL_COLOR_BUFFER_BIT | GL_DEPTH_BUFFER_BIT);
+}
+
+/* --- 2. triangle: corners (0,0) red, (W,0) green, (0,H) blue, times 0.5..1 */
+
+static const float tri_scale = 0.8f;
+
+static bool
+tri_expected(unsigned x, unsigned y, uint8_t out[4])
+{
+   float fx = x + 0.5f, fy = y + 0.5f;
+   float edge = fx + fy - (float)W;
+   if (fabsf(edge) < 1.0f)
+      return false;
+   if (edge > 0) {
+      memcpy(out, clear_px, 4);
+      return true;
+   }
+   float b = fx / W, c = fy / H, a = 1.0f - b - c;
+   out[0] = (uint8_t)lrintf(a * tri_scale * 255.0f);
+   out[1] = (uint8_t)lrintf(b * tri_scale * 255.0f);
+   out[2] = (uint8_t)lrintf(c * tri_scale * 255.0f);
+   out[3] = 0xff;
+   return true;
+}
+
+static const char tri_vs[] =
+   "attribute vec4 pos;\n"
+   "attribute vec3 attr;\n"
+   "varying mediump vec3 color;\n"
+   "void main() {\n"
+   "   color = attr;\n"
+   "   gl_Position = pos;\n"
+   "}\n";
+
+static const char tri_fs[] =
+   "precision mediump float;\n"
+   "uniform float scale;\n"
+   "varying vec3 color;\n"
+   "void main() {\n"
+   "   gl_FragColor = vec4(color * scale, 1.0);\n"
+   "}\n";
+
+static bool
+triangle(void)
+{
+   static const float verts[] = {
+      /* x, y, then r, g, b */
+      -1.0f, -1.0f, 1.0f, 0.0f, 0.0f,
+      1.0f, -1.0f, 0.0f, 1.0f, 0.0f,
+      -1.0f, 1.0f, 0.0f, 0.0f, 1.0f,
+   };
+   GLuint p = program(tri_vs, tri_fs);
+   glUseProgram(p);
+   glUniform1f(glGetUniformLocation(p, "scale"), tri_scale);
+   GLuint vbo;
+   glGenBuffers(1, &vbo);
+   glBindBuffer(GL_ARRAY_BUFFER, vbo);
+   glBufferData(GL_ARRAY_BUFFER, sizeof(verts), verts, GL_STATIC_DRAW);
+   glVertexAttribPointer(0, 2, GL_FLOAT, GL_FALSE, 20, (void *)0);
+   glVertexAttribPointer(1, 3, GL_FLOAT, GL_FALSE, 20, (void *)8);
+   glEnableVertexAttribArray(0);
+   glEnableVertexAttribArray(1);
+
+   clear();
+   glDrawArrays(GL_TRIANGLES, 0, 3);
+   gl_errors("triangle");
+   read_back();
+
+   glDisableVertexAttribArray(0);
+   glDisableVertexAttribArray(1);
+   glBindBuffer(GL_ARRAY_BUFFER, 0);
+   glDeleteBuffers(1, &vbo);
+   glUseProgram(0);
+   glDeleteProgram(p);
+   return check("triangle", tri_expected, 3);
+}
+
+/* --- 3. texture: 2x2 texels, one per quadrant, blended at alpha 0.5 */
+
+static const uint8_t texels[4][4] = {
+   { 0xff, 0x00, 0x00, 0x80 }, /* bottom left: red */
+   { 0x00, 0xff, 0x00, 0x80 }, /* bottom right: green */
+   { 0x00, 0x00, 0xff, 0x80 }, /* top left: blue */
+   { 0xff, 0xff, 0xff, 0x80 }, /* top right: white */
+};
+
+static bool
+tex_expected(unsigned x, unsigned y, uint8_t out[4])
+{
+   const uint8_t *t = texels[(y >= H / 2) * 2 + (x >= W / 2)];
+   float a = t[3] / 255.0f;
+   for (int i = 0; i < 3; i++)
+      out[i] = (uint8_t)lrintf(t[i] * a + clear_px[i] * (1.0f - a));
+   /* alpha blends too: a * a + 1 * (1 - a) */
+   out[3] = (uint8_t)lrintf((a * a + (1.0f - a)) * 255.0f);
+   return true;
+}
+
+static const char tex_vs[] =
+   "attribute vec4 pos;\n"
+   "attribute vec2 attr;\n"
+   "varying vec2 uv;\n"
+   "void main() {\n"
+   "   uv = attr;\n"
+   "   gl_Position = pos;\n"
+   "}\n";
+
+static const char tex_fs[] =
+   "precision mediump float;\n"
+   "uniform sampler2D tex;\n"
+   "varying vec2 uv;\n"
+   "void main() {\n"
+   "   gl_FragColor = texture2D(tex, uv);\n"
+   "}\n";
+
+static bool
+texture(void)
+{
+   static const float quad[] = {
+      -1.0f, -1.0f, 0.0f, 0.0f,
+      1.0f, -1.0f, 1.0f, 0.0f,
+      -1.0f, 1.0f, 0.0f, 1.0f,
+      1.0f, 1.0f, 1.0f, 1.0f,
+   };
+   GLuint tex;
+   glGenTextures(1, &tex);
+   glBindTexture(GL_TEXTURE_2D, tex);
+   glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA, 2, 2, 0, GL_RGBA, GL_UNSIGNED_BYTE, texels);
+   glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+   glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+   glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+   glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+
+   GLuint p = program(tex_vs, tex_fs);
+   glUseProgram(p);
+   glUniform1i(glGetUniformLocation(p, "tex"), 0);
+   /* client-side arrays: GL ES 2 allows them, and CoreAnimation uses them */
+   glVertexAttribPointer(0, 2, GL_FLOAT, GL_FALSE, 16, quad);
+   glVertexAttribPointer(1, 2, GL_FLOAT, GL_FALSE, 16, quad + 2);
+   glEnableVertexAttribArray(0);
+   glEnableVertexAttribArray(1);
+   glEnable(GL_BLEND);
+   glBlendFunc(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA);
+
+   clear();
+   glDrawArrays(GL_TRIANGLE_STRIP, 0, 4);
+   gl_errors("texture");
+   read_back();
+
+   glDisable(GL_BLEND);
+   glDisableVertexAttribArray(0);
+   glDisableVertexAttribArray(1);
+   glUseProgram(0);
+   glDeleteProgram(p);
+   glDeleteTextures(1, &tex);
+   return check("texture", tex_expected, 2);
+}
+
+/* --- 4. depth: left quad at z -0.5 (near, red) drawn first, right quad at
+ * z 0.5 (far, green) over it; the overlap x 24..39 must stay red */
+
+static bool
+depth_expected(unsigned x, unsigned y, uint8_t out[4])
+{
+   static const uint8_t red[4] = { 0xff, 0, 0, 0xff }, green[4] = { 0, 0xff, 0, 0xff };
+   if (y == 15 || y == 16 || y == 47 || y == 48 || x == 39 || x == 40 || x == 23 || x == 24)
+      return false; /* edges */
+   if (y < 16 || y >= 48)
+      memcpy(out, clear_px, 4);
+   else if (x < 40)
+      memcpy(out, red, 4);
+   else
+      memcpy(out, green, 4);
+   return true;
+}
+
+static const char depth_vs[] =
+   "attribute vec4 pos;\n"
+   "void main() {\n"
+   "   gl_Position = pos;\n"
+   "}\n";
+
+static const char depth_fs[] =
+   "precision mediump float;\n"
+   "uniform vec4 color;\n"
+   "void main() {\n"
+   "   gl_FragColor = color;\n"
+   "}\n";
+
+static bool
+depth(void)
+{
+   /* x -1..0.25 (pixels 0..39) near, x -0.25..1 (pixels 24..63) far; y 16..47 */
+   static const float near_quad[] = {
+      -1.0f, -0.5f, -0.5f, 0.25f, -0.5f, -0.5f, -1.0f, 0.5f, -0.5f, 0.25f, 0.5f, -0.5f,
+   };
+   static const float far_quad[] = {
+      -0.25f, -0.5f, 0.5f, 1.0f, -0.5f, 0.5f, -0.25f, 0.5f, 0.5f, 1.0f, 0.5f, 0.5f,
+   };
+   GLuint p = program(depth_vs, depth_fs);
+   glUseProgram(p);
+   GLint color = glGetUniformLocation(p, "color");
+   glEnableVertexAttribArray(0);
+   glEnable(GL_DEPTH_TEST);
+   glDepthFunc(GL_LESS);
+
+   clear();
+   glUniform4f(color, 1.0f, 0.0f, 0.0f, 1.0f);
+   glVertexAttribPointer(0, 3, GL_FLOAT, GL_FALSE, 0, near_quad);
+   glDrawArrays(GL_TRIANGLE_STRIP, 0, 4);
+   glUniform4f(color, 0.0f, 1.0f, 0.0f, 1.0f);
+   glVertexAttribPointer(0, 3, GL_FLOAT, GL_FALSE, 0, far_quad);
+   glDrawArrays(GL_TRIANGLE_STRIP, 0, 4);
+   gl_errors("depth");
+   read_back();
+
+   glDisable(GL_DEPTH_TEST);
+   glDisableVertexAttribArray(0);
+   glUseProgram(0);
+   glDeleteProgram(p);
+   return check("depth", depth_expected, 1);
+}
+
+int
+main(void)
+{
+   setvbuf(stdout, NULL, _IONBF, 0);
+   printf("step: display\n");
+   struct sgl_display *dpy = sgl_display_create();
+   if (!dpy) {
+      printf("FAIL: no display (is SweetGPU up? sweetgpu=4)\n");
+      return 1;
+   }
+   printf("step: context\n");
+   struct sgl_context *ctx = sgl_context_create(dpy, 2, NULL);
+   if (!ctx) {
+      printf("FAIL: no GL ES context\n");
+      return 1;
+   }
+   printf("step: surface\n");
+   struct sgl_surface *surf = sgl_surface_create(dpy, W, H, true);
+   if (!surf || !sgl_make_current(ctx, surf)) {
+      printf("FAIL: no surface or make-current failed\n");
+      return 1;
+   }
+   printf("GL_VERSION: %s\n", glGetString(GL_VERSION));
+   printf("GL_RENDERER: %s\n", glGetString(GL_RENDERER));
+   printf("GL_SHADING_LANGUAGE_VERSION: %s\n", glGetString(GL_SHADING_LANGUAGE_VERSION));
+   const char *ext = (const char *)glGetString(GL_EXTENSIONS);
+   unsigned n = 0;
+   for (const char *e = ext; e && *e; e++)
+      n += *e == ' ';
+   printf("GL_EXTENSIONS: %u\n", n + (ext && *ext));
+   glViewport(0, 0, W, H);
+
+   bool ok = true;
+   int64_t t0 = os_time_get_nano();
+   printf("step: clear\n");
+   clear();
+   read_back();
+   ok &= check("clear", clear_expected, 0);
+   printf("step: triangle\n");
+   ok &= triangle();
+   printf("step: texture\n");
+   ok &= texture();
+   printf("step: depth\n");
+   ok &= depth();
+   printf("4 steps in %.1f ms\n", (os_time_get_nano() - t0) / 1e6);
+
+   sgl_make_current(NULL, NULL);
+   sgl_surface_destroy(surf);
+   sgl_context_destroy(ctx);
+   sgl_display_destroy(dpy);
+   printf("%s\n", ok ? "PASS: all" : "FAIL");
+   return ok ? 0 : 1;
+}
