diff --git a/include/darwin-drm/xf86drm.h b/include/darwin-drm/xf86drm.h
new file mode 100644
index 0000000..e1858a1
--- /dev/null
+++ b/include/darwin-drm/xf86drm.h
@@ -0,0 +1,87 @@
+/*
+ * Copyright © 2026 ios-jasmine
+ * SPDX-License-Identifier: MIT
+ *
+ * Stand-in for libdrm's xf86drm.h on Apple platforms (ios-jasmine): there is
+ * no DRM device, freedreno runs on its darwin backend (src/freedreno/drm/
+ * darwin). The common freedreno code and the msm backend still reference a
+ * few libdrm calls; here they all fail with -ENODEV.
+ */
+
+#ifndef _XF86DRM_H_
+#define _XF86DRM_H_
+
+#include <errno.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <stdlib.h>
+
+#include "drm-uapi/drm.h"
+
+#define DRM_NODE_PRIMARY 0
+#define DRM_NODE_CONTROL 1
+#define DRM_NODE_RENDER  2
+#define DRM_NODE_MAX     3
+#define DRM_BUS_PCI      0
+#define DRM_BUS_PLATFORM 2
+
+typedef struct _drmVersion {
+   int version_major;
+   int version_minor;
+   int version_patchlevel;
+   int name_len;
+   char *name;
+   int date_len;
+   char *date;
+   int desc_len;
+   char *desc;
+} drmVersion, *drmVersionPtr;
+
+typedef struct _drmPlatformDeviceInfo {
+   char **compatible;
+} drmPlatformDeviceInfo, *drmPlatformDeviceInfoPtr;
+
+typedef struct _drmDevice {
+   char **nodes;
+   int available_nodes;
+   int bustype;
+   union {
+      drmPlatformDeviceInfoPtr platform;
+   } deviceinfo;
+} drmDevice, *drmDevicePtr;
+
+static inline drmVersionPtr drmGetVersion(int fd) { (void)fd; errno = ENODEV; return NULL; }
+static inline void drmFreeVersion(drmVersionPtr v) { (void)v; }
+static inline int drmIoctl(int fd, unsigned long request, void *arg)
+{ (void)fd; (void)request; (void)arg; return -ENODEV; }
+static inline int drmCommandWrite(int fd, unsigned long index, void *data, unsigned long size)
+{ (void)fd; (void)index; (void)data; (void)size; return -ENODEV; }
+static inline int drmCommandWriteRead(int fd, unsigned long index, void *data, unsigned long size)
+{ (void)fd; (void)index; (void)data; (void)size; return -ENODEV; }
+static inline int drmCommandRead(int fd, unsigned long index, void *data, unsigned long size)
+{ (void)fd; (void)index; (void)data; (void)size; return -ENODEV; }
+static inline int drmGetCap(int fd, uint64_t capability, uint64_t *value)
+{ (void)fd; (void)capability; (void)value; return -ENODEV; }
+static inline int drmOpenWithType(const char *name, const char *busid, int type)
+{ (void)name; (void)busid; (void)type; return -ENODEV; }
+static inline int drmPrimeHandleToFD(int fd, uint32_t handle, uint32_t flags, int *prime_fd)
+{ (void)fd; (void)handle; (void)flags; (void)prime_fd; return -ENODEV; }
+static inline int drmPrimeFDToHandle(int fd, int prime_fd, uint32_t *handle)
+{ (void)fd; (void)prime_fd; (void)handle; return -ENODEV; }
+static inline int drmSyncobjCreate(int fd, uint32_t flags, uint32_t *handle)
+{ (void)fd; (void)flags; (void)handle; return -ENODEV; }
+static inline int drmSyncobjDestroy(int fd, uint32_t handle)
+{ (void)fd; (void)handle; return -ENODEV; }
+static inline int drmSyncobjFDToHandle(int fd, int obj_fd, uint32_t *handle)
+{ (void)fd; (void)obj_fd; (void)handle; return -ENODEV; }
+static inline int drmSyncobjExportSyncFile(int fd, uint32_t handle, int *sync_file_fd)
+{ (void)fd; (void)handle; (void)sync_file_fd; return -ENODEV; }
+static inline int drmSyncobjImportSyncFile(int fd, uint32_t handle, int sync_file_fd)
+{ (void)fd; (void)handle; (void)sync_file_fd; return -ENODEV; }
+static inline int drmSyncobjReset(int fd, const uint32_t *handles, uint32_t handle_count)
+{ (void)fd; (void)handles; (void)handle_count; return -ENODEV; }
+static inline int drmGetDevice2(int fd, uint32_t flags, drmDevicePtr *device)
+{ (void)fd; (void)flags; (void)device; return -ENODEV; }
+static inline void drmFreeDevice(drmDevicePtr *device) { (void)device; }
+
+#endif /* _XF86DRM_H_ */
diff --git a/meson.build b/meson.build
index 5f19ef9..46c744c 100644
--- a/meson.build
+++ b/meson.build
@@ -159,6 +159,10 @@ pre_args += '-DHAVE_OPENGL_ES_2=@0@'.format(with_gles2.to_int())
 
 with_any_opengl = with_opengl or with_gles1 or with_gles2
 
+# ios-jasmine: no libdrm on Apple platforms; freedreno uses include/darwin-drm/xf86drm.h
+if host_machine.system() == 'darwin'
+  pre_args += '-I' + (meson.current_source_dir() / 'include' / 'darwin-drm')
+endif
 system_has_kms_drm = ['openbsd', 'netbsd', 'freebsd', 'gnu/kfreebsd', 'dragonfly', 'linux', 'sunos', 'android', 'managarm'].contains(host_machine.system())
 
 gallium_drivers = get_option('gallium-drivers')
@@ -994,6 +998,7 @@ endif
 
 with_gfx_compute = [
   with_any_opengl,
+  host_machine.system() == 'darwin' and with_gallium_freedreno,
   with_any_vk,
   with_clc,
   with_gallium_va and with_video_encode,
diff --git a/src/freedreno/drm/darwin/darwin_bo.c b/src/freedreno/drm/darwin/darwin_bo.c
new file mode 100644
index 0000000..90d06d4
--- /dev/null
+++ b/src/freedreno/drm/darwin/darwin_bo.c
@@ -0,0 +1,154 @@
+/*
+ * Copyright © 2026 ios-jasmine
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "darwin_priv.h"
+
+static int
+darwin_bo_offset(struct fd_bo *bo, uint64_t *offset)
+{
+   *offset = 0;
+   return 0;
+}
+
+/* SweetGPU maps a buffer by its handle (write-combined, like the GPU's view) */
+static void *
+darwin_bo_map(struct fd_bo *bo)
+{
+   mach_vm_address_t addr = 0;
+   mach_vm_size_t size = 0;
+   IOReturn ret = IOConnectMapMemory64(to_darwin_device(bo->dev)->conn, bo->handle,
+                                       mach_task_self(), &addr, &size, DARWIN_kIOMapAnywhere);
+   if (ret) {
+      ERROR_MSG("map of buffer %u failed: 0x%x", bo->handle, ret);
+      return NULL;
+   }
+   return (void *)(uintptr_t)addr;
+}
+
+/* Only reached for shared buffers (imported IOSurfaces), after
+ * fd_bo_cpu_prep waited on this process's own fences. GPU work of other
+ * processes on the same surface is not tracked (no implicit sync yet).
+ */
+static int
+darwin_bo_cpu_prep(struct fd_bo *bo, struct fd_pipe *pipe, uint32_t op)
+{
+   return 0;
+}
+
+static int
+darwin_bo_madvise(struct fd_bo *bo, int willneed)
+{
+   return willneed;
+}
+
+static uint64_t
+darwin_bo_iova(struct fd_bo *bo)
+{
+   return to_darwin_bo(bo)->iova;
+}
+
+static void
+darwin_bo_set_name(struct fd_bo *bo, const char *fmt, va_list ap)
+{
+}
+
+static void
+darwin_bo_destroy(struct fd_bo *bo)
+{
+   /* unmap here: fd_bo_fini_common would munmap() an IOKit mapping */
+   if (bo->map) {
+      IOConnectUnmapMemory64(to_darwin_device(bo->dev)->conn, bo->handle, mach_task_self(),
+                             (mach_vm_address_t)(uintptr_t)bo->map);
+      bo->map = NULL;
+   }
+   fd_bo_fini_common(bo);
+}
+
+static const struct fd_bo_funcs funcs = {
+   .offset = darwin_bo_offset,
+   .map = darwin_bo_map,
+   .cpu_prep = darwin_bo_cpu_prep,
+   .madvise = darwin_bo_madvise,
+   .iova = darwin_bo_iova,
+   .set_name = darwin_bo_set_name,
+   .destroy = darwin_bo_destroy,
+};
+
+static struct fd_bo *
+darwin_bo_wrap(struct fd_device *dev, uint32_t size, uint32_t handle, uint64_t iova)
+{
+   struct darwin_bo *darwin_bo = calloc(1, sizeof(*darwin_bo));
+   if (!darwin_bo)
+      return NULL;
+
+   struct fd_bo *bo = &darwin_bo->base;
+   bo->size = size;
+   bo->handle = handle;
+   bo->funcs = &funcs;
+   darwin_bo->iova = iova;
+
+   fd_bo_init_common(bo, dev);
+
+   return bo;
+}
+
+/* a handle the kernel gave out (an imported IOSurface): ask it where the buffer is */
+struct fd_bo *
+darwin_bo_from_handle(struct fd_device *dev, uint32_t size, uint32_t handle)
+{
+   uint64_t in = handle;
+   uint64_t out[2] = { 0, 0 };
+   uint32_t nout = 2;
+
+   IOReturn ret = IOConnectCallScalarMethod(to_darwin_device(dev)->conn, SWEETGPU_BUFFER_INFO,
+                                            &in, 1, out, &nout);
+   if (ret) {
+      ERROR_MSG("no buffer %u: 0x%x", handle, ret);
+      return NULL;
+   }
+   return darwin_bo_wrap(dev, (uint32_t)out[1], handle, out[0]);
+}
+
+/* fd_bo_from_dmabuf on Darwin: the "fd" is an IOSurface id */
+struct fd_bo *
+darwin_bo_from_iosurface(struct fd_device *dev, int iosurface_id)
+{
+   uint64_t in[2] = { (uint32_t)iosurface_id, 0 };
+   uint64_t out[4] = { 0, 0, 0, 0 };
+   uint32_t nout = 4;
+
+   IOReturn ret = IOConnectCallScalarMethod(to_darwin_device(dev)->conn, SWEETGPU_IMPORT_IOSURFACE,
+                                            in, 2, out, &nout);
+   if (ret || !out[0]) {
+      ERROR_MSG("IOSurface %d not imported: 0x%x", iosurface_id, ret);
+      return NULL;
+   }
+   /* out[3]: wrapped client memory that starts inside its first page. The buffer
+    * covers the whole pages; the importer puts the resource at that offset
+    * (winsys_handle.offset, which freedreno's layout takes as slice 0's offset). */
+   /* one handle per surface: the device's handle table finds a second import */
+   return fd_bo_from_handle(dev, (uint32_t)out[0], (uint32_t)out[2]);
+}
+
+struct fd_bo *
+darwin_bo_new(struct fd_device *dev, uint32_t size, uint32_t flags)
+{
+   uint64_t in[2] = { size, (flags & FD_BO_GPUREADONLY) ? 1 : 0 };
+   uint64_t out[2] = { 0, 0 };
+   uint32_t nout = 2;
+
+   IOReturn ret = IOConnectCallScalarMethod(to_darwin_device(dev)->conn, SWEETGPU_BUFFER_NEW,
+                                            in, 2, out, &nout);
+   if (ret || !out[0]) {
+      ERROR_MSG("buffer of %u bytes not allocated: 0x%x", size, ret);
+      return NULL;
+   }
+
+   struct fd_bo *bo = darwin_bo_wrap(dev, size, (uint32_t)out[0], out[1]);
+   if (!bo)
+      IOConnectCallScalarMethod(to_darwin_device(dev)->conn, SWEETGPU_BUFFER_FREE, out, 1,
+                                NULL, NULL);
+   return bo;
+}
diff --git a/src/freedreno/drm/darwin/darwin_device.c b/src/freedreno/drm/darwin/darwin_device.c
new file mode 100644
index 0000000..81c0409
--- /dev/null
+++ b/src/freedreno/drm/darwin/darwin_device.c
@@ -0,0 +1,82 @@
+/*
+ * Copyright © 2026 ios-jasmine
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "darwin_priv.h"
+
+int
+darwin_get_param(struct fd_device *dev, enum sweetgpu_param param, uint64_t *value)
+{
+   uint64_t in = param;
+   uint32_t nout = 1;
+   IOReturn ret = IOConnectCallScalarMethod(to_darwin_device(dev)->conn, SWEETGPU_GET_PARAM,
+                                            &in, 1, value, &nout);
+   return ret ? -EIO : 0;
+}
+
+static void
+darwin_bo_close_handle(struct fd_bo *bo)
+{
+   uint64_t in = bo->handle;
+   IOConnectCallScalarMethod(to_darwin_device(bo->dev)->conn, SWEETGPU_BUFFER_FREE, &in, 1,
+                             NULL, NULL);
+}
+
+static void
+darwin_device_destroy(struct fd_device *dev)
+{
+   IOServiceClose(to_darwin_device(dev)->conn);
+}
+
+static const struct fd_device_funcs funcs = {
+   .bo_new = darwin_bo_new,
+   .bo_from_handle = darwin_bo_from_handle,
+   .bo_from_dmabuf = darwin_bo_from_iosurface,
+   .bo_close_handle = darwin_bo_close_handle,
+   .pipe_new = darwin_pipe_new,
+   .destroy = darwin_device_destroy,
+};
+
+/* fd is not used: the device is the SweetGPU IOKit service */
+struct fd_device *
+darwin_device_new(int fd)
+{
+   io_service_t service =
+      IOServiceGetMatchingService(kIOMainPortDefault, IOServiceMatching("SweetGPU"));
+   if (!service) {
+      ERROR_MSG("no SweetGPU service (kernel without sweetgpu=4?)");
+      return NULL;
+   }
+
+   io_connect_t conn = 0;
+   IOReturn ret = IOServiceOpen(service, mach_task_self(), 0, &conn);
+   IOObjectRelease(service);
+   if (ret) {
+      ERROR_MSG("cannot open SweetGPU: 0x%x", ret);
+      return NULL;
+   }
+
+   struct darwin_device *darwin_dev = calloc(1, sizeof(*darwin_dev));
+   if (!darwin_dev) {
+      IOServiceClose(conn);
+      return NULL;
+   }
+   darwin_dev->conn = conn;
+
+   struct fd_device *dev = &darwin_dev->base;
+   dev->funcs = &funcs;
+   /* softpin, GMEM base and VA size queries: what SweetGPU offers */
+   dev->version = FD_VERSION_VA_SIZE;
+   dev->bo_size = sizeof(struct darwin_bo);
+
+   uint64_t ready = 0;
+   if (darwin_get_param(dev, SWEETGPU_PARAM_READY, &ready) || !ready) {
+      ERROR_MSG("SweetGPU is not ready");
+      IOServiceClose(conn);
+      free(darwin_dev);
+      return NULL;
+   }
+
+   return dev;
+}
diff --git a/src/freedreno/drm/darwin/darwin_pipe.c b/src/freedreno/drm/darwin/darwin_pipe.c
new file mode 100644
index 0000000..bb58578
--- /dev/null
+++ b/src/freedreno/drm/darwin/darwin_pipe.c
@@ -0,0 +1,205 @@
+/*
+ * Copyright © 2026 ios-jasmine
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "util/os_time.h"
+
+#include "freedreno_ringbuffer_sp.h"
+#include "darwin_priv.h"
+
+/* sweet_gpu.c's UCHE_TRAP_BASE and the GPU clock it runs at (gpumhz=266) */
+#define DARWIN_UCHE_TRAP_BASE 0x0001ffffffff0000ull
+#define DARWIN_MAX_FREQ       266000000ull
+
+static int
+darwin_pipe_get_param(struct fd_pipe *pipe, enum fd_param_id param, uint64_t *value)
+{
+   struct darwin_pipe *darwin_pipe = to_darwin_pipe(pipe);
+   switch (param) {
+   case FD_DEVICE_ID:
+   case FD_GPU_ID:
+      *value = darwin_pipe->gpu_id;
+      return 0;
+   case FD_GMEM_SIZE:
+      *value = darwin_pipe->gmem;
+      return 0;
+   case FD_GMEM_BASE:
+      *value = darwin_pipe->gmem_base;
+      return 0;
+   case FD_CHIP_ID:
+      *value = darwin_pipe->chip_id;
+      return 0;
+   case FD_MAX_FREQ:
+      *value = DARWIN_MAX_FREQ;
+      return 0;
+   case FD_TIMESTAMP:
+      return darwin_get_param(pipe->dev, SWEETGPU_PARAM_TIMESTAMP, value);
+   case FD_NR_PRIORITIES:
+      *value = 1;
+      return 0;
+   case FD_CTX_FAULTS:
+   case FD_GLOBAL_FAULTS:
+   case FD_SUSPEND_COUNT:
+      *value = 0;
+      return 0;
+   case FD_VA_SIZE:
+      return darwin_get_param(pipe->dev, SWEETGPU_PARAM_VA_SIZE, value);
+   case FD_UCHE_TRAP_BASE:
+      *value = DARWIN_UCHE_TRAP_BASE;
+      return 0;
+   default:
+      ERROR_MSG("invalid param id: %d", param);
+      return -1;
+   }
+}
+
+static int
+darwin_pipe_set_param(struct fd_pipe *pipe, enum fd_param_id param, uint64_t value)
+{
+   return -1;
+}
+
+static int
+darwin_pipe_wait(struct fd_pipe *pipe, const struct fd_fence *fence, uint64_t timeout)
+{
+   uint64_t ms = timeout == OS_TIMEOUT_INFINITE ? 60000 : timeout / 1000000;
+   uint64_t in[2] = { fence->kfence, ms };
+   IOReturn ret = IOConnectCallScalarMethod(to_darwin_device(pipe->dev)->conn, SWEETGPU_WAIT,
+                                            in, 2, NULL, NULL);
+   if (ret == DARWIN_kIOReturnTimeout)
+      return -ETIMEDOUT;
+   if (ret) {
+      ERROR_MSG("wait for fence %u failed: 0x%x", fence->kfence, ret);
+      return -EIO;
+   }
+   return 0;
+}
+
+struct darwin_ib {
+   uint64_t iova;
+   uint32_t dwords;
+   uint32_t pad;
+};
+
+/* As msm_ringbuffer_sp.c's flush_submit_list, minus the kernel BO table:
+ * every buffer is always mapped, so only the command buffers' GPU
+ * addresses go to the kernel.
+ */
+static int
+flush_submit_list(struct list_head *submit_list)
+{
+   struct fd_submit_sp *fd_submit = to_fd_submit_sp(last_submit(submit_list));
+   struct fd_pipe *pipe = fd_submit->base.pipe;
+   unsigned nr_cmds = 0;
+
+   foreach_submit (submit, submit_list)
+      nr_cmds += to_fd_ringbuffer_sp(submit->primary)->u.nr_cmds;
+
+   size_t len = 8 + nr_cmds * sizeof(struct darwin_ib);
+   uint8_t *req = calloc(1, len);
+   if (!req)
+      return -ENOMEM;
+   *(uint32_t *)req = nr_cmds;
+   struct darwin_ib *ibs = (struct darwin_ib *)(req + 8);
+
+   unsigned cmd_idx = 0;
+   foreach_submit_safe (submit, submit_list) {
+      struct fd_ringbuffer_sp *deferred_primary = to_fd_ringbuffer_sp(submit->primary);
+
+      for (unsigned i = 0; i < deferred_primary->u.nr_cmds; i++) {
+         struct fd_bo *ring_bo = deferred_primary->u.cmds[i].ring_bo;
+         fd_submit_append_bo(fd_submit, ring_bo);
+         ibs[cmd_idx].iova = fd_bo_get_iova(ring_bo) + submit_offset(ring_bo, deferred_primary->offset);
+         ibs[cmd_idx].dwords = deferred_primary->u.cmds[i].size / 4;
+         cmd_idx++;
+      }
+
+      if (submit == last_submit(submit_list))
+         break;
+
+      struct fd_submit_sp *fd_deferred_submit = to_fd_submit_sp(submit);
+      for (unsigned i = 0; i < fd_deferred_submit->nr_bos; i++)
+         fd_submit_append_bo(fd_submit, fd_deferred_submit->bos[i]);
+
+      list_del(&submit->node);
+      fd_submit_del(submit);
+   }
+
+   uint64_t seqno = 0;
+   uint32_t nout = 1;
+   IOReturn ret = IOConnectCallMethod(to_darwin_device(pipe->dev)->conn, SWEETGPU_SUBMIT, NULL, 0,
+                                      req, len, &seqno, &nout, NULL, NULL);
+   free(req);
+   if (ret) {
+      ERROR_MSG("submit of %u command buffers failed: 0x%x", nr_cmds, ret);
+      return -EIO;
+   }
+   fd_submit->out_fence->kfence = (uint32_t)seqno;
+   fd_submit->out_fence->fence_fd = -1;
+
+   if (fd_submit->in_fence_fd != -1)
+      close(fd_submit->in_fence_fd);
+
+   return 0;
+}
+
+static struct fd_submit *
+darwin_submit_sp_new(struct fd_pipe *pipe)
+{
+   return fd_submit_sp_new(pipe, flush_submit_list);
+}
+
+static void
+darwin_pipe_destroy(struct fd_pipe *pipe)
+{
+   fd_pipe_sp_ringpool_fini(pipe);
+   free(to_darwin_pipe(pipe));
+}
+
+static const struct fd_pipe_funcs sp_funcs = {
+   .ringbuffer_new_object = fd_ringbuffer_sp_new_object,
+   .submit_new = darwin_submit_sp_new,
+   .flush = fd_pipe_sp_flush,
+   .get_param = darwin_pipe_get_param,
+   .set_param = darwin_pipe_set_param,
+   .wait = darwin_pipe_wait,
+   .destroy = darwin_pipe_destroy,
+};
+
+struct fd_pipe *
+darwin_pipe_new(struct fd_device *dev, enum fd_pipe_id id, uint32_t prio)
+{
+   if (id != FD_PIPE_3D)
+      return NULL;
+
+   struct darwin_pipe *darwin_pipe = calloc(1, sizeof(*darwin_pipe));
+   if (!darwin_pipe)
+      return NULL;
+
+   struct fd_pipe *pipe = &darwin_pipe->base;
+   pipe->dev = dev;
+   pipe->funcs = &sp_funcs;
+
+   uint64_t v = 0;
+   if (!darwin_get_param(dev, SWEETGPU_PARAM_GPU_ID, &v))
+      darwin_pipe->gpu_id = v;
+   if (!darwin_get_param(dev, SWEETGPU_PARAM_CHIP_ID, &v))
+      darwin_pipe->chip_id = v;
+   if (!darwin_get_param(dev, SWEETGPU_PARAM_GMEM_SIZE, &v))
+      darwin_pipe->gmem = v;
+   if (!darwin_get_param(dev, SWEETGPU_PARAM_GMEM_BASE, &v))
+      darwin_pipe->gmem_base = v;
+
+   if (!(darwin_pipe->gpu_id || darwin_pipe->chip_id)) {
+      free(darwin_pipe);
+      return NULL;
+   }
+
+   INFO_MSG("SweetGPU pipe: GPU-id %u, chip-id 0x%016" PRIx64 ", GMEM 0x%08x", darwin_pipe->gpu_id,
+            darwin_pipe->chip_id, darwin_pipe->gmem);
+
+   fd_pipe_sp_ringpool_init(pipe);
+
+   return pipe;
+}
diff --git a/src/freedreno/drm/darwin/darwin_priv.h b/src/freedreno/drm/darwin/darwin_priv.h
new file mode 100644
index 0000000..80e2f53
--- /dev/null
+++ b/src/freedreno/drm/darwin/darwin_priv.h
@@ -0,0 +1,113 @@
+/*
+ * Copyright © 2026 ios-jasmine
+ * SPDX-License-Identifier: MIT
+ *
+ * freedreno backend for the SweetGPU kernel driver of ios-jasmine (XNU on a
+ * Snapdragon 660, Adreno 512): instead of Linux's msm DRM ioctls, an IOKit
+ * user client (iokit/Kernel/arm/SweetGPU.cpp in ios-jasmine's j0026):
+ *
+ *   selector 0  get param     in: param                 out: value
+ *   selector 1  buffer new    in: size, flags           out: handle, GPU VA
+ *   selector 2  buffer free   in: handle
+ *   selector 3  submit        struct in: u32 n, u32 0, n x {u64 iova, u32 dwords, u32 0}
+ *                                                       out: seqno
+ *   selector 4  wait          in: seqno, timeout ms     kIOReturnTimeout
+ *   selector 5  completed                               out: last seqno done
+ *   selector 6  import IOSurface  in: id, flags     out: handle, GPU VA, size, offset
+ *   selector 7  buffer info   in: handle                out: GPU VA, size
+ *   memory type = handle      IOConnectMapMemory64 maps a buffer
+ *
+ * Shared buffers are IOSurfaces (j0032): on Darwin a WINSYS_HANDLE_TYPE_FD
+ * handle carries an IOSurface id instead of a dma-buf fd, and the kernel
+ * maps the surface's own memory into the GPU address space.
+ *
+ * Every buffer stays mapped in the one GPU address space, so submits carry
+ * only the command buffers' GPU addresses (no BO list, no relocations).
+ */
+
+#ifndef DARWIN_PRIV_H_
+#define DARWIN_PRIV_H_
+
+#include "freedreno_drmif.h"
+#include "freedreno_priv.h"
+
+#include <mach/mach.h>
+
+/* IOKit user-client calls: the library is in the iPhoneOS SDK, its headers are not */
+typedef mach_port_t io_object_t;
+typedef io_object_t io_service_t;
+typedef io_object_t io_connect_t;
+typedef int IOReturn;
+typedef struct __CFDictionary *CFMutableDictionaryRef;
+extern const mach_port_t kIOMainPortDefault;
+CFMutableDictionaryRef IOServiceMatching(const char *name);
+io_service_t IOServiceGetMatchingService(mach_port_t main, CFMutableDictionaryRef matching);
+IOReturn IOServiceOpen(io_service_t service, task_port_t owning, uint32_t type, io_connect_t *connect);
+IOReturn IOServiceClose(io_connect_t connect);
+IOReturn IOObjectRelease(io_object_t object);
+IOReturn IOConnectCallScalarMethod(io_connect_t connection, uint32_t selector, const uint64_t *input,
+                                   uint32_t inputCnt, uint64_t *output, uint32_t *outputCnt);
+IOReturn IOConnectCallMethod(io_connect_t connection, uint32_t selector, const uint64_t *input,
+                             uint32_t inputCnt, const void *inputStruct, size_t inputStructCnt,
+                             uint64_t *output, uint32_t *outputCnt, void *outputStruct,
+                             size_t *outputStructCnt);
+IOReturn IOConnectMapMemory64(io_connect_t connect, uint32_t memoryType, task_port_t intoTask,
+                              mach_vm_address_t *atAddress, mach_vm_size_t *ofSize, uint32_t options);
+IOReturn IOConnectUnmapMemory64(io_connect_t connect, uint32_t memoryType, task_port_t fromTask,
+                                mach_vm_address_t atAddress);
+#define DARWIN_kIOMapAnywhere      0x00000001
+#define DARWIN_kIOReturnTimeout    ((IOReturn)0xe00002d6)
+
+enum sweetgpu_selector {
+   SWEETGPU_GET_PARAM = 0,
+   SWEETGPU_BUFFER_NEW = 1,
+   SWEETGPU_BUFFER_FREE = 2,
+   SWEETGPU_SUBMIT = 3,
+   SWEETGPU_WAIT = 4,
+   SWEETGPU_COMPLETED = 5,
+   SWEETGPU_IMPORT_IOSURFACE = 6,
+   SWEETGPU_BUFFER_INFO = 7,
+};
+
+/* sweet_gpu_param() numbers */
+enum sweetgpu_param {
+   SWEETGPU_PARAM_READY = 0,
+   SWEETGPU_PARAM_CHIP_ID = 1,
+   SWEETGPU_PARAM_GPU_ID = 2,
+   SWEETGPU_PARAM_GMEM_SIZE = 3,
+   SWEETGPU_PARAM_GMEM_BASE = 4,
+   SWEETGPU_PARAM_VA_START = 5,
+   SWEETGPU_PARAM_VA_SIZE = 6,
+   SWEETGPU_PARAM_NR_RINGS = 7,
+   SWEETGPU_PARAM_TIMESTAMP = 8,
+};
+
+struct darwin_device {
+   struct fd_device base;
+   io_connect_t conn;
+};
+FD_DEFINE_CAST(fd_device, darwin_device);
+
+struct darwin_pipe {
+   struct fd_pipe base;
+   uint32_t gpu_id;
+   uint64_t chip_id;
+   uint64_t gmem_base;
+   uint32_t gmem;
+};
+FD_DEFINE_CAST(fd_pipe, darwin_pipe);
+
+struct darwin_bo {
+   struct fd_bo base;
+   uint64_t iova;
+};
+FD_DEFINE_CAST(fd_bo, darwin_bo);
+
+struct fd_device *darwin_device_new(int fd);
+struct fd_pipe *darwin_pipe_new(struct fd_device *dev, enum fd_pipe_id id, uint32_t prio);
+struct fd_bo *darwin_bo_new(struct fd_device *dev, uint32_t size, uint32_t flags);
+struct fd_bo *darwin_bo_from_handle(struct fd_device *dev, uint32_t size, uint32_t handle);
+struct fd_bo *darwin_bo_from_iosurface(struct fd_device *dev, int iosurface_id);
+int darwin_get_param(struct fd_device *dev, enum sweetgpu_param param, uint64_t *value);
+
+#endif /* DARWIN_PRIV_H_ */
