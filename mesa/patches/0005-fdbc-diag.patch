From 37603c9d110bc41ac5d2ccc408bd4155a34e43f6 Mon Sep 17 00:00:00 2001
From: telegdyd <telegdyd93@gmail.com>
Date: Sun, 25 Oct 2026 07:02:09 +0100
Subject: [PATCH] freedreno: dump batch cache slots when no batch can be had
 (diagnostic)

---
 .../drivers/freedreno/freedreno_batch_cache.c | 32 ++++++++
 src/gallium/frontends/sweetgl/sweetca.c       | 21 +++--
 src/gallium/frontends/sweetgl/sweetgl.c       | 77 +++++++++++++++++++
 src/gallium/frontends/sweetgl/sweetgl.h       | 10 +++
 4 files changed, 135 insertions(+), 5 deletions(-)

diff --git a/src/gallium/drivers/freedreno/freedreno_batch_cache.c b/src/gallium/drivers/freedreno/freedreno_batch_cache.c
index dc308d2..621acec 100644
--- a/src/gallium/drivers/freedreno/freedreno_batch_cache.c
+++ b/src/gallium/drivers/freedreno/freedreno_batch_cache.c
@@ -499,6 +499,35 @@ fd_bc_alloc_batch(struct fd_context *ctx, bool nondraw)
    return batch;
 }
 
+#include <stdio.h>
+#include "freedreno_fence.h"
+
+/* ios-jasmine diagnostic (task 5): the cache has no batch to give and none to
+ * flush; say what holds its slots */
+static void
+sweet_dump_batches(struct fd_context *ctx) assert_dt
+{
+   struct fd_batch_cache *cache = &ctx->screen->batch_cache;
+   fprintf(stderr, "fdbc: no batch: mask %08x ctx %p batch %p nondraw %p last_fence %p (batch %p)\n",
+           cache->batch_mask, ctx, ctx->batch, ctx->batch_nondraw, ctx->last_fence,
+           ctx->last_fence ? ctx->last_fence->batch : NULL);
+   for (unsigned i = 0; i < ARRAY_SIZE(cache->batches); i++) {
+      struct fd_batch *b = cache->batches[i];
+      if (!b)
+         continue;
+      uint32_t held_by = 0;
+      for (unsigned j = 0; j < ARRAY_SIZE(cache->batches); j++)
+         if (cache->batches[j] && (cache->batches[j]->dependents_mask & (1u << i)))
+            held_by |= 1u << j;
+      fprintf(stderr, "fdbc: %2u %p ctx %s flushed %d ref %d draws %u needs %d nondraw %d seq %u "
+              "deps %08x held_by %08x fence %p fence_batch %p key %p\n",
+              i, b, b->ctx == ctx ? "same" : "other", b->flushed, b->reference.count, b->num_draws,
+              b->needs_flush, b->nondraw, b->seqno, b->dependents_mask, held_by, b->fence,
+              b->fence ? b->fence->batch : NULL, b->key);
+   }
+   fflush(stderr);
+}
+
 static struct fd_batch *
 batch_from_key(struct fd_context *ctx, struct fd_batch_key *key) assert_dt
 {
@@ -586,9 +615,12 @@ fd_batch_from_fb(struct fd_context *ctx,
    key->num_surfs = idx;
 
    struct fd_batch *batch = NULL;
+   unsigned tries = 0;
    while (!batch) {
       fd_screen_lock(ctx->screen);
       batch = batch_from_key(ctx, key);
+      if (!batch && ++tries == 100000)
+         sweet_dump_batches(ctx);
       fd_screen_unlock(ctx->screen);
    }
 
diff --git a/src/gallium/frontends/sweetgl/sweetca.c b/src/gallium/frontends/sweetgl/sweetca.c
index a3cf99e..6978e56 100644
--- a/src/gallium/frontends/sweetgl/sweetca.c
+++ b/src/gallium/frontends/sweetgl/sweetca.c
@@ -116,6 +116,7 @@ struct sca_ctx {
    unsigned frame;                     /* glFlush count: CA flushes once per frame */
    GLuint shadows[64];                 /* textures standing in for render-target surfaces */
    GLuint program, fbo;
+   bool followed;                      /* Mesa's driver thread has this one's priority */
    GLuint fbo_tex[FBOMAX];             /* color attachment 0 texture of each framebuffer */
    uint16_t tex_w[TEXMAX], tex_h[TEXMAX]; /* level 0 sizes, as given to us */
    uint8_t tex_swizzled[TEXMAX];
@@ -1201,19 +1202,29 @@ trace_draw(struct sca_ctx *c, GLenum mode, GLsizei count)
  * Merged submits (Mesa darwin: no implicit sync) reach the GPU only when a fence
  * is needed, at CA's per-frame finish: the GPU then idles while the CPU builds the
  * frame and the CPU waits while the GPU draws it. Every kick_every draws, a fence
- * checked without waiting sends what is queued, so both work at once.
- * SWEETCA_KICK=N (default 32, 0: off).
+ * checked without waiting sends what is queued, so both work at once. With Mesa's
+ * threaded context that check would only queue a flush, so sgl_kick has the
+ * driver thread send it. SWEETCA_KICK=N (default 32, 0: off).
+ *
+ * The driver thread does most of each draw's CPU work, so it gets the priority
+ * of the thread CA draws from (its display thread), once per context.
  */
 static unsigned kick_every = 32;
 static __thread unsigned kick_draws;
 
 static void
-kick_after_draw(void)
+kick_after_draw(struct sca_ctx *c)
 {
+   if (!c->followed) {
+      c->followed = true;
+      sgl_follow_thread(c->gl);
+   }
    if (kick_every == 0 || ++kick_draws < kick_every)
       return;
    kick_draws = 0;
    SWEET_SCOPE(sp_kick, SP_KICK);
+   if (sgl_kick(c->gl))
+      return;
    GLsync s = glFenceSync(GL_SYNC_GPU_COMMANDS_COMPLETE, 0);
    if (s) {
       (void)glClientWaitSync(s, GL_SYNC_FLUSH_COMMANDS_BIT, 0);
@@ -1234,7 +1245,7 @@ w_DrawArrays(void *rctx, GLenum mode, GLint first, GLsizei count)
       glDrawArrays(mode, first, count);
    }
    shadow_drawn(c);
-   kick_after_draw();
+   kick_after_draw(c);
    POST(65);
 }
 
@@ -1251,7 +1262,7 @@ w_DrawElements(void *rctx, GLenum mode, GLsizei count, GLenum type, const void *
       glDrawElements(mode, count, type, indices);
    }
    shadow_drawn(c);
-   kick_after_draw();
+   kick_after_draw(c);
    POST(67);
 }
 
diff --git a/src/gallium/frontends/sweetgl/sweetgl.c b/src/gallium/frontends/sweetgl/sweetgl.c
index 401f8be..c3c24af 100644
--- a/src/gallium/frontends/sweetgl/sweetgl.c
+++ b/src/gallium/frontends/sweetgl/sweetgl.c
@@ -9,7 +9,9 @@
  */
 
 #include <fcntl.h>
+#include <pthread.h>
 #include <stdio.h>
+#include <string.h>
 #include <unistd.h>
 
 #include "pipe/p_screen.h"
@@ -433,6 +435,81 @@ sgl_texture_barrier(void)
    _mesa_TextureBarrierNV();
 }
 
+/*
+ * With the threaded context (gallium's u_threaded_context, freedreno on a5xx
+ * and a6xx) st/mesa's pipe is a wrapper that queues calls for a driver thread;
+ * it has callback(), and its priv is the freedreno context the calls run on.
+ * freedreno's own context has no callback(). GALLIUM_THREAD=0 turns it off.
+ */
+static struct pipe_context *
+sgl_driver_pipe(struct sgl_context *ctx)
+{
+   struct pipe_context *pipe = ctx->st->pipe;
+   return pipe->callback ? pipe->priv : NULL;
+}
+
+/* on the driver thread, in order with the calls queued before it */
+static void
+sgl_kick_driver(void *data)
+{
+   struct pipe_context *pipe = data;
+   struct pipe_screen *screen = pipe->screen;
+   struct pipe_fence_handle *fence = NULL;
+
+   /* what a fence checked with a zero timeout does without the thread: the
+    * batch is flushed and the check sends Mesa's deferred submits to the kernel */
+   pipe->flush(pipe, &fence, 0);
+   if (fence) {
+      (void)screen->fence_finish(screen, pipe, fence, 0);
+      screen->fence_reference(screen, &fence, NULL);
+   }
+}
+
+bool
+sgl_kick(struct sgl_context *ctx)
+{
+   struct pipe_context *driver = sgl_driver_pipe(ctx);
+   if (!driver)
+      return false;
+   struct pipe_context *pipe = ctx->st->pipe;
+   pipe->callback(pipe, sgl_kick_driver, driver, false);
+   /* hand the queued calls, the kick among them, to the driver thread now */
+   pipe->flush(pipe, NULL, PIPE_FLUSH_ASYNC);
+   return true;
+}
+
+struct sgl_sched {
+   int policy;
+   struct sched_param param;
+};
+
+static void
+sgl_follow_driver(void *data)
+{
+   struct sgl_sched *s = data;
+   int r = pthread_setschedparam(pthread_self(), s->policy, &s->param);
+   fprintf(stderr, "sweetgl: driver thread scheduling policy %d priority %d: %s\n", s->policy,
+           s->param.sched_priority, r ? strerror(r) : "set");
+   FREE(s);
+}
+
+void
+sgl_follow_thread(struct sgl_context *ctx)
+{
+   struct pipe_context *driver = sgl_driver_pipe(ctx);
+   if (!driver)
+      return;
+   struct sgl_sched *s = CALLOC_STRUCT(sgl_sched);
+   if (!s)
+      return;
+   if (pthread_getschedparam(pthread_self(), &s->policy, &s->param)) {
+      FREE(s);
+      return;
+   }
+   struct pipe_context *pipe = ctx->st->pipe;
+   pipe->callback(pipe, sgl_follow_driver, s, false);
+}
+
 uint32_t
 sgl_sampled_2d_units(struct sgl_context *ctx)
 {
diff --git a/src/gallium/frontends/sweetgl/sweetgl.h b/src/gallium/frontends/sweetgl/sweetgl.h
index 23b2f6c..a374274 100644
--- a/src/gallium/frontends/sweetgl/sweetgl.h
+++ b/src/gallium/frontends/sweetgl/sweetgl.h
@@ -91,6 +91,16 @@ void sgl_texture_barrier(void);
  * linked-program state, including sampler arrays and glUniform changes. */
 uint32_t sgl_sampled_2d_units(struct sgl_context *ctx);
 
+/*
+ * With Mesa's threaded context (the default; GALLIUM_THREAD=0 turns it off),
+ * a driver thread does freedreno's draw, batch and submit work. sgl_kick sends
+ * what ctx has queued to the GPU without waiting, from that thread; false
+ * without the threaded context. sgl_follow_thread gives the driver thread the
+ * calling thread's scheduling policy and priority.
+ */
+bool sgl_kick(struct sgl_context *ctx);
+void sgl_follow_thread(struct sgl_context *ctx);
+
 /* bind ctx and surf to the calling thread (NULL, NULL unbinds) */
 bool sgl_make_current(struct sgl_context *ctx, struct sgl_surface *surf);
 
-- 
