diff --git a/src/freedreno/drm/darwin/sweet_profile.c b/src/freedreno/drm/darwin/sweet_profile.c
index ba1e038..6a26e01 100644
--- a/src/freedreno/drm/darwin/sweet_profile.c
+++ b/src/freedreno/drm/darwin/sweet_profile.c
@@ -36,7 +36,10 @@ static const char *const event_names[SPE_COUNT] = {
    "sysbarrier-reject-other-batch", "sysbarrier-reject-state", "sysbarrier-clear-split",
    "gmem-select", "gmem-split", "gmem-sys-barrier", "gmem-sys-ineligible",
    "gmem-sys-unsafe", "gmem-sys-nohist", "gmem-sys-cost", "gmem-measured",
-   "gmem-time-sys-us", "gmem-time-gmem-us", "gmem-sys-one-draw"
+   "gmem-time-sys-us", "gmem-time-gmem-us", "gmem-sys-one-draw",
+   "feedback-fetch", "feedback-selfread", "feedback-both",
+   "fbread-gmem", "fbread-sys-bins",
+   "gmem-time-min-us", "gmem-fb-decisions", "gmem-fb-time-sys-us", "gmem-fb-time-min-us"
 };
 
 __attribute__((constructor)) static void
diff --git a/src/gallium/drivers/freedreno/a5xx/fd5_context.c b/src/gallium/drivers/freedreno/a5xx/fd5_context.c
index 5f7954a..5f8e4a3 100644
--- a/src/gallium/drivers/freedreno/a5xx/fd5_context.c
+++ b/src/gallium/drivers/freedreno/a5xx/fd5_context.c
@@ -27,6 +27,8 @@ fd5_context_destroy(struct pipe_context *pctx) in_dt
    struct fd5_context *fd5_ctx = fd5_context(fd_context(pctx));
 
    u_upload_destroy(fd5_ctx->border_color_uploader);
+   if (fd5_ctx->fbread_uploader)
+      u_upload_destroy(fd5_ctx->fbread_uploader);
    pipe_resource_reference(&fd5_ctx->border_color_buf, NULL);
 
    fd_context_destroy(pctx);
@@ -57,6 +59,8 @@ fd5_context_create(struct pipe_screen *pscreen, void *priv,
 
    /* 0 off, 1 narrow (1-5 draws, no clear, nothing else pending), 2 widened */
    fd5_ctx->sysmem_barrier_level = debug_get_num_option("SWEETCA_SYS_BARRIER", 0);
+   fd5_ctx->gmem_fbread = debug_get_num_option("SWEETCA_GMEM_FBREAD", 0);
+   fd5_ctx->fbread_tile = debug_get_num_option("SWEETCA_GMEM_FBREAD_TILE", TILE5_2) & 3;
    fd5_ctx->base.sysmem_barrier_keeps_clears = fd5_ctx->sysmem_barrier_level >= 2;
    pctx = &fd5_ctx->base.base;
    pctx->screen = pscreen;
@@ -99,6 +103,8 @@ fd5_context_create(struct pipe_screen *pscreen, void *priv,
 
    fd5_ctx->border_color_uploader =
       u_upload_create(pctx, 4096, 0, PIPE_USAGE_STREAM, 0);
+   if (fd5_ctx->gmem_fbread > 0)
+      fd5_ctx->fbread_uploader = u_upload_create(pctx, 64 * 1024, 0, PIPE_USAGE_STREAM, 0);
 
    /* As on a6xx: the frontend's validation and the driver's draw emission,
     * batch and submit work then run on separate threads.  GALLIUM_THREAD=0
diff --git a/src/gallium/drivers/freedreno/a5xx/fd5_context.h b/src/gallium/drivers/freedreno/a5xx/fd5_context.h
index 78c1bd7..0fe0d47 100644
--- a/src/gallium/drivers/freedreno/a5xx/fd5_context.h
+++ b/src/gallium/drivers/freedreno/a5xx/fd5_context.h
@@ -19,6 +19,12 @@ struct fd5_context {
    struct fd_context base;
 
    int sysmem_barrier_level;
+   /* 0013 (SWEETCA_GMEM_FBREAD): a retained barrier's feedback reads come
+    * from the GMEM tile when the batch renders through GMEM (single bin
+    * only for now); SWEETCA_GMEM_FBREAD_TILE: the descriptor's tile mode */
+   int gmem_fbread;
+   unsigned fbread_tile, fbread_told;
+   struct u_upload_mgr *fbread_uploader;
    unsigned sysmem_barriers;
    /* task 24 stage 3: per-batch GMEM rule (SWEETCA_GMEM), fd5_gmem.c */
    struct fd5_sweet_gmem *sweet_gmem;
diff --git a/src/gallium/drivers/freedreno/a5xx/fd5_draw.c b/src/gallium/drivers/freedreno/a5xx/fd5_draw.c
index 1377580..39b8dda 100644
--- a/src/gallium/drivers/freedreno/a5xx/fd5_draw.c
+++ b/src/gallium/drivers/freedreno/a5xx/fd5_draw.c
@@ -653,7 +653,7 @@ fd5_texture_barrier(struct fd_context *ctx, unsigned flags) in_dt
    /* Task 24 stage 3: the draws so far would render through GMEM: end the
     * batch here instead (the caller flushes), feedback draws start anew.
     */
-   if (!batch->a5xx_sysmem_barrier && fd5_sweet_gmem_split(batch))
+   if (!fd5_ctx->gmem_fbread && !batch->a5xx_sysmem_barrier && fd5_sweet_gmem_split(batch))
       return fd5_texture_barrier_reject(SPE_GMEM_SPLIT);
    if (!batch->sweet_fb_barriers) {
       batch->sweet_fb_pre = MIN2(batch->num_draws, UINT16_MAX);
@@ -671,6 +671,9 @@ fd5_texture_barrier(struct fd_context *ctx, unsigned flags) in_dt
    fd5_emit_flush(ctx, ring); /* CACHE_FLUSH_TS then WAIT_FOR_IDLE */
    fd5_event_write(batch, ring, PC_CCU_INVALIDATE_COLOR, false);
    fd5_cache_flush(batch, ring); /* UCHE invalidate then WAIT_FOR_IDLE */
+   /* 0013: the first barrier decides; one without the switch keeps it sysmem */
+   batch->a5xx_fbread = fd5_ctx->gmem_fbread > 0 &&
+                        (batch->a5xx_fbread || !batch->a5xx_sysmem_barrier);
    batch->a5xx_sysmem_barrier = true;
    fd_batch_needs_flush(batch);
    fd_bt_batch(batch, "sysbarrier-retained", NULL, NULL, flags);
diff --git a/src/gallium/drivers/freedreno/a5xx/fd5_emit.c b/src/gallium/drivers/freedreno/a5xx/fd5_emit.c
index b6decab..8e55b06 100644
--- a/src/gallium/drivers/freedreno/a5xx/fd5_emit.c
+++ b/src/gallium/drivers/freedreno/a5xx/fd5_emit.c
@@ -11,6 +11,7 @@
 #include "util/format/u_format.h"
 #include "util/u_helpers.h"
 #include "util/u_memory.h"
+#include "util/u_upload_mgr.h"
 #include "util/u_string.h"
 #include "util/u_viewport.h"
 
@@ -311,6 +312,54 @@ emit_border_color(struct fd_context *ctx, struct fd_ringbuffer *ring) assert_dt
    u_upload_unmap(fd5_ctx->border_color_uploader);
 }
 
+/* 0013 (SWEETCA_GMEM_FBREAD): the views of the batch's own target are loaded
+ * a second time, indirectly, from a descriptor in memory (a slot). Sysmem
+ * batches leave it as written here (the same as the direct one); GMEM batches
+ * point it at the tile, rebased for every bin by the bin prologue
+ * (fd5_gmem.c fbread_*), since the shader reads absolute pixel positions.
+ */
+static void
+emit_fbread_slots(struct fd_context *ctx, struct fd_ringbuffer *ring, enum a4xx_state_block sb,
+                  struct fd_texture_stateobj *tex, uint32_t mask) assert_dt
+{
+   struct fd5_context *fd5_ctx = fd5_context(ctx);
+   struct fd_batch *batch = ctx->batch;
+   u_foreach_bit (i, mask) {
+      const struct fd5_pipe_sampler_view *view = fd5_pipe_sampler_view(tex->textures[i]);
+      struct fd_resource *rsc = fd_resource(view->base.texture);
+      uint64_t iova = fd_bo_get_iova(rsc->bo) + view->offset;
+      uint32_t d[12] = {
+         view->texconst0 | A5XX_TEX_CONST_0_TILE_MODE(rsc->layout.tile_mode), view->texconst1,
+         view->texconst2, view->texconst3, (uint32_t)iova, (uint32_t)(iova >> 32) | view->texconst5,
+         view->texconst6, view->texconst7, view->texconst8, view->texconst9, view->texconst10,
+         view->texconst11,
+      };
+      struct fd_fbread_slot *slot = NULL;
+      util_dynarray_foreach (&batch->fbread_slots, struct fd_fbread_slot, s) {
+         if (!memcmp(s->map, d, sizeof(d))) {
+            slot = s;
+            break;
+         }
+      }
+      if (!slot) {
+         struct pipe_resource *prsc = NULL;
+         unsigned off = 0;
+         void *map = NULL;
+         u_upload_alloc_ref(fd5_ctx->fbread_uploader, 0, 64, 64, &off, &prsc, &map);
+         if (!prsc)
+            continue;
+         memcpy(map, d, sizeof(d));
+         slot = util_dynarray_grow(&batch->fbread_slots, struct fd_fbread_slot, 1);
+         *slot = (struct fd_fbread_slot){ .bo = fd_resource(prsc)->bo, .offset = off, .map = map };
+         pipe_resource_reference(&prsc, NULL);
+      }
+      OUT_PKT7(ring, CP_LOAD_STATE4, 3);
+      OUT_RING(ring, CP_LOAD_STATE4_0_DST_OFF(i) | CP_LOAD_STATE4_0_STATE_SRC(SS4_INDIRECT) |
+                        CP_LOAD_STATE4_0_STATE_BLOCK(sb) | CP_LOAD_STATE4_0_NUM_UNIT(1));
+      OUT_RELOC(ring, slot->bo, slot->offset, CP_LOAD_STATE4_1_STATE_TYPE(ST4_CONSTANTS), 0);
+   }
+}
+
 static bool
 emit_textures(struct fd_context *ctx, struct fd_ringbuffer *ring,
               enum a4xx_state_block sb,
@@ -349,6 +398,8 @@ emit_textures(struct fd_context *ctx, struct fd_ringbuffer *ring,
    if (tex->num_textures > 0) {
       unsigned num_textures = tex->num_textures;
 
+      uint32_t fbread_mask = 0;
+
       /* emit texture state: */
       OUT_PKT7(ring, CP_LOAD_STATE4, 3 + (12 * num_textures));
       OUT_RING(ring, CP_LOAD_STATE4_0_DST_OFF(0) |
@@ -368,6 +419,13 @@ emit_textures(struct fd_context *ctx, struct fd_ringbuffer *ring,
          if (view->base.texture)
             tile_mode = fd_resource(view->base.texture)->layout.tile_mode;
 
+         /* 0013: a view of the target this batch draws into */
+         struct fd_batch *batch = ctx->batch;
+         if (fd5_context(ctx)->gmem_fbread > 0 && batch && ring == batch->draw &&
+             view->base.texture && batch->framebuffer.nr_cbufs &&
+             view->base.texture == batch->framebuffer.cbufs[0].texture && i < 32)
+            fbread_mask |= 1u << i;
+
          OUT_RING(ring,
                   view->texconst0 | A5XX_TEX_CONST_0_TILE_MODE(tile_mode));
          OUT_RING(ring, view->texconst1);
@@ -390,6 +448,8 @@ emit_textures(struct fd_context *ctx, struct fd_ringbuffer *ring,
          OUT_RING(ring, view->texconst10);
          OUT_RING(ring, view->texconst11);
       }
+      if (fbread_mask)
+         emit_fbread_slots(ctx, ring, sb, tex, fbread_mask);
    }
 
    return needs_border;
diff --git a/src/gallium/drivers/freedreno/a5xx/fd5_gmem.c b/src/gallium/drivers/freedreno/a5xx/fd5_gmem.c
index eb074c6..4ad37dd 100644
--- a/src/gallium/drivers/freedreno/a5xx/fd5_gmem.c
+++ b/src/gallium/drivers/freedreno/a5xx/fd5_gmem.c
@@ -24,8 +24,81 @@
 #include "fd5_program.h"
 #include "fd5_zsa.h"
 
+#include "util/sweet_profile.h"
+
 static void sg_emit(struct fd_batch *b, struct fd_ringbuffer *ring, unsigned which);
 
+/* 0013 (SWEETCA_GMEM_FBREAD, default off): framebuffer reads from the tile.
+ *
+ * a5xx's texture cache reads GMEM through the UCHE_GMEM_RANGE window (the
+ * kernel sets it to 0x100000, SweetGPU param 4 = screen->gmem_base), as a6xx's
+ * framebuffer fetch does. The views of a batch's own target are loaded from
+ * memory slots (fd5_emit.c emit_fbread_slots()). For a GMEM batch,
+ * fbread_gmem_init() turns each slot into a view of the tile: the bin's
+ * pitch, tile mode SWEETCA_GMEM_FBREAD_TILE (default TILE5_2, what emit_mrt()
+ * renders GMEM in) and the swizzle without the target's swap (GMEM holds the
+ * colour unswapped; an a5xx view does BGRA by swizzle over memory order).
+ * The shader reads absolute pixel positions, the tile holds the bin's: fbread
+ * batches get bins of full width (one column, freedreno_gmem.c), so a bin is
+ * its rows yoff.. and fbread_gmem_bin() writes every slot's base as
+ * gmem_base + cbuf_base[0] - yoff * pitch before the bin's draws (49-bit
+ * address, wrapping below zero).
+ */
+static void
+fbread_gmem_init(struct fd_batch *batch)
+{
+   struct fd5_context *fd5_ctx = fd5_context(batch->ctx);
+   const struct fd_gmem_stateobj *gmem = batch->gmem_state;
+   unsigned n = util_dynarray_num_elements(&batch->fbread_slots, struct fd_fbread_slot);
+   if (!n)
+      return;
+   uint32_t pitch = gmem->bin_w * gmem->cbuf_cpp[0];
+   enum a3xx_color_swap swap = fd5_pipe2swap(batch->framebuffer.cbufs[0].format);
+   util_dynarray_foreach (&batch->fbread_slots, struct fd_fbread_slot, slot) {
+      uint32_t *d = slot->map;
+      d[0] = (d[0] & ~A5XX_TEX_CONST_0_TILE_MODE__MASK) | A5XX_TEX_CONST_0_TILE_MODE(fd5_ctx->fbread_tile);
+      if (swap != WZYX) {
+         uint32_t sw = d[0];
+         d[0] &= ~(A5XX_TEX_CONST_0_SWIZ_X__MASK | A5XX_TEX_CONST_0_SWIZ_Y__MASK |
+                   A5XX_TEX_CONST_0_SWIZ_Z__MASK | A5XX_TEX_CONST_0_SWIZ_W__MASK);
+         for (unsigned c = 0; c < 4; c++) {
+            unsigned sel = (sw >> (4 + 3 * c)) & 7;
+            if (sel <= A5XX_TEX_W)
+               sel = swap == WXYZ ? (sel == A5XX_TEX_X ? A5XX_TEX_Z : sel == A5XX_TEX_Z ? A5XX_TEX_X : sel)
+                                  : 3 - sel;      /* XYZW: ABGR */
+            d[0] |= sel << (4 + 3 * c);
+         }
+      }
+      d[2] = (d[2] & ~A5XX_TEX_CONST_2_PITCH__MASK) | A5XX_TEX_CONST_2_PITCH(pitch);
+   }
+   SWEET_EVENT(SPE_FBREAD_GMEM, 1);
+   if (fd5_ctx->fbread_told++ < 4)
+      fprintf(stderr, "sweetca: gmem fbread batch %ux%u, %u draws, bins %ux%u of %ux%u, pitch %u tile %u, %u slots\n",
+              batch->framebuffer.width, batch->framebuffer.height, batch->num_draws, gmem->nbins_x, gmem->nbins_y,
+              gmem->bin_w, gmem->bin_h, pitch, fd5_ctx->fbread_tile, n);
+}
+
+static void
+fbread_gmem_bin(struct fd_batch *batch, struct fd_ringbuffer *ring, const struct fd_tile *tile) assert_dt
+{
+   const struct fd_gmem_stateobj *gmem = batch->gmem_state;
+   if (!util_dynarray_num_elements(&batch->fbread_slots, struct fd_fbread_slot))
+      return;
+   uint64_t pitch = gmem->bin_w * gmem->cbuf_cpp[0];
+   uint64_t base = (batch->ctx->screen->gmem_base + gmem->cbuf_base[0] - tile->yoff * pitch -
+                    tile->xoff * (uint64_t)gmem->cbuf_cpp[0]) & ((1ull << 49) - 1);
+   util_dynarray_foreach (&batch->fbread_slots, struct fd_fbread_slot, slot) {
+      OUT_PKT7(ring, CP_MEM_WRITE, 4);
+      OUT_RELOC(ring, slot->bo, slot->offset + 16, 0, 0);
+      OUT_RING(ring, (uint32_t)base);
+      OUT_RING(ring, (slot->map[5] & ~A5XX_TEX_CONST_5_BASE_HI__MASK) |
+                        A5XX_TEX_CONST_5_BASE_HI((uint32_t)(base >> 32)));
+   }
+   OUT_PKT7(ring, CP_WAIT_MEM_WRITES, 0);
+   OUT_PKT7(ring, CP_WAIT_FOR_ME, 0);
+   fd5_cache_flush(batch, ring);      /* nothing may hold the last bin's descriptor */
+}
+
 static void
 emit_mrt(struct fd_ringbuffer *ring, unsigned nr_bufs,
          struct pipe_surface *bufs, const struct fd_gmem_stateobj *gmem)
@@ -383,6 +456,7 @@ fd5_emit_tile_init(struct fd_batch *batch) assert_dt
    struct pipe_framebuffer_state *pfb = &batch->framebuffer;
 
    sg_emit(batch, ring, 0);   /* task 24 stage 3: GPU time of the whole pass */
+   fbread_gmem_init(batch);
    fd5_emit_restore(batch, ring);
 
    if (batch->prologue)
@@ -482,6 +556,8 @@ fd5_emit_tile_prep(struct fd_batch *batch, const struct fd_tile *tile) assert_dt
 
    OUT_PKT4(ring, REG_A5XX_RB_WINDOW_OFFSET, 1);
    OUT_RING(ring, A5XX_RB_WINDOW_OFFSET_X(x1) | A5XX_RB_WINDOW_OFFSET_Y(y1));
+
+   fbread_gmem_bin(batch, ring, tile);
 }
 
 /*
@@ -699,6 +775,7 @@ fd5_emit_tile_fini(struct fd_batch *batch) assert_dt
    fd5_cache_flush(batch, ring);
    fd5_set_render_mode(batch->ctx, ring, BYPASS);
    sg_emit(batch, ring, 4);
+   util_dynarray_clear(&batch->fbread_slots);
 }
 
 static void
@@ -708,6 +785,7 @@ fd5_emit_sysmem_prep(struct fd_batch *batch) assert_dt
    struct fd_ringbuffer *ring = batch->gmem;
 
    sg_emit(batch, ring, 0);
+   util_dynarray_clear(&batch->fbread_slots);   /* 0013: the slots stay views of memory */
    fd5_emit_restore(batch, ring);
 
    fd5_emit_lrz_flush(batch, ring);
@@ -1030,7 +1108,7 @@ sg_decide(struct fd5_sweet_gmem *s, struct fd_batch *b, const struct sg_key *k,
           bool *measure) assert_dt
 {
    *measure = false;
-   if (b->a5xx_sysmem_barrier)
+   if (b->a5xx_sysmem_barrier && !b->a5xx_fbread)
       return SG_BARRIER;
    if (!sg_eligible(b))
       return SG_INELIGIBLE;
@@ -1063,6 +1141,13 @@ sg_decide(struct fd5_sweet_gmem *s, struct fd_batch *b, const struct sg_key *k,
    if (commit) {
       SWEET_EVENT(SPE_GMEM_T_SYS_US, e->t[0] * 1000 / 19200);   /* microseconds */
       SWEET_EVENT(SPE_GMEM_T_GMEM_US, e->t[1] * 1000 / 19200);
+      uint64_t lo = MIN2(e->t[0], e->t[1]) * 1000 / 19200;
+      SWEET_EVENT(SPE_GMEM_T_MIN_US, lo);
+      if (b->a5xx_fbread) {
+         SWEET_EVENT(SPE_GMEM_FB_DECISIONS, 1);
+         SWEET_EVENT(SPE_GMEM_FB_T_SYS_US, e->t[0] * 1000 / 19200);
+         SWEET_EVENT(SPE_GMEM_FB_T_MIN_US, lo);
+      }
    }
    return gmem ? SG_GMEM : SG_COST;
 }
diff --git a/src/gallium/drivers/freedreno/freedreno_batch.c b/src/gallium/drivers/freedreno/freedreno_batch.c
index e2dbec0..bf2f192 100644
--- a/src/gallium/drivers/freedreno/freedreno_batch.c
+++ b/src/gallium/drivers/freedreno/freedreno_batch.c
@@ -124,6 +124,7 @@ fd_batch_create(struct fd_context *ctx, bool nondraw)
 
    batch->draw_patches = UTIL_DYNARRAY_INIT;
    batch->fb_read_patches = UTIL_DYNARRAY_INIT;
+   batch->fbread_slots = UTIL_DYNARRAY_INIT;
 
    if (is_a2xx(ctx->screen)) {
       batch->shader_patches = UTIL_DYNARRAY_INIT;
@@ -295,6 +296,7 @@ __fd_batch_destroy_locked(struct fd_batch *batch)
 
    util_dynarray_fini(&batch->draw_patches);
    util_dynarray_fini(&(batch->fb_read_patches));
+   util_dynarray_fini(&batch->fbread_slots);
 
    if (is_a2xx(batch->ctx->screen)) {
       util_dynarray_fini(&batch->shader_patches);
diff --git a/src/gallium/drivers/freedreno/freedreno_batch.h b/src/gallium/drivers/freedreno/freedreno_batch.h
index 4f99c05..4f73c5a 100644
--- a/src/gallium/drivers/freedreno/freedreno_batch.h
+++ b/src/gallium/drivers/freedreno/freedreno_batch.h
@@ -77,6 +77,13 @@ struct fd_batch_subpass {
  * ringbuffers used for binning, draw, and gmem cmds, list of associated
  * fd_resource-s, etc.
  */
+/* 0013: one indirectly loaded texture descriptor (12 dwords at map) */
+struct fd_fbread_slot {
+   struct fd_bo *bo;          /* held by the batch's submit through its relocs */
+   uint32_t offset;
+   uint32_t *map;
+};
+
 struct fd_batch {
    struct pipe_reference reference;
    unsigned seqno;
@@ -115,6 +122,7 @@ struct fd_batch {
    bool flushed : 1;
    bool tessellation : 1; /* tessellation used in batch */
    bool a5xx_sysmem_barrier : 1; /* draw IB contains a bypass-only barrier */
+   bool a5xx_fbread : 1; /* ... whose reads may be pointed at GMEM (0013) */
    /* task 24 stage 3: retained feedback barriers, draws before the first, sample slot + 1 */
    uint16_t sweet_fb_barriers, sweet_fb_pre;
    uint32_t sweet_meas;
@@ -201,6 +209,11 @@ struct fd_batch {
    /* texture state that needs patching for fb_read: */
    struct util_dynarray fb_read_patches;
 
+   /* a5xx GMEM framebuffer read (0013): struct fd_fbread_slot, descriptors
+    * the draw IB loads indirectly and the bin prologue rebases per bin
+    */
+   struct util_dynarray fbread_slots;
+
    /* Keep track of writes to RB_RENDER_CONTROL which need to be patched
     * once we know whether or not to use GMEM, and GMEM tile pitch.
     *
diff --git a/src/gallium/drivers/freedreno/freedreno_gmem.c b/src/gallium/drivers/freedreno/freedreno_gmem.c
index 9d603cc..6c3beee 100644
--- a/src/gallium/drivers/freedreno/freedreno_gmem.c
+++ b/src/gallium/drivers/freedreno/freedreno_gmem.c
@@ -81,6 +81,7 @@ struct gmem_key {
