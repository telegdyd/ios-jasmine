 src/gallium/drivers/freedreno/a5xx/fd5_gmem.c |  87 ++++++-
 .../drivers/freedreno/freedreno_batch.c       |   2 +
 .../drivers/freedreno/freedreno_batch.h       |  13 ++
 .../drivers/freedreno/freedreno_gmem.c        |  31 ++-
 src/gallium/frontends/sweetgl/sweetca.c       |  66 +++++-
 .../sweetgl/sweetgpu_fbread_test.inc          | 219 ++++++++++++++++++
 .../frontends/sweetgl/sweetgpu_gltest.c       |  30 ++-
