+
+/* ios-jasmine task 24 stage 3: per-batch GMEM selection (SWEETCA_GMEM).
+ *
+ * libsweetca forces FD_MESA_DEBUG=sysmem: every draw reads and writes its
+ * target in DRAM. With SWEETCA_GMEM=1 a batch renders through GMEM when that
+ * was measured to be faster for "the same batch" (same target, draw count,
+ * draw cost, clear/restore masks), which CoreAnimation repeats every frame.
+ * The measurement is the batch's own GPU time: RB_DONE_TS stamps (the 19.2 MHz
+ * always-on counter, written once all earlier work is done) at the start and
+ * end of its render pass, restore, binning and resolve included. Per kind of
+ * batch:
+ *
+ *  - it renders in sysmem until two sysmem times are known, then in GMEM
+ *    until two GMEM times are known (exploration), then in the faster mode;
+ *    GMEM must beat sysmem by SWEETCA_GMEM_MARGIN percent (default 110);
+ *  - the chosen mode is timed once in SWEETCA_GMEM_SAMPLE (8) uses, and the
+ *    other mode is retried once in SWEETCA_GMEM_RETRY (64) uses, so a batch
+ *    whose content changes moves back;
+ *  - a batch that cannot win is never tried: one draw without a clear (in
+ *    sysmem it moves at most W*H*cpp twice, which is GMEM's restore plus
+ *    resolve alone).
+ *
+ * (The first version estimated sysmem traffic from RB_SAMPLE_COUNT; with
+ * SAMPLES_PASSED on, large targets lost whole triangles in sysmem and GMEM
+ * alike on the phone, so counting was dropped. Timestamps are the gpuprof
+ * mechanism, which has rendered correctly in both modes.)
+ *
+ * Never GMEM: a batch with a retained feedback barrier (a self-sampling draw
+ * must read memory; a5xx has no framebuffer fetch), depth/stencil, MSAA,
+ * layers, queries, tessellation, tiled targets, or a target whose buffer
+ * cannot hold the 32x32-granular mem<->gmem blits (fd5_layout pads its own
+ * allocations to 32 rows for this; imported IOSurfaces are not padded, so their
+ * overhang must fit in the scratch VA the kernel maps after every buffer,
+ * j0033; rows must hold the width rounded to gmem_align_w).
+ *
+ * Feedback split: at the first barrier of a batch (patch 0008, level >= 1),
+ * if the batch so far would go through GMEM (chosen or being explored), the
+ * barrier ends the batch instead of being retained: the prefix renders
+ * through GMEM, the feedback draws start a sysmem batch reading the resolve.
+ * Inside retained batches the prefix's sysmem time is a third stamp at the
+ * barrier (which waits for idle anyway).
+ *
+ * SWEETCA_GMEM=2 (tests only): every eligible, safe batch through GMEM, and
+ * every eligible prefix split.
+ */
+#include <stdio.h>
+#include "util/simple_mtx.h"
+#include "util/sweet_profile.h"
+#include "util/u_debug.h"
+#include "util/u_math.h"
+
+#define SG_SLOTS   1024u               /* timestamp slots, 64 bytes each */
+#define SG_ENTRIES 4096u               /* remembered batches (power of two) */
+#define SG_PROBE   8u
+#define SG_NONE    0xdeadbeefdeadbeefull
+#define SG_PAD     (124u << 10)        /* of the 128 KiB of scratch VA the kernel maps after each buffer (j0033) */
+#define SG_SANE    (19200ull * 500)    /* longer than 500 ms: not a batch time */
+
+struct sg_key {
+   uint32_t hash, draws, cost, w, h, cleared, restore;
+};
+
+struct sg_entry {
+   struct sg_key k;
+   bool used;
+   uint32_t n[2], uses;
+   uint64_t t[2];                      /* EMA of GPU ticks: [0] sysmem, [1] GMEM */
+};
+
+struct sg_slot {
+   struct sg_key main, pre;
+   bool has_main, has_pre, gmem;
+};
+
+struct fd5_sweet_gmem {
+   simple_mtx_t lock;
+   int level;
+   unsigned margin, sample, retry;
+   struct fd_bo *bo;
+   volatile uint64_t *mem;             /* per slot: start [0], mid [2], end [4] */
+   uint32_t head, tail;
+   struct sg_slot slot[SG_SLOTS];
+   struct sg_entry e[SG_ENTRIES];
+   bool told_gmem, told_split;
+   int log;                            /* SWEETCA_GMEM_LOG: every decision to stderr */
+};
+
+enum sg_why { SG_GMEM, SG_BARRIER, SG_INELIGIBLE, SG_UNSAFE, SG_NOHIST, SG_COST, SG_ONE_DRAW };
+
+static void
+sg_key_of(struct fd_batch *b, struct sg_key *k)
+{
+   memset(k, 0, sizeof(*k));
+   k->hash = b->hash;
+   k->draws = b->num_draws;
+   k->cost = b->cost;
+   k->w = b->framebuffer.width;
+   k->h = b->framebuffer.height;
+   k->cleared = b->cleared & FD_BUFFER_ALL;
+   k->restore = b->restore & FD_BUFFER_ALL;
+}
+
+static struct sg_entry *
+sg_find(struct fd5_sweet_gmem *s, const struct sg_key *k, bool insert)
+{
+   uint32_t h = k->hash ^ (k->draws * 0x9e3779b1u) ^ (k->cost * 0x85ebca6bu) ^
+                ((k->w << 16) ^ k->h) * 0x27d4eb2fu ^ ((k->cleared << 8) | k->restore) * 0xc2b2ae35u;
+   h ^= h >> 15;
+   struct sg_entry *free_e = NULL;
+   for (unsigned i = 0; i < SG_PROBE; i++) {
+      struct sg_entry *e = &s->e[(h + i) & (SG_ENTRIES - 1)];
+      if (e->used && !memcmp(&e->k, k, sizeof(*k)))
+         return e;
+      if (!e->used && !free_e)
+         free_e = e;
+   }
+   if (!insert)
+      return NULL;
+   if (!free_e)
+      free_e = &s->e[h & (SG_ENTRIES - 1)];   /* evict */
+   memset(free_e, 0, sizeof(*free_e));
+   free_e->used = true;
+   free_e->k = *k;
+   return free_e;
+}
+
+static void
+sg_update(struct sg_entry *e, unsigned mode, uint64_t ticks)
+{
+   e->t[mode] = e->n[mode] ? (3 * e->t[mode] + ticks) / 4 : ticks;
+   e->n[mode]++;
+}
+
+/* with s->lock: account the slots the GPU has finished, oldest first */
+static void
+sg_harvest(struct fd5_sweet_gmem *s)
+{
+   while (s->tail != s->head) {
+      unsigned i = s->tail % SG_SLOTS;
+      volatile uint64_t *m = s->mem + 8 * i;
+      uint64_t end = m[4];
+      if (end == SG_NONE)
+         break;
+      uint64_t start = m[0], mid = m[2];
+      struct sg_slot *sl = &s->slot[i];
+      if (start != SG_NONE && end >= start && end - start < SG_SANE) {
+         if (sl->has_main) {
+            sg_update(sg_find(s, &sl->main, true), sl->gmem, end - start);
+            SWEET_EVENT(SPE_GMEM_MEASURED, 1);
+         }
+         if (sl->has_pre && mid != SG_NONE && mid >= start && mid <= end)
+            sg_update(sg_find(s, &sl->pre, true), 0, mid - start);
+      }
+      s->tail++;
+   }
+}
+
+/* with s->lock: a slot for this batch (stamps not yet written) */
+static void
+sg_slot_alloc(struct fd5_sweet_gmem *s, struct fd_batch *b)
+{
+   if (b->sweet_meas)
+      return;
+   if (s->head - s->tail >= SG_SLOTS)
+      s->tail++;                       /* never finished: give it up */
+   unsigned i = s->head % SG_SLOTS;
+   volatile uint64_t *m = s->mem + 8 * i;
+   m[0] = m[2] = m[4] = SG_NONE;
+   memset(&s->slot[i], 0, sizeof(s->slot[i]));
+   b->sweet_meas = ++s->head;          /* slot index + 1 (mod SG_SLOTS) */
+}
+
+static bool
+sg_eligible(struct fd_batch *b) assert_dt
+{
+   struct fd_context *ctx = b->ctx;
+   struct pipe_framebuffer_state *pfb = &b->framebuffer;
+   if (b->nondraw || b->tessellation || b->prologue || pfb->zsbuf.texture ||
+       !pfb->nr_cbufs || pfb->samples > 1 || pfb->layers > 1 ||
+       ctx->occlusion_queries_active || !list_is_empty(&ctx->acc_active_queries) ||
+       !list_is_empty(&ctx->hw_active_queries))
+      return false;
+   for (unsigned i = 0; i < pfb->nr_cbufs; i++) {
+      struct pipe_surface *ps = &pfb->cbufs[i];
+      if (!ps->texture)
+         return false;
+      if (ps->first_layer != ps->last_layer || ps->texture->nr_samples > 1 ||
+          (ps->texture->target != PIPE_TEXTURE_2D && ps->texture->target != PIPE_TEXTURE_RECT) ||
+          util_format_is_compressed(ps->format) || util_format_is_depth_or_stencil(ps->format))
+         return false;
+   }
+   return true;
+}
+
+/* mem<->gmem blits work in 32x32 blocks (see fdl5_layout_image): the rows up
+ * to the next multiple of 32 must be inside the buffer, or for an imported
+ * buffer inside the kernel's scratch pad after it. Rows must hold the width
+ * rounded up to gmem_align_w (upstream's pitch rule for GMEM resolves).
+ */
+static bool
+sg_safe(struct fd_batch *b)
+{
+   struct pipe_framebuffer_state *pfb = &b->framebuffer;
+   unsigned align_w = b->ctx->screen->info->gmem_align_w;
+   for (unsigned i = 0; i < pfb->nr_cbufs; i++) {
+      struct pipe_surface *ps = &pfb->cbufs[i];
+      struct fd_resource *rsc = fd_resource(ps->texture);
+      unsigned lvl = ps->level;
+      if (fd_resource_tile_mode(ps->texture, lvl) || rsc->layout.ubwc)
+         return false;
+      uint32_t w = u_minify(ps->texture->width0, lvl), h = u_minify(ps->texture->height0, lvl);
+      uint64_t pitch = fd_resource_pitch(rsc, lvl);
+      if (pitch < (uint64_t)align(w, align_w) * rsc->layout.cpp)
+         return false;
+      uint64_t need = fd_resource_offset(rsc, lvl, ps->first_layer) + pitch * align(h, 32);
+      uint64_t have = fd_bo_size(rsc->bo);
+      if (rsc->b.is_shared)
+         have = align64(have, 4096) + SG_PAD;
+      if (need > have)
+         return false;
+   }
+   return true;
+}
+
+/* with s->lock. *measure: stamp this batch; *mode_out: what a measurement means */
+static enum sg_why
+sg_decide(struct fd5_sweet_gmem *s, struct fd_batch *b, const struct sg_key *k, bool commit,
+          bool *measure) assert_dt
+{
+   *measure = false;
+   if (b->a5xx_sysmem_barrier)
+      return SG_BARRIER;
+   if (!sg_eligible(b))
+      return SG_INELIGIBLE;
+   if (!sg_safe(b))
+      return SG_UNSAFE;
+   if (s->level >= 2)
+      return SG_GMEM;
+   if (b->num_draws <= 1 && !(b->cleared & FD_BUFFER_COLOR))
+      return SG_ONE_DRAW;
+   struct sg_entry *e = sg_find(s, k, commit);
+   if (!e) {
+      return SG_NOHIST;                /* prediction only: nothing known */
+   }
+   uint32_t use = commit ? ++e->uses : e->uses + 1;
+   if (e->n[0] < 2) {
+      *measure = true;
+      return SG_NOHIST;
+   }
+   if (e->n[1] < 2) {
+      *measure = true;
+      return SG_GMEM;                  /* exploration */
+   }
+   bool gmem = e->t[0] * 100 > e->t[1] * s->margin;
+   if (use % s->retry == 0) {          /* retry the other mode */
+      *measure = true;
+      gmem = !gmem;
+   } else if (use % s->sample == 0) {
+      *measure = true;
+   }
+   if (commit) {
+      SWEET_EVENT(SPE_GMEM_T_SYS_US, e->t[0] * 1000 / 19200);   /* microseconds */
+      SWEET_EVENT(SPE_GMEM_T_GMEM_US, e->t[1] * 1000 / 19200);
+   }
+   return gmem ? SG_GMEM : SG_COST;
+}
+
+static void
+sg_count(enum sg_why why)
+{
+   static const enum sweet_profile_event ev[] = {
+      [SG_GMEM] = SPE_GMEM_SELECT, [SG_BARRIER] = SPE_GMEM_SYS_BARRIER,
+      [SG_INELIGIBLE] = SPE_GMEM_SYS_INELIGIBLE, [SG_UNSAFE] = SPE_GMEM_SYS_UNSAFE,
+      [SG_NOHIST] = SPE_GMEM_SYS_NOHIST, [SG_COST] = SPE_GMEM_SYS_COST,
+      [SG_ONE_DRAW] = SPE_GMEM_SYS_ONE_DRAW,
+   };
+   SWEET_EVENT(ev[why], 1);
+}
+
+/* fd_gmem_render_tiles(): true = render this batch through GMEM */
+static bool
+fd5_sweet_gmem_select(struct fd_batch *b) assert_dt
+{
+   struct fd5_sweet_gmem *s = fd5_context(b->ctx)->sweet_gmem;
+   struct sg_key k;
+   bool measure;
+   sg_key_of(b, &k);
+   simple_mtx_lock(&s->lock);
+   sg_harvest(s);
+   enum sg_why why = sg_decide(s, b, &k, true, &measure);
+   if (measure || b->sweet_meas) {
+      sg_slot_alloc(s, b);
+      struct sg_slot *sl = &s->slot[(b->sweet_meas - 1) % SG_SLOTS];
+      sl->main = k;
+      sl->has_main = measure;
+      sl->gmem = why == SG_GMEM;
+   }
+   bool tell = why == SG_GMEM && !s->told_gmem;
+   s->told_gmem |= tell;
+   simple_mtx_unlock(&s->lock);
+   sg_count(why);
+   if (s->log) {
+      static const char *const names[] = { "gmem", "sysmem:barrier", "sysmem:ineligible", "sysmem:unsafe",
+                                           "sysmem:nohist", "sysmem:cost", "sysmem:one-draw" };
+      fprintf(stderr, "sweetca: gmem decision %ux%u %u draws cleared %x restore %x: %s%s\n",
+              b->framebuffer.width, b->framebuffer.height, b->num_draws, b->cleared, b->restore, names[why],
+              measure ? " (timed)" : "");
+   }
+   if (tell)
+      fprintf(stderr, "sweetca: gmem batch selected (SWEETCA_GMEM=%d, margin %u%%) %ux%u, %u draws\n",
+              s->level, s->margin, b->framebuffer.width, b->framebuffer.height, b->num_draws);
+   return why == SG_GMEM;
+}
+
+/* fd5_texture_barrier(), before the first retained barrier of a batch:
+ * true = end the batch here (its draws so far go through GMEM)
+ */
+bool
+fd5_sweet_gmem_split(struct fd_batch *b) disable_thread_safety_analysis
+{
+   struct fd5_sweet_gmem *s = fd5_context(b->ctx)->sweet_gmem;
+   if (!s || b->a5xx_sysmem_barrier)
+      return false;
+   struct sg_key k;
+   bool measure;
+   sg_key_of(b, &k);
+   simple_mtx_lock(&s->lock);
+   sg_harvest(s);
+   bool split = sg_decide(s, b, &k, false, &measure) == SG_GMEM;
+   bool tell = split && !s->told_split;
+   s->told_split |= tell;
+   simple_mtx_unlock(&s->lock);
+   if (tell)
+      fprintf(stderr, "sweetca: gmem split at a feedback barrier %ux%u, %u draws before it\n",
+              b->framebuffer.width, b->framebuffer.height, b->num_draws);
+   return split;
+}
+
+static void
+sg_emit(struct fd_batch *b, struct fd_ringbuffer *ring, unsigned which)
+{
+   struct fd5_sweet_gmem *s = fd5_context(b->ctx)->sweet_gmem;
+   if (!s || !b->sweet_meas)
+      return;
+   unsigned i = (b->sweet_meas - 1) % SG_SLOTS;
+   OUT_PKT7(ring, CP_EVENT_WRITE, 4);
+   OUT_RING(ring, CP_EVENT_WRITE_0_EVENT(RB_DONE_TS) | CP_EVENT_WRITE_0_TIMESTAMP);
+   OUT_RELOC(ring, s->bo, (8 * i + which) * 8, 0, 0);
+   OUT_RING(ring, 0x00000000);
+}
+
+/* fd5_texture_barrier(), at the first retained barrier: time the prefix
+ * (only when the batch so far is a GMEM candidate at all)
+ */
+void
+fd5_sweet_gmem_prefix(struct fd_batch *b) disable_thread_safety_analysis
+{
+   struct fd5_sweet_gmem *s = fd5_context(b->ctx)->sweet_gmem;
+   if (!s || s->level >= 2 || !sg_eligible(b) || !sg_safe(b) ||
+       (b->num_draws <= 1 && !(b->cleared & FD_BUFFER_COLOR)))
+      return;
+   struct sg_key k;
+   sg_key_of(b, &k);
+   simple_mtx_lock(&s->lock);
+   struct sg_entry *e = sg_find(s, &k, false);
+   bool want = !e || e->n[0] < 2 || ++e->uses % s->sample == 0;
+   if (want) {
+      sg_slot_alloc(s, b);
+      struct sg_slot *sl = &s->slot[(b->sweet_meas - 1) % SG_SLOTS];
+      sl->pre = k;
+      sl->has_pre = true;
+   }
+   simple_mtx_unlock(&s->lock);
+   if (want)
+      sg_emit(b, b->draw, 2);
+}
+
+void
+fd5_sweet_gmem_destroy(struct fd5_context *fd5_ctx)
+{
+   struct fd5_sweet_gmem *s = fd5_ctx->sweet_gmem;
+   if (!s)
+      return;
+   fd_bo_del(s->bo);
+   free(s);
+   fd5_ctx->sweet_gmem = NULL;
+}
+
+static void
+fd5_sweet_gmem_init(struct fd_context *ctx) disable_thread_safety_analysis
+{
+   int level = debug_get_num_option("SWEETCA_GMEM", 0);
+   if (level <= 0 || !FD_DBG(SYSMEM))
+      return;
+   struct fd5_sweet_gmem *s = calloc(1, sizeof(*s));
+   if (!s)
+      return;
+   s->bo = fd_bo_new(ctx->screen->dev, SG_SLOTS * 64, 0, "sweet-gmem");
+   s->mem = s->bo ? fd_bo_map(s->bo) : NULL;
+   if (!s->mem) {
+      if (s->bo)
+         fd_bo_del(s->bo);
+      free(s);
+      return;
+   }
+   for (unsigned i = 0; i < SG_SLOTS * 8; i++)
+      s->mem[i] = SG_NONE;
+   simple_mtx_init(&s->lock, mtx_plain);
+   s->level = level;
+   s->margin = debug_get_num_option("SWEETCA_GMEM_MARGIN", 110);
+   s->sample = MAX2(1, debug_get_num_option("SWEETCA_GMEM_SAMPLE", 8));
+   s->retry = MAX2(2, debug_get_num_option("SWEETCA_GMEM_RETRY", 64));
+   s->log = debug_get_num_option("SWEETCA_GMEM_LOG", 0);
