+
+/*
+ * Fences. With glthread, glFenceSync and glClientWaitSync would each wait for
+ * the worker (they return values): CA gets a wrapper fence, the real one is
+ * made on the worker and polled there at frame ends (sgl_fence_*). A zero
+ * timeout is answered from the last poll once per frame (not signaled yet is
+ * a valid answer: the fence's commands may not even have reached the driver);
+ * a repeated ask in the same frame or a real timeout waits for real.
+ */
+static GLsync
+w_FenceSync(void *rctx, GLenum cond, GLbitfield flags)
+{
+   CUR(rctx);
+   if (!c->glthread || cond != GL_SYNC_GPU_COMMANDS_COMPLETE || flags) {
+      GLsync r = glFenceSync(cond, flags);
+      POST(779);
+      return r;
+   }
+   struct sca_fence *w = calloc(1, sizeof(*w));
+   if (w && !(w->f = sgl_fence_create(c->gl))) {
+      free(w);
+      w = NULL;
+   }
+   return (GLsync)w;
+}
+
+static void
+w_DeleteSync(void *rctx, GLsync s)
+{
+   CUR(rctx);
+   if (!c->glthread) {
+      glDeleteSync(s);
+      POST(781);
+      return;
+   }
+   struct sca_fence *w = (struct sca_fence *)s;
+   if (w) {
+      sgl_fence_delete(c->gl, w->f);
+      free(w);
+   }
+}
+
+static GLenum
+w_ClientWaitSync(void *rctx, GLsync s, GLbitfield flags, GLuint64 timeout)
+{
+   CUR(rctx);
+   if (!c->glthread) {
+      GLenum r = glClientWaitSync(s, flags, timeout);
+      POST(782);
+      return r;
+   }
+   struct sca_fence *w = (struct sca_fence *)s;
+   if (!w)
+      return GL_WAIT_FAILED;
+   if (sgl_fence_state(w->f) == SGL_FENCE_SIGNALED)
+      return GL_ALREADY_SIGNALED;
+   if (timeout == 0 && !(w->stale && w->stale_frame == c->frame)) {
+      w->stale = true;
+      w->stale_frame = c->frame;
+      glthread_stale_fences++;
+      /* a fresher answer for the next ask: poll on the worker soon */
+      sgl_fence_poll(c->gl);
+      sgl_glthread_flush(c->gl);
+      return GL_TIMEOUT_EXPIRED;
+   }
+   glthread_fence_waits++;
+   return sgl_fence_wait(c->gl, w->f, flags, timeout);
+}
+
+/* glthread: the sampler units of the current program after glUniform1i(v) */
+static void
+samplers_set(struct sca_ctx *c, GLint loc, GLsizei n, const GLint *v)
+{
+   if (!c->glthread || loc < 0 || !c->program || c->program >= OBJMAX)
+      return;
+   struct sca_obj *p = &c->obj[c->program];
+   for (GLsizei k = 0; k < n; k++) {
+      for (unsigned i = 0; i < p->nsamp; i++) {
+         if (p->samp_loc[i] == loc + k && v[k] >= 0 && v[k] < UNITS)
+            p->samp_unit[i] = (uint8_t)v[k];
+      }
+   }
+}
+
+static void
+w_Uniform1i(void *rctx, GLint l, GLint a)
+{
+   CUR(rctx);
+   glUniform1i(l, a);
+   samplers_set(c, l, 1, &a);
+   POST(606);
+}
+
+static void
+w_Uniform1iv(void *rctx, GLint l, GLsizei n, const GLint *v)
+{
+   CUR(rctx);
+   glUniform1iv(l, n, v);
+   if (v && n > 0)
+      samplers_set(c, l, n, v);
+   POST(614);
+}
 
