+/*
+ * glthread (sgl_context_enable_glthread): GL calls made on the application
+ * thread are recorded and executed by Mesa's worker thread; st/mesa and the
+ * threaded context's queue then belong to the worker. Everything here that
+ * uses them directly either runs in command order on the worker (sgl_run) or
+ * waits for the worker first (sgl_glthread_finish). Without glthread both run
+ * at once, as before.
+ */
+void GLAPIENTRY _mesa_marshal_InternalSweetCallbackMESA(GLintptr fn, GLintptr data);
+
+static bool
+sgl_is_current(struct sgl_context *ctx)
+{
+   return st_api_get_current() == ctx->st;
+}
+
+void
+sgl_glthread_finish(struct sgl_context *ctx)
+{
+   /* An idle worker is all that is needed when ctx is not current here: it
+    * was finished when it stopped being current (sgl_make_current). */
+   if (ctx->glthread && sgl_is_current(ctx))
+      _mesa_glthread_finish(ctx->st->ctx);
+}
+
+static void
+sgl_run(struct sgl_context *ctx, void (*fn)(void *), void *data)
+{
+   if (ctx->glthread && sgl_is_current(ctx)) {
+      _mesa_marshal_InternalSweetCallbackMESA((GLintptr)fn, (GLintptr)data);
+      return;
+   }
+   fn(data);
+}
