jasmine: adapt Chlorophyll ir3-ssbo-subdword for a512 / Mesa 26.2.5.
MIT; based on mesa/metal/patches/ir3-ssbo-subdword.patch.
Unlike a6xx descriptor scaling, a5xx needs this because its SSBO emitters
unconditionally use TYPE_U32 for both LDGB and STGB. Keep shared dwords safe
with the generic NIR atomic lowering, including adjacent parallel writers.

--- a/src/freedreno/ir3/ir3_nir.c
+++ b/src/freedreno/ir3/ir3_nir.c
@@ -1185,6 +1185,8 @@
                  uint32_t align_offset, bool offset_is_const,
                  enum gl_access_qualifier access, const void *cb_data)
 {
+   const struct ir3_compiler *compiler = cb_data;
+
    align = nir_combined_align(align, align_offset);
    assert(util_is_power_of_two_nonzero(align));
 
@@ -1201,6 +1203,20 @@
 
    if (intrin == nir_intrinsic_load_ubo)
       bit_size = 32;
+
+   /* jasmine: a4xx/a5xx LDGB/STGB always use TYPE_U32 (ir3_a4xx.c).
+    * Gallium on newer GPUs also has only a dword SSBO descriptor unless
+    * the storage options say otherwise. Lower narrow accesses to dwords;
+    * the generic pass extracts loads and uses atomics for partial stores.
+    */
+   if ((intrin == nir_intrinsic_load_ssbo || intrin == nir_intrinsic_store_ssbo) &&
+       ((compiler && compiler->gen <= 5) ||
+        (bit_size == 16 && (!compiler || !compiler->options.storage_16bit)) ||
+        (bit_size == 8 && (!compiler || !compiler->options.storage_8bit)))) {
+      bit_size = 32;
+      if (align < 4)
+         bytes = MIN2(bytes, 4);
+   }
 
    return (nir_mem_access_size_align){
       .num_components = MAX2(1, MIN2(bytes / (bit_size / 8), 4)),
@@ -1562,6 +1578,8 @@
                nir_var_mem_global | nir_var_mem_shared |
                nir_var_function_temp | nir_var_mem_ssbo | nir_var_mem_global,
       .callback = ir3_mem_access_size_align,
+      .cb_data = (void *)so->compiler,
+      .may_lower_unaligned_stores_to_atomics = true,
    };
 
    progress |= OPT(s, nir_lower_mem_access_bit_sizes, &mem_bit_size_options);
