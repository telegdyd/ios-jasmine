jasmine: a5xx compute border colours (TPL1_CS_BORDER_COLOR_BASE_ADDR at 0xe762, compute samplers' entries)

diff --git a/src/gallium/drivers/freedreno/a5xx/fd5_emit.c b/src/gallium/drivers/freedreno/a5xx/fd5_emit.c
--- a/src/gallium/drivers/freedreno/a5xx/fd5_emit.c
+++ b/src/gallium/drivers/freedreno/a5xx/fd5_emit.c
@@ -312,6 +312,40 @@ emit_border_color(struct fd_context *ctx, struct fd_ringbuffer *ring) assert_dt
    u_upload_unmap(fd5_ctx->border_color_uploader);
 }
 
+/* jasmine: the compute stage's border colours. A clamp-to-border sampler in a kernel (Metal
+ * Performance Shaders' blurs with MPSImageEdgeModeZero) made the TP fetch its border colour from a
+ * fixed bare address (SMMU fault at 41a680, the same on every boot) and wedge the GPU: compute reads
+ * its own base, at 0xe762 -- after TPL1_CS_TEX_CONST, as a6xx has TPL1_CS_BORDER_COLOR_BASE next to
+ * the graphics one -- which nothing programmed. The entries are the compute samplers' own (their
+ * BCOLOR_OFFSET starts at 0), not the vertex and fragment ones emit_border_color lays out.
+ */
+#define REG_A5XX_TPL1_CS_BORDER_COLOR_BASE_ADDR 0xe762
+
+static void
+emit_cs_border_color(struct fd_context *ctx, struct fd_ringbuffer *ring) assert_dt
+{
+   struct fd5_context *fd5_ctx = fd5_context(ctx);
+   struct bcolor_entry *entries;
+   unsigned off;
+   void *ptr;
+
+   const unsigned int alignment =
+      util_next_power_of_two(FD5_BORDER_COLOR_UPLOAD_SIZE);
+   u_upload_alloc_ref(fd5_ctx->border_color_uploader, 0,
+                  FD5_BORDER_COLOR_UPLOAD_SIZE, alignment,
+                  &off, &fd5_ctx->border_color_buf, &ptr);
+
+   entries = ptr;
+   setup_border_colors(&ctx->tex[MESA_SHADER_COMPUTE], &entries[0]);
+
+   OUT_PKT4(ring, REG_A5XX_TPL1_TP_BORDER_COLOR_BASE_ADDR, 2);
+   OUT_RELOC(ring, fd_resource(fd5_ctx->border_color_buf)->bo, off, 0, 0);
+   OUT_PKT4(ring, REG_A5XX_TPL1_CS_BORDER_COLOR_BASE_ADDR, 2);
+   OUT_RELOC(ring, fd_resource(fd5_ctx->border_color_buf)->bo, off, 0, 0);
+
+   u_upload_unmap(fd5_ctx->border_color_uploader);
+}
+
 /* 0013 (SWEETCA_GMEM_FBREAD): the views of the batch's own target are loaded
  * a second time, indirectly, from a descriptor in memory (a slot). Sysmem
  * batches leave it as written here (the same as the direct one); GMEM batches
@@ -929,7 +963,7 @@ fd5_emit_cs_state(struct fd_context *ctx, struct fd_ringbuffer *ring,
          emit_textures(ctx, ring, SB4_CS_TEX, &ctx->tex[MESA_SHADER_COMPUTE]);
 
       if (needs_border)
-         emit_border_color(ctx, ring);
+         emit_cs_border_color(ctx, ring);
 
       OUT_PKT4(ring, REG_A5XX_TPL1_VS_TEX_COUNT, 1);
       OUT_RING(ring, 0);
