Subject: [PATCH] jasmine: USB controller, PHY and clocks off while unplugged

diff --git a/bsd/dev/sweet_usb.c b/bsd/dev/sweet_usb.c
--- a/bsd/dev/sweet_usb.c
+++ b/bsd/dev/sweet_usb.c
@@ -185,6 +185,9 @@ usb_wr(vm_offset_t base, uint32_t off, uint32_t v)
 	__asm__ volatile ("dsb sy" ::: "memory");
 }
 
+static vm_offset_t usb_gcc_va, usb_phy_va, usb_phyqs_va;      /* j0156: kept for the plug-in path */
+static void usb_phy_init(vm_offset_t gcc, vm_offset_t phy, vm_offset_t qs, vm_offset_t dwc);
+
 static void
 usb_phy_bringup(vm_offset_t gcc, vm_offset_t dwc)
 {
@@ -195,6 +198,9 @@ usb_phy_bringup(vm_offset_t gcc, vm_offset_t dwc)
 	if (phy == 0 || qs == 0) {
 		return;
 	}
+	usb_gcc_va = gcc;
+	usb_phy_va = phy;
+	usb_phyqs_va = qs;
 	uint32_t status = usb_rd(phy, QUSB2_PLL_STATUS);
 	printf("SWEET USB: QUSB2 PLL_STATUS 0x%02x PLL_TEST 0x%02x POWERDOWN 0x%02x, QSCRATCH GENERAL_CFG 0x%08x\n",
 	    status, usb_rd(phy, QUSB2_PLL_TEST), usb_rd(phy, QUSB2_PORT_POWERDOWN), usb_rd(qs, QSCRATCH_GENERAL_CFG));
@@ -205,6 +211,18 @@ usb_phy_bringup(vm_offset_t gcc, vm_offset_t dwc)
 		return;         /* ABL's fastboot left the PHY running */
 	}
 	printf("SWEET USB: QUSB2 PHY init (%s)\n", force == 1 ? "forced" : "PLL not locked: normal boot");
+	usb_phy_init(gcc, phy, qs, dwc);
+}
+
+/*
+ * QUSB2 PHY init as Linux phy-qcom-qusb2.c qusb2_phy_init (sdm660 table): block reset, table,
+ * power up, PLL lock; then the UTMI pipe clock. Boot, and (j0156) every plug-in after the
+ * unplugged power-down, as Linux re-inits the PHY when the controller leaves low power.
+ */
+static void
+usb_phy_init(vm_offset_t gcc, vm_offset_t phy, vm_offset_t qs, vm_offset_t dwc)
+{
+	uint32_t status;
 	if (usb_phy_bcr != 0) {
 		usb_wr(gcc, usb_phy_bcr, usb_rd(gcc, usb_phy_bcr) | 1);
 		delay(120);
@@ -431,6 +449,8 @@ static struct {
 	uint32_t    tx_seq;
 	uint32_t    dev_events[16];     /* j0116: device events by type */
 	uint32_t    dev_logged;
+	volatile bool lp;           /* j0156: unplugged: controller halted, PHY down, clocks off */
+	uint32_t    lp_count;
 } ud;
 
 static inline void
@@ -1296,10 +1316,151 @@ extern void sweet_poll_thread_to_e(bool *on_e);     /* osfmk/kern/sched_prim.c,
 extern int sweet_poll_e;
 extern int sweet_console_muted;                     /* osfmk/console/serial_console.c */
 
+static bool ud_hw_start(bool boot);
+
+/*
+ * VBUS session of the controller (j0113). With the override set the controller pulls D+ up
+ * whenever it runs, and that spoils the PM660's BC1.2 detection (APSD) at plug-in: a wall
+ * charger or a CDP port reads as SDP (500 mA). Like Linux dwc3-qcom, which sets it when the
+ * charger reports a USB host (dwc3_qcom_vbus_override_enable), sweet_pmic.c turns it on for
+ * SDP/CDP and off on unplug and for an APSD re-run. On until the charger says otherwise.
+ */
+static LCK_GRP_DECLARE(usb_vbus_grp, "sweet_usb_vbus");
+static LCK_MTX_DECLARE(usb_vbus_lock, &usb_vbus_grp);
+static vm_offset_t usb_vbus_qs;
+static int usb_vbus_want = -1;
+
+static void
+usb_vbus_apply_locked(void)
+{
+	if (usb_vbus_qs == 0) {
+		return;
+	}
+	uint32_t hs = usb_rd(usb_vbus_qs, QSCRATCH_HS_PHY_CTRL), ss = usb_rd(usb_vbus_qs, QSCRATCH_SS_PHY_CTRL);
+	if (usb_vbus_want != 0) {
+		hs |= UTMI_OTG_VBUS_VALID | SW_SESSVLD_SEL;
+		ss |= LANE0_PWR_PRESENT;
+	} else {
+		hs &= ~(UTMI_OTG_VBUS_VALID | SW_SESSVLD_SEL);
+		ss &= ~LANE0_PWR_PRESENT;
+	}
+	*(volatile uint32_t *)(usb_vbus_qs + QSCRATCH_HS_PHY_CTRL) = hs;
+	*(volatile uint32_t *)(usb_vbus_qs + QSCRATCH_SS_PHY_CTRL) = ss;
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+void
+sweet_usb_vbus(bool on)
+{
+	lck_mtx_lock(&usb_vbus_lock);
+	if (usb_vbus_want != (int)on) {
+		usb_vbus_want = on;
+		if (!ud.lp) {
+			usb_vbus_apply_locked();
+		}
+		printf("SWEET USB: VBUS session %s (charger)\n", on ? "on" : "off");
+		thread_wakeup((event_t)&usb_vbus_want);         /* j0156: ud_thread powers up */
+	}
+	lck_mtx_unlock(&usb_vbus_lock);
+}
+
 unsigned sweet_usb_idle_ms = 5;                 /* j0136 */
 extern unsigned sweet_modem_idle_ms;            /* iokit/Kernel/arm/TopazModem.cpp (j0136) */
 extern unsigned sweet_wscan_dwell_p, sweet_wscan_min_rest, sweet_wscan_max_rest;     /* (j0138) */
 
+/*
+ * j0156: unplugged = no USB power at all, as Linux dwc3-msm low power mode with no cable
+ * (dwc3_msm_suspend, qusb_phy_set_suspend disconnect case): once the charger has ended the
+ * VBUS session for 500 ms the controller is stopped (Run/Stop off, halted), the QUSB2 PHY
+ * powered down and the controller and PHY clocks gated (mock UTMI, master, aggre2 and
+ * config-NoC AXI, the PHY's CXO reference clkref), and ud_thread sleeps until the charger
+ * reports a USB host again (instead of polling the event count every 5 ms). The GDSC, the
+ * sleep clock, the PHY's AHB clock and its RPM supplies stay on (APSD shares D+/D-), so all
+ * registers keep their contents; on plug-in the clocks come back, the PHY is initialised and
+ * the controller started as at boot (ud_hw_start), and the host enumerates the phone again.
+ * Boot-arg sweetusb_lp=0: always powered as before.
+ */
+static const uint8_t usb_lp_clk[] = { 2, 0, 4, 3, 6 };     /* usb_cbcr: utmi, master, aggre, cfg-noc, clkref */
+static uint32_t usb_lp_on = 1;
+static vm_offset_t usb_lp_dwc;
+
+static void
+usb_lp_clocks(bool on)
+{
+	const unsigned n = sizeof(usb_lp_clk);
+	for (unsigned k = 0; k < n; k++) {
+		uint32_t off = usb_cbcr[usb_lp_clk[on ? n - 1 - k : k]].off;
+		uint32_t v = usb_rd(usb_gcc_va, off);
+		usb_wr(usb_gcc_va, off, on ? (v | 1) : (v & ~1u));
+		for (int t = 0; on && t < 200 && (usb_rd(usb_gcc_va, off) & CBCR_CLK_OFF); t++) {
+			delay(1);
+		}
+	}
+}
+
+static void
+ud_lp_enter(void)
+{
+	uint64_t t0 = mach_absolute_time(), ns;
+	ud_function_reset();
+	dwc_wr(DCTL, dwc_rd(DCTL) & ~DCTL_RUN_STOP);
+	int i;
+	for (i = 0; i < 500 && !(dwc_rd(DSTS) & DSTS_DEVCTRLHLT); i++) {
+		uint32_t c = dwc_rd(GEVNTCOUNT) & 0xffff;     /* it only halts with no events pending */
+		if (c != 0) {
+			dwc_wr(GEVNTCOUNT, c);
+		}
+		delay(1000);
+	}
+	uint32_t dsts = dwc_rd(DSTS);
+	if (!(dsts & DSTS_DEVCTRLHLT)) {
+		dwc_wr(DCTL, dwc_rd(DCTL) | DCTL_RUN_STOP);
+		usb_lp_on = 0;
+		printf("SWEET USB: unplugged: controller NOT HALTED (DSTS %#x): stays powered from now on\n", dsts);
+		return;
+	}
+	lck_mtx_lock(&usb_vbus_lock);
+	usb_wr(usb_phy_va, QUSB2_PORT_POWERDOWN, usb_rd(usb_phy_va, QUSB2_PORT_POWERDOWN) | QUSB2_POWER_DOWN);
+	ud.lp = true;
+	usb_lp_clocks(false);
+	lck_mtx_unlock(&usb_vbus_lock);
+	ud.lp_count++;
+	absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+	printf("SWEET USB: unplugged: controller halted (DSTS %#x), PHY powered down, clocks off (master %#x clkref %#x) "
+	    "in %llu us (%u)\n", dsts,
+	    usb_rd(usb_gcc_va, usb_cbcr[0].off), usb_rd(usb_gcc_va, usb_cbcr[6].off), ns / 1000, ud.lp_count);
+}
+
+static void
+ud_lp_exit(void)
+{
+	uint64_t t0 = mach_absolute_time(), ns;
+	lck_mtx_lock(&usb_vbus_lock);
+	usb_lp_clocks(true);
+	usb_phy_init(usb_gcc_va, usb_phy_va, usb_phyqs_va, usb_lp_dwc);
+	ud.lp = false;
+	lck_mtx_unlock(&usb_vbus_lock);
+	bool ok = ud_hw_start(false);
+	absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+	printf("SWEET USB: USB host again: clocks on (master %#x clkref %#x), PHY PLL %s, controller %s in %llu us\n",
+	    usb_rd(usb_gcc_va, usb_cbcr[0].off), usb_rd(usb_gcc_va, usb_cbcr[6].off),
+	    (usb_rd(usb_phy_va, QUSB2_PLL_STATUS) & QUSB2_PLL_LOCKED) ? "locked" : "NOT LOCKED",
+	    ok ? "running" : "NOT RUNNING", ns / 1000);
+}
+
+static void
+ud_lp_wait(void)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(10, NSEC_PER_SEC, &deadline);   /* fallback only */
+	(void)assert_wait_deadline((event_t)&usb_vbus_want, THREAD_UNINT, deadline);
+	if (usb_vbus_want == 0) {
+		thread_block(THREAD_CONTINUE_NULL);
+	} else {
+		clear_wait(current_thread(), THREAD_AWAKENED);
+	}
+}
+
 static void
 ud_thread(void *arg __unused, wait_result_t wr __unused)
 {
@@ -1311,10 +1472,41 @@ ud_thread(void *arg __unused, wait_result_t wr __unused)
 #define idle_ms sweet_usb_idle_ms
 	uint32_t checks = 0;
 	uint64_t now_ms = 0, last_event_ms = 0, next_check_ms = 30000, t0 = mach_absolute_time();
-	bool on_e = false;
+	bool on_e = false, vbus_off = false;
+	uint64_t vbus_off_ms = 0;
 	(void)PE_parse_boot_argn("sweetusb_idle_ms", &sweet_usb_idle_ms, sizeof(sweet_usb_idle_ms));
+	(void)PE_parse_boot_argn("sweetusb_lp", &usb_lp_on, sizeof(usb_lp_on));
+	if (usb_gcc_va == 0 || usb_phy_va == 0 || usb_phyqs_va == 0 || usb_vbus_qs == 0) {
+		usb_lp_on = 0;
+	}
+	printf("SWEET USB: unplugged power-down %s\n", usb_lp_on ? "on" : "off (sweetusb_lp=0 or PHY not mapped)");
 	for (;;) {
 		sweet_poll_thread_to_e(&on_e);
+		uint64_t ns;
+		if (ud.lp) {
+			if (usb_vbus_want == 0) {
+				ud_lp_wait();
+			} else {
+				ud_lp_exit();
+				vbus_off = false;
+			}
+			absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+			now_ms = ns / NSEC_PER_MSEC;
+			last_event_ms = now_ms;
+			next_check_ms = now_ms + 30000;
+			continue;
+		}
+		if (usb_lp_on && usb_vbus_want == 0) {
+			if (!vbus_off) {
+				vbus_off = true;
+				vbus_off_ms = now_ms;
+			} else if (now_ms - vbus_off_ms >= 500) {
+				ud_lp_enter();
+				continue;
+			}
+		} else {
+			vbus_off = false;
+		}
 		uint32_t count = dwc_rd(GEVNTCOUNT) & 0xffff;
 		if (count) {
 			last_event_ms = now_ms;
@@ -1349,7 +1541,6 @@ ud_thread(void *arg __unused, wait_result_t wr __unused)
 		}
 		bool busy = ud.tx_busy || ud.txq_count > 0 || ud_net_check_now || now_ms - last_event_ms < 100;
 		ud_sleep_ms(busy || idle_ms <= 1 ? 1 : idle_ms);
-		uint64_t ns;
 		absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
 		now_ms = ns / NSEC_PER_MSEC;
 	}
@@ -1789,7 +1980,7 @@ sweet_usb_panic(const char *pbuf, uint32_t plen)
 {
 	static bool once;
 	static char seg[1400];
-	if (once || ud.dwc == 0 || !ud.configured || ud_log_cs == NULL || !ud_peer_mac_valid) {
+	if (once || ud.dwc == 0 || ud.lp || !ud.configured || ud_log_cs == NULL || !ud_peer_mac_valid) {
 		return;
 	}
 	once = true;
@@ -2087,48 +2278,8 @@ ud_cmd_thread(void *arg __unused, wait_result_t wr __unused)
 	}
 }
 
