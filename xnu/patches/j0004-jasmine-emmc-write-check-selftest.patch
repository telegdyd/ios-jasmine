From abec6c9c470927bce0ba8694a5b83bbd7ecb17c3 Mon Sep 17 00:00:00 2001
From: telegdyd <telegdyd93@gmail.com>
Date: Tue, 20 Oct 2026 22:24:48 +0200
Subject: [PATCH] jasmine-0139: no FLUSH_CACHE without an eMMC cache; write
 self-test

jasmine's eMMC reports CACHE_CTRL 0. HFS's DKIOCSYNCHRONIZE sent CMD6
FLUSH_CACHE anyway, the card set SWITCH_ERROR, and the next command (the
journal header CMD24) failed the R1 check with status 0x980, so the journal
went invalid and every file write returned EINVAL. Flush now only with
CACHE_SIZE > 0 and CACHE_CTRL on, like Linux. The R1 check logs the status
twice with the interrupt state. With ufsrw=1 the attach writes a pattern to
the log header block (1 then 8 blocks), reads it back and keeps the disk
read-only if anything differs.
---
 bsd/dev/sweet_ufs.c | 70 ++++++++++++++++++++++++++++++++++++++++-----
 1 file changed, 63 insertions(+), 7 deletions(-)

diff --git a/bsd/dev/sweet_ufs.c b/bsd/dev/sweet_ufs.c
index f452a21..f3bef45 100644
--- a/bsd/dev/sweet_ufs.c
+++ b/bsd/dev/sweet_ufs.c
@@ -660,10 +660,22 @@ emmc_cmd(unsigned idx, uint32_t arg, uint16_t flags, uint16_t mode)
 	emmc_wr16(SD_XFERMODE, mode);
 	emmc_wr16(SD_CMD, (uint16_t)(idx << 8 | flags));
 	int error = emmc_wait(NIS_CMD_DONE, "command", idx);
-	if (!error && (emmc_rd32(SD_RESP0) & R1_ERRORS)) {
-		printf("SWEET EMMC: CMD%u arg %#x: card status %#x\n", idx, arg, emmc_rd32(SD_RESP0));
-		emmc_recover();
-		error = EIO;
+	uint32_t r1 = error ? 0 : emmc_rd32(SD_RESP0);
+	if (r1 & R1_ERRORS) {
+		/*
+		 * Log the status twice (with the interrupt state) for diagnosis
+		 * and fail only if the error bits are still there. 2026-10-20:
+		 * CMD24 saw 0x980 both times: SWITCH_ERROR left by a FLUSH_CACHE
+		 * CMD6 on a card without an enabled cache (see emmc_flush).
+		 */
+		delay(10);
+		uint32_t again = emmc_rd32(SD_RESP0);
+		printf("SWEET EMMC: CMD%u arg %#x: card status %#x, reread %#x (nis %#x eis %#x)\n",
+		    idx, arg, r1, again, emmc_rd16(SD_NIS), emmc_rd16(SD_EIS));
+		if (again & R1_ERRORS) {
+			emmc_recover();
+			error = EIO;
+		}
 	}
 	return error;
 }
@@ -735,10 +747,19 @@ emmc_rw(uint64_t lba, uint32_t count, bool write)
 	return emmc_data(idx, (uint32_t)lba, count, write);
 }
 
-/* The one CMD6: EXT_CSD[32] FLUSH_CACHE = 1 (R1b, waits for the card). */
+static bool emmc_cache_on;              /* EXT_CSD CACHE_SIZE > 0 and CACHE_CTRL bit 0 */
+
+/*
+ * The one CMD6: EXT_CSD[32] FLUSH_CACHE = 1 (R1b, waits for the card), only
+ * when the cache is on. Without a cache the card rejects it and reports
+ * SWITCH_ERROR in the next command's status (seen as 0x980 on CMD24).
+ */
 static int
 emmc_flush(void)
 {
+	if (!emmc_cache_on) {
+		return 0;
+	}
 	int error = emmc_cmd(6, 0x03200101, CMD_R1B, 0);
 	if (!error) {
 		error = emmc_wait(NIS_XFER_DONE, "flush", 6);
@@ -776,8 +797,10 @@ emmc_take_over_host(void)
 		return error;
 	}
 	uint32_t sectors = (uint32_t)ext[212] | (uint32_t)ext[213] << 8 | (uint32_t)ext[214] << 16 | (uint32_t)ext[215] << 24;
-	printf("SWEET EMMC: EXT_CSD rev %u, %u MiB, part_config %#x, cmdq %u, cache %u, hs_timing %#x, bus %#x\n",
-	    ext[192], sectors >> 11, ext[179], ext[15], ext[33], ext[185], ext[183]);
+	uint32_t cache_kib = (uint32_t)ext[249] | (uint32_t)ext[250] << 8 | (uint32_t)ext[251] << 16 | (uint32_t)ext[252] << 24;
+	emmc_cache_on = cache_kib != 0 && (ext[33] & 1);
+	printf("SWEET EMMC: EXT_CSD rev %u, %u MiB, part_config %#x, cmdq %u, cache %u (%u KiB), hs_timing %#x, bus %#x\n",
+	    ext[192], sectors >> 11, ext[179], ext[15], ext[33], cache_kib, ext[185], ext[183]);
 	if ((ext[179] & 7) != 0 || ext[15] != 0) {
 		printf("SWEET EMMC: not on the user area with command queuing off, not touching it\n");
 		return ENXIO;
@@ -1097,6 +1120,39 @@ sweet_ufs_init(void)
 	devfs_make_node(makedev(su.cmajor, 0), DEVFS_CHAR, UID_ROOT, GID_OPERATOR, 0640, "rufsroot0");
 	/* Only now, with the partition bounds known, can writes be allowed. */
 	su.writable = (rw != 0);
+	if (su.emmc && su.writable) {
+		/*
+		 * eMMC write self-test before any filesystem write: a pattern into the
+		 * persistent log area at the end of the partition (single block, then
+		 * 8 blocks), read back and compared. The log header block is rewritten
+		 * by sweet_log_thread anyway.
+		 */
+		uint8_t *b = (uint8_t *)(su.dma + DMA_BOUNCE);
+		uint64_t t = su.first_block + su.nblocks - (1 + (4u << 20) / UFS_BLOCK);
+		int werr = 0, rerr = 0, bad = -1;
+		lck_mtx_lock(&sweet_ufs_lock);
+		for (uint32_t n = 1; n <= 8 && bad < 0 && !werr && !rerr; n += 7) {
+			for (uint32_t i = 0; i < n * 512; i++) {
+				b[i] = (uint8_t)(i * 7 + n);
+			}
+			werr = ufs_write_blocks(t, n);
+			bzero(b, n * 512);
+			rerr = werr ? 0 : ufs_read_blocks(t, n);
+			for (uint32_t i = 0; !werr && !rerr && i < n * 512; i++) {
+				if (b[i] != (uint8_t)(i * 7 + n)) {
+					bad = (int)i;
+					break;
+				}
+			}
+			printf("SWEET EMMC: write test %u block(s) at 0x%llx: write %d read %d %s\n",
+			    n, t, werr, rerr, (werr || rerr) ? "-" : bad < 0 ? "data OK" : "DATA MISMATCH");
+		}
+		lck_mtx_unlock(&sweet_ufs_lock);
+		if (werr || rerr || bad >= 0) {
+			printf("SWEET EMMC: write test failed, disk stays read-only\n");
+			su.writable = false;
+		}
+	}
 	su.ready = true;
 	printf("SWEET UFS: \"%s\" on LUN %u: first block 0x%llx, %llu MiB, %s, DMA at 0x%llx\n",
 	    want, su.lun, su.first_block, su.nblocks * UFS_BLOCK >> 20,
-- 
