+/*
+ * j0152: move an enabled SPI to another core (the QTimer broadcast follows the earliest
+ * sleeper), as Linux gic_set_affinity: disable, wait for RWP, IROUTER, enable.
+ */
+void sweet_gic_spi_retarget(uint32_t intid, uint64_t mpidr);
+void
+sweet_gic_spi_retarget(uint32_t intid, uint64_t mpidr)
+{
+	if (gicd_base == 0 || intid < 32 || intid >= 1020) {
+		return;
+	}
