+
+/*
+ * j0152: CPU idle on by default. `sweetidle=N` boot-arg (default 3: ret, core pc, L2 pc;
+ * 0 keeps WFI only). Set 30 s after the platform expert starts, once every CPU is up,
+ * from a kernel thread (the broadcast self-test sleeps and takes the interrupt).
+ */
+static uint32_t sweet_cpuidle_boot_mode = 3;
+
+static void
+sweet_cpuidle_boot_thread(void *arg, wait_result_t wr)
+{
+	(void)arg; (void)wr;
+	static char reply[2048];
+	char cmd[4] = { (char)('0' + sweet_cpuidle_boot_mode), 0 };
+	unsigned up = 0;
+	delay_for_interval(30, NSEC_PER_SEC);
+	for (int tries = 0; tries < 30; tries++) {
+		up = 0;
+		for (unsigned i = 0; i < MAX_CPUS; i++) {
+			if (CpuDataEntries[i].cpu_data_vaddr != NULL) {
+				up++;
+			}
+		}
+		if (up >= real_ncpus) {
+			break;
+		}
+		delay_for_interval(1, NSEC_PER_SEC);
+	}
+	sweet_cpuidle_command(cmd, reply, sizeof(reply));
+	printf("SWEET CPUIDLE: boot mode %u (%u of %u CPUs): %s", sweet_cpuidle_boot_mode, up, real_ncpus, reply);
+}
+
+void sweet_cpuidle_boot(void);
+void
+sweet_cpuidle_boot(void)
+{
+	(void)PE_parse_boot_argn("sweetidle", &sweet_cpuidle_boot_mode, sizeof(sweet_cpuidle_boot_mode));
+	if (sweet_cpuidle_boot_mode == 0 || sweet_cpuidle_boot_mode > 3) {
+		printf("SWEET CPUIDLE: sweetidle=%u, WFI only\n", sweet_cpuidle_boot_mode);
+		return;
+	}
+	thread_t thread;
+	if (kernel_thread_start(sweet_cpuidle_boot_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
 #endif
 
 
