+
+/* a Gold OSM word through TZ (sequencer space); counts refusals */
+static uint32_t osm_tz_refused;
+
+static void
+osm_tzw(uint32_t off, uint32_t v)
+{
+	if (osm_scm2(SCM_FAST_FN(SCM_SVC_IO, SCM_IO_WRITE), OSM_GOLD + off, v) != 0) {
+		osm_tz_refused++;
+	}
+}
+
+/*
+ * clk_osm_do_additional_setup() + clk_osm_program_mem_acc_regs() and
+ * clk_osm_apm_vc_setup() of the no-TZ (secure_init) path, Gold cluster, all
+ * sequencer words through TZ IO writes. MEM-ACC: the SDM660 values are not
+ * published (stock leaves them to TZ), so each level gets the register's
+ * current value (msm8998's MEM-ACC config registers, APCS 0x179d1368/6c/70):
+ * the sequencer's MEM-ACC writes then change nothing.
+ */
+static void
+osm_seq_load(volatile uint32_t *o)
+{
+	static const uint32_t acc_cfg[3] = { 0x179d1368, 0x179d136c, 0x179d1370 };
+	volatile uint32_t *apcs = osm_map(APCS_COMMON, 0x1000);
+	uint32_t acc_now[3];
+	for (int k = 0; k < 3; k++) {
+		printf("SWEET OSM: reading MEM-ACC %#x\n", acc_cfg[k]);
+		delay(50000);
+		acc_now[k] = osm_rd(apcs, acc_cfg[k] - APCS_COMMON);
+	}
+	printf("SWEET OSM: MEM-ACC now %#x %#x %#x\n", acc_now[0], acc_now[1], acc_now[2]);
+
+	osm_wr(o, 0x1028, 0xfu << 16);                  /* SPM_CC_CTRL */
+	osm_tzw(OSM_SEQ(0), 0x17816004);                /* PLL L_VAL address */
+	osm_tzw(OSM_SEQ(21), 43);                       /* PLL_MIN_LVAL */
+	osm_tzw(OSM_SEQ(18), 0x1781600c);               /* PLL USER_CTL address */
+	osm_tzw(OSM_SEQ(19), 0x11f);                    /* PLL_POST_DIV2 */
+	osm_tzw(OSM_SEQ(29), 0x1f);                     /* PLL_POST_DIV1 */
+	osm_tzw(OSM_SEQ(2), 0x179d0010);                /* APM mode ctl */
+	osm_tzw(OSM_SEQ(3), 0x179d0018);                /* APM status */
+	osm_tzw(OSM_SEQ(77), 0);                        /* APM_MX_MODE */
+	osm_tzw(OSM_SEQ(78), 0);                        /* APM_MX_MODE_VAL */
+	osm_tzw(OSM_SEQ(79), 7u << 2 | 3u);             /* APM_MODE_SWITCH_MASK */
+	osm_tzw(OSM_SEQ(80), 1u << 1);                  /* APM_APC_MODE */
+	osm_tzw(OSM_SEQ(81), 3);                        /* APM_APC_MODE_VAL */
+	osm_tzw(OSM_SEQ(16), 0x17811054);               /* GFMUX: RCG CFG */
+	osm_tzw(OSM_SEQ(33), 0x17811050);               /* RCG CMD */
+	osm_tzw(OSM_SEQ(34), 3);                        /* RCG_UPDATE */
+	osm_tzw(OSM_SEQ(17), 0x400);                    /* GPLL_SEL */
+	osm_tzw(OSM_SEQ(82), 0x500);                    /* PLL_EARLY_SEL */
+	osm_tzw(OSM_SEQ(83), 0x300);                    /* PLL_MAIN_SEL */
+	osm_tzw(OSM_SEQ(84), 2);                        /* RCG_UPDATE_SUCCESS */
+	osm_tzw(OSM_SEQ(85), 3);                        /* RCG_UPDATE */
+	osm_tzw(OSM_SEQ(37), 0x179d143c);               /* ITM_PRESENT address */
+	osm_tzw(OSM_SEQ(38), 0);
+	osm_tzw(OSM_SEQ(39), 1);                        /* ITM_CL0_ENABLED_CL1_DISABLE (perfcl) */
+	for (uint32_t i = 0; i < sizeof(osm_seq_instr) / 4; i++) {
+		osm_tzw(0x500 + 4 * i, osm_seq_instr[i]);
+	}
+	for (uint32_t i = 0; i < sizeof(osm_seq_br_instr) / 4; i++) {
+		osm_tzw(0x170 + 4 * i, osm_seq_br_instr[i]);
+	}
+	/* MEM-ACC, secure_init path */
+	for (int k = 0; k < 4; k++) {
+		osm_tzw(OSM_SEQ(51 + k), (uint32_t)k + 1);
+	}
+	osm_tzw(OSM_SEQ(59), 0xff);
+	for (int k = 0; k < 4; k++) {
+		osm_tzw(OSM_SEQ(55 + k), cpr.mem_acc_vc[k]);
+	}
+	osm_tzw(OSM_SEQ(49), (uint32_t)(OSM_GOLD + OSM_SEQ(28)));
+	for (int k = 0; k < 9; k++) {
+		osm_tzw(OSM_SEQ(60 + k), acc_now[k % 3]);
+	}
+	for (int k = 0; k < 3; k++) {
+		osm_tzw(OSM_SEQ(12 + k), acc_cfg[k]);
+	}
+	osm_tzw(OSM_SEQ(32), cpr.mem_acc_lval);
+	/* APM corners, secure_init path */
+	osm_tzw(OSM_SEQ(1), cpr.apm_threshold_vc);
+	osm_tzw(OSM_SEQ(72), cpr.apm_crossover_vc);
+	osm_tzw(OSM_SEQ(8), (uint32_t)(OSM_GOLD + OSM_SEQ(1)));
+	osm_tzw(OSM_SEQ(15), cpr.apm_threshold_vc);
+	osm_tzw(OSM_SEQ(31), cpr.apm_pre_vc);
+	osm_tzw(OSM_SEQ(73), 0x3bu | cpr.apm_threshold_vc << 6);
+	osm_tzw(OSM_SEQ(76), 0x39u | cpr.apm_threshold_vc << 6);
+	uint64_t r0 = 0, r1 = 0;
+	(void)osm_scm1(SCM_FAST_FN(SCM_SVC_IO, SCM_IO_READ), OSM_GOLD + OSM_SEQ(0), &r0);
+	(void)osm_scm1(SCM_FAST_FN(SCM_SVC_IO, SCM_IO_READ), OSM_GOLD + OSM_SEQ(39), &r1);
+	uint64_t r2 = 0;
+	(void)osm_scm1(SCM_FAST_FN(SCM_SVC_IO, SCM_IO_READ), OSM_GOLD + 0x170, &r2);
+	printf("SWEET OSM: sequencer loaded: %u TZ writes refused; SEQ_REG(0) %#llx SEQ_REG(39) %#llx, br[0] %#llx\n",
+	    osm_tz_refused, r0, r1, r2);
+}
+
+static void
+osm_phase2_steps(volatile uint32_t *o, uint32_t maxkhz, uint64_t ns_boot)
+{
+	int moved = osm_steps(o, maxkhz, ns_boot, "A");
+	if (moved != 0) {
+		return;
+	}
+	/* B: OSM follows the software request only (no LLM frequency/voltage votes, no core-count DCVS) */
+	osm_wr(o, 0x1034, 3);
+	osm_wr(o, 0x1020, 1);
+	osm_state("B: LLM votes and CC DCVS off", o);
+	moved = osm_steps(o, maxkhz, ns_boot, "B");
+	uint32_t seq = 0;
+	(void)PE_parse_boot_argn("osmseq", &seq, sizeof(seq));
+	if (moved != 0 || !seq) {
+		return;
+	}
+	/* C: load the sequencer as Linux does without TZ, with OSM off, then enable again at index 0 */
+	osm_wr(o, 0x1f10, 0);
+	delay(2000);
+	osm_wr(o, 0x1004, 0);
+	delay(100);
+	osm_seq_load(o);
+	osm_wr(o, 0x1f10, 0);
+	delay(5);
+	osm_wr(o, 0x1004, 1);
+	delay(100);
+	osm_state("C: sequencer loaded, enabled at index 0", o);
+	(void)osm_steps(o, maxkhz, ns_boot, "C");
 }
 
