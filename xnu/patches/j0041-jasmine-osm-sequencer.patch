--- a/osfmk/arm64/sweet_osm.c
+++ b/osfmk/arm64/sweet_osm.c
@@ -872,9 +872,227 @@ static void
 osm_state(const char *when, volatile uint32_t *o)
 {
 	uint32_t st = osm_rd(osm_cprh, 0x3aa4);
-	printf("SWEET OSM: %s: PLL mode %#x L %#x status %#x, RCG cfg %#x; OSM enable %#x desired %u pstate %#x; "
-	    "CPRh corner %u last %u; SAW PMIC_STS %#x\n", when, osm_gpll[0], osm_gpll[1], osm_gpll[11], osm_grcg[1],
-	    osm_rd(o, 0x1004), osm_rd(o, 0x1f10), osm_rd(o, 0x1c00), st & 0x3f, (st >> 6) & 0xfff, osm_rd(osm_saw, 0xc18));
+	printf("SWEET OSM: %s: PLL mode %#x L %#x status %#x, RCG cfg %#x; OSM enable %#x desired %u pstate %#x pc %#x "
+	    "cc %#x irq dev %#x met %#x; CPRh corner %u last %u; SAW PMIC_STS %#x\n", when, osm_gpll[0], osm_gpll[1],
+	    osm_gpll[11], osm_grcg[1], osm_rd(o, 0x1004), osm_rd(o, 0x1f10), osm_rd(o, 0x1c00), osm_rd(o, 0x1c74),
+	    osm_rd(o, 0x1f04), osm_rd(o, 0x1f14), osm_rd(o, 0x1f2c), st & 0x3f, (st >> 6) & 0xfff, osm_rd(osm_saw, 0xc18));
+}
+
+/*
+ * Step the enabled OSM up to maxkhz. Returns -1 after a wrong result (left at
+ * index 0), else 1 if the cluster clock followed (PLL or RCG changed from XBL's
+ * L 0x20 / GPLL0), 0 if it did not move at all (round j40: enable 1, desired
+ * stepping, clock stays on GPLL0).
+ */
+static int
+osm_steps(volatile uint32_t *o, uint32_t maxkhz, uint64_t ns_boot, const char *tag)
+{
+	uint32_t good = 0;
+	int moved = 0;
+	for (uint32_t i = 0; i < cpr.lut_rows && cpr.lut[i].freq / 1000 <= maxkhz; i++) {
+		osm_wr(o, 0x1f10, i);
+		delay(2000);
+		char what[64];
+		snprintf(what, sizeof(what), "%s index %u (%u kHz)", tag, i, cpr.lut[i].freq / 1000);
+		osm_state(what, o);
+		if (osm_gpll[1] != 0x20 || osm_grcg[1] != 0x401) {
+			moved = 1;
+		}
+		uint64_t ns, t0 = mach_absolute_time();
+		uint64_t r = osm_workload(OSM_WORK);
+		absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+		uint32_t errs = r == osm_ref ? osm_load_all() : 1;
+		printf("SWEET OSM: %s index %u: workload %s, %llu us (boot %llu us, ~%llu MHz); 4 cores x 20: %u errors\n",
+		    tag, i, r == osm_ref ? "OK" : "WRONG", ns / 1000, ns_boot / 1000,
+		    1747ull * OSM_WORK_1747_US * 1000 / (ns ? ns : 1), errs);
+		osm_tsens(what);
+		if (r != osm_ref || errs) {
+			osm_wr(o, 0x1f10, 0);
+			delay(2000);
+			osm_state("errors: back to index 0", o);
+			return -1;
+		}
+		good = i;
+	}
+	osm_wr(o, 0x1f10, good);
+	delay(2000);
+	osm_state("staying", o);
+	return moved;
+}
+
+/*
