+/*
+ * Reset through the ADT node /sweet-reset (jasmine): reg = <PS_HOLD 4>,
+ * <IMEM restart_reason 4> (absolute physical). Reboot, halt and panic go back
+ * to ABL's fastboot (restart reason 0x77665500), so the next `fastboot boot`
+ * needs no buttons. A panic first keeps the screen for panicwait= seconds
+ * (default 60); panicwait=-1 hangs as before. Mapped in start(): nothing may
+ * be allocated on the panic path.
+ */
+static volatile uint32_t *sweet_pshold, *sweet_restart_reason;
+
+static void
+sweet_map_reset(void)
+{
+	DTEntry node;
+	uintptr_t const *reg = NULL;
+	unsigned int size = 0;
+
+	if (SecureDTLookupEntry(NULL, "/sweet-reset", &node) != kSuccess ||
+	    SecureDTGetProperty(node, "reg", (void const **)&reg, &size) != kSuccess ||
+	    size < 4 * sizeof(uintptr_t)) {
+		IOLog("SWEET: no /sweet-reset node, reboot and panic do not reset\n");
+		return;
+	}
+	sweet_pshold = (volatile uint32_t *)(ml_io_map(reg[0] & ~(uintptr_t)0xfff, 0x1000) + (reg[0] & 0xfff));
+	sweet_restart_reason = (volatile uint32_t *)(ml_io_map(reg[2] & ~(uintptr_t)0xfff, 0x1000) + (reg[2] & 0xfff));
+	IOLog("SWEET: reset via PS_HOLD %#lx, restart reason %#lx\n", reg[0], reg[2]);
+}
+
+static void __attribute__((noreturn))
+sweet_reset_now(void)
+{
+	*sweet_restart_reason = 0x77665500;     /* ABL: stay in fastboot */
+	__asm__ volatile ("dsb sy" ::: "memory");
+	/* PSCI SYSTEM_RESET; the Qualcomm TZ keeps IMEM and ABL reads the reason */
+	register uint64_t x0 __asm__("x0") = 0x84000009;
+	__asm__ volatile ("smc #0" : "+r"(x0) : : "x1", "x2", "x3", "memory");
+	*sweet_pshold = 0;                      /* PSCI returned: drop PS_HOLD */
+	for (;;) {
+		__asm__ volatile ("wfe");
+	}
+}
+
+int
+SweetPlatformExpert::haltRestart(unsigned int type)
+{
+	if (sweet_pshold == NULL) {
+		return IODTPlatformExpert::haltRestart(type);
+	}
+	switch (type) {
+	case kPEPanicRestartCPU:
+	case kPEPanicRestartCPUNoCallouts:
+	case kPEPanicDiagnosticsDone: {
+		int wait = 60;
+		(void)PE_parse_boot_argn("panicwait", &wait, sizeof(wait));
+		if (wait < 0) {
+			return IODTPlatformExpert::haltRestart(type);
+		}
+		uint64_t end = mach_absolute_time() + (uint64_t)wait * 19200000ull;  /* 19.2 MHz timebase */
+		while (mach_absolute_time() < end) {
+		}
+		sweet_reset_now();
+	}
+	case kPERestartCPU:
+	case kPEHaltCPU:
+		sweet_reset_now();
+	default:
+		return IODTPlatformExpert::haltRestart(type);
+	}
+}
+
 OSDefineMetaClassAndStructors(SweetPlatformExpert, IODTPlatformExpert);
 
 bool
 SweetPlatformExpert::start(IOService *provider)
