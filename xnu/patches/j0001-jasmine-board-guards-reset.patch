--- /dev/null
+++ b/bsd/dev/sweet_board.c
@@ -0,0 +1,31 @@
+/*
+ * Which board the ADT describes. Some drivers have one SoC's MMIO addresses
+ * built in (topaz: SM6225). On another SoC those addresses are unrelated
+ * blocks or holes, and a stray access can hang the bus, so they only start
+ * when the ADT root says it is that board (tools/mkadt.py writes it).
+ */
+#include <pexpert/device_tree.h>
+#include <string.h>
+#include <dev/sweet_board.h>
+
+int
+sweet_board_is(const char *compat)
+{
+	DTEntry root;
+	void const *prop;
+	unsigned int size;
+	size_t want = strlen(compat);
+
+	if (SecureDTLookupEntry(NULL, "/", &root) != kSuccess ||
+	    SecureDTGetProperty(root, "compatible", &prop, &size) != kSuccess) {
+		return 0;
+	}
+	for (const char *s = prop, *end = s + size; s < end;) {
+		size_t n = strnlen(s, (size_t)(end - s));
+		if (n == want && strncmp(s, compat, n) == 0) {
+			return 1;
+		}
+		s += n + 1;
+	}
+	return 0;
+}
