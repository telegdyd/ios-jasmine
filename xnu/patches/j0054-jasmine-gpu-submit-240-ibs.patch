From 3bd8828e7c78f935d1bb54b764245bfbd4d803db Mon Sep 17 00:00:00 2001
From: telegdyd <telegdyd93@gmail.com>
Date: Thu, 22 Oct 2026 20:08:24 +0200
Subject: [PATCH] jasmine-j0054: submits of up to 240 command buffers (Mesa
 merges ~130 once shared buffers no longer stop it)

---
 bsd/dev/sweet_gpu.c           | 2 +-
 iokit/Kernel/arm/SweetGPU.cpp | 8 +++++++-
 2 files changed, 8 insertions(+), 2 deletions(-)

diff --git a/bsd/dev/sweet_gpu.c b/bsd/dev/sweet_gpu.c
index 7c6d1d3..9ddeed2 100755
--- a/bsd/dev/sweet_gpu.c
+++ b/bsd/dev/sweet_gpu.c
@@ -975,7 +975,7 @@ int sweet_gpu_submit(const uint64_t *iova, const uint32_t *dwords, uint32_t n, u
 int
 sweet_gpu_submit(const uint64_t *iova, const uint32_t *dwords, uint32_t n, uint32_t *seqno)
 {
-	if (!gpu_ready || n == 0 || n > 64) {
+	if (!gpu_ready || n == 0 || n > 240) {   /* SweetGPU.cpp SWEET_GPU_MAX_IBS */
 		return gpu_ready ? EINVAL : ENODEV;
 	}
 	uint32_t need = 4 * n + 5;
diff --git a/iokit/Kernel/arm/SweetGPU.cpp b/iokit/Kernel/arm/SweetGPU.cpp
index f7539c9..d22792f 100644
--- a/iokit/Kernel/arm/SweetGPU.cpp
+++ b/iokit/Kernel/arm/SweetGPU.cpp
@@ -119,7 +119,13 @@ static IOLock *sweet_gpu_pool_lock;
 #else
 #define SWEET_GPU_UPAGE         ((uint64_t)page_size)
 #endif
-#define SWEET_GPU_MAX_IBS       64
+/*
+ * Mesa merges deferred submits until more than 128 command buffers wait (as for
+ * msm), so one submit can carry ~130 (j0054; 64 dropped every merged frame).
+ * 240 x 16 bytes still fit IOKit's 4 KiB inline structure, and the ring (8192
+ * dwords) takes 4 per IB.
+ */
+#define SWEET_GPU_MAX_IBS       240
 #define SWEET_GPU_MAX_JOB_BUFS  1024
 
 class SweetGPU : public IOService {
-- 
2.47.3

