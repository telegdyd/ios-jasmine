-static int
-gpu_load_fw(const char *prop, uint32_t off)
-{
-	DTEntry e;
-	const void *fw;
-	unsigned int size;
-	if (SecureDTLookupEntry(NULL, "/sweet-gpu", &e) != kSuccess ||
