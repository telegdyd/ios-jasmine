From f177af5f7dd18e3c6e3136da86599729268c7beb Mon Sep 17 00:00:00 2001
From: telegdyd <telegdyd93@gmail.com>
Date: Wed, 21 Oct 2026 14:00:56 +0200
Subject: [PATCH] jasmine-j0019: Adreno zap shader through TrustZone, CP out of
 secure mode (sweetgpu=3)

PAS id 13 the way qcom_mdt_load and TopazModem.cpp do it: init_image with
the metadata (ELF header, program headers, hash segment) in the GPU window,
mem_setup with the reserved gpu@fed00000 region (/sweet-gpu zap-mem), the
relocatable segment copied there through a device mapping, auth_and_reset.
Then CP_SET_SECURE_MODE 0 and one more CP_MEM_WRITE.
---
 bsd/dev/sweet_gpu.c | 211 ++++++++++++++++++++++++++++++++++++++++++--
 1 file changed, 203 insertions(+), 8 deletions(-)

diff --git a/bsd/dev/sweet_gpu.c b/bsd/dev/sweet_gpu.c
index 203c5db..ae8eeda 100755
--- a/bsd/dev/sweet_gpu.c
+++ b/bsd/dev/sweet_gpu.c
@@ -7,6 +7,9 @@
  *   sweetgpu=2  + load the microcode, start the command processor (CP) on a
  *               ringbuffer, CP_ME_INIT, then two CP_MEM_WRITEs: one below and
  *               one above 4 GiB (the CP is still in secure mode: no zap shader)
+ *   sweetgpu=3  + load the zap shader through TrustZone (PAS id 13) and take the
+ *               CP out of secure mode (CP_SET_SECURE_MODE 0), then one more
+ *               CP_MEM_WRITE
  *
  * Power (sequences of mainline gpucc-sdm660.c / gdsc.c and downstream
  * msm_gfx_ldo.c, which mainline lacks): the GPU rail on SDM660 is VDD_CX
@@ -43,6 +46,7 @@
 #include <pexpert/pexpert.h>
 #include <pexpert/device_tree.h>
 #include <libkern/libkern.h>
+#include <stdbool.h>
 
 extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
 extern vm_offset_t ml_io_map_wcomb(vm_offset_t, vm_size_t);
@@ -590,11 +594,11 @@ cp_mem_write(uint64_t pa, uint32_t v)
 	ring_out(v);
 }
 
-static void
+static int
 gpu_cp_test(void)
 {
 	if (gpu_load_fw("pm4", PM4_OFF) || gpu_load_fw("pfp", PFP_OFF)) {
-		return;
+		return ENOENT;
 	}
 	bzero((void *)(uintptr_t)(sg.mem + RING_OFF / 4), RING_SIZE);
 	bzero((void *)(uintptr_t)(sg.mem + SCRATCH_OFF / 4), 0x1000);
@@ -662,12 +666,12 @@ gpu_cp_test(void)
 	if (kmem_alloc_contig(kernel_map, &page, PAGE_SIZE, PAGE_MASK, 0, 0, KMA_DATA | KMA_ZERO | KMA_PERMANENT,
 	    VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
 		printf("SWEET GPU: no kernel page for the high write\n");
-		return;
+		return ENOMEM;
 	}
 	uint64_t hi = ptoa_64(pmap_find_phys(kernel_pmap, (addr64_t)page));
 	flush_dcache64((addr64_t)hi, 64, TRUE);
 	if (smmu_identity(hi)) {
-		return;
+		return EPERM;
 	}
 
 	gpu_pause(4, "starting the CP (PFP/ME out of halt) next");
@@ -683,7 +687,7 @@ gpu_cp_test(void)
 	ring_out(0);
 	if (ring_kick("CP_ME_INIT")) {
 		gpu_power_off();
-		return;
+		return ETIMEDOUT;
 	}
 
 	/* below 4 GiB: the scratch page of the window */
@@ -694,7 +698,7 @@ gpu_cp_test(void)
 	printf("SWEET GPU: memory at %llx reads %08x (want c0ffee01)\n", lo, sg.mem[SCRATCH_OFF / 4]);
 	if (err) {
 		gpu_power_off();
-		return;
+		return err;
 	}
 
 	gpu_pause(4, "CP_MEM_WRITE above 4 GiB next");
@@ -705,6 +709,197 @@ gpu_cp_test(void)
 	if (err) {
 		gpu_power_off();
 	}
+	return err;
+}
+
+/*
+ * Zap shader (sweetgpu=3): the GPU comes up in secure mode, where the CP may
+ * not drop to the non-secure state on its own; TrustZone loads a small
+ * signed program for that ("zap shader", PAS id 13, a512_zap from the stock
+ * vendor partition) and then CP_SET_SECURE_MODE 0 on the ring switches the
+ * CP over (a5xx_hw_init). The load is Linux's qcom_mdt_load as topaz's
+ * TopazModem.cpp does it for the modem: init_image with the metadata (ELF
+ * header + program headers + hash segment, contiguous, here in the GPU window
+ * below 4 GiB), mem_setup with the reserved region gpu@fed00000 (the one
+ * PT_LOAD segment is relocatable), the segment copied there through a device
+ * mapping (no speculative reads once TZ owns the region), auth_and_reset.
+ */
+#define PAS_ID_GPU              13
+#define SCM_FN(svc, cmd)        (0x42000000u | ((uint32_t)(svc) << 8) | (uint32_t)(cmd))
+#define SCM_SVC_PIL             0x02
+#define PIL_INIT_IMAGE          0x01
+#define PIL_MEM_SETUP           0x02
+#define PIL_AUTH_RESET          0x05
+#define PIL_SHUTDOWN            0x06
+#define PIL_IS_SUPPORTED        0x07
+#define SCM_ARG_RW              2
+#define META_OFF                0x30000u        /* zap metadata in the GPU window, up to 0x10000 */
+#define MDT_TYPE_MASK           (7u << 24)
+#define MDT_TYPE_HASH           (2u << 24)
+#define MDT_RELOCATABLE         (1u << 27)
+#define CP_SET_SECURE_MODE      0x66
+
+struct zap_ehdr {
+	uint8_t  e_ident[16];
+	uint16_t e_type, e_machine;
+	uint32_t e_version, e_entry, e_phoff, e_shoff, e_flags;
+	uint16_t e_ehsize, e_phentsize, e_phnum, e_shentsize, e_shnum, e_shstrndx;
+} __attribute__((packed));
+struct zap_phdr {
+	uint32_t p_type, p_offset, p_vaddr, p_paddr, p_filesz, p_memsz, p_flags, p_align;
+} __attribute__((packed));
+
+/* SMCCC SMC64 to TrustZone (TopazModem.cpp smc/scm): long calls return 1 and are resumed */
+static uint64_t
+scm(uint32_t fn, uint64_t arginfo, uint64_t a, uint64_t b, uint64_t c, uint64_t *res1)
+{
+	uint64_t r0 = fn, r1 = arginfo, r2 = a, r3 = b, r4 = c, r5 = 0, r6 = 0, r7 = 0;
+	for (int n = 0; n < 100000; n++) {
+		register uint64_t x0 __asm__("x0") = r0, x1 __asm__("x1") = r1, x2 __asm__("x2") = r2,
+		    x3 __asm__("x3") = r3, x4 __asm__("x4") = r4, x5 __asm__("x5") = r5, x6 __asm__("x6") = r6,
+		    x7 __asm__("x7") = r7;
+		__asm__ volatile ("smc #0"
+                    : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3), "+r"(x4), "+r"(x5), "+r"(x6), "+r"(x7)
+                    :
+                    : "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "x16", "x17", "memory");
+		if (x0 != 1) {
+			if (res1 != NULL) {
+				*res1 = x1;
+			}
+			return x0;
+		}
+		/* INTERRUPTED: resume with x0 = 1 and the session from x6 */
+		r0 = 1; r1 = arginfo; r2 = a; r3 = b; r4 = c; r5 = 0; r6 = x6; r7 = 0;
+	}
+	return ~0ull;
+}
+
+static int
+gpu_zap_load(void)
+{
+	DTEntry e;
+	const uint8_t *fw;
+	const uint64_t *zmem;
+	unsigned int size, zsize;
+	uint64_t st, res = 0;
+
+	if (SecureDTLookupEntry(NULL, "/sweet-gpu", &e) != kSuccess ||
+	    SecureDTGetProperty(e, "zap", (const void **)&fw, &size) != kSuccess ||
+	    SecureDTGetProperty(e, "zap-mem", (const void **)&zmem, &zsize) != kSuccess || zsize < 16 ||
+	    size < sizeof(struct zap_ehdr)) {
+		printf("SWEET GPU: no zap shader or zap-mem in /sweet-gpu\n");
+		return ENOENT;
+	}
+	const struct zap_ehdr *eh = (const struct zap_ehdr *)fw;
+	if (memcmp(eh->e_ident, "\x7f" "ELF", 4) != 0 || eh->e_phentsize != sizeof(struct zap_phdr) ||
+	    eh->e_phoff + (uint64_t)eh->e_phnum * sizeof(struct zap_phdr) > size) {
+		printf("SWEET GPU: zap: bad ELF header\n");
+		return EINVAL;
+	}
+	const struct zap_phdr *ph = (const struct zap_phdr *)(fw + eh->e_phoff);
+	uint32_t hash = ~0u, min_a = ~0u, max_a = 0;
+	bool relocate = false;
+	for (uint32_t i = 0; i < eh->e_phnum; i++) {
+		if ((ph[i].p_flags & MDT_TYPE_MASK) == MDT_TYPE_HASH) {
+			hash = i;
+		}
+		if (ph[i].p_type != 1 || ph[i].p_memsz == 0 || (ph[i].p_flags & MDT_TYPE_MASK) == MDT_TYPE_HASH) {
+			continue;
+		}
+		if (ph[i].p_flags & MDT_RELOCATABLE) {
+			relocate = true;
+		}
+		min_a = MIN(min_a, ph[i].p_paddr);
+		max_a = MAX(max_a, ph[i].p_paddr + ph[i].p_memsz);
+		if (ph[i].p_offset + (uint64_t)ph[i].p_filesz > size || (ph[i].p_filesz & 3) || (ph[i].p_offset & 3)) {
+			printf("SWEET GPU: zap: segment %u outside the file or unaligned\n", i);
+			return EINVAL;
+		}
+	}
+	uint64_t hdr = eh->e_phoff + (uint64_t)eh->e_phnum * sizeof(struct zap_phdr);
+	if (hash == ~0u || !relocate || max_a <= min_a || max_a - min_a > zmem[1] ||
+	    ph[hash].p_offset + (uint64_t)ph[hash].p_filesz > size || hdr + ph[hash].p_filesz > 0x10000) {
+		printf("SWEET GPU: zap: unexpected layout (hash %u, relocate %d, %x..%x)\n", hash, relocate, min_a, max_a);
+		return EINVAL;
+	}
+
+	uint64_t st0 = scm(SCM_FN(SCM_SVC_PIL, PIL_IS_SUPPORTED), 1, PAS_ID_GPU, 0, 0, &res);
+	printf("SWEET GPU: zap: PAS %u supported: ret %llx res %llx\n", PAS_ID_GPU, st0, res);
+
+	/* metadata: ELF header + phdrs, then the hash segment (qcom_mdt_read_metadata) */
+	uint8_t *meta = (uint8_t *)(uintptr_t)(sg.mem + META_OFF / 4);
+	memcpy(meta, fw, hdr);
+	memcpy(meta + hdr, fw + ph[hash].p_offset, ph[hash].p_filesz);
+	__builtin_arm_dsb(0xf);
+	gpu_pause(4, "zap: TrustZone init_image next");
+	/*
+	 * mem_setup with the exact image size (0x1334, as Linux's qcom_mdt_load
+	 * passes it) failed with ret 0xffffffe0. TopazModem.cpp rounds to 4 KiB
+	 * and downstream PIL allocates in 1 MiB steps: try those, then the whole
+	 * reserved region, each after a shutdown and a fresh init_image.
+	 */
+	const uint64_t sizes[] = { ((uint64_t)(max_a - min_a) + 0xfff) & ~0xfffull,
+		                   ((uint64_t)(max_a - min_a) + 0xfffff) & ~0xfffffull, zmem[1] };
+	bool ready = false;
+	for (unsigned t = 0; t < sizeof(sizes) / sizeof(sizes[0]) && !ready; t++) {
+		if (t > 0) {
+			st = scm(SCM_FN(SCM_SVC_PIL, PIL_SHUTDOWN), 1, PAS_ID_GPU, 0, 0, &res);
+			printf("SWEET GPU: zap: shutdown: ret %llx res %llx\n", st, res);
+		}
+		st = scm(SCM_FN(SCM_SVC_PIL, PIL_INIT_IMAGE), 2 | (SCM_ARG_RW << 6), PAS_ID_GPU, sg.mem_pa + META_OFF, 0, &res);
+		printf("SWEET GPU: zap: init_image (%llu bytes at %llx): ret %llx res %llx\n",
+		    hdr + ph[hash].p_filesz, sg.mem_pa + META_OFF, st, res);
+		if (st != 0 || res != 0) {
+			return EIO;
+		}
+		st = scm(SCM_FN(SCM_SVC_PIL, PIL_MEM_SETUP), 3, PAS_ID_GPU, zmem[0], sizes[t], &res);
+		printf("SWEET GPU: zap: mem_setup %llx + %llx: ret %llx res %llx\n", zmem[0], sizes[t], st, res);
+		ready = st == 0 && res == 0;
+	}
+	if (!ready) {
+		st = scm(SCM_FN(SCM_SVC_PIL, PIL_SHUTDOWN), 1, PAS_ID_GPU, 0, 0, &res);
+		printf("SWEET GPU: zap: shutdown: ret %llx res %llx\n", st, res);
+		return EIO;
+	}
+	/* segments, relocated to the region; device mapping, 32-bit stores */
+	volatile uint32_t *dst = (volatile uint32_t *)ml_io_map(zmem[0], ((max_a - min_a) + 0x3fff) & ~0x3fffu);
+	for (uint32_t i = 0; i < eh->e_phnum; i++) {
+		if (ph[i].p_type != 1 || ph[i].p_memsz == 0 || (ph[i].p_flags & MDT_TYPE_MASK) == MDT_TYPE_HASH) {
+			continue;
+		}
+		volatile uint32_t *d = dst + (ph[i].p_paddr - min_a) / 4;
+		const uint32_t *src = (const uint32_t *)(fw + ph[i].p_offset);
+		for (uint32_t w = 0; w < ph[i].p_memsz / 4; w++) {
+			d[w] = w < ph[i].p_filesz / 4 ? src[w] : 0;
+		}
+	}
+	__builtin_arm_dsb(0xf);
+	st = scm(SCM_FN(SCM_SVC_PIL, PIL_AUTH_RESET), 1, PAS_ID_GPU, 0, 0, &res);
+	printf("SWEET GPU: zap: auth_and_reset: ret %llx res %llx\n", st, res);
+	return st != 0 || res != 0 ? EIO : 0;
+}
+
+static void
+gpu_zap_test(void)
+{
+	if (gpu_zap_load()) {
+		printf("SWEET GPU: zap shader not loaded, the CP stays in secure mode\n");
+		return;
+	}
+	gpu_pause(4, "CP_SET_SECURE_MODE 0 next");
+	ring_pkt7(CP_SET_SECURE_MODE, 1);
+	ring_out(0);
+	if (ring_kick("CP_SET_SECURE_MODE 0")) {
+		gpu_power_off();
+		return;
+	}
+	uint64_t lo = sg.mem_pa + SCRATCH_OFF + 4;
+	cp_mem_write(lo, 0xc0ffee03);
+	int err = ring_kick("CP_MEM_WRITE, non-secure");
+	printf("SWEET GPU: memory at %llx reads %08x (want c0ffee03)\n", lo, sg.mem[(SCRATCH_OFF + 4) / 4]);
+	if (err) {
+		gpu_power_off();
+	}
 }
 
 static void
@@ -738,8 +933,8 @@ sweet_gpu_thread(__unused void *arg, __unused wait_result_t wr)
 		return;
 	}
 	gpu_dump();
-	if (sg.level >= 2) {
-		gpu_cp_test();
+	if (sg.level >= 2 && gpu_cp_test() == 0 && sg.level >= 3) {
+		gpu_zap_test();
 	}
 	printf("SWEET GPU: done\n");
 }
-- 
