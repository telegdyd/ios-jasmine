-/*
- * Every store to the SMMU goes through here. The hypervisor traps and
- * emulates the global register space, and its emulation goes "horribly
- * wrong for stores using r31 (XZR/WZR) as the source register" (arm-smmu.c,
- * QCOM_DUMMY_VAL): a plain `= 0` compiles to `str wzr` and hung the phone.
- * The "r" constraint forces a real register.
- */
-static inline void
-smmu_wr(volatile uint32_t *base, uint32_t off, uint32_t v)
-{
-	__asm__ volatile ("str %w0, [%1]" : : "r"(v), "r"((volatile uint8_t *)base + off) : "memory");
-}
-
-/*
- * The GPU SMMU (SMMU-v2, 3 stream groups, 5 context banks of which TZ keeps
- * CB2-4: arm-smmu-qcom.c "TZ protects several last context banks") comes out
- * of the GX power-up faulting every stream, and the hypervisor ignores a
- * write of sCR0.USFCFG (Qualcomm firmware does not allow bypass). So CB0 gets
- * a stage 1 table as Linux would build it (io-pgtable-arm, AArch64 4K
- * granule, 36-bit VA, walk non-coherent) that maps the GPU window and the
- * 2 MiB around hi 1:1 with 2 MiB blocks, and stream 0 (the GPU's, iommus =
- * <&kgsl_smmu 0>) is routed to it. Every write is read back.
- */
-static int
-smmu_identity(uint64_t hi)
-{
-	volatile uint32_t *s = sg.smmu, *cb = sg.smmu + SMMU_CB0 / 4;
-	gpu_pause(3, "SMMU setup next");
-	volatile uint64_t *pt = (volatile uint64_t *)(sg.mem + PT_OFF / 4);
-	uint64_t pt_pa = sg.mem_pa + PT_OFF;
-
-	/* L1 at +0, L2 tables at +0x1000 (the window's GiB) and +0x2000 (hi's GiB) */
-	bzero((void *)(uintptr_t)pt, 3 * 0x1000);
-	uint64_t gib_lo = sg.mem_pa >> 30, gib_hi = hi >> 30;
-	pt[gib_lo] = (pt_pa + 0x1000) | 3;
-	if (gib_hi != gib_lo) {
-		pt[gib_hi] = (pt_pa + 0x2000) | 3;
-	}
-	/* block: AF | SH none | AP[2:1] = 01 (read/write, any level) | AttrIndx 0 (MAIR 0x44, non-cacheable) */
-	const uint64_t blk = (1ull << 10) | (1ull << 6) | 1;
-	for (uint64_t a = sg.mem_pa & ~0x1fffffull; a < sg.mem_pa + GMEM_MAP_SIZE; a += 0x200000) {
-		pt[512 + ((a >> 21) & 511)] = a | blk;
-	}
-	uint64_t a = hi & ~0x1fffffull;
-	pt[(gib_hi != gib_lo ? 1024 : 512) + ((a >> 21) & 511)] = a | blk;
-	__builtin_arm_dsb(0xf);
-
-	smmu_wr(cb, 0x000, 0);                              /* SCTLR off while it is set up */
-	smmu_wr(cb, 0x010, (7u << 15) | 1);                 /* TCR2: SEP upstream, PASize 36 bits */
-	smmu_wr(cb, 0x020, (uint32_t)pt_pa);                /* TTBR0, ASID 0 */
-	smmu_wr(cb, 0x024, (uint32_t)(pt_pa >> 32));
-	smmu_wr(cb, 0x028, 0);
-	smmu_wr(cb, 0x02c, 0);
-	smmu_wr(cb, 0x030, (1u << 23) | 28);                /* TCR: EPD1, 4K, walk NC / non-shareable, T0SZ 28 */
-	smmu_wr(cb, 0x034, 0);                              /* CONTEXTIDR */
-	smmu_wr(cb, 0x038, 0x0004ff44);                     /* MAIR0: 0 NC, 1 WB, 2 device */
-	smmu_wr(cb, 0x03c, 0);
-	smmu_wr(cb, 0x058, 0xffffffffu);                    /* FSR: clear */
-	smmu_wr(s, SMMU_GR1, (1u << 16) | (0xfu << 12) | (3u << 8)); /* CBAR0: S1 + S2 bypass, WB, NSH */
-	smmu_wr(s, (SMMU_GR1 + 0x800), 1);                  /* CBA2R0: VA64 */
-	smmu_wr(s, 0x068, ~0u);                         /* TLBIALLNSNH (Linux writes QCOM_DUMMY_VAL) */
-	smmu_wr(s, 0x070, ~0u);                         /* sTLBGSYNC */
-	(void)poll32(&s[0x074 / 4], 1, 0, 1000);
-	smmu_wr(s, 0xc00, 0);                               /* S2CR0: translate, CB0 */
-	smmu_wr(s, 0x800, (1u << 31));                      /* SMR0: valid, ID 0, mask 0 */
-	__builtin_arm_dsb(0xf);
-	/* M | TRE | AFE | CFRE | CFIE | S1_ASIDPNE; faults terminate (no CFCFG stall) */
-	smmu_wr(cb, 0x000, (1u << 12) | (1u << 6) | (1u << 5) | (1u << 2) | (1u << 1) | 1);
-	__builtin_arm_dsb(0xf);
-	printf("SWEET GPU: SMMU CB0 table at %llx: SMR0 %08x S2CR0 %08x CBAR0 %08x CBA2R0 %08x SCTLR %08x "
-	    "TCR %08x TCR2 %08x TTBR0 %08x%08x MAIR0 %08x; hi page %llx\n", pt_pa,
-	    s[0x800 / 4], s[0xc00 / 4], s[SMMU_GR1 / 4], s[(SMMU_GR1 + 0x800) / 4], cb[0], cb[0x30 / 4],
-	    cb[0x10 / 4], cb[0x24 / 4], cb[0x20 / 4], cb[0x38 / 4], hi);
-	if (s[0x800 / 4] != (1u << 31) || (s[0xc00 / 4] & (3u << 16)) != 0 || (cb[0] & 1) == 0) {
-		printf("SWEET GPU: SMMU writes did not stick, CP not started\n");
-		gpu_power_off();
-		return EPERM;
-	}
-	return 0;
-}
