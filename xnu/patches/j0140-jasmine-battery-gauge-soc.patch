Subject: [PATCH] jasmine-j0140: iOS battery percent = the PM660 gauge's own SOC

SweetBattery published a generic voltage-curve estimate (rest voltage from V - 0.11 Ohm * I,
averaged, 1 % per 30 s step) while the gauge's SOC (MSOC, same as `batt` and the charger
tool) was read but only logged: e.g. 3642 mV -225 mA -> iOS 16 %, gauge 7 %. The gauge value
is now published; the voltage curve stays as the fallback when the gauge does not answer.
SweetBatterySOCFromGauge in the power source properties says which one is shown.
---
diff --git a/iokit/Kernel/arm/SweetBattery.cpp b/iokit/Kernel/arm/SweetBattery.cpp
--- a/iokit/Kernel/arm/SweetBattery.cpp
+++ b/iokit/Kernel/arm/SweetBattery.cpp
@@ -47,6 +47,7 @@
 	int fTempC100;          /* centidegrees C; 2500 when not measured */
 	int fOcvAvg;            /* jasmine: averaged rest voltage estimate, mV (0 = none yet) */
 	unsigned fPercent;      /* jasmine: last published percent (0 = none yet) */
+	bool fSocFromGauge;     /* jasmine: percent is the PM660 gauge's own SOC (j0140) */
 	bool pollJasmine(void);
 	void putNumber(const char *key, UInt32 value);
 	void putBool(const char *key, bool value);
@@ -77,6 +78,7 @@
 	fTempC100 = 2500;
 	fOcvAvg = 0;
 	fPercent = 0;
+	fSocFromGauge = false;
 	if (dictionary) {
 		OSCollectionIterator *it = OSCollectionIterator::withCollection(dictionary);
 		if (!it) {
@@ -151,7 +153,8 @@
 	putNumber("Temperature", (UInt32)fTempC100);
 	putBool("SweetBatteryHardwareSampleValid", measured);
 	putBool("SweetBatteryCurrentValid", currentValid);
-	putBool("SweetBatterySOCEstimated", measured);
+	putBool("SweetBatterySOCEstimated", measured && !fSocFromGauge);
+	putBool("SweetBatterySOCFromGauge", fSocFromGauge);
 	putBool("SweetBatteryTemperatureEstimated", !fJasmine);
 	putBool("SweetBatteryFallback", !measured);
 	putNumber("SweetBatteryPercent", percent);
@@ -405,11 +408,23 @@
 	}
 	int ocv = f.mv - f.ma * 11 / 100;
 	fOcvAvg = fOcvAvg == 0 ? ocv : fOcvAvg + (ocv - fOcvAvg) / 4;
-	unsigned percent = estimatePercent(fOcvAvg < 0 ? 0 : (unsigned)fOcvAvg);
-	if (fPercent != 0 && percent > fPercent + 1) {
-		percent = fPercent + 1;
-	} else if (fPercent != 0 && percent + 1 < fPercent) {
-		percent = fPercent - 1;
+	unsigned percent;
+	if (f.fg_soc >= 0 && f.fg_soc <= 100) {
+		/*
+		 * j0140: the PM660 gauge's own SOC (MSOC, Linux fg-gen3 scaling; the charger
+		 * tool and `batt` show the same). The generic voltage curve below read
+		 * ~16 % while the gauge said 7 % and was optimistic near empty.
+		 */
+		percent = (unsigned)f.fg_soc;
+		fSocFromGauge = true;
+	} else {
+		percent = estimatePercent(fOcvAvg < 0 ? 0 : (unsigned)fOcvAvg);
+		if (fPercent != 0 && percent > fPercent + 1) {
+			percent = fPercent + 1;
+		} else if (fPercent != 0 && percent + 1 < fPercent) {
+			percent = fPercent - 1;
+		}
+		fSocFromGauge = false;
 	}
 	fPercent = percent;
 	fTempC100 = f.temp_dc * 10;
