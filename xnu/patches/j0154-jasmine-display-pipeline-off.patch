+/*
+ * j0154: jasmine display off as the stock mdss driver does it for the tianma nt36672
+ * video-mode panel (DT qcom,mdss_dsi_nt36672_tianma_fhd_video): backlight off, DCS
+ * 0x28 display off, 20 ms, 0x10 sleep in, 120 ms (qcom,mdss-dsi-off-command), then the
+ * MDP INTF_1 timing engine off, so nothing is scanned out of DDR any more. On: timing
+ * engine on, 0x11 sleep out, 120 ms, 0x29 display on, then the backlight. The panel keeps
+ * its supplies and reset, so its init registers survive sleep-in. Commands go through
+ * the DSI0 command DMA (6G registers as topaz) from 16 KiB after flip buffer 0 in the
+ * splash reservation (the DMA address is 32 bits; XNU has no RAM below 4 GiB here).
+ * sweetfb_pipeoff=0: backlight-only display off as before.
+ */
+bool
+AppleCLCD::jasmineDsiInit(void)
+{
+	uint32_t on = 1;
+	(void)PE_parse_boot_argn("sweetfb_pipeoff", &on, sizeof(on));
+	DTEntry node;
+	uint64_t const *flip = NULL;
+	unsigned int fs = 0;
+	if (!on || SecureDTLookupEntry(NULL, "/sweet-mdp", &node) != kSuccess ||
+	    SecureDTGetProperty(node, "flip", (void const **)&flip, &fs) != kSuccess || fs < 4 * 8) {
+		IOLog("SWEET FB: display pipeline stays on with the screen off (sweetfb_pipeoff=%u)\n", on);
+		return false;
+	}
+	uint64_t used = round_page((uint64_t)fRowBytes * fHeight);
+	if (flip[1] < used + page_size || flip[0] + used + page_size > (1ull << 32)) {
+		IOLog("SWEET FB: no room for DSI commands after flip buffer 0 (%#llx of %#llx)\n", used, flip[1]);
+		return false;
+	}
+	volatile uint8_t *dsi = (volatile uint8_t *)ml_io_map(0x0c994000, 0x1000);
+	volatile uint32_t *intf = (volatile uint32_t *)ml_io_map(0x0c96b000, 0x1000);
+	IOMemoryDescriptor *md = IOMemoryDescriptor::withPhysicalAddress(flip[0] + used, page_size, kIODirectionInOut);
+	fDsiMap = md ? md->createMappingInTask(kernel_task, 0, kIOMapAnywhere | kIOMapWriteCombineCache) : NULL;
+	OSSafeReleaseNULL(md);
+	if (dsi == NULL || intf == NULL || fDsiMap == NULL) {
+		IOLog("SWEET FB: DSI0 / INTF_1 / command buffer not mapped\n");
+		OSSafeReleaseNULL(fDsiMap);
+		return false;
+	}
+	intf += 0x800 / 4;
+	uint32_t ctrl = *(volatile uint32_t *)(dsi + 0x004), te = intf[0];
+	IOLog("SWEET FB: jasmine DSI0 ctrl %#x (video %u), INTF_1 timing engine %#x, command buffer %#llx\n",
+	    ctrl, (ctrl >> 1) & 1, te, flip[0] + used);
+	if ((ctrl & 3) != 3 || (te & 1) == 0) {
+		IOLog("SWEET FB: DSI0 not in video mode or INTF_1 not running: backlight-only display off\n");
+		OSSafeReleaseNULL(fDsiMap);
+		return false;
+	}
+	fDsi = dsi;
+	fDsiVA = (uint8_t *)fDsiMap->getVirtualAddress();
+	fDsiBufPhys = flip[0] + used;
+	fJIntf = intf;
+	return true;
+}
+
+void
+AppleCLCD::jasmineTiming(bool on)
+{
+	if (fJIntf == NULL || ((fJIntf[0] & 1) != 0) == on) {
+		return;
+	}
+	uint32_t v = on ? 1 : 0;
+	__asm__ volatile ("dsb sy\n\tstr %w1, [%0]\n\tdsb sy" : : "r"(fJIntf), "r"(v) : "memory");
+	IOSleep(40);            /* the frame in flight ends (30 Hz) / the panel gets sync again */
+}
