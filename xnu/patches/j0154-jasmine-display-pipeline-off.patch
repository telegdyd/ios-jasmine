 	bool any = false;
 	for (;;) {
+		if (nvt_display_off) {
+			for (int s = 0; s < max; s++) {
+				if (down[s]) {
+					down[s] = false;
+					sweet_hid_touch(s, 0, px[s], py[s]);
+				}
+			}
+			any = false;
+			while (nvt_display_off) {
+				assert_wait((event_t)&nvt_display_off, THREAD_UNINT);
+				if (nvt_display_off) {
+					thread_block(THREAD_CONTINUE_NULL);
+				} else {
+					clear_wait(current_thread(), THREAD_AWAKENED);
+				}
+			}
+			int pr = -1;
+			for (int tries = 0; tries < 8; tries++) {
+				nvt_sleep_ms(tries ? 100 : 20);
+				pr = nvt_read(NVT_PARAMS, p, 15);
+				if (pr == 0 && p[0x0e] == 0x08) {
+					break;
+				}
+				if (tries == 3) {
+					nvt_reset_pulse();
+				}
+			}
+			printf("SWEET NVT: display on, touch %s (chip id %#x)\n", pr == 0 && p[0x0e] == 0x08 ? "back" : "NOT BACK", p[0x0e]);
+			continue;
+		}
