+			}
 		}
 		break;
+	}
 	case CMD_CLOSE_ACK:
 	case CMD_SIGNALS:
 		rx_advance(8);
@@ -1295,6 +1606,17 @@ rx_one(void)
 		}
 		rx_advance(n);
 		if (hdr[1] == 0) {
+			struct aux_chan *c = m.p1 != g_rcid ? aux_by_rcid(m.p1) : NULL;
+			if (c != NULL) {
