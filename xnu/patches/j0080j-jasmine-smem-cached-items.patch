From 2317f38b1ed61f278232f55791c5157457ef4e3c Mon Sep 17 00:00:00 2001
From: telegdyd <telegdyd93@gmail.com>
Date: Sat, 24 Oct 2026 16:53:38 +0200
Subject: [PATCH] jasmine-j0080j: SMEM cached list searched too
 (qcom_smem_get_private); partition item dump while the modem GLINK FIFO is
 missing

---
 iokit/Kernel/arm/TopazModem.cpp | 83 +++++++++++++++++++++++++++++++--
 1 file changed, 80 insertions(+), 3 deletions(-)

diff --git a/iokit/Kernel/arm/TopazModem.cpp b/iokit/Kernel/arm/TopazModem.cpp
index 5304bbe..4043a5f 100644
--- a/iokit/Kernel/arm/TopazModem.cpp
+++ b/iokit/Kernel/arm/TopazModem.cpp
@@ -536,12 +536,32 @@ smem_partition(uint16_t a, uint16_t b)
 	return NULL;
 }
 
+/* the partition's cacheline from its TOC entry (0: no cached list) */
+static uint32_t
+smem_cacheline(struct smem_part_hdr *p)
+{
+	struct smem_pt *pt = (struct smem_pt *)(smem + SMEM_SIZE - 0x1000);
+	struct smem_pt_entry *e = (struct smem_pt_entry *)(pt + 1);
+
+	for (uint32_t i = 0; i < pt->num_entries && i < 64; i++) {
+		if (smem + e[i].offset == (uint8_t *)p) {
+			return e[i].cacheline;
+		}
+	}
+	return 0;
+}
+
+/*
+ * qcom_smem_get_private(): the uncached list from the header up, then the cached list from the
+ * end down (entry headers cacheline-aligned, the item below its header). visit != NULL: every
+ * entry of both lists goes to visit (the dump), nothing is returned.
+ */
 static void *
-smem_get(struct smem_part_hdr *p, uint16_t item, uint32_t *size)
+smem_walk(struct smem_part_hdr *p, uint16_t item, uint32_t *size, void (*visit)(uint16_t, uint32_t, bool))
 {
 	uint8_t *e, *end;
 
-	if (p == NULL || memcmp(p->magic, "$PRT", 4) != 0 || p->free_uncached > p->size) {
+	if (p == NULL || memcmp(p->magic, "$PRT", 4) != 0 || p->free_uncached > p->size || p->free_cached > p->size) {
 		return NULL;
 	}
 	e = (uint8_t *)p + sizeof(*p);
@@ -551,7 +571,9 @@ smem_get(struct smem_part_hdr *p, uint16_t item, uint32_t *size)
 		if (h->canary != 0xA5A5) {
 			return NULL;
 		}
-		if (h->item == item) {
+		if (visit != NULL) {
+			visit(h->item, h->size - h->pad_data, false);
+		} else if (h->item == item) {
 			if (size != NULL) {
 				*size = h->size - h->pad_data;
 			}
@@ -559,9 +581,58 @@ smem_get(struct smem_part_hdr *p, uint16_t item, uint32_t *size)
 		}
 		e += sizeof(*h) + h->pad_hdr + h->size;
 	}
+	uint32_t cl = smem_cacheline(p);
+	if (cl == 0 || cl > 0x1000) {
+		return NULL;
+	}
+	uint32_t hsz = (sizeof(struct smem_priv_entry) + cl - 1) & ~(cl - 1);
+	e = (uint8_t *)p + p->size - hsz;
+	end = (uint8_t *)p + p->free_cached;
+	while (e > end) {
+		struct smem_priv_entry *h = (struct smem_priv_entry *)e;
+		if (h->canary != 0xA5A5 || h->size > (uint32_t)(e - end)) {
+			return NULL;
+		}
+		if (visit != NULL) {
+			visit(h->item, h->size - h->pad_data, true);
+		} else if (h->item == item) {
+			if (size != NULL) {
+				*size = h->size - h->pad_data;
+			}
+			return e - h->size;
+		}
+		e -= h->size + hsz;
+	}
 	return NULL;
 }
 
+static void *
+smem_get(struct smem_part_hdr *p, uint16_t item, uint32_t *size)
+{
+	return smem_walk(p, item, size, NULL);
+}
+
+static char smem_dump_buf[512];
+
+static void
+smem_dump_one(uint16_t item, uint32_t size, bool cached)
+{
+	size_t n = strlen(smem_dump_buf);
+	if (n + 24 < sizeof(smem_dump_buf)) {
+		snprintf(smem_dump_buf + n, sizeof(smem_dump_buf) - n, " %u%s:%x", item, cached ? "c" : "", size);
+	}
+}
+
+/* one line: every item of the partition, "c" for the cached list */
+static void
+smem_dump(struct smem_part_hdr *p, const char *what)
+{
+	smem_dump_buf[0] = 0;
+	(void)smem_walk(p, 0, NULL, smem_dump_one);
+	LOG("SMEM %s (free %x..%x, cacheline %u):%s", what, p != NULL ? p->free_uncached : 0, p != NULL ? p->free_cached : 0,
+	    p != NULL ? smem_cacheline(p) : 0, smem_dump_buf);
+}
+
 static bool
 smem_lock(void)
 {
@@ -1240,6 +1311,8 @@ glink_start(struct smem_part_hdr *part)
 static void
 glink_poll(struct smem_part_hdr *part, unsigned ms)
 {
+	static unsigned dumps;
+
 	g_ms = ms;
 	if (g_rx == NULL && g_rx_msgs == 0) {
 		uint32_t sz = 0;
@@ -1247,6 +1320,10 @@ glink_poll(struct smem_part_hdr *part, unsigned ms)
 		if (g_rx != NULL) {
 			g_rx_len = sz;
 			LOG("t=%u ms: modem RX FIFO, %u bytes", ms, sz);
+		} else if ((dumps == 0 && ms >= 3000) || (dumps == 1 && ms >= 20000)) {
+			dumps++;
+			LOG("t=%u ms: no modem RX FIFO (item %u) yet", ms, SMEM_GLINK_FIFO_RX);
+			smem_dump(part, "apps<->modem");
 		}
 	}
 	for (int i = 0; i < 64 && g_rx != NULL && rx_one(); i++) {
-- 
2.47.3

