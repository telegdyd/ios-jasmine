From 3ced633660eabf1448c9011c70bdd234c13f5449 Mon Sep 17 00:00:00 2001
From: telegdyd <telegdyd93@gmail.com>
Date: Sun, 25 Oct 2026 02:02:43 +0100
Subject: [PATCH] jasmine-j0096: reboot watchdog: step lines in
 reboot_kernel/proc_shutdown, a dump of the processes left and kernel
 backtraces when one step takes 6 s (j83/j85/j93: reboots while joined hung
 after launchd quiesce)

---
 bsd/dev/sweet_sample.c   | 106 +++++++++++++++++++++++++++++++++++++++
 bsd/kern/kern_shutdown.c |  30 +++++++++++
 osfmk/kern/exception.c   |  69 +++++++++++++++++++++++++
 3 files changed, 205 insertions(+)

diff --git a/bsd/dev/sweet_sample.c b/bsd/dev/sweet_sample.c
index b40eccd..a33299e 100644
--- a/bsd/dev/sweet_sample.c
+++ b/bsd/dev/sweet_sample.c
@@ -19,6 +19,8 @@
 #include <kern/task.h>
 #include <kern/thread.h>
 #include <pexpert/pexpert.h>
+#include <kern/clock.h>
+#include <mach/mach_time.h>
 
 extern task_t proc_task(proc_t);
 extern int hz;
@@ -86,3 +88,107 @@ sweet_sample_start(void)
 		thread_deallocate(thread);
 	}
 }
+
+/*
+ * j0096 reboot watchdog: where does a reboot hang? (j83/j85/j93: reboots while
+ * joined to Wi-Fi stopped after "launchd quiesce complete", before
+ * vfs_unmountall.) reboot_kernel and proc_shutdown name each step with
+ * sweet_shutdown_step ("SDW step NAME at +N ms"); the first step starts a
+ * kernel thread that says every 2 s which step runs ("SDW in NAME for N ms":
+ * when these lines stop, the whole system stopped). 6 s in one step it dumps
+ * the reboot thread's kernel backtrace and every process left with its
+ * threads (state, wait event, kernel backtrace); 20 s in it also dumps the
+ * kernel_task threads. Gives up after 3 minutes.
+ */
+extern void sweet_sample_kthread(const char *tag, thread_t thread);     /* osfmk/kern/exception.c */
+extern void sweet_sample_ktask(const char *name, int pid, task_t task);
+extern vm_offset_t vm_kernel_slide;
+extern void sweet_shutdown_step(const char *what);
+
+static const char *volatile sdw_step;
+static volatile uint64_t sdw_step_at;
+static uint64_t sdw_start;
+static thread_t sdw_thread;
+
+static uint64_t
+sdw_ms(uint64_t abs)
+{
+	uint64_t ns;
+	absolutetime_to_nanoseconds(abs, &ns);
+	return ns / 1000000;
+}
+
+static int
+sdw_proc(proc_t p, __unused void *arg)
+{
+	char name[32];
+	task_t task = proc_task(p);
+	proc_name(proc_pid(p), name, sizeof(name));
+	printf("SDW proc %s[%d] stat %d shutdownstate %d flag 0x%x lflag 0x%x\n", name, proc_pid(p),
+	    p->p_stat, p->p_shutdownstate, p->p_flag, p->p_lflag);
+	if (task != TASK_NULL) {
+		sweet_sample_ktask(name, proc_pid(p), task);
+	}
+	return PROC_RETURNED;
+}
+
+static void
+sdw_dump(const char *step, bool kernel_threads)
+{
+	printf("SDW dump: stuck in %s, slide 0x%lx\n", step, (unsigned long)vm_kernel_slide);
+	sweet_sample_kthread("reboot thread", sdw_thread);
+	proc_iterate(PROC_ALLPROCLIST | PROC_ZOMBPROCLIST, sdw_proc, NULL, NULL, NULL);
+	if (kernel_threads) {
+		sweet_sample_ktask("kernel_task", 0, kernel_task);
+	}
+	printf("SDW dump end\n");
+}
+
+static void
+sdw_watch(__unused void *arg, __unused wait_result_t wr)
+{
+	static int chan;
+	const char *seen = NULL;
+	int dumped = 0;
+
+	for (int s = 0; s < 180; s++) {
+		(void)tsleep(&chan, PZERO, "sweetsdw", hz);
+		const char *step = sdw_step;
+		uint64_t in = sdw_ms(mach_absolute_time() - sdw_step_at);
+		if (step != seen) {
+			seen = step;
+			dumped = 0;
+		}
+		if ((s & 1) == 1) {
+			printf("SDW in %s for %llu ms\n", step, in);
+		}
+		if (dumped == 0 && in >= 6000) {
+			sdw_dump(step, false);
+			dumped = 1;
+		} else if (dumped == 1 && in >= 20000) {
+			sdw_dump(step, true);
+			dumped = 2;
+		}
+	}
+}
+
+void
+sweet_shutdown_step(const char *what)
+{
+	uint64_t now = mach_absolute_time();
+	bool first = sdw_start == 0;
+
+	if (first) {
+		sdw_start = now;
+		sdw_thread = current_thread();
+	}
+	sdw_step_at = now;
+	sdw_step = what;
+	printf("SDW step %s at +%llu ms\n", what, sdw_ms(now - sdw_start));
+	if (first) {
+		thread_t thread;
+		if (kernel_thread_start(sdw_watch, NULL, &thread) == KERN_SUCCESS) {
+			thread_deallocate(thread);
+		}
+	}
+}
