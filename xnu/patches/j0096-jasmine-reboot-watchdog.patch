+/*
+ * j0096 reboot watchdog (bsd/dev/sweet_sample.c): state, wait event and a
+ * frame-pointer backtrace of a thread's kernel stack, from the callee-saved
+ * state the last context switch left at the top of the stack (raw addresses:
+ * unslid = address - the slide on the "SDW dump" line). Reads go through
+ * ml_nofault_copy and stay inside the stack, so a thread that runs or exits
+ * meanwhile gives a short or stale line, not a fault.
+ */
+void sweet_sample_kthread(const char *tag, thread_t thread);
+void sweet_sample_ktask(const char *name, int pid, task_t task);
+
+void
+sweet_sample_kthread(const char *tag, thread_t thread)
+{
+	char line[480];
+	int n;
+	vm_offset_t stack = thread->kernel_stack;
+	uint64_t fp = 0;
+
+	n = snprintf(line, sizeof(line), "SDW %s tid %llu state 0x%x pri %d hint %d wait 0x%llx",
+	    tag, thread->thread_id, thread->state, thread->sched_pri, (int)thread->block_hint,
+	    (uint64_t)thread->wait_event);
+	if (thread == current_thread()) {
+		fp = (uint64_t)__builtin_frame_address(0);
+		n += snprintf(line + n, sizeof(line) - n, " (self) bt");
+	} else if (stack == 0) {
+		n += snprintf(line + n, sizeof(line) - n, " no stack, continuation 0x%llx",
+		    (uint64_t)thread->continuation);
+	} else {
+		struct arm_kernel_saved_state ss;
+		if (ml_nofault_copy((vm_offset_t)&thread_get_kernel_state(thread)->machine.ss,
+		    (vm_offset_t)&ss, sizeof(ss)) == sizeof(ss)) {
+			fp = ss.fp;
+			n += snprintf(line + n, sizeof(line) - n, " lr 0x%llx bt", ss.lr);
+		}
+	}
+	for (int i = 0; i < 24 && fp != 0 && (fp & 7) == 0 && n < (int)sizeof(line) - 20; i++) {
+		uint64_t frame[2];
+		if (stack != 0 && (fp < stack || fp + sizeof(frame) > stack + kernel_stack_size)) {
+			break;
+		}
+		if (ml_nofault_copy((vm_offset_t)fp, (vm_offset_t)frame, sizeof(frame)) != sizeof(frame)) {
+			break;
+		}
+		n += snprintf(line + n, sizeof(line) - n, " 0x%llx", frame[1]);
+		if (frame[0] <= fp) {
+			break;
+		}
+		fp = frame[0];
+	}
+	printf("%s\n", line);
+}
+
+void
+sweet_sample_ktask(const char *name, int pid, task_t task)
+{
+	char tag[48];
+	thread_t thread;
+	int tn = 0;
+
+	task_lock(task);
+	queue_iterate(&task->threads, thread, thread_t, task_threads) {
+		snprintf(tag, sizeof(tag), "%s[%d] t%d", name, pid, tn++);
+		sweet_sample_kthread(tag, thread);
+	}
+	task_unlock(task);
+}
+
 #endif /* ARM64_BOARD_CONFIG_SWEET */
 
 kern_return_t
