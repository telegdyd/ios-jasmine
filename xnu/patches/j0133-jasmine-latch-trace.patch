+
+static void
+sweet_fb_trace_dump(const char *why, bool stuck)
+{
+	if (sweet_fb_trace_out_lock == NULL) {
+		return;
+	}
+	IOLockLock(sweet_fb_trace_out_lock);
+	if (sweet_fb_trace_render(sweet_fb_trace_text, sizeof(sweet_fb_trace_text), why) != 0) {
+		char *line = sweet_fb_trace_text;
+		while (*line != 0) {
+			char *nl = strchr(line, '\n');
+			if (nl != NULL) {
+				*nl = 0;
+			}
+			IOLog("%s\n", line);
+			if (nl == NULL) {
+				break;
+			}
+			line = nl + 1;
+		}
+	}
+	IOLockUnlock(sweet_fb_trace_out_lock);
+	(void)stuck;
+}
+
+/* Called without fLock; prints if a queueFallback (or the first stuck SwapWait) asked for it. */
+static void
+sweet_fb_trace_service(void)
+{
+	if (__atomic_exchange_n(&sweet_fb_trace.dump_req, 0, __ATOMIC_RELAXED) != 0) {
+		sweet_fb_trace_dump("queueFallback", false);
+	}
+}
+
+static void
+sweet_fb_trace_stuck(void)
+{
+	if (__atomic_exchange_n(&sweet_fb_trace.stuck_done, 1, __ATOMIC_RELAXED) == 0) {
+		sweet_fb_trace_dump("swapWait stuck", true);
+	}
+}
