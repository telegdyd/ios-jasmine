+static const char *
+sweet_fb_trace_outcome(uint32_t ok)
+{
+	switch (ok) {
+	case SWEET_FB_TR_OUT_QUEUED: return "queued";
+	case SWEET_FB_TR_OUT_SYNC: return "sync";
+	case SWEET_FB_TR_OUT_DIRECT: return "direct";
+	case SWEET_FB_TR_OUT_PENDING: return "pending";
+	case SWEET_FB_TR_OUT_REJECT: return "reject";
+	case SWEET_FB_TR_OUT_ABORT: return "abort";
+	case SWEET_FB_TR_OUT_SYNC_TIMEOUT: return "sync-timeout";
+	case SWEET_FB_TR_OUT_TICKET_FAIL: return "ticket-fail";
+	case SWEET_FB_TR_OUT_LATCH_FAIL: return "latch-fail";
+	default: return "?";
+	}
+}
+
+/*
+ * Formats the last entries (oldest first) and one live-state line. The caller must not hold
+ * fLock; this takes the trace lock, then fLock only for the state line (never at the same time).
+ */
+static size_t
+sweet_fb_trace_render(char *out, size_t len, const char *why)
+{
+	size_t off = 0;
+	unsigned n = 0, first = 0;
+	uint64_t boot = 0;
+#define TADD(...) do { \
+	if (off + 1 < len) { \
+		int r_ = snprintf(out + off, len - off, __VA_ARGS__); \
+		if (r_ > 0) { off += (size_t)r_; if (off >= len) { off = len - 1; } } \
+	} \
+} while (0)
+
+	if (out == NULL || len < 2) {
+		return 0;
+	}
+	out[0] = 0;
+	if (sweet_fb_trace_ready) {
+		uint32_t written = __atomic_load_n(&sweet_fb_trace.write_seq, __ATOMIC_RELAXED);
+		n = written < SWEET_FB_TRACE_ENTRIES ? written : SWEET_FB_TRACE_ENTRIES;
+		first = (written - n) % SWEET_FB_TRACE_ENTRIES;
+		boot = sweet_fb_trace.boot;
+		TADD("SWEET FB: trace: %s: %u entries; t = ms since the first entry; c = GPU completed, "
+		    "s = GPU last submitted seqno\n", why, n);
+		for (unsigned i = 0; i < n; i++) {
+			unsigned slot = (first + i) % SWEET_FB_TRACE_ENTRIES;
+			uint32_t s1 = __atomic_load_n(&sweet_fb_trace.ent_seq[slot], __ATOMIC_ACQUIRE);
+			if (s1 == 0 || (s1 & 1)) {
+				continue;       /* a writer has the slot right now */
+			}
+			struct sweet_fb_trace_ent copy = sweet_fb_trace.ent[slot];
+			__atomic_thread_fence(__ATOMIC_ACQUIRE);
+			if (__atomic_load_n(&sweet_fb_trace.ent_seq[slot], __ATOMIC_RELAXED) != s1) {
+				continue;       /* wrapped under the copy */
+			}
+			struct sweet_fb_trace_ent *e = &copy;
+			unsigned long long ms = boot != 0 && e->t >= boot ? (e->t - boot) / 1000000 : 0;
+			unsigned long long us = boot != 0 && e->t >= boot ? ((e->t - boot) / 1000) % 1000 : 0;
+			switch (e->kind) {
+			case SWEET_FB_TR_BEGIN:
+				TADD("SWEET FB: trace: t=%llu.%03llu BEGIN id=%u ser=%llu ep=%u q=%u pid=%d c=%u s=%u\n",
+				    ms, us, e->id, (unsigned long long)e->serial, e->epoch, e->ok, e->pid,
+				    e->done, e->submit);
+				break;
+			case SWEET_FB_TR_ADMIT:
+				TADD("SWEET FB: trace: t=%llu.%03llu ADMIT id=%u ser=%llu pid=%d %s reason=%u ms=%u "
+				    "cand=%u tok=%u wr=%u avail=%u mask=%#x layers=%u c=%u s=%u\n",
+				    ms, us, e->id, (unsigned long long)e->serial, e->pid,
+				    sweet_fb_trace_outcome(e->ok), e->latch, e->a, e->b, e->c,
+				    e->d & 1u, (e->d >> 1) & 1u, e->flush, e->shown, e->done, e->submit);
+				break;
+			case SWEET_FB_TR_ACCEPT:
+				TADD("SWEET FB: trace: t=%llu.%03llu ACCEPT id=%u ser=%llu ep=%u mode=%s accepted=%u "
+				    "waiting=%u busy=%u q=%u tickets=%#x seq=%u,%u,%u,%u mask=%#x c=%u s=%u\n",
+				    ms, us, e->id, (unsigned long long)e->serial, e->epoch,
+				    e->a == 1 ? "queue" : "sync", e->accepted, e->waiting, e->busy,
+				    e->status, e->b, e->seq[0], e->seq[1], e->seq[2], e->seq[3],
+				    e->mask, e->done, e->submit);
+				break;
+			case SWEET_FB_TR_QP_ENTER:
+				TADD("SWEET FB: trace: t=%llu.%03llu QP-ENTER id=%u ser=%llu ep=%u age=%u ms tickets=%#x "
+				    "seq=%u,%u,%u,%u c=%u s=%u\n",
+				    ms, us, e->id, (unsigned long long)e->serial, e->epoch, e->a, e->b,
+				    e->seq[0], e->seq[1], e->seq[2], e->seq[3], e->done, e->submit);
+				break;
+			case SWEET_FB_TR_QP_TICKET_WAIT:
+				TADD("SWEET FB: trace: t=%llu.%03llu QP-TICKET-WAIT id=%u ser=%llu done=%u wait=%u ms "
+				    "lag=%#x tickets=%#x seq=%u,%u,%u,%u c=%u s=%u\n",
+				    ms, us, e->id, (unsigned long long)e->serial, e->a, e->c, e->b, e->d,
+				    e->seq[0], e->seq[1], e->seq[2], e->seq[3], e->done, e->submit);
+				break;
+			case SWEET_FB_TR_QP_TICKET:
+				TADD("SWEET FB: trace: t=%llu.%03llu QP-TICKET id=%u ser=%llu ready=%u err=%#x wait=%u ms "
+				    "lag=%#x tickets=%#x c=%u s=%u\n",
+				    ms, us, e->id, (unsigned long long)e->serial, e->ok, e->c, e->a, e->b,
+				    e->d, e->done, e->submit);
+				break;
+			case SWEET_FB_TR_QP_LATCH:
+				TADD("SWEET FB: trace: t=%llu.%03llu QP-LATCH id=%u ser=%llu got=%u wait=%u ms pending=%u "
+				    "latch=%u ctl=%#x flush=%#x shown=%u end=%u latched=%llu program=%llu c=%u s=%u\n",
+				    ms, us, e->id, (unsigned long long)e->serial, e->ok, e->a, e->b, e->latch,
+				    e->ctl, e->flush, e->shown, e->end, (unsigned long long)e->latched,
+				    (unsigned long long)e->program, e->done, e->submit);
+				break;
+			case SWEET_FB_TR_QP_PROG:
+				TADD("SWEET FB: trace: t=%llu.%03llu QP-PROG id=%u ser=%llu surf=%u seq=%u pa=%#llx "
+				    "stride=%u ms=%u ctl=%#x c=%u s=%u\n",
+				    ms, us, e->id, (unsigned long long)e->serial, e->b, e->c,
