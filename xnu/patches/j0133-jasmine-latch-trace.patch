+/* "fb trace" (bsd/dev/sweet_usb.c): the command port calls this with no lock held. */
+extern "C" const char *
+sweet_fb_trace_cmd(const char *line)
+{
+	static char reply[SWEET_FB_TRACE_TEXT];
+	if (strcmp(line, "fb trace") != 0) {
+		return NULL;
+	}
+	if (sweet_fb_main == NULL || sweet_fb_trace_render(reply, sizeof(reply), "fb trace") == 0) {
+		return "fb trace: no trace\n";
+	}
+	return reply;
+}
