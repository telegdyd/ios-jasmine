+}
+
+static void
+sweet_fb_trace_qp_exit(AppleCLCD *fb, uint32_t id, uint32_t reason, bool valid, bool ready,
+    bool cancelled, bool quiesced, bool latched, bool epochok, bool terminal, uint64_t ns,
+    uint32_t mask, uint32_t tickets, SweetSurface **held)
+{
+	struct sweet_fb_trace_ent e;
+	sweet_fb_trace_z(&e, SWEET_FB_TR_QP_EXIT, id);
+	e.serial = sweet_fb_trace_serial_for(id);
+	e.a = reason;
+	e.b = (valid ? 1u : 0u) | (ready ? 2u : 0u) | (cancelled ? 4u : 0u) |
+	    (quiesced ? 8u : 0u) | (latched ? 16u : 0u) | (epochok ? 32u : 0u) |
+	    (terminal ? 64u : 0u);
+	e.ok = valid;
+	e.accepted = fb->fAcceptedSerial;
+	e.waiting = fb->fQueueWaiting;
+	e.busy = fb->fPresentBusy;
+	e.status = fb->fQueueActive;
+	e.mask = mask;
+	e.c = tickets << 8;
+	e.d = (uint32_t)(ns / NSEC_PER_MSEC);
+	e.epoch = fb->fEpoch;
+	e.ctl = fb->fCtl0 != NULL ? fb->fCtl0[0x18 / 4] : 0;
+	e.flush = fb->fFlushMask;
+	e.shown = fb->fShownID;
+	e.end = fb->fEndID;
+	e.latch = fb->fLatchID;
+	e.latched = fb->fLatchedSerial;
+	e.program = fb->fProgramSerial;
+	for (unsigned i = 0; i < 4; i++) {
+		e.seq[i] = held != NULL && held[i] != NULL ? held[i]->gpuSeqno : 0;
+	}
+	sweet_fb_trace_put(&e);
+}
