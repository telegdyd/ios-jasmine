+/*
+ * j0133: latch trace (diagnostic only). CoreAnimation's queued swaps are admitted in swap(),
+ * programmed in queuePresent(), and completed in retireLatched() only when the MDP's CTL_FLUSH
+ * bits clear. This ring records those steps so a stuck latch can be read back. Every entry also
+ * carries the GPU's completed seqno and its last submitted seqno. The ring is printed by "fb
+ * trace" (bsd/dev/sweet_usb.c) and automatically on the first swapWait stuck and on queueFallback.
+ * No IOLog happens while the ring or the framebuffer lock is held.
+ */
+#define SWEET_FB_TRACE_ENTRIES  64
+#define SWEET_FB_TRACE_END_SLOTS 16
+#define SWEET_FB_TRACE_TEXT     32768
+
+enum {
+	SWEET_FB_TR_BEGIN = 1,
+	SWEET_FB_TR_ADMIT,
+	SWEET_FB_TR_ACCEPT,
+	SWEET_FB_TR_QP_ENTER,
+	SWEET_FB_TR_QP_TICKET_WAIT,
+	SWEET_FB_TR_QP_TICKET,
+	SWEET_FB_TR_QP_LATCH,
+	SWEET_FB_TR_QP_PROG,
+	SWEET_FB_TR_QP_DROP,
+	SWEET_FB_TR_QP_CANCEL,
+	SWEET_FB_TR_QP_EXIT,
+	SWEET_FB_TR_NOTE,
+	SWEET_FB_TR_RETIRE_WAIT,
+	SWEET_FB_TR_RETIRE_OK,
+	SWEET_FB_TR_FALLBACK,
+	SWEET_FB_TR_PRESENTER,
+	SWEET_FB_TR_WAITLATCH,
+	SWEET_FB_TR_POWER,
+	SWEET_FB_TR_DRAIN,
+};
+
+/* Admission outcomes (the ADMIT line's word). */
+enum {
+	SWEET_FB_TR_OUT_QUEUED = 1,
+	SWEET_FB_TR_OUT_SYNC,
+	SWEET_FB_TR_OUT_DIRECT,
+	SWEET_FB_TR_OUT_PENDING,
+	SWEET_FB_TR_OUT_REJECT,
+	SWEET_FB_TR_OUT_ABORT,
+	SWEET_FB_TR_OUT_SYNC_TIMEOUT,
+	SWEET_FB_TR_OUT_TICKET_FAIL,
+	SWEET_FB_TR_OUT_LATCH_FAIL,
+};
+
+struct sweet_fb_trace_ent {
+	uint64_t t;                     /* mach_absolute_time of the event (SwapEnd time for ADMIT) */
+	uint64_t serial, latched, program, addr;
+	uint32_t done, submit;          /* sweet_gpu_completed(), sweet_gpu_seqno() */
+	uint32_t id, kind;
+	int32_t  pid;
+	uint32_t a, b, c, d;            /* event-specific */
+	uint32_t seq[4];                /* the queued record's per-layer seqno */
+	uint32_t ctl, flush, shown, end, latch, epoch;
+	uint32_t accepted, waiting, busy, status, mask;   /* j0133 follow-up state */
+	uint32_t latchValid;
+	uint8_t  ok;
+};
+
+static struct {
+	struct sweet_fb_trace_ent ent[SWEET_FB_TRACE_ENTRIES];
+	volatile uint32_t ent_seq[SWEET_FB_TRACE_ENTRIES];   /* seqlock stamps: odd = being written */
+	volatile uint32_t write_seq;    /* entries ever written; only bumped atomically */
+	volatile uint32_t end_gen;      /* end-cache updates; only bumped atomically */
+	uint64_t boot;
+	struct {
+		uint32_t id;
+		uint64_t t, serial;
+		bool valid;
+	} end[SWEET_FB_TRACE_END_SLOTS];
+	volatile uint32_t end_seq[SWEET_FB_TRACE_END_SLOTS];
+	volatile uint32_t dump_req;
+	volatile uint32_t stuck_done;
+} sweet_fb_trace;
+
+static char sweet_fb_trace_text[SWEET_FB_TRACE_TEXT];
+
+static void
+sweet_fb_trace_z(struct sweet_fb_trace_ent *e, uint32_t kind, uint32_t id)
+{
+	bzero(e, sizeof(*e));
+	e->kind = kind;
+	e->id = id;
+}
+
+/*
+ * Recording is lock free: one atomic bump reserves a ring slot, the slot is written and then
+ * stamped with an even seqlock value (odd while the write is in progress). Callers may hold
+ * fLock, so this path must never take a sleep lock.
+ */
+static void
+sweet_fb_trace_put(struct sweet_fb_trace_ent *e)
+{
+	if (!sweet_fb_trace_ready) {
+		return;
+	}
+	e->done = sweet_gpu_completed();
+	e->submit = sweet_gpu_seqno();
+	if (e->t == 0) {
+		e->t = mach_absolute_time();
+	}
+	uint32_t seq = __atomic_add_fetch(&sweet_fb_trace.write_seq, 1, __ATOMIC_RELAXED);
+	unsigned slot = (seq - 1) % SWEET_FB_TRACE_ENTRIES;
+	__atomic_store_n(&sweet_fb_trace.ent_seq[slot], seq * 2 - 1, __ATOMIC_RELAXED);
+	__atomic_thread_fence(__ATOMIC_RELEASE);
+	sweet_fb_trace.ent[slot] = *e;
+	__atomic_store_n(&sweet_fb_trace.ent_seq[slot], seq * 2, __ATOMIC_RELEASE);
+	if (sweet_fb_trace.boot == 0) {
+		sweet_fb_trace.boot = e->t;
+	}
+}
+
+/* The id -> SwapEnd-time/serial cache is updated the same lock-free way. */
+static void
+sweet_fb_trace_end_at(uint32_t id, uint64_t t, uint64_t serial)
+{
+	if (!sweet_fb_trace_ready) {
+		return;
+	}
+	uint32_t seq = __atomic_add_fetch(&sweet_fb_trace.end_gen, 1, __ATOMIC_RELAXED);
+	unsigned slot = id % SWEET_FB_TRACE_END_SLOTS;
+	__atomic_store_n(&sweet_fb_trace.end_seq[slot], seq * 2 - 1, __ATOMIC_RELAXED);
+	__atomic_thread_fence(__ATOMIC_RELEASE);
+	if (sweet_fb_trace.end[slot].id != id) {
+		sweet_fb_trace.end[slot].serial = 0;
+	}
+	sweet_fb_trace.end[slot].id = id;
+	if (t != 0) {
+		sweet_fb_trace.end[slot].t = t;
+	}
+	if (serial != 0) {
+		sweet_fb_trace.end[slot].serial = serial;
+	}
+	sweet_fb_trace.end[slot].valid = true;
+	__atomic_store_n(&sweet_fb_trace.end_seq[slot], seq * 2, __ATOMIC_RELEASE);
+}
+
+static bool
+sweet_fb_trace_end_read(unsigned slot, uint32_t id, uint64_t *t, uint64_t *serial)
+{
+	for (unsigned tries = 0; tries < 3; tries++) {
+		uint32_t s1 = __atomic_load_n(&sweet_fb_trace.end_seq[slot], __ATOMIC_ACQUIRE);
+		if (s1 == 0 || (s1 & 1)) {
+			continue;
+		}
+		if (!sweet_fb_trace.end[slot].valid || sweet_fb_trace.end[slot].id != id) {
+			return false;
+		}
+		uint64_t tt = sweet_fb_trace.end[slot].t;
+		uint64_t ss = sweet_fb_trace.end[slot].serial;
+		__atomic_thread_fence(__ATOMIC_ACQUIRE);
+		if (__atomic_load_n(&sweet_fb_trace.end_seq[slot], __ATOMIC_RELAXED) == s1) {
+			if (t != NULL) { *t = tt; }
+			if (serial != NULL) { *serial = ss; }
+			return true;
+		}
+	}
+	return false;
+}
+
+static uint64_t
+sweet_fb_trace_serial_for(uint32_t id)
+{
+	uint64_t serial = 0;
+	if (!sweet_fb_trace_ready) {
+		return 0;
+	}
+	(void)sweet_fb_trace_end_read(id % SWEET_FB_TRACE_END_SLOTS, id, NULL, &serial);
+	return serial;
+}
+
+static uint32_t
+sweet_fb_trace_age_ms(uint32_t id)
+{
+	uint64_t t = 0;
+	if (!sweet_fb_trace_ready) {
+		return 0;
+	}
+	for (unsigned i = 0; i < SWEET_FB_TRACE_END_SLOTS; i++) {
+		if (sweet_fb_trace_end_read(i, id, &t, NULL)) {
+			break;
+		}
+	}
+	if (t == 0 || mach_absolute_time() <= t) {
+		return 0;
+	}
+	uint64_t ns = 0;
+	absolutetime_to_nanoseconds(mach_absolute_time() - t, &ns);
+	return (uint32_t)(ns / NSEC_PER_MSEC);
+}
+
+static void
+sweet_fb_trace_begin(uint32_t id, uint64_t serial, uint32_t epoch, bool queued)
+{
+	struct sweet_fb_trace_ent e;
+	sweet_fb_trace_z(&e, SWEET_FB_TR_BEGIN, id);
+	e.serial = serial;
+	e.epoch = epoch;
+	e.ok = queued;
+	e.pid = proc_selfpid();
+	sweet_fb_trace_put(&e);
+	if (serial != 0) {
+		sweet_fb_trace_end_at(id, 0, serial);
+	}
+}
+
+static void
+sweet_fb_trace_admit(uint32_t id, uint64_t serial, uint32_t epoch, uint32_t outcome,
+    uint32_t reason, uint64_t t0, uint32_t cand, bool token, bool writers, bool available,
+    uint32_t mask, uint32_t layers)
+{
+	struct sweet_fb_trace_ent e;
+	sweet_fb_trace_z(&e, SWEET_FB_TR_ADMIT, id);
+	e.t = t0;
+	e.serial = serial;
+	e.epoch = epoch;
+	e.ok = (uint8_t)outcome;
+	e.latch = reason;
+	e.b = cand;
+	e.c = token;
+	e.d = (writers ? 1u : 0u) | (available ? 2u : 0u);
+	e.flush = mask;
+	e.shown = layers;
+	e.pid = proc_selfpid();
+	if (mach_absolute_time() > t0) {
+		uint64_t ns = 0;
+		absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+		e.a = (uint32_t)(ns / NSEC_PER_MSEC);
+	}
+	sweet_fb_trace_put(&e);
+}
+
+static void
+sweet_fb_trace_accept(AppleCLCD *fb, uint32_t id, uint64_t serial, uint32_t epoch, uint32_t mask,
+    SweetSurface **held, bool queued)
+{
+	struct sweet_fb_trace_ent e;
+	sweet_fb_trace_z(&e, SWEET_FB_TR_ACCEPT, id);
+	e.serial = serial;
+	e.epoch = epoch;
+	e.mask = mask;
+	e.a = queued ? 1 : 2;
+	e.accepted = fb->fAcceptedSerial;
+	e.waiting = fb->fQueueWaiting;
+	e.busy = fb->fPresentBusy;
+	e.status = fb->fQueueActive;
+	e.ctl = fb->fCtl0 != NULL ? fb->fCtl0[0x18 / 4] : 0;
+	e.flush = fb->fFlushMask;
+	e.shown = fb->fShownID;
+	e.end = fb->fEndID;
+	e.latch = fb->fLatchID;
+	e.latched = fb->fLatchedSerial;
+	e.program = fb->fProgramSerial;
+	for (unsigned i = 0; i < 4; i++) {
+		e.seq[i] = held != NULL && held[i] != NULL ? held[i]->gpuSeqno : 0;
+		if (held != NULL && held[i] != NULL && held[i]->renderTicket != NULL) {
+			e.b |= 1u << i;
+		}
+	}
+	sweet_fb_trace_put(&e);
+	sweet_fb_trace_end_at(id, 0, serial);
+}
+
+static void
+sweet_fb_trace_presenter(AppleCLCD *fb, uint32_t phase)
+{
+	struct sweet_fb_trace_ent e;
+	sweet_fb_trace_z(&e, SWEET_FB_TR_PRESENTER, 0);
+	e.a = phase;
+	if (fb != NULL) {
+		/* Read-only, best effort: the trace must never take fLock. */
+		e.ok = fb->fProtocol;
+		e.epoch = fb->fEpoch;
+		e.accepted = fb->fAcceptedSerial;
+		e.waiting = fb->fQueueWaiting;
+		e.busy = fb->fPresentBusy;
+		e.status = fb->fSerial;
+		e.shown = fb->fShownID;
+		e.end = fb->fEndID;
+		e.latch = fb->fLatchID;
+		e.latched = fb->fLatchedSerial;
+		e.program = fb->fProgramSerial;
+		e.b = (fb->fQueueWaiting ? 1u : 0u) | (fb->fPresentBusy ? 2u : 0u);
+	}
+	sweet_fb_trace_put(&e);
+}
+
+static void
+sweet_fb_trace_ticket_wait(uint32_t id, uint32_t done, uint32_t lag, uint32_t tickets,
+    const uint32_t seq[4], uint64_t ns)
+{
+	struct sweet_fb_trace_ent e;
+	sweet_fb_trace_z(&e, SWEET_FB_TR_QP_TICKET_WAIT, id);
+	e.serial = sweet_fb_trace_serial_for(id);
+	e.a = done;
+	e.b = lag;
+	e.d = tickets;
+	uint64_t elapsed = 0;
+	absolutetime_to_nanoseconds(ns, &elapsed);
+	e.c = (uint32_t)(elapsed / NSEC_PER_MSEC);
+	for (unsigned i = 0; i < 4; i++) {
+		e.seq[i] = seq[i];
+	}
+	sweet_fb_trace_put(&e);
+}
