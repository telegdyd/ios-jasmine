+static void
+sweet_fb_trace_power(AppleCLCD *fb, bool off, uint32_t phase, bool changed, bool owned, IOReturn ret)
+{
+	struct sweet_fb_trace_ent e;
+	sweet_fb_trace_z(&e, SWEET_FB_TR_POWER, 0);
+	e.a = phase;
+	e.ok = off;
+	e.b = (changed ? 1u : 0u) | (owned ? 2u : 0u);
+	e.status = (uint32_t)ret;
+	/* Read-only, best effort: the trace must never take fLock. */
+	e.epoch = fb->fEpoch;
+	e.accepted = fb->fAcceptedSerial;
+	e.waiting = fb->fQueueWaiting;
+	e.busy = fb->fPresentBusy;
+	e.mask = fb->fPowerOff;
+	e.shown = fb->fShownID;
+	e.end = fb->fEndID;
+	e.latch = fb->fLatchID;
+	e.latched = fb->fLatchedSerial;
+	e.program = fb->fProgramSerial;
+	e.latchValid = fb->fLatchValid ? 1u : 0u;
+	e.ctl = fb->fCtl0 != NULL ? fb->fCtl0[0x18 / 4] : 0;
+	e.flush = fb->fFlushMask;
+	e.c = fb->fQueueActive;
+	e.d = sweet_ticket_suspended ? 1u : 0u;
+	e.seq[2] = (uint32_t)sweet_render_epoch;
+	for (unsigned i = 0; i < 128; i++) {
+		if (fb->fTokens[i].owner != NULL) {
+			e.seq[0]++;
+		}
+	}
+	for (unsigned i = 0; i < 4; i++) {
+		if (fb->fQueueTicket[i] != NULL) {
+			e.seq[1]++;
+		}
+	}
+	sweet_fb_trace_put(&e);
+}
+
+static void
+sweet_fb_trace_drain(AppleCLCD *fb, uint32_t phase, uint64_t ns)
+{
+	struct sweet_fb_trace_ent e;
+	sweet_fb_trace_z(&e, SWEET_FB_TR_DRAIN, 0);
+	e.a = phase;
+	uint64_t elapsed = 0;
+	absolutetime_to_nanoseconds(ns, &elapsed);
+	e.d = (uint32_t)(elapsed / NSEC_PER_MSEC);
+	/* Read-only, best effort: the trace must never take fLock. */
+	e.b = fb->fPresentBusy;
+	e.waiting = fb->fQueueWaiting;
+	e.accepted = fb->fAcceptedSerial;
+	e.latchValid = fb->fLatchValid ? 1u : 0u;
+	e.latch = fb->fLatchID;
+	e.ctl = fb->fCtl0 != NULL ? fb->fCtl0[0x18 / 4] : 0;
+	e.flush = fb->fFlushMask;
+	sweet_fb_trace_put(&e);
+}
