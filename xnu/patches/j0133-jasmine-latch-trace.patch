+	sweet_fb_trace_z(&e, kind, id);
+	e.serial = sweet_fb_trace_serial_for(id);
+	e.a = (uint32_t)(ns / NSEC_PER_MSEC);
+	e.b = retry;
+	e.ctl = ctl;
+	e.flush = fb->fFlushMask;
+	e.latch = id;
+	e.shown = fb->fShownID;
+	e.end = fb->fEndID;
+	e.latched = fb->fLatchedSerial;
+	e.program = fb->fProgramSerial;
+	e.epoch = fb->fEpoch;
+	e.c = fb->fQueueActive;
+	e.d = fb->fLatchValid;
+	e.ok = kind == SWEET_FB_TR_RETIRE_OK ? ((ctl & fb->fFlushMask) == 0) :
+	    ((fb->fLatchValid || fb->fLatchID != 0) ? 1 : 0);
+	sweet_fb_trace_put(&e);
+}
