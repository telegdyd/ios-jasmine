--- a/iokit/Kernel/IOMemoryDescriptor.cpp
+++ b/iokit/Kernel/IOMemoryDescriptor.cpp
@@ -109,6 +109,24 @@ static IORecursiveLock * gIOMemoryLock;
 
 #define LOCK    IORecursiveLockLock( gIOMemoryLock)
 #define UNLOCK  IORecursiveLockUnlock( gIOMemoryLock)
+
+/*
+ * j0099 (bsd/dev/sweet_sample.c reboot watchdog): the thread that holds
+ * gIOMemoryLock (j97-aj2: two surface closes waited 30 s for it), or 0.
+ */
+extern "C" thread_t sweet_iorecursivelock_owner(IORecursiveLock *lock, UInt32 *count);
+extern "C" uint64_t thread_tid(thread_t thread);
+extern "C" uint64_t sweet_iomemory_lock_owner(uint32_t *count);
+
+uint64_t
+sweet_iomemory_lock_owner(uint32_t *count)
+{
+	UInt32 held = 0;
+	thread_t owner = gIOMemoryLock != NULL ? sweet_iorecursivelock_owner(gIOMemoryLock, &held) : NULL;
+
+	*count = held;
+	return owner != NULL ? thread_tid(owner) : 0;
+}
 #define SLEEP   IORecursiveLockSleep( gIOMemoryLock, (void *)this, THREAD_UNINT)
 #define WAKEUP  \
     IORecursiveLockWakeup( gIOMemoryLock, (void *)this, /* one-thread */ false)
