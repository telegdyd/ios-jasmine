 extern "C" uint32_t sweet_gpu_completed(void);
 
+bool
+sweet_surface_pin(SweetSurface *s)
+{
+	if (!s->wrapped) {
+		return true;
+	}
+	if (s->memory == NULL || s->memory->prepare() != kIOReturnSuccess) {
+		return false;
+	}
+	OSIncrementAtomic(&sweet_surface_pins);
+	return true;
+}
+
+void
+sweet_surface_unpin(SweetSurface *s)
+{
+	if (s->wrapped) {
+		s->memory->complete();
+		OSDecrementAtomic(&sweet_surface_pins);
+	}
+}
+
+/*
+ * j0099 reboot watchdog (bsd/dev/sweet_sample.c): how much client memory is wired
+ * at the RootUnmount step and in each stall dump. Only the GPU's wires are left;
+ * with none, a surface free cannot be what a VM object's destroy waits for.
+ */
+extern "C" void sweet_surface_pinned_note(const char *when);
+
+void
+sweet_surface_pinned_note(const char *when)
+{
+	printf("SDW pinned client memory (%s): %d wrapped surfaces alive, wired by %d GPU imports and %d pins\n",
+	    when, sweet_surface_wraps, sweet_gpu_wrapped_imports, sweet_surface_pins);
+}
+
