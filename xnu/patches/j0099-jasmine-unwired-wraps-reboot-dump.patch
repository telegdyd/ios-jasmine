diff --git a/osfmk/vm/vm_object.c b/osfmk/vm/vm_object.c
index fa256e6..feb9723 100644
--- a/osfmk/vm/vm_object.c
+++ b/osfmk/vm/vm_object.c
@@ -8501,3 +8501,45 @@ again:
 
 	task_objq_unlock(task);
 }
+
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+/*
+ * j0099 reboot watchdog (bsd/dev/sweet_sample.c, osfmk/kern/exception.c): a
+ * thread that sleeps on a VM object event (vm_object_sleep: the object's
+ * address + the event number) gets the object's counts and pager in the dump.
+ * j97-aj2: vm_object_destroy and the object reaper waited for
+ * paging_in_progress/activity_in_progress to drop and nobody said who held
+ * them. Unlocked reads of a zone element: a snapshot. 0: not a VM object event.
+ */
+extern bool zone_owns(zone_t zone, void *addr);
+extern vm_size_t ml_nofault_copy(vm_offset_t virtsrc, vm_offset_t virtdst, vm_size_t size);
+int sweet_vm_object_note(event64_t event, char *out, size_t len);
+
+int
+sweet_vm_object_note(event64_t event, char *out, size_t len)
+{
+	vm_offset_t ev = (vm_offset_t)event;
+	vm_offset_t idx = ev & (VM_PAGE_PACKED_PTR_ALIGNMENT - 1);
+	vm_object_t object = (vm_object_t)(ev - idx);
+	const char *name = "none";
+
+	if (ev == 0 || idx > VM_OBJECT_EVENT_MAX || !zone_owns(vm_object_zone, (void *)object)) {
+		return 0;
+	}
+	memory_object_t pager = object->pager;
+	if (pager != MEMORY_OBJECT_NULL) {
+		const struct memory_object_pager_ops *ops = NULL;
+		const char *pn = NULL;
+		name = "?";
+		if (ml_nofault_copy((vm_offset_t)&pager->mo_pager_ops, (vm_offset_t)&ops, sizeof(ops)) == sizeof(ops) &&
+		    ops != NULL &&
+		    ml_nofault_copy((vm_offset_t)&ops->memory_object_pager_name, (vm_offset_t)&pn, sizeof(pn)) == sizeof(pn) &&
+		    pn != NULL) {
+			name = pn;
+		}
+	}
+	return snprintf(out, len, " vm object %p event %lu refs %d paging %u activity %u pager %s contig %d private %d named %d",
+	    object, (unsigned long)idx, object->ref_count, (unsigned)object->paging_in_progress,
+	    object->activity_in_progress, name, object->phys_contiguous, object->private, object->named);
+}
