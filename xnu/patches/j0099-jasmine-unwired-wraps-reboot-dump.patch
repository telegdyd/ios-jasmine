 /*
- * Make s's pixels the memory a task has already at address (size bytes): the
- * range is prepared (wired) for as long as the surface lives, and every task
- * that looks the surface up maps those same pages.
+ * Make s's pixels the memory a task has already at address (size bytes): every
+ * task that looks the surface up maps those same pages.
+ *
+ * j0099: not wired for the surface's life any more. The range is prepared once
+ * as the check (writable if it can be, else read-only) and completed again; the
+ * descriptor is persistent, so its memory entries hold the pages from here on,
+ * also once the task unmaps them. Wired, the range kept an activity count on
+ * the task's VM object that only this surface's free dropped, and every way to
+ * that free releases an IOMemoryMap first, which takes IOKit's global memory
+ * lock. j97-aj2's reboot stalled 30 s like that: backboardd's and SpringBoard's
+ * surface closes waited for the lock while a kernel thread sat in
+ * vm_object_destroy (under the lock, as IOKit destroys VM objects) waiting for
+ * such a count. GPU users wire the range while they use it (SweetGPUBuffer::
+ * import, sweet_surface_pin).
  */
 static IOReturn
 sweet_surface_use_task_memory(SweetSurface *s, task_t task, uint64_t address, uint64_t size)
@@ -1164,13 +1179,16 @@ sweet_surface_use_task_memory(SweetSurface *s, task_t task, uint64_t address, ui
 	/* writable if it can be; a picture that is only shown may be read-only memory */
 	for (attempt = 0; attempt < 2 && held != kIOReturnSuccess; attempt++) {
 		OSSafeReleaseNULL(md);
-		md = IOMemoryDescriptor::withAddressRange(first, length, attempt == 0 ? kIODirectionInOut : kIODirectionOut, task);
+		md = IOMemoryDescriptor::withAddressRange(first, length,
+		    (attempt == 0 ? kIODirectionInOut : kIODirectionOut) | kIOMemoryPersistent, task);
 		held = md != NULL ? md->prepare() : kIOReturnNoMemory;
 	}
 	if (held != kIOReturnSuccess) {
 		OSSafeReleaseNULL(md);
 		return kIOReturnVMError;
 	}
+	md->complete();
+	OSIncrementAtomic(&sweet_surface_wraps);
 	s->memory = md;
 	s->wrapped = true;
 	s->readOnly = attempt == 2;
@@ -1628,6 +1646,42 @@ extern "C" void sweet_gpu_flush_all(void);
