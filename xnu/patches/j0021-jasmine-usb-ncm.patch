+		return 0;
+	}
+	usb_dwc_pa = reg[0];
+	usb_qs_pa = reg[2];
+	usb_phy_pa = reg[4];
+	usb_gcc_pa = reg[6];
+	usb_gdscr = gcc[0];
+	for (unsigned i = 0; i < sizeof(usb_cbcr) / sizeof(usb_cbcr[0]); i++) {
+		usb_cbcr[i].off = gcc[1 + i];
+	}
+	usb_from_dt = true;
+	return 1;
