+
+/*
+ * NCM transfer blocks (CDC NCM 1.0, 16-bit): an NTH16 header ("NCMH"), an
+ * NDP16 ("NCM0") listing (index, length) of each datagram, the Ethernet
+ * frames. Both directions are limited to 2 KiB blocks (the RX buffer).
+ */
+#define NCM_NTB_MAX     2048
+#define NCM_NTH16_SIG   0x484d434eu     /* "NCMH" */
+#define NCM_NDP16_SIG   0x304d434eu     /* "NCM0", no CRC */
+#define NCM_TX_HDR      28              /* NTH16 12 + NDP16 8 + one entry + terminator */
+
+static inline uint32_t ld16(const uint8_t *p) { return (uint32_t)p[0] | (uint32_t)p[1] << 8; }
+static inline uint32_t ld32(const uint8_t *p) { return ld16(p) | ld16(p + 2) << 16; }
+static inline void st16(uint8_t *p, uint32_t v) { p[0] = (uint8_t)v; p[1] = (uint8_t)(v >> 8); }
+static inline void st32(uint8_t *p, uint32_t v) { st16(p, v); st16(p + 2, v >> 16); }
+
+/* GET_NTB_PARAMETERS reply (28 bytes) */
+static uint32_t
+ncm_ntb_params(uint8_t *d)
+{
+	bzero(d, 28);
+	st16(d + 0, 28);                /* wLength */
+	st16(d + 2, 1);                 /* bmNtbFormatsSupported: NTB-16 */
+	st32(d + 4, NCM_NTB_MAX);       /* dwNtbInMaxSize (phone -> host) */
+	st16(d + 8, 4);                 /* wNdpInDivisor */
+	st16(d + 12, 4);                /* wNdpInAlignment */
+	st32(d + 16, NCM_NTB_MAX);      /* dwNtbOutMaxSize (host -> phone) */
+	st16(d + 20, 4);                /* wNdpOutDivisor */
+	st16(d + 24, 4);                /* wNdpOutAlignment */
+	return 28;                      /* wNtbOutMaxDatagrams 0: no limit */
+}
