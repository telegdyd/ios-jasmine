From 41b84d76fb7a0d2ba4d97207a9e2028d6e10ff8e Mon Sep 17 00:00:00 2001
From: telegdyd <telegdyd93@gmail.com>
Date: Sat, 24 Oct 2026 23:52:12 +0200
Subject: [PATCH] jasmine-j0087: the USB link survives Wi-Fi: scoped routes for
 ue0 (192.168.7/24, 169.254/16), the log/command/file listeners bound to ue0
 (j86-wlan: silent once en0 had its address; also keeps them off the Wi-Fi
 network)

---
 bsd/dev/sweet_netfs.c |  5 +++-
 bsd/dev/sweet_usb.c   | 54 +++++++++++++++++++++++++++++++++++++++++--
 2 files changed, 56 insertions(+), 3 deletions(-)

diff --git a/bsd/dev/sweet_netfs.c b/bsd/dev/sweet_netfs.c
index d1aaa32..ec06733 100644
--- a/bsd/dev/sweet_netfs.c
+++ b/bsd/dev/sweet_netfs.c
@@ -39,6 +39,8 @@
 #include <libkern/libkern.h>
 #include <stdbool.h>
 
+bool sweet_usb_bind_listener(socket_t ls);   /* sweet_usb.c (j0087): ue0 only */
+
 extern kern_return_t kernel_thread_start(thread_continue_t, void *, thread_t *);
 extern void thread_deallocate(thread_t);
 extern int unlink1(vfs_context_t, vnode_t, user_addr_t, enum uio_seg, int);
@@ -391,7 +393,8 @@ netfs_thread(void *arg __unused, wait_result_t wr __unused)
 			continue;
 		}
 		(void)sock_setsockopt(ls, SOL_SOCKET, SO_REUSEADDR, &on, sizeof(on));
-		if (sock_bind(ls, (struct sockaddr *)&me) != 0 || sock_listen(ls, 1) != 0) {
+		if (!sweet_usb_bind_listener(ls) ||
+		    sock_bind(ls, (struct sockaddr *)&me) != 0 || sock_listen(ls, 1) != 0) {
 			sock_close(ls);
 			ls = NULL;
 		}
diff --git a/bsd/dev/sweet_usb.c b/bsd/dev/sweet_usb.c
index e4936f2..6fecef2 100755
--- a/bsd/dev/sweet_usb.c
+++ b/bsd/dev/sweet_usb.c
@@ -40,6 +40,7 @@
 #include <net/ether_if_module.h>
 #include <net/kpi_interface.h>
 #include <net/kpi_protocol.h>
+#include <net/route_private.h>
 #include <netinet/in.h>
 #include <sys/socketvar.h>
 #include <netinet/in_pcb.h>
@@ -899,6 +900,49 @@ ud_if_detach(ifnet_t ifp __unused)
 {
 }
 
+/*
+ * j0087: the USB link keeps working while Wi-Fi is up. configd makes en0 the primary interface and
+ * gives it the unscoped 169.254/16 route (as on a Mac: "169.254 link#N UCS en0"); ue0, which configd
+ * does not know, is left with no route to the PC's link-local address, and the log, command and file
+ * ports went silent once en0 had its address (j86-wlan). So ue0 gets scoped routes of its own for both
+ * of its subnets (XNU makes none for an interface address), and the servers' listening sockets are bound
+ * to ue0 (IP_BOUND_IF, which accepted connections inherit): they use those routes, and they are not
+ * reachable from the Wi-Fi network.
+ */
+static void
+ud_scoped_route(uint32_t net, uint32_t mask, uint32_t addr)
+{
+	struct sockaddr_in dst, msk, gw;
+	bzero(&dst, sizeof(dst));
+	dst.sin_len = sizeof(dst);
+	dst.sin_family = AF_INET;
+	msk = gw = dst;
+	dst.sin_addr.s_addr = htonl(net);
+	msk.sin_addr.s_addr = htonl(mask);
+	gw.sin_addr.s_addr = htonl(addr);              /* ue0's own address: an interface route, as rtinit */
+	int e = rtrequest_scoped(RTM_ADD, (struct sockaddr *)&dst, (struct sockaddr *)&gw, (struct sockaddr *)&msk,
+	    RTF_UP | RTF_CLONING | RTF_STATIC, NULL, ifnet_index(ud.ifp));
+	printf("SWEET USB: ue0 scoped route %u.%u.%u.%u/%u: %d\n", net >> 24, (net >> 16) & 255, (net >> 8) & 255,
+	    net & 255, (unsigned)__builtin_popcount(mask), e);
+}
+
+/* ue0's interface index for IP_BOUND_IF, 0 while there is none */
+int sweet_usb_ifindex(void);
+int
+sweet_usb_ifindex(void)
+{
+	return ud.ifp != NULL ? (int)ifnet_index(ud.ifp) : 0;
+}
+
+/* bind a listening socket to ue0 before sock_bind(); false: no ue0 yet (or the option failed) */
+bool sweet_usb_bind_listener(socket_t ls);
+bool
+sweet_usb_bind_listener(socket_t ls)
+{
+	int idx = sweet_usb_ifindex();
+	return idx != 0 && sock_setsockopt(ls, IPPROTO_IP, IP_BOUND_IF, &idx, sizeof(idx)) == 0;
+}
+
 /* ue0, 192.168.7.2/24 (the host side is 192.168.7.1). */
 static void
 ud_if_create(void)
@@ -983,6 +1027,10 @@ ud_if_create(void)
 	}
 	ifnet_set_flags(ud.ifp, IFF_UP | IFF_RUNNING, IFF_UP | IFF_RUNNING);
 	printf("SWEET USB: ue0 192.168.7.2/24 + 169.254.7.2/16 %s (err %d)\n", err ? "NOT configured" : "up", err);
+	if (err == 0) {
+		ud_scoped_route(0xc0a80700, 0xffffff00, 0xc0a80702);
+		ud_scoped_route(0xa9fe0000, 0xffff0000, 0xa9fe0702);
+	}
 }
 
 static void
@@ -1119,7 +1167,8 @@ ud_log_thread(void *arg __unused, wait_result_t wr __unused)
 			continue;
 		}
 		(void)sock_setsockopt(ls, SOL_SOCKET, SO_REUSEADDR, &on, sizeof(on));
-		if (sock_bind(ls, (struct sockaddr *)&me) != 0 || sock_listen(ls, 1) != 0) {
+		if (!sweet_usb_bind_listener(ls) ||
+		    sock_bind(ls, (struct sockaddr *)&me) != 0 || sock_listen(ls, 1) != 0) {
 			sock_close(ls);
 			ls = NULL;
 		}
@@ -1482,7 +1531,8 @@ ud_cmd_thread(void *arg __unused, wait_result_t wr __unused)
 			continue;
 		}
 		(void)sock_setsockopt(ls, SOL_SOCKET, SO_REUSEADDR, &on, sizeof(on));
-		if (sock_bind(ls, (struct sockaddr *)&me) != 0 || sock_listen(ls, 1) != 0) {
+		if (!sweet_usb_bind_listener(ls) ||
+		    sock_bind(ls, (struct sockaddr *)&me) != 0 || sock_listen(ls, 1) != 0) {
 			sock_close(ls);
 			ls = NULL;
 		}
-- 
