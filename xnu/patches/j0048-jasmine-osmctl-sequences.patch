From 0ec223ee6286517b5610cd10ba0e6df6129af38b Mon Sep 17 00:00:00 2001
From: telegdyd <telegdyd93@gmail.com>
Date: Thu, 22 Oct 2026 15:44:23 +0200
Subject: [PATCH] jasmine-j0048: osmctl sequences (m, poll, d, t, rep) so
 experiments need no kernel build

Every hardware question so far cost one XNU CI build, and the macOS
runner queue made that 10-30+ minutes each. The live tool now runs whole
register sequences in the kernel, back to back within one command line:
  m ADDR MASK VAL          read-modify-write
  poll ADDR MASK VAL [US]  wait for a value; a timeout skips the rest of the line
  d US / t                 delay / microseconds since the line started
  rep N                    run the rest of the line N times (stops at a failed poll)
Same address whitelist as r / w. The command port takes 2 KiB lines and
returns up to 8 KiB (sent in full); output past that is dropped and counted.
---
 bsd/dev/sweet_usb.c     |  15 +++--
 osfmk/arm64/sweet_osm.c | 126 +++++++++++++++++++++++++++++++++++++---
 2 files changed, 128 insertions(+), 13 deletions(-)

diff --git a/bsd/dev/sweet_usb.c b/bsd/dev/sweet_usb.c
index 3a431ef..dd344e9 100755
--- a/bsd/dev/sweet_usb.c
+++ b/bsd/dev/sweet_usb.c
@@ -1457,7 +1457,7 @@ ud_panic_test_thread(void *arg, wait_result_t wr __unused)
  * Boot-arg sweetusbcmd=0 disables the port.
  */
 extern int sweet_osm_cmd(char *line, char *out, size_t len);
-static char ud_cmd_line[512], ud_cmd_reply[2048];
+static char ud_cmd_line[2048], ud_cmd_reply[8192];
 static void
 ud_cmd_thread(void *arg __unused, wait_result_t wr __unused)
 {
@@ -1519,10 +1519,15 @@ ud_cmd_thread(void *arg __unused, wait_result_t wr __unused)
 		if (!reboot && sweet_osm_cmd(line, ud_cmd_reply, sizeof(ud_cmd_reply))) {
 			reply = ud_cmd_reply;
 		}
-		struct iovec iov = { .iov_base = (void *)(uintptr_t)reply, .iov_len = strlen(reply) };
-		struct msghdr msg = { .msg_iov = &iov, .msg_iovlen = 1 };
-		size_t sent = 0;
-		(void)sock_send(cs, &msg, 0, &sent);
+		for (size_t off = 0, rl = strlen(reply); off < rl;) {
+			struct iovec iov = { .iov_base = (void *)(uintptr_t)(reply + off), .iov_len = rl - off };
+			struct msghdr msg = { .msg_iov = &iov, .msg_iovlen = 1 };
+			size_t sent = 0;
+			if (sock_send(cs, &msg, 0, &sent) != 0 || sent == 0) {
+				break;
+			}
+			off += sent;
+		}
 		sock_close(cs);
 		if (reboot) {
 			printf("SWEET USB: reboot requested over the command port\n");
diff --git a/osfmk/arm64/sweet_osm.c b/osfmk/arm64/sweet_osm.c
index a4c6268..9e2fd0b 100755
--- a/osfmk/arm64/sweet_osm.c
+++ b/osfmk/arm64/sweet_osm.c
@@ -1206,6 +1206,14 @@ osm_phase2(void)
  *                  kernel reference's, tools/cpuclk/refinit.c) in the ramoops region at 0xa0000000
  *   spmi SID ADDR [N]  read N PMIC registers (SIDs 0-3, read-only)
  *   rails          PM660 S1-S3 (the APC supplies): set point, valid voltage, mode, limit
+ * Sequences (j0048), so an experiment is a command line instead of a kernel build. One
+ * line runs back to back in the kernel, without network round trips in between:
+ *   m ADDR MASK VAL      read-modify-write: (old & ~MASK) | (VAL & MASK)
+ *   poll ADDR MASK VAL [US]  wait until (read & MASK) == VAL (default 1000 us, max 1 s);
+ *                        on a timeout the rest of the line is skipped
+ *   d US                 delay (max 100 ms)           t     microseconds since the line started
+ *   rep N                run the rest of the line N times (max 100000); stops at a failed poll;
+ *                        output that no longer fits the reply is dropped and counted
  * Direct accesses only inside the blocks this work touches (osm_ok()); a read of
  * an unimplemented offset can still SError (the panic then goes out on the live
  * log and the phone resets into fastboot). Every write goes through a register
@@ -1282,12 +1290,16 @@ osm_num(const char *s)                          /* 0x... hex or decimal */
 
 extern int sweet_pmic_peek(uint32_t sid, uint32_t addr, unsigned n, uint32_t *out);   /* bsd/dev/sweet_pmic.c */
 
+static int osm_abort;                   /* a failed poll skips the rest of the line */
+static int osm_quiet;                   /* inside "rep": no log line per write */
+static uint64_t osm_line_t0;
+
 static int
 osm_cmd_one(char *cmd, char *out, size_t len)
 {
-	char *argv[4];
+	char *argv[6];
 	int argc = 0;
-	for (char *p = cmd; *p && argc < 4;) {
+	for (char *p = cmd; *p && argc < 6;) {
 		while (*p == ' ') {
 			p++;
 		}
@@ -1325,9 +1337,60 @@ osm_cmd_one(char *cmd, char *out, size_t len)
 		volatile uint32_t *p = osm_ptr(a);
 		osm_wr(p, 0, (uint32_t)b);
 		__asm__ volatile ("dsb sy" ::: "memory");
-		printf("SWEET OSM: ctl w %#llx %#llx\n", a, b);
+		if (!osm_quiet) {
+			printf("SWEET OSM: ctl w %#llx %#llx\n", a, b);
+		}
 		return snprintf(out, len, "%#llx <- %#llx, reads %08x\n", a, b, *p);
 	}
+	if (!strcmp(c, "m") && argc == 4) {
+		if (!osm_ok(a)) {
+			osm_abort = 1;
+			return snprintf(out, len, "m %#llx: refused (rest of line skipped)\n", a);
+		}
+		volatile uint32_t *p = osm_ptr(a);
+		uint32_t old = *p, nv = (old & ~(uint32_t)b) | ((uint32_t)osm_num(argv[3]) & (uint32_t)b);
+		osm_wr(p, 0, nv);
+		__asm__ volatile ("dsb sy" ::: "memory");
+		if (!osm_quiet) {
+			printf("SWEET OSM: ctl m %#llx %08x -> %08x\n", a, old, nv);
+		}
+		return snprintf(out, len, "%#llx: %08x -> %08x, reads %08x\n", a, old, nv, *p);
+	}
+	if (!strcmp(c, "poll") && argc >= 4) {
+		if (!osm_ok(a)) {
+			osm_abort = 1;
+			return snprintf(out, len, "poll %#llx: refused (rest of line skipped)\n", a);
+		}
+		volatile uint32_t *p = osm_ptr(a);
+		uint32_t mask = (uint32_t)b, want = (uint32_t)osm_num(argv[3]), v = 0;
+		uint64_t limit = argc > 4 ? osm_num(argv[4]) : 1000, ns, t0 = mach_absolute_time();
+		if (limit > 1000000) {
+			limit = 1000000;
+		}
+		for (;;) {
+			v = *p;
+			absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+			if ((v & mask) == want || ns / 1000 >= limit) {
+				break;
+			}
+			delay(1);
+		}
+		if ((v & mask) != want) {
+			osm_abort = 1;
+			return snprintf(out, len, "poll %#llx: TIMEOUT after %llu us, reads %08x (rest of line skipped)\n",
+			           a, ns / 1000, v);
+		}
+		return snprintf(out, len, "poll %#llx: %08x after %llu us\n", a, v, ns / 1000);
+	}
+	if (!strcmp(c, "d") && argc == 2) {
+		delay((int)(a > 100000 ? 100000 : a));
+		return 0;
+	}
+	if (!strcmp(c, "t")) {
+		uint64_t ns;
+		absolutetime_to_nanoseconds(mach_absolute_time() - osm_line_t0, &ns);
+		return snprintf(out, len, "t %llu us\n", ns / 1000);
+	}
 	if (!strcmp(c, "tr") && argc == 2) {
 		uint64_t r = 0, st = osm_scm1(SCM_FAST_FN(SCM_SVC_IO, SCM_IO_READ), a, &r);
 		return snprintf(out, len, "tz %#llx: st %#llx val %#llx\n", a, st, r);
@@ -1474,7 +1537,22 @@ osm_cmd_one(char *cmd, char *out, size_t len)
 		}
 		return k;
 	}
-	return snprintf(out, len, "%s: ? (r w tr tw check tsens state table prog ramoops spmi rails)\n", c);
+	return snprintf(out, len, "%s: ? (r w m poll d t rep tr tw check tsens state table prog ramoops spmi rails)\n", c);
+}
+
+/* One command; once the reply has no room left its output goes to a scratch buffer and is counted. */
+static void
+osm_run(char *cmd, char *out, size_t len, size_t *k, uint32_t *dropped)
+{
+	static char drop[1024];
+	if (*k + 600 < len) {
+		int n = osm_cmd_one(cmd, out + *k, len - *k);
+		if (n > 0) {
+			*k += (size_t)n < len - *k ? (size_t)n : len - *k - 1;
+		}
+	} else if (osm_cmd_one(cmd, drop, sizeof(drop)) > 0) {
+		(*dropped)++;
+	}
 }
 
 /* bsd/dev/sweet_usb.c command port: line in, reply out; 0 = not ours (no sweetosm) */
@@ -1487,18 +1565,50 @@ sweet_osm_cmd(char *line, char *out, size_t len)
 		return 0;
 	}
 	size_t k = 0;
+	uint32_t dropped = 0;
 	out[0] = 0;
-	for (char *cmd = line; cmd && k < len - 1;) {
+	osm_abort = 0;
+	osm_quiet = 0;
+	osm_line_t0 = mach_absolute_time();
+	for (char *cmd = line; cmd && !osm_abort;) {
 		char *next = strchr(cmd, ';');
 		if (next) {
 			*next++ = 0;
 		}
-		int n = osm_cmd_one(cmd, out + k, len - k);
-		if (n > 0) {
-			k += (size_t)n < len - k ? (size_t)n : len - k - 1;
+		while (*cmd == ' ') {
+			cmd++;
 		}
+		if (!strncmp(cmd, "rep ", 4)) {
+			static char body[2048];
+			uint64_t n = osm_num(cmd + 4), i;
+			if (n > 100000) {
+				n = 100000;
+			}
+			if (!next || strlen(next) >= sizeof(body)) {
+				break;
+			}
+			osm_quiet = 1;
+			for (i = 0; i < n && !osm_abort; i++) {
+				strlcpy(body, next, sizeof(body));
+				for (char *c2 = body; c2 && !osm_abort;) {
+					char *n2 = strchr(c2, ';');
+					if (n2) {
+						*n2++ = 0;
+					}
+					osm_run(c2, out, len, &k, &dropped);
+					c2 = n2;
+				}
+			}
+			osm_quiet = 0;
+			k += (size_t)snprintf(out + k, len - k, "rep: %llu of %llu runs\n", i, n);
+			break;
+		}
+		osm_run(cmd, out, len, &k, &dropped);
 		cmd = next;
 	}
+	if (dropped && k < len - 40) {
+		snprintf(out + k, len - k, "(%u outputs dropped)\n", dropped);
+	}
 	return 1;
 }
 
-- 
2.47.3

