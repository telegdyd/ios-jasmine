Subject: [PATCH] jasmine-j0153: `cpuidle ab CYCLES SECS [WAIT]`: unplugged idle power A/B kept for after replug

Runs on the phone without the USB link: after WAIT s (default 60, time to unplug and turn the
screen off) it alternates WFI and the current idle mode for SECS s each, order flipped every
cycle, averages the PM660 gauge current (first 4 s after a switch dropped) and keeps the
per-cycle results for `cpuidle ab` once the cable is back (also SWEET IDLEAB console lines).
Diagnostic only; nothing runs unless the command is sent.
---
diff --git a/osfmk/arm64/cpu.c b/osfmk/arm64/cpu.c
--- a/osfmk/arm64/cpu.c
+++ b/osfmk/arm64/cpu.c
@@ -81,6 +81,7 @@
 #include <libkern/section_keywords.h>
 #if defined(SWEET)
 #include <string.h>
+#include <stdarg.h>
 #include <kern/clock.h>
 #include <kern/misc_protos.h>
 #endif
@@ -1494,6 +1495,142 @@ sweet_cpu_idle_resumed(cpu_data_t *cdp)
 	ClearIdlePop(FALSE);
 }
 
+/*
+ * j0153: unplugged power A/B without the USB link: `cpuidle ab CYCLES SECS [WAIT]` waits
+ * WAIT s (default 60: unplug, screen off), then runs CYCLES cycles of mode 0 (WFI) and
+ * mode B (the mode set when started) for SECS s each, order flipped every cycle; the
+ * gauge current is sampled every 1 s, the first 4 s after a switch dropped. Results stay
+ * here for `cpuidle ab` after the cable is back, and go to the console log.
+ */
+struct sweet_fg_ab {
+	int mv, ma;
+	int temp_dc;
+	int fg_soc;
+	int online, charging, full;
+};
+extern int sweet_fg_read(struct sweet_fg_ab *out);
+extern int vsnprintf(char *, size_t, const char *, va_list) __printflike(3, 0);
+static char sweet_ab_out[1536];
+static int sweet_ab_len;
+static uint32_t sweet_ab_cycles, sweet_ab_secs, sweet_ab_wait, sweet_ab_mode_b;
+static boolean_t sweet_ab_running;
+
+static void
+sweet_ab_printf(const char *fmt, ...) __printflike(1, 2);
+static void
+sweet_ab_printf(const char *fmt, ...)
+{
+	va_list ap;
+	va_start(ap, fmt);
+	if (sweet_ab_len < (int)sizeof(sweet_ab_out) - 1) {
+		int n = vsnprintf(sweet_ab_out + sweet_ab_len, sizeof(sweet_ab_out) - (size_t)sweet_ab_len, fmt, ap);
+		if (n > 0) {
+			sweet_ab_len += n;
+			if (sweet_ab_len > (int)sizeof(sweet_ab_out) - 1) {
+				sweet_ab_len = (int)sizeof(sweet_ab_out) - 1;
+			}
+		}
+	}
+	va_end(ap);
+}
+
+/* mean battery current (mA, negative = discharge) over one window; online = any sample on USB */
+static int
+sweet_ab_window(unsigned mode, int *online, int *mv)
+{
+	struct sweet_fg_ab f;
+	os_atomic_store(&sweet_cpuidle_mode, mode, relaxed);
+	int64_t sum = 0;
+	int n = 0;
+	for (uint32_t t = 0; t < sweet_ab_secs; t++) {
+		delay_for_interval(1, NSEC_PER_SEC);
+		if (t < 4 || sweet_fg_read(&f) != 0) {
+			continue;
+		}
+		sum += f.ma;
+		n++;
+		*online |= f.online;
+		*mv = f.mv;
+	}
+	return n ? (int)(sum / n) : 0;
+}
+
+static void
+sweet_ab_thread(void *arg, wait_result_t wr)
+{
+	(void)arg; (void)wr;
+	struct sweet_fg_ab f;
+	delay_for_interval(sweet_ab_wait, NSEC_PER_SEC);
+	int t0 = sweet_fg_read(&f) == 0 ? f.temp_dc : 0;
+	int s0 = sweet_fg_read(&f) == 0 ? f.fg_soc : 0;
+	int64_t dsum = 0;
+	int any_online = 0;
+	for (uint32_t c = 0; c < sweet_ab_cycles; c++) {
+		int on = 0, mv = 0, a, b;
+		if (c & 1) {
+			b = sweet_ab_window(sweet_ab_mode_b, &on, &mv);
+			a = sweet_ab_window(0, &on, &mv);
+		} else {
+			a = sweet_ab_window(0, &on, &mv);
+			b = sweet_ab_window(sweet_ab_mode_b, &on, &mv);
+		}
+		dsum += b - a;
+		any_online |= on;
+		sweet_ab_printf("  cycle %u: wfi %d mA, mode %u %d mA, B-A %+d mA, %d mV%s\n", c, a, sweet_ab_mode_b, b, b - a, mv, on ? ", ON USB" : "");
+		printf("SWEET IDLEAB: cycle %u: wfi %d mA, mode %u %d mA, B-A %+d mA, %d mV%s\n", c, a, sweet_ab_mode_b, b, b - a, mv, on ? ", ON USB" : "");
+	}
+	os_atomic_store(&sweet_cpuidle_mode, sweet_ab_mode_b, relaxed);
+	int t1 = sweet_fg_read(&f) == 0 ? f.temp_dc : 0;
+	sweet_ab_printf("  mean B-A %+lld mA over %u cycles (positive: idle mode %u draws less)%s; %d.%d -> %d.%d C, soc %d -> %d %%\n",
+	    sweet_ab_cycles ? dsum / (int64_t)sweet_ab_cycles : 0, sweet_ab_cycles, sweet_ab_mode_b,
+	    any_online ? ", USB WAS CONNECTED" : "", t0 / 10, t0 % 10, t1 / 10, t1 % 10, s0, f.fg_soc);
+	printf("SWEET IDLEAB: done: %s", sweet_ab_out);
+	sweet_ab_running = FALSE;
+}
+
+static const char *
+sweet_ab_start(const char *p)
+{
+	uint32_t v[3] = { 0, 0, 60 };
+	for (int k = 0; k < 3; k++) {
+		while (*p == ' ') {
+			p++;
+		}
+		if (*p < '0' || *p > '9') {
+			break;
+		}
+		uint32_t x = 0;
+		for (; *p >= '0' && *p <= '9'; p++) {
+			x = x * 10 + (uint32_t)(*p - '0');
+		}
+		v[k] = x;
+	}
+	if (v[0] == 0) {
+		return NULL;            /* show results */
+	}
+	if (sweet_ab_running) {
+		return "A/B already running";
+	}
+	if (sweet_cpuidle_mode == 0) {
+		return "set the mode to compare first (e.g. `cpuidle 3`)";
+	}
+	sweet_ab_cycles = v[0] > 20 ? 20 : v[0];
+	sweet_ab_secs = v[1] < 10 ? 10 : (v[1] > 600 ? 600 : v[1]);
+	sweet_ab_wait = v[2] > 600 ? 600 : v[2];
+	sweet_ab_mode_b = sweet_cpuidle_mode;
+	sweet_ab_len = 0;
+	sweet_ab_out[0] = 0;
+	sweet_ab_printf("cpuidle ab: %u cycles x 2 x %u s after %u s, wfi vs mode %u\n", sweet_ab_cycles, sweet_ab_secs, sweet_ab_wait, sweet_ab_mode_b);
+	thread_t thread;
+	sweet_ab_running = TRUE;
+	if (kernel_thread_start(sweet_ab_thread, NULL, &thread) != KERN_SUCCESS) {
+		sweet_ab_running = FALSE;
+		return "no thread";
+	}
+	thread_deallocate(thread);
+	return NULL;
+}
+
 /* `cpuidle [MODE [PC_US [MASK]]] [force]`, `cpuidle flush 0|1`, `cpuidle reset` */
 int sweet_cpuidle_command(const char *args, char *out, size_t len);
 int
@@ -1504,6 +1641,15 @@ sweet_cpuidle_command(const char *args, char *out, size_t len)
 	while (*p == ' ') {
 		p++;
 	}
+	if (strncmp(p, "ab", 2) == 0 && (p[2] == 0 || p[2] == ' ')) {
+		const char *e = sweet_ab_start(p + 2);
+		int m = snprintf(out, len, "%s%s%s%s", e ? "ERROR " : "", e ? e : "", e ? "\n" : "",
+		    sweet_ab_len ? sweet_ab_out : "cpuidle ab: no results yet\n");
+		if (sweet_ab_running) {
+			m += snprintf(out + m, len - (size_t)m, "  (running)\n");
+		}
+		return m < (int)len ? m : (int)len - 1;
+	}
 	if (strncmp(p, "gic", 3) == 0) {
 		extern int sweet_gic_dump(char *out, size_t len);
 		int m = snprintf(out, len, "cpuidle gic:\n");
