+static int
+fat_find(const char *path)
+{
+	for (unsigned i = 0; i < fat_nfiles; i++) {
+		if (fat_name_eq(fat_files[i].path, path)) {
+			return (int)i;
+		}
+	}
+	return -1;
+}
