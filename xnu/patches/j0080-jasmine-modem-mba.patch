+		}
+		st = rmb_wait(0, 5000);
+		LOG("mba: MBA status %d%s", st, (st == RMB_MBA_XPU_UNLOCKED || st == RMB_MBA_XPU_UNLOCKED_SCRIBBLED) ? " (MBA booted)" : "");
+		if (st != RMB_MBA_XPU_UNLOCKED && st != RMB_MBA_XPU_UNLOCKED_SCRIBBLED) {
+			goto fail;
+		}
+
+		/* q6v5_mpss_load: metadata first */
+		w32(rmb, RMB_PMI_CODE_LENGTH, 0);
+		if (mss_assign("metadata", meta_pa, meta_size, &meta_perm, false, true) != 0) {
+			goto fail;
+		}
+		w32(rmb, RMB_PMI_META_DATA, (uint32_t)meta_pa);
+		w32(rmb, RMB_MBA_COMMAND, RMB_CMD_META_DATA_READY);
+		st = rmb_wait(RMB_MBA_META_DATA_AUTH_SUCCESS, 1000);
+		LOG("mba: metadata (%llu bytes @%llx) authentication: status %d", meta_size, meta_pa, st);
+		(void)mss_assign("metadata", meta_pa, meta_size, &meta_perm, true, false);
+		if (st != RMB_MBA_META_DATA_AUTH_SUCCESS) {
+			goto fail;
+		}
+
+		/* the segments, with the MPSS region shared between us and the modem */
+		(void)mss_assign("mpss", MPSS_PA, MPSS_SIZE, &mpss_perm, true, false);
+		if (mss_assign("mpss", MPSS_PA, MPSS_SIZE, &mpss_perm, true, true) != 0) {
+			goto fail;
+		}
+		uint64_t reloc = relocate ? min_a : MPSS_PA, size = 0;
+		for (uint32_t i = 0; i < eh->e_phnum; i++) {
+			if (!loadable(&ph[i])) {
+				continue;
+			}
+			int64_t offset = (int64_t)ph[i].p_paddr - (int64_t)reloc;
+			if (offset < 0 || (uint64_t)offset + ph[i].p_memsz > MPSS_SIZE || ph[i].p_filesz > ph[i].p_memsz) {
+				LOG("mba: segment %u (%08x+%x) outside the MPSS region", i, ph[i].p_paddr, ph[i].p_memsz);
+				goto fail;
+			}
+			char name[16];
+			snprintf(name, sizeof(name), "modem.b%02u", i);
+			bool in_mdt = ph[i].p_filesz != 0 && ph[i].p_offset < (uint64_t)mdt_size;
+			if (in_mdt && ph[i].p_offset + (uint64_t)ph[i].p_filesz > (uint64_t)mdt_size) {
+				LOG("mba: segment %u truncated in modem.mdt", i);
+				goto fail;
+			}
+			if (!mss_copy(name, MPSS_PA + offset, ph[i].p_filesz, ph[i].p_memsz, in_mdt ? mdt + ph[i].p_offset : NULL)) {
+				LOG("mba: %s (%x bytes) not loaded", name, ph[i].p_filesz);
+				goto fail;
+			}
+			size += ph[i].p_memsz;
+			if (r32(rmb, RMB_PMI_CODE_LENGTH) == 0) {
+				w32(rmb, RMB_PMI_CODE_START, (uint32_t)(relocate ? MPSS_PA : min_a));
+				w32(rmb, RMB_MBA_COMMAND, RMB_CMD_LOAD_READY);
+			}
+			w32(rmb, RMB_PMI_CODE_LENGTH, (uint32_t)size);
+			st = (int32_t)r32(rmb, RMB_MBA_STATUS);
+			if (st < 0) {
+				LOG("mba: after %s: MPSS authentication failed: %d", name, st);
+				goto fail;
+			}
+		}
+		LOG("mba: segments loaded (%llu bytes)", size);
+		if (mss_assign("mpss", MPSS_PA, MPSS_SIZE, &mpss_perm, false, true) != 0) {
+			goto fail;
+		}
+		st = rmb_wait(RMB_MBA_AUTH_COMPLETE, 10000);
+		LOG("mba: MPSS authentication: status %d%s", st, st == RMB_MBA_AUTH_COMPLETE ? " (complete, modem starting)" : "");
+		if (st != RMB_MBA_AUTH_COMPLETE) {
+			goto fail;
+		}
+		ok = true;
+		goto out;
+	}
+fail:
+	LOG("mba: boot failed: RMB PBL %08x MBA %08x, RESET %08x PWR_CTL %08x", r32(rmb, RMB_PBL_STATUS),
+	    r32(rmb, RMB_MBA_STATUS), r32(q6ss, Q6SS_RESET), r32(q6ss, Q6SS_PWR_CTL));
+	mss_reclaim();
+out:
+	if (mdt != NULL) {
+		IOFree(mdt, mdt_size);
+	}
+	return ok;
+}
+
+/* the modem is READY (q6v5_start after qcom_q6v5_wait_for_start): the MBA region comes back */
+static void
+mba_started(void)
+{
+	if (!mba_reclaimed) {
+		mba_reclaimed = true;
+		(void)mss_assign("mba", MBA_PA, MBA_SIZE, &mba_perm, true, false);
+	}
+}
+
+/* HANDOVER (q6v5_handover_interrupt): the modem votes for itself, our proxy votes go */
+static void
+mba_handover(void)
+{
+	if (mba_votes) {
+		mss_rom_off();
+		mss_votes(false);
+		LOG("mba: handover: proxy votes dropped (cx back to the GPU's, mx NOM, our boot_rom_ahb vote off)");
+	}
+}
