Date: Sat, 24 Oct 2026 05:54:06 +0200
Subject: [PATCH] jasmine-j0080: modem boot on SDM660 through the MBA (Linux
 qcom_q6v5_mss.c sdm660_mss: cx/mx proxy votes, GCC MSS clocks and reset,
 QDSP6 v62 power-up, PBL/MBA RMB handshake, metadata + segment authentication,
 hyp assign HLOS/MSS_MSA); firmware from the modem partition FAT16 at run
 time; SoC addresses per board; RPM rail votes aggregated per AP client;
 modem=1, Wi-Fi radio still off on jasmine

---
 bsd/dev/sweet_rpm.c                   |  45 +-
 iokit/Kernel/arm/SweetFramebuffer.cpp |   2 +
 iokit/Kernel/arm/TopazModem.cpp       | 912 +++++++++++++++++++++++++-
 3 files changed, 937 insertions(+), 22 deletions(-)

diff --git a/bsd/dev/sweet_rpm.c b/bsd/dev/sweet_rpm.c
index e152251..4b5eb65 100644
--- a/bsd/dev/sweet_rpm.c
+++ b/bsd/dev/sweet_rpm.c
@@ -374,18 +374,57 @@ rpm_request(const char *what, uint32_t set, uint32_t type, uint32_t id, const ui
  * active set like the stock DT's qcom,set = 3. The RPM takes the highest of
  * all masters' votes; this one replaces the AP's earlier one (the
  * bootloader's).
+ *
+ * The AP is one master but has several users of a rail (j0080): client 0
+ * the GPU (sweet_rpm_level), 1 the modem's proxy vote while it boots
+ * (TopazModem.cpp). The AP's vote is the highest of its clients' levels, as
+ * Linux rpmpd aggregates its consumers; 0 = no vote from that client. With
+ * no client voting the last vote stays (nothing ever voted the rail off).
  */
+#define RPM_LEVEL_CLIENTS 2
+static struct {
+	uint32_t type, level[RPM_LEVEL_CLIENTS], sent;
+} rpm_rails[2] = { {0x78637772u /* rwcx */}, {0x786d7772u /* rwmx */} };
+
+bool sweet_rpm_level_client(unsigned client, uint32_t type, uint32_t level);
 bool
-sweet_rpm_level(uint32_t type, uint32_t level)
+sweet_rpm_level_client(unsigned client, uint32_t type, uint32_t level)
 {
-	uint32_t kv[4] = {KEY_SWEN, 1u, KEY_VLVL, level};
+	uint32_t vote = level, *sent = NULL;
 	lck_mtx_lock(&sweet_rpm_lock);
+	for (unsigned r = 0; r < 2 && client < RPM_LEVEL_CLIENTS; r++) {
+		if (rpm_rails[r].type == type) {
+			rpm_rails[r].level[client] = level;
+			vote = 0;
+			for (unsigned c = 0; c < RPM_LEVEL_CLIENTS; c++) {
+				vote = MAX(vote, rpm_rails[r].level[c]);
+			}
+			if (vote == 0 || vote == rpm_rails[r].sent) {
+				lck_mtx_unlock(&sweet_rpm_lock);
+				printf("SWEET RPM: %.4s client %u level %#x: AP vote stays %#x\n", (const char *)&type, client, level,
+				    rpm_rails[r].sent);
+				return true;
+			}
+			sent = &rpm_rails[r].sent;
+		}
+	}
+	uint32_t kv[4] = {KEY_SWEN, 1u, KEY_VLVL, vote};
 	bool ok = rpm_request("level sleep", 1, type, 0, kv, 2) && rpm_request("level active", 0, type, 0, kv, 2);
+	if (ok && sent != NULL) {
+		*sent = vote;
+	}
 	lck_mtx_unlock(&sweet_rpm_lock);
-	printf("SWEET RPM: %.4s level %#x: %s\n", (const char *)&type, level, ok ? "ok" : "FAILED");
+	printf("SWEET RPM: %.4s client %u level %#x: AP vote %#x %s\n", (const char *)&type, client, level, vote,
+	    ok ? "ok" : "FAILED");
 	return ok;
 }
 
+bool
+sweet_rpm_level(uint32_t type, uint32_t level)
+{
+	return sweet_rpm_level_client(0, type, level);
+}
