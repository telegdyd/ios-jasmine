+/*
+ * jasmine: no table. The modem partition (identical modem_a and modem_b, FAT16, 512-byte
+ * sectors, 16 KiB clusters, ~430 files) is indexed once from its boot sector, first FAT and
+ * directories (root plus subdirectories, short and long names, lower case), and files are
+ * read cluster run by cluster run along the FAT. Read-only, like the rest of this file.
+ */
+#define FAT_MAX_FILES       1024
+#define FAT_PATH            112                 /* the deepest: image/modem_pr/mcfg/configs/... (91) */
+struct fat_file { char path[FAT_PATH]; uint32_t size, clus; };
+static struct fat_file *fat_files;
+static unsigned fat_nfiles;
+static uint16_t *fat_tab;
+static uint32_t fat_nent, fat_csize;
+static uint64_t fat_data;                       /* byte offset of cluster 2 */
+
+static bool
+fat_name_eq(const char *a, const char *b)
+{
+	for (; *a != 0 && *b != 0; a++, b++) {
+		char x = (*a >= 'A' && *a <= 'Z') ? (char)(*a + 32) : *a, y = (*b >= 'A' && *b <= 'Z') ? (char)(*b + 32) : *b;
+		if (x != y) {
+			return false;
+		}
+	}
+	return *a == *b;
+}
+
+static uint32_t
+fat_next(uint32_t c)
+{
+	return c < fat_nent ? fat_tab[c] : 0xFFFF;
+}
+
+/* n bytes at off of the cluster chain from clus (size bytes long): contiguous clusters in one read */
+static bool
+fat_chain_read(uint32_t clus, uint32_t size, uint64_t off, void *dst, uint64_t n)
+{
+	if (off > size || n > size - off) {
+		return false;
+	}
+	uint64_t pos = 0, done = 0;
+	for (uint32_t c = clus; done < n; ) {
+		if (c < 2 || c >= 0xFFF8) {
+			return false;
+		}
+		uint32_t run = 1;                       /* clusters c .. c+run-1 are consecutive */
+		while (fat_next(c + run - 1) == c + run && run < 256) {
+			run++;
+		}
+		uint64_t len = (uint64_t)run * fat_csize;
+		if (off + done < pos + len) {
+			uint64_t in = off + done - pos, take = MIN(len - in, n - done);
+			if (sweet_ufs_read_part(fw_part, fat_data + (uint64_t)(c - 2) * fat_csize + in,
+			    (uint8_t *)dst + done, take) != 0) {
+				return false;
+			}
+			done += take;
+		}
+		pos += len;
+		c = fat_next(c + run - 1);
+	}
+	return true;
+}
+
+static void
+fat_dir(const uint8_t *d, uint32_t len, const char *prefix, int depth)
+{
+	static char lfn[FAT_PATH], name[FAT_PATH];  /* one thread; lfn is empty whenever this recurses */
+	lfn[0] = 0;
+	for (uint32_t i = 0; i + 32 <= len && d[i] != 0; i += 32) {
+		const uint8_t *e = d + i;
+		if (e[0] == 0xE5) {
+			lfn[0] = 0;
+			continue;
+		}
+		if (e[11] == 0x0F) {                    /* long name piece: 13 UCS-2 characters, last piece first */
+			static const uint8_t at[13] = { 1, 3, 5, 7, 9, 14, 16, 18, 20, 22, 24, 28, 30 };
+			unsigned seq = (e[0] & 0x1F) - 1;
+			if (e[0] & 0x40) {
+				lfn[0] = 0;
+			}
+			for (unsigned k = 0; k < 13 && seq * 13 + k < FAT_PATH - 1; k++) {
+				uint16_t ch = (uint16_t)(e[at[k]] | e[at[k] + 1] << 8);
+				lfn[seq * 13 + k] = (ch == 0 || ch == 0xFFFF) ? 0 : (ch < 0x80 ? (char)ch : '_');
+				if (ch == 0) {
+					break;
+				}
+			}
+			if (e[0] & 0x40) {
+				lfn[MIN((seq + 1) * 13, (unsigned)FAT_PATH - 1)] = 0;
+			}
+			continue;
+		}
+		if (lfn[0] != 0) {
+			strlcpy(name, lfn, sizeof(name));
+		} else {
+			unsigned n = 0;
+			for (unsigned k = 0; k < 8 && e[k] != ' '; k++) {
+				name[n++] = (e[k] >= 'A' && e[k] <= 'Z') ? (char)(e[k] + 32) : (char)e[k];
+			}
+			if (e[8] != ' ') {
+				name[n++] = '.';
+				for (unsigned k = 8; k < 11 && e[k] != ' '; k++) {
+					name[n++] = (e[k] >= 'A' && e[k] <= 'Z') ? (char)(e[k] + 32) : (char)e[k];
+				}
+			}
+			name[n] = 0;
+		}
+		lfn[0] = 0;
+		if ((e[11] & 0x08) || strcmp(name, ".") == 0 || strcmp(name, "..") == 0) {
+			continue;                           /* volume label, dot entries */
+		}
+		uint32_t clus = (uint32_t)(e[26] | e[27] << 8), size = (uint32_t)(e[28] | e[29] << 8 | e[30] << 16 | (uint32_t)e[31] << 24);
+		char path[FAT_PATH];
+		snprintf(path, sizeof(path), "%s%s", prefix, name);
+		if (e[11] & 0x10) {
+			if (depth >= 12 || clus < 2) {
+				continue;
+			}
+			uint32_t dlen = 0;                  /* directory size: its cluster chain */
+			for (uint32_t c = clus; c >= 2 && c < 0xFFF8 && dlen < 0x40000; c = fat_next(c)) {
+				dlen += fat_csize;
+			}
+			uint8_t *sub = (uint8_t *)IOMalloc(dlen);
+			if (sub != NULL && fat_chain_read(clus, dlen, 0, sub, dlen)) {
+				strlcat(path, "/", sizeof(path));
+				fat_dir(sub, dlen, path, depth + 1);
+			}
+			if (sub != NULL) {
+				IOFree(sub, dlen);
+			}
+		} else if (fat_nfiles < FAT_MAX_FILES) {
+			struct fat_file *f = &fat_files[fat_nfiles++];
+			strlcpy(f->path, path, sizeof(f->path));
+			f->size = size;
+			f->clus = clus;
+		}
+	}
+}
+
+static bool
+fat_index(void)
+{
+	uint8_t bs[512];
+	if (fat_files != NULL) {
+		return true;
+	}
+	if (sweet_ufs_read_part(fw_part, 0, bs, sizeof(bs)) != 0 || bs[510] != 0x55 || bs[511] != 0xAA) {
+		LOG("fat: %s has no boot sector", fw_part);
+		return false;
+	}
+	uint32_t bps = (uint32_t)(bs[11] | bs[12] << 8), spc = bs[13], rsv = (uint32_t)(bs[14] | bs[15] << 8);
+	uint32_t nfat = bs[16], nroot = (uint32_t)(bs[17] | bs[18] << 8), fsz = (uint32_t)(bs[22] | bs[23] << 8);
+	uint32_t tot = (uint32_t)(bs[19] | bs[20] << 8);
+	if (tot == 0) {
+		tot = (uint32_t)(bs[32] | bs[33] << 8 | bs[34] << 16 | (uint32_t)bs[35] << 24);
+	}
+	if (bps != 512 || spc == 0 || fsz == 0 || nroot == 0 || nfat == 0) {
+		LOG("fat: %s: bps %u spc %u fsz %u nroot %u: not FAT12/16", fw_part, bps, spc, fsz, nroot);
+		return false;
+	}
+	uint32_t root_secs = (nroot * 32 + bps - 1) / bps, first_data = rsv + nfat * fsz + root_secs;
+	uint32_t nclus = (tot - first_data) / spc;
+	if (nclus < 4085 || nclus >= 65525) {
+		LOG("fat: %s: %u clusters: not FAT16", fw_part, nclus);
+		return false;
+	}
+	fat_csize = bps * spc;
+	fat_data = (uint64_t)first_data * bps;
+	fat_nent = MIN(fsz * bps / 2, nclus + 2);
+	fat_tab = (uint16_t *)IOMalloc(fsz * bps);
+	fat_files = (struct fat_file *)IOMalloc(FAT_MAX_FILES * sizeof(struct fat_file));
+	uint8_t *root = (uint8_t *)IOMalloc(nroot * 32);
+	bool ok = fat_tab != NULL && fat_files != NULL && root != NULL &&
+	    sweet_ufs_read_part(fw_part, (uint64_t)rsv * bps, fat_tab, fsz * bps) == 0 &&
+	    sweet_ufs_read_part(fw_part, (uint64_t)(rsv + nfat * fsz) * bps, root, nroot * 32) == 0;
+	if (ok) {
+		fat_dir(root, nroot * 32, "", 0);
+	}
+	if (root != NULL) {
+		IOFree(root, nroot * 32);
+	}
+	LOG("fat: %s: FAT16, %u clusters of %u bytes, %u files%s", fw_part, nclus, fat_csize, fat_nfiles, ok ? "" : ": READ FAILED");
+	if (!ok || fat_nfiles == 0) {
+		fat_nfiles = 0;
+		return false;
+	}
+	return true;
+}
