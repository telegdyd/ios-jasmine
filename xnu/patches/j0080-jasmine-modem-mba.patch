+	soc.smmu_pa = 0x016C0000ull;                /* iommu@16c0000 (anoc2), wifi iommus 0x1a00/0x1a01 */
+	soc.smmu_size = 0x00040000u;
+	soc.wlan_sid = 0x1A00;
+	soc.ce_pa = 0x18800000ull + 0x240000;       /* wifi@18800000 membase */
+}
