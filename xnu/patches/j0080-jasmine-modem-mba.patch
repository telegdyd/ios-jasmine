+/* ---------------------------------------------------------------- jasmine: MBA boot */
+
+/*
+ * SDM660 (qcom,sdm660-mss-pil) has no PAS for the modem: the AP powers the Hexagon up itself,
+ * the modem's PBL starts the modem boot authenticator (mba.mbn, copied whole into the MBA
+ * region), the MBA checks the .mdt metadata and then each loaded segment of the MPSS region.
+ * Adapted from Linux drivers/remoteproc/qcom_q6v5_mss.c (GPL-2.0-only; Copyright (C) 2016
+ * Linaro Ltd., Copyright (C) 2014 Sony Mobile Communications AB, Copyright (c) 2012-2013,
+ * The Linux Foundation), sdm660_mss: q6v5_mba_load, q6v5proc_reset (MSS_SDM660 branch),
+ * q6v5_mpss_init_image, q6v5_mpss_load, q6v5_start, q6v5_mba_reclaim, q6v5_xfer_mem_ownership
+ * (close adaptation with the user's OK, 2026-10-22). Addresses from the jasmine DTB:
+ *   qdsp6 0x4080000, rmb 0x4180000; qcom,halt-regs in TCSR 0x1f60000: q6 +0x3000,
+ *   modem +0x5000, nc +0x4000; memory mba 0x94800000+2M, mpss 0x8ac00000+0x7e00000.
+ * GCC (gcc-sdm660.c, the DT's clock indices): iface gcc_mss_cfg_ahb 0x8a000, bus
+ * gcc_bimc_mss_q6_axi 0x4401c, mem gcc_boot_rom_ahb (vote 0x52004 bit 10, halt 0x38004),
+ * snoc_axi 0x8a03c, mnoc_axi 0x8a004, reset GCC_MSS_RESTART 0x79000. "gpll0_mss"
+ * (GPLL0_OUT_MSSCC) has no clock in mainline either; "xo" and "qdss" are RPM clocks that stay
+ * on (sweet_rpm.c). Power domains cx and mx: RPM rwcx/rwmx at TURBO (rpmpd sdm660 max_state)
+ * from before the boot until the modem's handover. Ownership: hyp assign between HLOS (3) and
+ * MSS_MSA (15), tracked per region as Linux does. No interrupts: RMB and SMP2P are polled.
+ */
+extern "C" bool sweet_rpm_level_client(unsigned client, uint32_t type, uint32_t level);   /* bsd/dev/sweet_rpm.c */
+
+#define RPM_RWCX            0x78637772u         /* "rwcx" */
+#define RPM_RWMX            0x786d7772u         /* "rwmx" */
+#define RPM_LEVEL_NOM       0x100
+#define RPM_LEVEL_TURBO     0x180
+#define RPM_CLIENT_MODEM    1
+
+#define MSS_QDSP6_PA        0x04080000ull
+#define MSS_RMB_PA          0x04180000ull
+#define MSS_HALT_PA         0x01F60000ull
+#define MSS_HALT_Q6         0x3000
+#define MSS_HALT_MODEM      0x5000
+#define MSS_HALT_NC         0x4000
+#define MBA_PA              0x94800000ull
+#define MBA_SIZE            0x00200000ull
+#define MPSS_PA             0x8AC00000ull
+#define MPSS_SIZE           0x07E00000ull
+#define MSS_GCC_PA          0x00100000ull
+#define MSS_GCC_SIZE        0x00094000u
+#define GCC_MSS_RESTART     0x79000
+#define GCC_BOOT_ROM_VOTE   0x52004
+#define GCC_BOOT_ROM_HALT   0x38004
+#define PERM_RWX            7
+
+/* RMB (PBL/MBA interface) */
+#define RMB_MBA_IMAGE       0x00
+#define RMB_PBL_STATUS      0x04
+#define RMB_MBA_COMMAND     0x08
+#define RMB_MBA_STATUS      0x0C
+#define RMB_PMI_META_DATA   0x10
+#define RMB_PMI_CODE_START  0x14
+#define RMB_PMI_CODE_LENGTH 0x18
+#define RMB_CMD_META_DATA_READY 1
+#define RMB_CMD_LOAD_READY  2
+#define RMB_MBA_XPU_UNLOCKED 1
+#define RMB_MBA_XPU_UNLOCKED_SCRIBBLED 2
+#define RMB_MBA_META_DATA_AUTH_SUCCESS 3
+#define RMB_MBA_AUTH_COMPLETE 4
+
+/* QDSP6SS (v62 on SDM660) */
+#define Q6SS_RESET          0x014
+#define Q6SS_GFMUX_CTL      0x020
+#define Q6SS_PWR_CTL        0x030
+#define Q6SS_MEM_PWR_CTL    0x034               /* QDSP6V6SS_MEM_PWR_CTL */
+#define Q6SS_XO_CBCR        0x038
+#define Q6SS_BHS_STATUS     0x0C4               /* QDSP6V62SS_BHS_STATUS */
+#define Q6SS_STRAP_ACC      0x110
+#define Q6SS_ACC_OVERRIDE   0x20
+#define Q6SS_STOP_CORE      (1u << 0)
+#define Q6SS_CORE_ARES      (1u << 1)
+#define Q6SS_BUS_ARES_EN    (1u << 2)
+#define Q6SS_CLK_ENABLE     (1u << 1)
+#define Q6SS_CBCR_CLKOFF    (1u << 31)
+#define Q6SS_L2DATA_STBY_N  (1u << 18)
+#define Q6SS_SLP_RET_N      (1u << 19)
+#define Q6SS_CLAMP_IO       (1u << 20)
+#define Q6SS_CLAMP_WL       (1u << 21)
+#define Q6SS_CLAMP_QMC_MEM  (1u << 22)
+#define Q6SS_BHS_ON         (1u << 24)
+#define Q6SS_LDO_BYP        (1u << 25)
+#define Q6SS_BHS_EN_REST_ACK (1u << 0)
+
+static volatile uint8_t *q6ss, *rmb, *mss_halt, *mss_gcc;
+static uint64_t mba_perm = 1ull << VMID_HLOS, mpss_perm = 1ull << VMID_HLOS;
+static bool mba_votes, mba_reclaimed;
+static uint32_t mss_clks_set;                  /* bit i: mss_active_clks[i] switched on here; bit 31: the boot ROM vote */
+
+static const struct { uint32_t cbcr; const char *name; } mss_active_clks[] = {
+	{ 0x8a000, "iface (mss_cfg_ahb)" },
+	{ 0x4401c, "bus (bimc_mss_q6_axi)" },
+	{ 0x8a004, "mnoc_axi (mss_mnoc_bimc_axi)" },
+	{ 0x8a03c, "snoc_axi (mss_snoc_axi)" },
+};
+
+/* q6v5_xfer_mem_ownership: *perm = bit per VMID that owns the region now */
+static int
+mss_assign(const char *what, uint64_t addr, uint64_t size, uint64_t *perm, bool local, bool remote)
+{
+	if (local == (((*perm >> VMID_HLOS) & 1) != 0) && remote == (((*perm >> VMID_MSS_MSA) & 1) != 0)) {
+		return 0;
+	}
+	uint64_t pa = 0;
+	uint64_t *p = (uint64_t *)pool_alloc(0x1000, &pa);
+	if (p == NULL) {
+		return -1;
+	}
+	size = (size + 0xfff) & ~0xfffull;
+	p[0] = addr;                                /* 0x000: mem map {addr, size} */
+	p[1] = size;
+	uint32_t *src = (uint32_t *)(p + 8), nsrc = 0;  /* 0x040: current owners */
+	for (unsigned v = 0; v < 64; v++) {
+		if (*perm & (1ull << v)) {
+			src[nsrc++] = v;
+		}
+	}
+	uint32_t *dst = (uint32_t *)(p + 16), ndst = 0; /* 0x080: {vmid, perm, ctx(8), ctx_size, unused} */
+	uint64_t next = 0;
+	if (local) {
+		dst[6 * ndst] = VMID_HLOS;
+		dst[6 * ndst + 1] = PERM_RWX;
+		ndst++;
+		next |= 1ull << VMID_HLOS;
+	}
+	if (remote) {
+		dst[6 * ndst] = VMID_MSS_MSA;
+		dst[6 * ndst + 1] = PERM_RW;
+		ndst++;
+		next |= 1ull << VMID_MSS_MSA;
+	}
+	p[32] = nsrc * 4;                           /* 0x100: extended args: src size, dest, dest size, 0 */
+	p[33] = pa + 0x80;
+	p[34] = ndst * 24;
+	p[35] = 0;
+	mb();
+	uint64_t ai = 7 | (1 << 4) | (1 << 8) | (1 << 12);
+	uint64_t args[8] = { SCM_FN(0x0C, 0x16), ai, pa, 16, pa + 0x40, pa + 0x100, 0, 0 };
+	smc(args);
+	for (unsigned n = 0; args[0] == 1 && n < 100000; n++) {
+		uint64_t again[8] = { 1, ai, pa, 16, pa + 0x40, pa + 0x100, args[6], 0 };
+		memcpy(args, again, sizeof(args));
+		smc(args);
+	}
+	int ret = args[0] != 0 ? (int)args[0] : (int)args[1];
+	LOG("mba: assign %s %llx+%llx %llx -> %llx: ret %llx res %llx", what, addr, size, *perm, next, args[0], args[1]);
+	if (ret == 0) {
+		*perm = next;
+	}
+	return ret;
+}
+
+static bool
+mss_poll(volatile uint8_t *base, uint32_t off, uint32_t mask, uint32_t want, unsigned us)
+{
+	for (unsigned n = 0; n <= us; n++) {
+		if ((r32(base, off) & mask) == want) {
+			return true;
+		}
+		IODelay(1);
+	}
+	return false;
+}
+
+static bool
+mss_clk_on(unsigned i)
+{
+	uint32_t cbcr = mss_active_clks[i].cbcr;
+	const char *name = mss_active_clks[i].name;
+	if ((r32(mss_gcc, cbcr) & 1u) == 0) {
+		mss_clks_set |= 1u << i;
+	}
+	w32(mss_gcc, cbcr, r32(mss_gcc, cbcr) | 1u);
+	bool ok = mss_poll(mss_gcc, cbcr, Q6SS_CBCR_CLKOFF, 0, 200);
+	LOG("mba: clock %s %05x: %08x%s", name, cbcr, r32(mss_gcc, cbcr), ok ? "" : " STILL OFF");
+	return ok;
+}
+
+/* only what was switched on here: the boot ROM clock and the buses can have other users */
+static void
+mss_rom_off(void)
+{
+	if (mss_clks_set & (1u << 31)) {
+		w32(mss_gcc, GCC_BOOT_ROM_VOTE, r32(mss_gcc, GCC_BOOT_ROM_VOTE) & ~(1u << 10));
+		mss_clks_set &= ~(1u << 31);
+	}
+}
+
+static void
+mss_clks_off(void)
+{
+	for (unsigned i = 0; i < sizeof(mss_active_clks) / sizeof(mss_active_clks[0]); i++) {
+		if (mss_clks_set & (1u << i)) {
+			w32(mss_gcc, mss_active_clks[i].cbcr, r32(mss_gcc, mss_active_clks[i].cbcr) & ~1u);
+		}
+	}
+	mss_clks_set &= 1u << 31;
+	mss_rom_off();
+}
+
+/* the AP's proxy votes for cx/mx: TURBO while the modem boots, then the GPU's cx and NOM mx */
+static void
+mss_votes(bool on)
+{
+	if (on == mba_votes) {
+		return;
+	}
+	mba_votes = on;
+	(void)sweet_rpm_level_client(RPM_CLIENT_MODEM, RPM_RWCX, on ? RPM_LEVEL_TURBO : 0);
+	(void)sweet_rpm_level_client(RPM_CLIENT_MODEM, RPM_RWMX, on ? RPM_LEVEL_TURBO : RPM_LEVEL_NOM);
+}
+
+/* q6v5proc_halt_axi_port */
+static void
+mss_halt_port(uint32_t off, const char *name)
+{
+	if (r32(mss_halt, off + 8) != 0) {
+		return;                                 /* already idle */
+	}
+	w32(mss_halt, off, 1);
+	bool ack = mss_poll(mss_halt, off + 4, 1, 1, 100000);
+	uint32_t idle = r32(mss_halt, off + 8);
+	w32(mss_halt, off, 0);
+	LOG("mba: halt %s port: ack %u idle %u", name, ack, idle);
+}
+
+/* q6v5_mba_reclaim after a failed boot: ports halted, modem in reset, clocks off, memory back */
+static void
+mss_reclaim(void)
+{
+	mss_halt_port(MSS_HALT_Q6, "q6");
+	mss_halt_port(MSS_HALT_MODEM, "modem");
+	mss_halt_port(MSS_HALT_NC, "nc");
+	w32(mss_gcc, GCC_MSS_RESTART, r32(mss_gcc, GCC_MSS_RESTART) | 1u);
+	mss_clks_off();
+	(void)mss_assign("mba", MBA_PA, MBA_SIZE, &mba_perm, true, false);
+	(void)mss_assign("mpss", MPSS_PA, MPSS_SIZE, &mpss_perm, true, false);
+	mss_votes(false);
+	LOG("mba: modem stopped (reset held, clocks off, memory reclaimed)");
+}
+
+/* q6v5_rmb_mba_wait: status (0 = any non-zero) or a negative error, -1000 on timeout */
+static int32_t
+rmb_wait(uint32_t status, unsigned ms)
+{
+	int32_t v = 0;
+	for (unsigned n = 0; n <= ms; n++) {
+		v = (int32_t)r32(rmb, RMB_MBA_STATUS);
+		if (v < 0 || (status == 0 && v != 0) || (status != 0 && (uint32_t)v == status)) {
+			return v;
+		}
+		IOSleep(1);
+	}
+	LOG("mba: RMB status still %d after %u ms (want %u)", v, ms, status);
+	return -1000;
+}
+
+/* q6v5proc_reset, MSS_SDM660: power the QDSP6 v62 up and start the PBL */
+static bool
+q6_power_up(void)
+{
+	uint32_t val;
+
+	w32(q6ss, Q6SS_STRAP_ACC, Q6SS_ACC_OVERRIDE);
+	val = r32(q6ss, Q6SS_RESET) | Q6SS_CORE_ARES | Q6SS_BUS_ARES_EN | Q6SS_STOP_CORE;
+	w32(q6ss, Q6SS_RESET, val);
+	w32(q6ss, Q6SS_XO_CBCR, r32(q6ss, Q6SS_XO_CBCR) | 1u);
+	if (!mss_poll(q6ss, Q6SS_XO_CBCR, Q6SS_CBCR_CLKOFF, 0, 200)) {
+		LOG("mba: QDSP6 xo cbcr stays off (%08x)", r32(q6ss, Q6SS_XO_CBCR));
+		return false;
+	}
+	val = r32(q6ss, Q6SS_PWR_CTL) | Q6SS_BHS_ON;
+	w32(q6ss, Q6SS_PWR_CTL, val);
+	val |= r32(q6ss, Q6SS_PWR_CTL);
+	IODelay(1);
+	if (!mss_poll(q6ss, Q6SS_BHS_STATUS, Q6SS_BHS_EN_REST_ACK, Q6SS_BHS_EN_REST_ACK, 200)) {
+		LOG("mba: BHS_EN_REST_ACK not set (%08x)", r32(q6ss, Q6SS_BHS_STATUS));
+		return false;
+	}
+	val |= Q6SS_LDO_BYP;
+	w32(q6ss, Q6SS_PWR_CTL, val);
+	val = r32(q6ss, Q6SS_PWR_CTL) & ~Q6SS_CLAMP_QMC_MEM;
+	w32(q6ss, Q6SS_PWR_CTL, val);
+	val |= Q6SS_L2DATA_STBY_N | Q6SS_SLP_RET_N;
+	w32(q6ss, Q6SS_PWR_CTL, val);
+	val = r32(q6ss, Q6SS_MEM_PWR_CTL);
+	for (int i = 28; i >= 0; i--) {             /* L1, L2, ETB and JU memories one at a time */
+		val |= 1u << i;
+		w32(q6ss, Q6SS_MEM_PWR_CTL, val);
+		val |= r32(q6ss, Q6SS_MEM_PWR_CTL);
+		IODelay(1);
+	}
+	val = r32(q6ss, Q6SS_PWR_CTL) & ~Q6SS_CLAMP_WL;
+	w32(q6ss, Q6SS_PWR_CTL, val);
+	val &= ~Q6SS_CLAMP_IO;
+	w32(q6ss, Q6SS_PWR_CTL, val);
+	w32(q6ss, Q6SS_RESET, r32(q6ss, Q6SS_RESET) & ~Q6SS_CORE_ARES);
+	w32(q6ss, Q6SS_GFMUX_CTL, r32(q6ss, Q6SS_GFMUX_CTL) | Q6SS_CLK_ENABLE);
+	w32(q6ss, Q6SS_RESET, r32(q6ss, Q6SS_RESET) & ~Q6SS_STOP_CORE);
+
+	uint32_t pbl = 0;
+	for (unsigned n = 0; n <= 1000 && pbl == 0; n++) {
+		pbl = r32(rmb, RMB_PBL_STATUS);
+		if (pbl == 0) {
+			IOSleep(1);
+		}
+	}
+	LOG("mba: QDSP6 started: PWR_CTL %08x MEM_PWR_CTL %08x RESET %08x, PBL status %u%s", r32(q6ss, Q6SS_PWR_CTL),
+	    r32(q6ss, Q6SS_MEM_PWR_CTL), r32(q6ss, Q6SS_RESET), pbl, pbl == 1 ? "" : (pbl == 0 ? " (timeout)" : " (unexpected)"));
+	return pbl == 1;
+}
+
+/* copy a whole firmware file to physical memory (WC mapping while copying), zero to memsz */
+static bool
+mss_copy(const char *name, uint64_t pa, uint32_t filesz, uint32_t memsz, const uint8_t *from)
+{
+	uint64_t base = pa & ~0x3fffull, off = pa - base, len = (off + memsz + 0x3fff) & ~0x3fffull;
+	IOMemoryMap *m = map_phys(base, len, true);
+	if (m == NULL) {
+		LOG("mba: %s: cannot map %llx+%x", name, pa, memsz);
+		return false;
+	}
+	uint8_t *dst = (uint8_t *)m->getVirtualAddress() + off;
+	bool ok = true;
+	if (from != NULL) {
+		memcpy(dst, from, filesz);
+	} else if (filesz != 0) {
+		ok = fw_read(name, dst, filesz) == (int64_t)filesz;
+	}
+	if (ok && memsz > filesz) {
+		bzero(dst + filesz, memsz - filesz);
+	}
+	mb();
+	m->release();
+	return ok;
+}
+
+static bool
+modem_boot_mba(void)
+{
+	uint8_t *mdt = NULL, *meta;
+	int64_t mdt_size, mba_size;
+	uint64_t meta_pa = 0, meta_perm = 1ull << VMID_HLOS;
+	int32_t st;
+	bool ok = false;
+
+	struct smem_part_hdr *part = smem_partition(0, 1);
+	LOG("mba: SMEM apps<->modem partition %p", part);
+	if (part == NULL) {
+		return false;
+	}
+	if (smem_get(part, ITEM_SMP2P_IN, NULL) != NULL) {
+		LOG("mba: modem SMP2P item %u already exists: modem is not cold, not touching it", ITEM_SMP2P_IN);
+		return false;
+	}
+	q6ss = (volatile uint8_t *)ml_io_map(MSS_QDSP6_PA, 0x1000);
+	rmb = (volatile uint8_t *)ml_io_map(MSS_RMB_PA, 0x1000);
+	mss_halt = (volatile uint8_t *)ml_io_map(MSS_HALT_PA, 0x6000);
+	mss_gcc = (volatile uint8_t *)ml_io_map(MSS_GCC_PA, MSS_GCC_SIZE);
+	if (q6ss == NULL || rmb == NULL || mss_halt == NULL || mss_gcc == NULL) {
+		LOG("mba: register mappings failed");
+		return false;
+	}
+	/* GCC only here: the QDSP6SS and RMB registers need the MSS clocks (unclocked reads can hang the bus) */
+	LOG("mba: before: MSS_RESTART %08x, gpll0 votes %08x, boot_rom vote %08x", r32(mss_gcc, GCC_MSS_RESTART),
+	    r32(mss_gcc, 0x5200c), r32(mss_gcc, GCC_BOOT_ROM_VOTE));
+
+	/* q6v5_load: mba.mbn whole into the MBA region (max 1 MiB) */
+	mba_size = fw_size("mba.mbn");
+	if (mba_size <= 0 || mba_size > 0x100000 || !mss_copy("mba.mbn", MBA_PA, (uint32_t)mba_size, (uint32_t)mba_size, NULL)) {
+		LOG("mba: mba.mbn (%lld bytes) not loaded", mba_size);
+		return false;
+	}
+	mdt_size = fw_size("modem.mdt");
+	if (mdt_size <= (int64_t)sizeof(struct elf32_ehdr) || mdt_size > 0x100000) {
+		LOG("mba: modem.mdt: size %lld", mdt_size);
+		return false;
+	}
+	mdt = (uint8_t *)IOMalloc(mdt_size);
+	if (mdt == NULL || fw_read("modem.mdt", mdt, mdt_size) != mdt_size) {
+		goto out;
+	}
+	{
+		struct elf32_ehdr *eh = (struct elf32_ehdr *)mdt;
+		if (memcmp(eh->e_ident, "\x7f" "ELF", 4) != 0 || eh->e_phnum < 2 ||
+		    eh->e_phoff + (uint64_t)eh->e_phnum * sizeof(struct elf32_phdr) > (uint64_t)mdt_size) {
+			LOG("mba: modem.mdt: bad ELF header");
+			goto out;
+		}
+		struct elf32_phdr *ph = (struct elf32_phdr *)(mdt + eh->e_phoff);
+		uint32_t hash = 0, min_a = ~0u, max_a = 0;
+		bool relocate = false;
+		for (uint32_t i = 1; i < eh->e_phnum && hash == 0; i++) {
+			if ((ph[i].p_flags & MDT_TYPE_MASK) == MDT_TYPE_HASH) {
+				hash = i;
+			}
+		}
+		for (uint32_t i = 0; i < eh->e_phnum; i++) {
+			if (!loadable(&ph[i])) {
+				continue;
+			}
+			relocate |= (ph[i].p_flags & MDT_RELOCATABLE) != 0;
+			min_a = MIN(min_a, ph[i].p_paddr);
+			max_a = MAX(max_a, (ph[i].p_paddr + ph[i].p_memsz + 0xfff) & ~0xfffu);
+		}
+		LOG("mba: mba.mbn %lld bytes; modem.mdt %u phdrs, hash %u, %08x..%08x relocate %u", mba_size, eh->e_phnum, hash,
+		    min_a, max_a, relocate);
+		if (hash == 0 || ph[0].p_type == PT_LOAD || min_a > max_a || max_a - min_a > MPSS_SIZE) {
+			LOG("mba: unexpected modem.mdt layout");
+			goto out;
+		}
+
+		/* qcom_mdt_read_metadata: ELF header (phdr 0's filesz) + the hash segment */
+		uint32_t ehdr_size = ph[0].p_filesz, hash_size = ph[hash].p_filesz;
+		uint64_t meta_size = (uint64_t)ehdr_size + hash_size;
+		meta = (uint8_t *)pool_alloc(meta_size, &meta_pa);
+		if (meta == NULL || ehdr_size > (uint64_t)mdt_size) {
+			LOG("mba: metadata: %llu bytes, no room", meta_size);
+			goto out;
+		}
+		memcpy(meta, mdt, ehdr_size);
+		if (meta_size == (uint64_t)mdt_size) {
+			memcpy(meta + ehdr_size, mdt + ehdr_size, hash_size);     /* split, hash packed after the header */
+		} else if (ph[hash].p_offset + (uint64_t)hash_size <= (uint64_t)mdt_size) {
+			memcpy(meta + ehdr_size, mdt + ph[hash].p_offset, hash_size);
+		} else {
+			char hname[16];
+			snprintf(hname, sizeof(hname), "modem.b%02u", hash);
+			if (fw_read(hname, meta + ehdr_size, hash_size) != (int64_t)hash_size) {
+				goto out;
+			}
+		}
+		mb();
+
+		/* q6v5_mba_load */
+		mss_votes(true);
+		if ((r32(mss_gcc, GCC_BOOT_ROM_VOTE) & (1u << 10)) == 0) {                         /* proxy "mem" */
+			mss_clks_set |= 1u << 31;
+			w32(mss_gcc, GCC_BOOT_ROM_VOTE, r32(mss_gcc, GCC_BOOT_ROM_VOTE) | (1u << 10));
+		}
+		bool rom = mss_poll(mss_gcc, GCC_BOOT_ROM_HALT, Q6SS_CBCR_CLKOFF, 0, 200);
+		LOG("mba: clock mem (boot_rom_ahb): %08x%s", r32(mss_gcc, GCC_BOOT_ROM_HALT), rom ? "" : " STILL OFF");
+		w32(mss_gcc, GCC_MSS_RESTART, r32(mss_gcc, GCC_MSS_RESTART) & ~1u);                /* reset deassert */
+		IODelay(10);
+		bool clks = rom;
+		for (unsigned i = 0; i < sizeof(mss_active_clks) / sizeof(mss_active_clks[0]); i++) {
+			clks &= mss_clk_on(i);
+		}
+		if (!clks) {
+			goto fail;
+		}
+		LOG("mba: clocked: RESET %08x PWR_CTL %08x RMB PBL %08x MBA %08x", r32(q6ss, Q6SS_RESET), r32(q6ss, Q6SS_PWR_CTL),
+		    r32(rmb, RMB_PBL_STATUS), r32(rmb, RMB_MBA_STATUS));
+		if (r32(rmb, RMB_PBL_STATUS) != 0 || r32(rmb, RMB_MBA_STATUS) != 0) {
+			LOG("mba: the PBL/MBA ran already since the last reset: not touching the modem");
+			goto fail;
+		}
+		if (mss_assign("mpss", MPSS_PA, MPSS_SIZE, &mpss_perm, false, true) != 0 ||
