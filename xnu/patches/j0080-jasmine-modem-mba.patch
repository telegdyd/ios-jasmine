+static void
+board_setup(void)
+{
+	if (!sweet_board_is("xiaomi,jasmine")) {
+		return;
+	}
+	soc.jasmine = true;
+	/*
+	 * Free low DDR (Linux System RAM a0000000-bfffbfff, after the 4 MiB ramoops at 0xa0000000;
+	 * XNU runs from 0x1_00000000, the GPU pool is 0xc0000000-0xf6000000), inside the range
+	 * Linux takes the modem metadata from (mpss-metadata alloc-ranges 0xa0000000+0x20000000).
