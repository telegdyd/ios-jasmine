+#define CP_IB1_BUFSZ            0x0b21
+#define CP_IB2_BASE             0x0b22
+#define CP_IB2_BASE_HI          0x0b23
+#define CP_IB2_BUFSZ            0x0b24
+#define CP_SCRATCH(n)           (0x0b78 + (n))
+#define RBBM_AHB_ME_SPLIT_STATUS 0x04f0
+#define RBBM_AHB_PFP_SPLIT_STATUS 0x04f1
+#define RBBM_AHB_ETS_SPLIT_STATUS 0x04f3
