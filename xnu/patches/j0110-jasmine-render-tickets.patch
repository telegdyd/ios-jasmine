diff --git a/iokit/Kernel/arm/SweetSurface.h b/iokit/Kernel/arm/SweetSurface.h
index 5ac56f5..df5d68c 100644
--- a/iokit/Kernel/arm/SweetSurface.h
+++ b/iokit/Kernel/arm/SweetSurface.h
@@ -14,10 +14,61 @@
 #include <IOKit/IOMemoryDescriptor.h>
 #include <IOKit/IOBufferMemoryDescriptor.h>
 #include <libkern/c++/OSObject.h>
+#include <libkern/c++/OSArray.h>
 #include <mach/mach_types.h>
 
 #define SWEET_SURFACE_MAX_PLANES        20
 
+/* j0101: fLock in AppleCLCD protects tickets and their surface links. */
+class SweetSurface;
+#define SWEET_TICKET_PROOFS 1024
+#define SWEET_TICKET_RECEIPTS 256 /* newest terminal receipts kept per GPU connection */
+struct SweetSubmitProof {
+	uint64_t serial, issued;
+	uint32_t seqno;
+};
+struct SweetRenderOwner {
+	uint64_t generation, serial, errors, issued, identity;
+	uint32_t seqno;
+	SweetSubmitProof *proof;
+	bool closed;
+};
+
+class SweetRenderTicket : public OSObject {
+	OSDeclareDefaultStructors(SweetRenderTicket);
+public:
