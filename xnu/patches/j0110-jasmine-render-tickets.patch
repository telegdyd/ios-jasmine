+		for (unsigned i = fTickets ? fTickets->getCount() : 0; i > 0; i--) {
+			SweetRenderTicket *p = (SweetRenderTicket *)fTickets->getObject(i - 1);
+			if (__atomic_load_n(&p->generation, __ATOMIC_ACQUIRE) == in[1]) { t = p; t->retain(); break; }
+		}
+		IOLockUnlock(fLock);
+		if (!t) { sweet_ticket_unknown(); return kIOReturnNotFound; }
+		IOReturn ret = sweet_ticket_end(&fRender, t, in[2], in[3] == 1, (uint32_t)in[4]);
+		t->release();
+		return ret;
+	}
 	default:
 		return kIOReturnUnsupported;
 	}
diff --git a/iokit/Kernel/arm/SweetRenderTickets.inc b/iokit/Kernel/arm/SweetRenderTickets.inc
new file mode 100755
index 0000000..020aaf9
--- /dev/null
+++ b/iokit/Kernel/arm/SweetRenderTickets.inc
@@ -0,0 +1,355 @@
+/* j0101: included by SweetFramebuffer.cpp. All state uses AppleCLCD::fLock.
+ * No GPU/client/pool lock is taken here. Polls and last releases are outside it.
+ */
+OSDefineMetaClassAndStructors(SweetRenderTicket, OSObject);
+static SweetRenderTicket *sweet_ticket_list;
+static uint64_t sweet_render_epoch = 1;
+static uint64_t sweet_render_owner;
+static bool sweet_ticket_suspended;
+static uint32_t sweet_tickets_on;
+static uint64_t sweet_ticket_begins, sweet_ticket_seals, sweet_ticket_aborts;
+static uint64_t sweet_ticket_stale, sweet_ticket_errors, sweet_ticket_timeouts;
+static uint64_t sweet_ticket_live, sweet_ticket_high;
+
+static void
+sweet_ticket_unlink(SweetRenderTicket *t)
+{
+	SweetRenderTicket **p = &sweet_ticket_list;
+	while (*p && *p != t) { p = &(*p)->next; }
+	if (*p) { *p = t->next; }
+	t->next = NULL; t->listed = false;
+}
+
+static void
+sweet_ticket_metadata(SweetRenderTicket *t)
+{
+	sweet_bench_event(40, (uint32_t)t->generation, (uint32_t)(t->generation >> 32),
+	    (uint32_t)t->identity, (uint32_t)(t->identity >> 32));
+	sweet_bench_event(41, (uint32_t)t->generation, (uint32_t)(t->generation >> 32),
+	    (uint32_t)t->epoch, (uint32_t)(t->epoch >> 32));
+}
+
+void
+SweetRenderTicket::free()
+{
+	AppleCLCD *fb = sweet_fb_main;
+	if (listed && fb) {
+		IOLockLock(fb->fLock);
+		sweet_ticket_unlink(this);
+		IOLockUnlock(fb->fLock);
+	}
+	OSSafeReleaseNULL(backing);
+	OSObject::free();
+}
+
+bool
+sweet_tickets_enabled(void)
+{
+	return sweet_tickets_on != 0;
+}
+
+uint64_t
+sweet_ticket_query(uint64_t *epoch)
+{
+	AppleCLCD *fb = sweet_fb_main;
+	if (!fb) { *epoch = sweet_render_epoch; return 2; }
+	IOLockLock(fb->fLock);
+	*epoch = sweet_render_epoch;
+	uint64_t flags = 2 | (sweet_tickets_on ? 1 : 0) | (sweet_fb_sleeping ? 4 : 0) |
+	    (fb->fQueueActive && !sweet_ticket_suspended && !fb->fPowerOff && !fb->terminal() ? 8 : 0);
+	IOLockUnlock(fb->fLock);
+	return flags;
+}
+
+IOReturn
+sweet_ticket_begin(SweetRenderOwner *owner, SweetRenderTicket *t, SweetSurface **surfaces,
+    uint32_t count, uint64_t epoch)
+{
+	AppleCLCD *fb = sweet_fb_main;
+	if (!sweet_tickets_on || !fb) { return kIOReturnUnsupported; }
+	SweetRenderTicket *old[32] = {};
+	IOLockLock(fb->fLock);
+	IOReturn ret = kIOReturnSuccess;
+	if (owner->closed || !fb->fQueueActive || sweet_ticket_suspended || fb->fPowerOff || fb->terminal() || epoch != sweet_render_epoch) {
+		sweet_ticket_stale++; ret = kIOReturnAborted;
+	} else if (owner->generation == ~0ull || owner->issued == ~0ull || owner->serial == ~0ull ||
+	    owner->errors == ~0ull || (!owner->identity && sweet_render_owner == ~0ull)) {
+		ret = kIOReturnBusy;
+	}
+	for (unsigned i = 0; ret == kIOReturnSuccess && i < count; i++) {
+		SweetSurface *s = surfaces[i];
+		SweetRenderTicket *p = s->renderTicket;
+		if (s->displayWriters || fb->writeState(s) || (p && (p->status == 0 || p->backing))) { ret = kIOReturnBusy; }
+		for (unsigned j = 0; j < i; j++) { if (s == surfaces[j]) { ret = kIOReturnBadArgument; } }
+	}
+	if (ret == kIOReturnSuccess) {
+		t->owner = owner;
+		__atomic_store_n(&t->generation, ++owner->generation, __ATOMIC_RELEASE);
+		t->epoch = epoch;
+		t->serial = owner->serial;
+		t->issued = owner->issued;
+		if (!owner->identity) { owner->identity = ++sweet_render_owner; }
+		t->identity = owner->identity;
+		t->errors = owner->errors;
+		t->status = t->seqno = 0;
+		t->next = sweet_ticket_list; sweet_ticket_list = t; t->listed = true;
+		sweet_ticket_metadata(t);
+		for (unsigned i = 0; i < count; i++) {
+			old[i] = surfaces[i]->renderTicket;
+			t->retain(); surfaces[i]->renderTicket = t;
+			sweet_bench_event(30, surfaces[i]->id, (uint32_t)t->generation,
+			    (uint32_t)(t->generation >> 32), (uint32_t)epoch);
+		}
+		sweet_ticket_begins++; sweet_ticket_live++;
+		if (sweet_ticket_live > sweet_ticket_high) { sweet_ticket_high = sweet_ticket_live; }
+	}
+	IOLockUnlock(fb->fLock);
+	for (unsigned i = 0; i < count; i++) { OSSafeReleaseNULL(old[i]); }
+	return ret;
+}
+
+IOReturn
+sweet_ticket_proof(SweetRenderOwner *owner, SweetRenderTicket *t, uint32_t seqno)
+{
+	if (!seqno || !owner->proof || owner->errors != t->errors) { return kIOReturnBadArgument; }
+	for (unsigned i = 0; i < SWEET_TICKET_PROOFS; i++) {
+		SweetSubmitProof &p = owner->proof[i];
+		if (p.seqno == seqno && p.serial > t->serial && p.issued > t->issued) { return kIOReturnSuccess; }
+	}
+	return kIOReturnBadArgument; /* never infer success from a global/evicted fence */
+}
+
+bool
+sweet_ticket_owner_prepare(SweetRenderOwner *owner)
+{
+	AppleCLCD *fb = sweet_fb_main;
+	if (!fb) { return false; }
+	IOLockLock(fb->fLock); bool have = owner->proof != NULL; IOLockUnlock(fb->fLock);
+	if (have) { return true; }
+	SweetSubmitProof *proof = IONewZero(SweetSubmitProof, SWEET_TICKET_PROOFS);
+	IOLockLock(fb->fLock);
+	if (!owner->proof) { owner->proof = proof; proof = NULL; }
+	have = owner->proof != NULL;
+	IOLockUnlock(fb->fLock);
+	if (proof) { IODelete(proof, SweetSubmitProof, SWEET_TICKET_PROOFS); }
+	return have;
+}
+
+IOReturn
+sweet_ticket_end(SweetRenderOwner *owner, SweetRenderTicket *t, uint64_t epoch,
+    bool abort, uint32_t seqno)
+{
+	AppleCLCD *fb = sweet_fb_main;
+	if (!fb || !sweet_tickets_on) { return kIOReturnUnsupported; }
+	OSArray *backing = NULL;
+	IOLockLock(fb->fLock);
+	IOReturn ret = kIOReturnSuccess;
+	if (t->owner != owner || t->epoch != epoch) {
+		sweet_ticket_stale++; ret = kIOReturnAborted;
+	} else if (t->status) {
+		if (!(abort && t->status == 2) && !(t->status == 1 && !abort && t->seqno == seqno)) {
+			sweet_ticket_stale++; ret = t->status == 2 ? kIOReturnAborted : kIOReturnBusy;
+		}
+		if (abort && t->status == 2) {
+			backing = t->backing; t->backing = NULL;
+			sweet_ticket_unlink(t);
+		}
+	} else if (epoch != sweet_render_epoch || fb->terminal()) {
+		sweet_ticket_stale++; ret = kIOReturnAborted;
+	} else if (!abort && sweet_ticket_proof(owner, t, seqno) != kIOReturnSuccess) {
+		sweet_ticket_errors++; ret = kIOReturnBadArgument;
+	} else {
+		t->status = abort ? 2 : 1; t->seqno = seqno;
+		if (abort) { sweet_ticket_aborts++; } else { sweet_ticket_seals++; }
+		sweet_ticket_live--;
+		sweet_ticket_metadata(t);
+		sweet_bench_event(abort ? 37 : 31, (uint32_t)t->generation,
+		    (uint32_t)(t->generation >> 32), seqno, abort ? 1 : 0);
+		backing = t->backing; t->backing = NULL;
+		sweet_ticket_unlink(t);
+		IOLockWakeup(fb->fLock, fb->fQueueRec, false);
+	}
+	IOLockUnlock(fb->fLock);
+	OSSafeReleaseNULL(backing);
+	return ret;
+}
+
+uint64_t
+sweet_ticket_submit_enter(SweetRenderOwner *owner)
+{
+	AppleCLCD *fb = sweet_fb_main;
+	if (!sweet_tickets_on || !fb) { return 0; }
+	IOLockLock(fb->fLock);
+	uint64_t issued = owner->issued == ~0ull ? 0 : ++owner->issued;
+	IOLockUnlock(fb->fLock);
+	return issued;
+}
+
+void
+sweet_ticket_submit(SweetRenderOwner *owner, uint64_t issued, uint32_t seqno, bool success)
+{
+	AppleCLCD *fb = sweet_fb_main;
+	if (!sweet_tickets_on || !fb) { return; }
+	IOLockLock(fb->fLock);
+	if (success && owner->serial != ~0ull) {
+		owner->serial++; owner->seqno = seqno;
+		if (owner->proof) {
+			SweetSubmitProof &p = owner->proof[owner->serial % SWEET_TICKET_PROOFS];
+			p.serial = owner->serial; p.issued = issued; p.seqno = seqno;
+		}
+	}
+	else { if (owner->errors != ~0ull) { owner->errors++; } sweet_ticket_errors++; }
+	IOLockUnlock(fb->fLock);
+}
+
+/* Cancel first, then detach each backing retain outside fLock. UC/job/CA holds
+ * cover in-flight writers; closing a GPU UC still proves quiescence or quarantines.
+ */
+void
+sweet_ticket_cancel(SweetRenderOwner *owner)
+{
+	AppleCLCD *fb = sweet_fb_main;
+	if (!sweet_tickets_on || !fb) { return; }
+	IOLockLock(fb->fLock);
+	if (!owner) {
+		sweet_render_epoch++; sweet_ticket_suspended = true;
+		sweet_bench_event(35, fb->fEpoch, 20, (uint32_t)sweet_render_epoch, (uint32_t)(sweet_render_epoch >> 32));
+	}
+	else { owner->closed = true; }
+	for (SweetRenderTicket *t = sweet_ticket_list; t; t = t->next) {
+		if ((!owner || t->owner == owner) && t->status == 0) {
+			t->status = 2; t->cancelled = true; sweet_ticket_live--; sweet_ticket_aborts++;
+			sweet_ticket_metadata(t);
+			sweet_bench_event(37, (uint32_t)t->generation, (uint32_t)(t->generation >> 32), 0, 2);
+		}
+	}
+	IOLockWakeup(fb->fLock, fb->fQueueRec, false);
+	IOLockUnlock(fb->fLock);
+	/* A display cancellation cannot drain TC. Its callback still owns these
+	 * imports until it has drained/aborted. GPU close has quiesced calls (or
+	 * retained the entire UC), so it can detach them immediately. */
+	if (!owner) { return; }
+	for (;;) {
+		IOLockLock(fb->fLock);
+		OSArray *backing = NULL;
+		for (SweetRenderTicket *t = sweet_ticket_list; t; t = t->next) {
+			if ((!owner || t->owner == owner) && t->status == 2 && t->backing) {
+				backing = t->backing; t->backing = NULL;
+				sweet_ticket_unlink(t); break;
+			}
+		}
+		IOLockUnlock(fb->fLock);
+		if (!backing) { break; }
+		backing->release();
+	}
+}
+
+/* Called under fLock by the presenter; the retained ticket is its snapshot. */
+IOReturn
+sweet_ticket_ready(SweetRenderTicket *t, uint32_t done, uint32_t *seqno)
+{
+	if (!t) { return kIOReturnSuccess; }
+	if (t->status == 2 || sweet_fb_main->terminal()) { return kIOReturnAborted; }
+	if (t->status == 1 && t->seqno && (int32_t)(done - t->seqno) >= 0) {
+		*seqno = t->seqno; return kIOReturnSuccess;
+	}
+	/* No deadline of its own: BEGIN is the frame's first draw, so CA's CPU work, shader
+	 * variants compiled in the drain and heavy GPU jobs all count against it. A slow
+	 * frame is not a fault; the presenter and CPU readers bound their own waits. */
+	return kIOReturnNotReady;
+}
+
+/* After a boot fallback, a later synchronous frame uses the legacy fence.
+ * Queue snapshots retain the old terminal ticket, so this cannot ready a drop.
+ */
+void
+sweet_ticket_legacy_write(SweetSurface *s, bool cpu)
+{
+	AppleCLCD *fb = sweet_fb_main;
+	if (!sweet_tickets_on || !fb) { return; }
+	SweetRenderTicket *old = NULL;
+	IOLockLock(fb->fLock);
+	if ((!fb->fQueueActive || cpu) && s->renderTicket && s->renderTicket->status && !s->renderTicket->backing) {
+		old = s->renderTicket; s->renderTicket = NULL;
+	}
+	IOLockUnlock(fb->fLock);
+	OSSafeReleaseNULL(old);
+}
+
+int
+sweet_ticket_cpu_write_begin(SweetSurface *s)
+{
+	AppleCLCD *fb = sweet_fb_main;
+	if (!fb) { return 0; }
+	IOLockLock(fb->fLock);
+	uint32_t state = fb->writeState(s);
+	bool pending = s->renderTicket && (s->renderTicket->status == 0 || s->renderTicket->backing);
+	if (state || pending || fb->terminal()) {
+		if (state) { fb->fGuard[state]++; fb->fGuardReject[state]++; }
+		sweet_bench_event(36, s->id, state, 1, 0);
+		if (state || fb->terminal()) { fb->queueFallback(17); } /* pending only: not on the display */
+		IOLockUnlock(fb->fLock); return -1;
+	}
+	if (!fb->fQueueActive) { IOLockUnlock(fb->fLock); return 0; }
+	s->displayWriters++; fb->fWriters++;
+	IOLockUnlock(fb->fLock);
+	return 1;
+}
+
+IOReturn
+sweet_ticket_wait(SweetSurface *s, bool sync)
+{
+	AppleCLCD *fb = sweet_fb_main;
+	if (!sweet_tickets_on || !fb || !sync) { return kIOReturnSuccess; }
+	IOLockLock(fb->fLock);
+	SweetRenderTicket *t = s->renderTicket;
+	if (t) { t->retain(); }
+	IOLockUnlock(fb->fLock);
+	if (!t) { return kIOReturnSuccess; }
+	uint64_t until, start = mach_absolute_time(), ns = 0;
+	clock_interval_to_deadline(100, kMillisecondScale, &until);
+	IOReturn ret;
+	for (;;) {
+		uint32_t done = sweet_gpu_completed(), seq = 0;
+		IOLockLock(fb->fLock);
+		ret = sweet_ticket_ready(t, done, &seq);
+		IOLockUnlock(fb->fLock);
+		if (ret != kIOReturnNotReady) { break; }
+		if (mach_absolute_time() >= until) { ret = kIOReturnTimeout; break; }
+		IOSleep(1);
+	}
+	absolutetime_to_nanoseconds(mach_absolute_time() - start, &ns);
+	sweet_ticket_metadata(t);
+	sweet_bench_event(38, s->id, (uint32_t)t->generation, (uint32_t)ret, (uint32_t)(ns / 1000));
+	t->release();
+	if (ret == kIOReturnTimeout) { IOLockLock(fb->fLock); sweet_ticket_timeouts++; IOLockUnlock(fb->fLock); }
+	return ret;
+}
+
+void
+sweet_ticket_stats(void)
+{
+	if (!sweet_tickets_on) { return; }
+	/* Caller holds fLock. Cumulative counters, not a liveness assertion. */
+	IOLog("SWEET FB: tickets begin/seal/abort %llu/%llu/%llu stale/error/timeout %llu/%llu/%llu live/high %llu/%llu epoch %llu\n",
+	    sweet_ticket_begins, sweet_ticket_seals, sweet_ticket_aborts, sweet_ticket_stale,
+	    sweet_ticket_errors, sweet_ticket_timeouts, sweet_ticket_live, sweet_ticket_high, sweet_render_epoch);
+}
+
+void
+sweet_ticket_gpu_stats(void)
+{
+	AppleCLCD *fb = sweet_fb_main;
+	if (!sweet_tickets_on || !fb) { return; }
+	IOLockLock(fb->fLock);
+	sweet_ticket_stats();
+	IOLockUnlock(fb->fLock);
+}
+
+void
+sweet_ticket_unknown(void)
+{
+	AppleCLCD *fb = sweet_fb_main;
+	if (!sweet_tickets_on || !fb) { return; }
+	IOLockLock(fb->fLock); sweet_ticket_stale++; IOLockUnlock(fb->fLock);
+}
