 bsd/dev/sweet_nvt.c                      | 419 +++++++++++++++++++++++
 iokit/Kernel/arm/SweetPlatformExpert.cpp |   3 +
 iokit/Kernel/arm/hid/SweetHID.cpp        |  23 +-
 4 files changed, 437 insertions(+), 9 deletions(-)
