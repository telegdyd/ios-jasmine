+int sweet_gic_spi_route(uint32_t intid, uint64_t mpidr, uint32_t group_word[3]);
+int
+sweet_gic_spi_route(uint32_t intid, uint64_t mpidr, uint32_t group_word[3])
+{
+	if (gicd_base == 0 || intid < 32 || intid >= 1020) {
