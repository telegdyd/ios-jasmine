+int sweet_gic_dump(char *out, size_t len);
+int
+sweet_gic_dump(char *out, size_t len)
+{
+	if (gicd_base == 0) {
+		return 0;
+	}
+	int n = snprintf(out, len, "  GICD_CTLR 0x%08x TYPER 0x%08x IIDR 0x%08x\n",
+	    gicd_read32(GICD_CTLR), gicd_read32(0x004), gicd_read32(0x008));
+	const uint32_t base[3] = { 0x080, 0x100, 0xD00 };
+	const char *name[3] = { "IGROUPR", "ISENABLER", "IGRPMODR" };
