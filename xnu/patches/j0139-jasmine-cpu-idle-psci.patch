+/* A 32-bit MMIO store from a real register, never wzr (see sweet_gic_spi_route). */
+void sweet_mmio_w32(vm_offset_t addr, uint32_t v);
+void
+sweet_mmio_w32(vm_offset_t addr, uint32_t v)
+{
+	__asm__ volatile ("str %w1, [%0]" : : "r"(addr), "r"(v) : "memory");
+}
+
+/* j0139 diagnostics: GICD_TYPER, IGROUPR, ISENABLER and IGRPMODR words 0-15 as the
