diff --git a/iokit/Kernel/arm/SweetGPU.cpp b/iokit/Kernel/arm/SweetGPU.cpp
--- a/iokit/Kernel/arm/SweetGPU.cpp
+++ b/iokit/Kernel/arm/SweetGPU.cpp
@@ -85,6 +85,9 @@ uint64_t sweet_gpu_bulk_bytes(void);
 void sweet_gpu_flush_all(void);
 int sweet_board_is(const char *compat);
 uint64_t topaz_gpu_pool_alloc(uint64_t size, void **va);
+uint64_t topaz_gpu_pool_alloc_in(uint64_t size, void **va, unsigned first, unsigned end);
+void topaz_gpu_pool_info(unsigned first, unsigned end, unsigned *chunks, uint64_t *free,
+    uint64_t *largest, unsigned *ranges, uint64_t *lost);
 void topaz_gpu_pool_free(uint64_t pa, uint64_t size);
 bool topaz_gpu_pool_place(uint64_t base, uint64_t size);
 IOMemoryDescriptor *topaz_gpu_pool_md(uint64_t pa, uint64_t size);
@@ -146,6 +149,114 @@ static uint32_t sweet_gpu_lazy = 1;     /* surface upkeep at the CPU's and GPU's
 static bool sweet_gpu_pool;             /* jasmine: buffers from the write-combined GPU pool */
 static IOLock *sweet_gpu_pool_lock;
 
+/*
+ * j0122: the pool is shared first-fit by every Metal process. With all wallpaper
+ * providers on Metal at once it ran out ("pool has no 12582912 bytes left") and
+ * the window server, whose display frames must come from it (MDP scaling),
+ * competed with them. The last sweetpool_bb chunks (64 MB each, default 4) are
+ * backboardd's alone; backboardd takes those first, then the shared ones like
+ * everyone else. Other processes fall back to cacheable memory when the shared
+ * part is full, as before. sweetpool_bb=0: one shared pool (the old behaviour).
+ * Pool bytes are accounted per process for the log (fLock-free: pool lock).
+ */
+#define SWEET_POOL_OWNERS 24
+static struct { int pid; char name[20]; uint64_t bytes, peak; uint32_t fails; } sweet_pool_owner[SWEET_POOL_OWNERS];
+static uint64_t sweet_pool_frames;      /* backboardd's display frames (SweetSurface) */
+static uint32_t sweet_pool_fails;
+static unsigned sweet_pool_chunks, sweet_pool_bb_first;
+
+static bool
+sweet_pool_is_compositor(const char *name)
+{
+	return strcmp(name, "backboardd") == 0;
+}
+
+/* the owner slot for this process (pool lock held): -1 when the table is full */
+static int
+sweet_pool_owner_slot(int pid, const char *name)
+{
+	int empty = -1;
+	for (int i = 0; i < SWEET_POOL_OWNERS; i++) {
+		if (sweet_pool_owner[i].pid == pid && strcmp(sweet_pool_owner[i].name, name) == 0) {
+			return i;
+		}
+		if (empty < 0 && sweet_pool_owner[i].bytes == 0 && sweet_pool_owner[i].fails == 0) {
+			empty = i;
+		}
+	}
+	if (empty < 0) {
+		/* reuse a gone process's slot that only counted failures */
+		for (int i = 0; i < SWEET_POOL_OWNERS && empty < 0; i++) {
+			if (sweet_pool_owner[i].bytes == 0) {
+				empty = i;
+			}
+		}
+	}
+	if (empty >= 0) {
+		sweet_pool_owner[empty].pid = pid;
+		strlcpy(sweet_pool_owner[empty].name, name, sizeof(sweet_pool_owner[empty].name));
+		sweet_pool_owner[empty].bytes = sweet_pool_owner[empty].peak = 0;
+		sweet_pool_owner[empty].fails = 0;
+	}
+	return empty;
+}
+
+/* pool memory for a process (pool lock held): the compositor's own chunks first */
+static uint64_t
+sweet_pool_alloc_for(uint64_t size, void **va, bool compositor)
+{
+	uint64_t pa = 0;
+	if (compositor && sweet_pool_bb_first < sweet_pool_chunks) {
+		pa = topaz_gpu_pool_alloc_in(size, va, sweet_pool_bb_first, sweet_pool_chunks);
+	}
+	if (pa == 0) {
+		pa = topaz_gpu_pool_alloc_in(size, va, 0, sweet_pool_bb_first);
+	}
+	return pa;
+}
+
+/* one line: shared and reserved free space, fragmentation, the biggest owners (pool lock held) */
+static void
+sweet_pool_log(const char *why)
+{
+	unsigned chunks, ranges;
+	uint64_t sfree, slargest, rfree, rlargest, lost;
+	topaz_gpu_pool_info(0, sweet_pool_bb_first, &chunks, &sfree, &slargest, &ranges, &lost);
+	topaz_gpu_pool_info(sweet_pool_bb_first, sweet_pool_chunks, &chunks, &rfree, &rlargest, &ranges, &lost);
+	char top[200];
+	size_t at = 0;
+	top[0] = 0;
+	bool used[SWEET_POOL_OWNERS] = {};
+	for (int n = 0; n < 6; n++) {
+		int best = -1;
+		for (int i = 0; i < SWEET_POOL_OWNERS; i++) {
+			if (!used[i] && (sweet_pool_owner[i].bytes != 0 || sweet_pool_owner[i].fails != 0) &&
+			    (best < 0 || sweet_pool_owner[i].bytes > sweet_pool_owner[best].bytes)) {
+				best = i;
+			}
+		}
+		if (best < 0 || at >= sizeof(top) - 1) {
+			break;
+		}
+		used[best] = true;
+		/* name[pid] now/peak MB, then the fallbacks it had */
+		int w = snprintf(top + at, sizeof(top) - at, " %s[%d] %llu/%llu MB", sweet_pool_owner[best].name,
+		    sweet_pool_owner[best].pid, sweet_pool_owner[best].bytes >> 20, sweet_pool_owner[best].peak >> 20);
+		if (w > 0 && (size_t)w < sizeof(top) - at && sweet_pool_owner[best].fails) {
+			at += (size_t)w;
+			w = snprintf(top + at, sizeof(top) - at, " (%u fallbacks)", sweet_pool_owner[best].fails);
+		}
+		if (w <= 0 || (size_t)w >= sizeof(top) - at) {
+			break;
+		}
+		at += (size_t)w;
+	}
+	IOLog("SWEET POOL: %s: shared %llu MB free (largest %llu) of %u chunks, backboardd's %llu MB free (largest %llu) "
+	    "of %u; frames %llu MB; %u free ranges, %llu MB lost; %u fallbacks; by owner:%s\n", why,
+	    sfree >> 20, slargest >> 20, sweet_pool_bb_first, rfree >> 20, rlargest >> 20,
+	    sweet_pool_chunks - sweet_pool_bb_first, sweet_pool_frames >> 20, ranges, lost >> 20, sweet_pool_fails, top);
+}
+
 /*
  * j0058: SweetSurface takes jasmine's window-server frames from the pool too (the MDP scans
  * them), under the lock of Mesa's buffers. topaz has no lock here, as before.
@@ -163,8 +274,8 @@ sweet_gpu_pool_take(uint64_t size, void **va)
 		return topaz_gpu_pool_alloc(size, va);
 	}
 	IOLockLock(sweet_gpu_pool_lock);
-	uint64_t pa = topaz_gpu_pool_alloc(size, va);
-	if (pa != 0) { sweet_bench_alloc(4, (int64_t)size); }
+	uint64_t pa = sweet_pool_alloc_for(size, va, true);     /* backboardd's frames only (sweet_gpu_pool_eligible) */
+	if (pa != 0) { sweet_bench_alloc(4, (int64_t)size); sweet_pool_frames += size; }
 	IOLockUnlock(sweet_gpu_pool_lock);
 	return pa;
 }
@@ -179,6 +290,7 @@ sweet_gpu_pool_give(uint64_t pa, uint64_t size)
 	IOLockLock(sweet_gpu_pool_lock);
 	topaz_gpu_pool_free(pa, size);
 	sweet_bench_alloc(4, -(int64_t)size);
+	sweet_pool_frames -= size;
 	IOLockUnlock(sweet_gpu_pool_lock);
 }
 
