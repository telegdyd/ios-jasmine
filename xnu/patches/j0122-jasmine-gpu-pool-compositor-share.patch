@@ -287,13 +400,32 @@ SweetGPUBuffer::create(uint64_t size, bool readonly)
 	if (sweet_gpu_pool) {
 		void *va = NULL;
 		IOLockLock(sweet_gpu_pool_lock);
-		uint64_t pa = topaz_gpu_pool_alloc(size, &va);
+		uint64_t pa = sweet_pool_alloc_for(size, &va, sweet_pool_is_compositor(owner));
+		int slot = sweet_pool_owner_slot(proc_selfpid(), owner);
+		if (pa != 0 && slot >= 0) {
+			sweet_pool_owner[slot].bytes += size;
+			if (sweet_pool_owner[slot].bytes > sweet_pool_owner[slot].peak) {
+				sweet_pool_owner[slot].peak = sweet_pool_owner[slot].bytes;
+			}
+		}
+		if (pa == 0) {
+			sweet_pool_fails++;
+			if (slot >= 0) {
+				sweet_pool_owner[slot].fails++;
+			}
+			if (sweet_pool_fails <= 4 || (sweet_pool_fails & 63) == 0) {
+				char why[64];
+				snprintf(why, sizeof(why), "%s wanted %llu KB", owner, size >> 10);
+				sweet_pool_log(why);
+			}
+		}
 		IOLockUnlock(sweet_gpu_pool_lock);
 		/* the descriptor carries the cache mode: the client's mapping is write-combined too */
 		IOMemoryDescriptor *pm = pa != 0 ? topaz_gpu_pool_md(pa, size) : NULL;
 		if (pm != NULL && pm->prepare() == kIOReturnSuccess) {
 			b->md = pm;
 			b->poolPA = pa;
+			b->poolOwner = slot;
 			sweet_bench_alloc(4, (int64_t)size);
 			b->kva = (uintptr_t)va;
 			b->flush = false;
@@ -310,6 +442,9 @@ SweetGPUBuffer::create(uint64_t size, bool readonly)
 		if (pa != 0) {
 			IOLockLock(sweet_gpu_pool_lock);
 			topaz_gpu_pool_free(pa, size);
+			if (slot >= 0) {
+				sweet_pool_owner[slot].bytes -= size;
+			}
 			IOLockUnlock(sweet_gpu_pool_lock);
 		}
 		static uint32_t told;
@@ -413,6 +548,9 @@ SweetGPUBuffer::free()
 			IOLockLock(sweet_gpu_pool_lock);
 			topaz_gpu_pool_free(poolPA, size);
 			sweet_bench_alloc(4, -(int64_t)size);
+			if (poolOwner >= 0) {
+				sweet_pool_owner[poolOwner].bytes -= size;
+			}
 			IOLockUnlock(sweet_gpu_pool_lock);
 			poolPA = 0;
 		}
@@ -824,6 +962,11 @@ SweetGPUUserClient::account(uint64_t t0, uint64_t bytes, bool submit, uint32_t n
 		    fStatBytes >> 20, fStatNs / NSEC_PER_MSEC, fStatBulk, sweet_gpu_held_draws,
 		    sweet_gpu_panel_waits, sweet_gpu_panel_us / 1000, sweet_gpu_nbo_zero, sweet_fb_sleep_us(), sweet_fb_spin_us(), sweet_gpu_protected_listings);
 		sweet_ticket_gpu_stats();
+		if (sweet_gpu_pool && sweet_pool_is_compositor(fName)) {
+			IOLockLock(sweet_gpu_pool_lock);
+			sweet_pool_log("every 10 s");
+			IOLockUnlock(sweet_gpu_pool_lock);
+		}
 		sweet_gpu_held_draws = sweet_gpu_panel_waits = 0;
 		sweet_gpu_panel_us = 0;
 		fStatT0 = now;
@@ -888,7 +1031,7 @@ SweetGPUUserClient::externalMethod(uint32_t selector, IOExternalMethodArguments
 		if (nin < 2 || args->scalarOutputCount < 2) {
 			return kIOReturnBadArgument;
 		}
-		SweetGPUBuffer *b = SweetGPUBuffer::create(in[0], (in[1] & 1) != 0);
+		SweetGPUBuffer *b = SweetGPUBuffer::create(in[0], (in[1] & 1) != 0, fName);
 		if (b == NULL) {
 			sweet_bench_alloc(6, 1);
 			return kIOReturnNoMemory;
@@ -1262,6 +1405,18 @@ sweet_gpu_publish(void)
 		sweet_gpu_pool = pa != 0;
 		if (pa != 0) {
 			topaz_gpu_pool_free(pa, 0x10000);
+			unsigned chunks, ranges;
+			uint64_t free, largest, lost;
+			topaz_gpu_pool_info(0, 0, &chunks, &free, &largest, &ranges, &lost);
+			uint32_t bb = 4;
+			(void)PE_parse_boot_argn("sweetpool_bb", &bb, sizeof(bb));
+			sweet_pool_chunks = chunks;
+			sweet_pool_bb_first = bb < chunks ? chunks - bb : 0;
+			if (bb == 0) {
+				sweet_pool_bb_first = chunks;
+			}
+			IOLog("SWEET POOL: %u chunks of 64 MB, the last %u backboardd's alone (sweetpool_bb)\n",
+			    chunks, chunks - sweet_pool_bb_first);
 		}
 		IOLog("SWEET GPU: pool %#llx-%#llx (shim at %#llx, %#llx bytes): %s\n", lo, hi, shim, shimsz,
 		    sweet_gpu_pool ? "buffers write-combined from it" : "NOT usable, cacheable buffers");
