+/*
+ * j0122: the pool's state for the log. chunks: how many; free/largest: in chunks [first, end);
+ * ranges: free ranges recorded (of 2048); lost: freed bytes the full list dropped.
+ */
+extern "C" void topaz_gpu_pool_info(unsigned first, unsigned end, unsigned *chunks, uint64_t *free,
+    uint64_t *largest, unsigned *ranges, uint64_t *lost);
+void
+topaz_gpu_pool_info(unsigned first, unsigned end, unsigned *chunks, uint64_t *free,
+    uint64_t *largest, unsigned *ranges, uint64_t *lost)
+{
+	uint64_t lo = GPU_POOL_BASE + first * GPU_POOL_CHUNK, hi = GPU_POOL_BASE + (uint64_t)end * GPU_POOL_CHUNK;
+	*chunks = (unsigned)GPU_POOL_CHUNKS;
+	*free = *largest = 0;
+	for (unsigned i = 0; gpu_pool_ready && i < pool_free_count; i++) {
+		if (pool_free[i].start >= lo && pool_free[i].start < hi) {
+			*free += pool_free[i].size;
+			if (pool_free[i].size > *largest) {
+				*largest = pool_free[i].size;
+			}
+		}
+	}
+	*ranges = pool_free_count;
+	*lost = pool_free_lost;
+}
