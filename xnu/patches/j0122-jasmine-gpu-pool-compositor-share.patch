Subject: [PATCH] jasmine-j0122: GPU pool share for backboardd, per-process pool log, wallpaper sampler

diff --git a/bsd/dev/sweet_sample.c b/bsd/dev/sweet_sample.c
--- a/bsd/dev/sweet_sample.c
+++ b/bsd/dev/sweet_sample.c
@@ -3,7 +3,8 @@
  *
  * The phone has no debugger and daemons log nowhere readable. Every
  * interval a kernel thread prints, for each process named in boot-arg
- * sweetsample (comma separated, default "SpringBoard,backboardd"; "-" = off)
+ * sweetsample (comma separated, default "SpringBoard,backboardd,@wallpaper"; "-" = off;
+ * j0122: @wallpaper = PosterBoard and every *Poster, *PosterExtension, *PosterProvider)
  * and for each of its threads, the user pc/lr/sp and a frame-pointer
  * backtrace as "SMP name[pid] tN pc ... lr ... bt ..." (header line with the
  * shared region slide and the main binary's mach header, to symbolicate
@@ -35,6 +36,13 @@ static char sweet_sample_names[128];
 static volatile bool sweet_sample_off;          /* j0097: a reboot runs */
 static bool sweet_sample_force;                 /* j0097: sdw_sample=1 test pass */
 
+static bool
+sweet_sample_ends(const char *name, size_t n, const char *tail)
+{
+	size_t tn = strlen(tail);
+	return n > tn && strcmp(name + n - tn, tail) == 0;
+}
+
 static bool
 sweet_sample_wanted(const char *name)
 {
@@ -45,6 +53,11 @@ sweet_sample_wanted(const char *name)
 		if (tl == n && n > 0 && strncmp(t, name, n) == 0) {
 			return true;
 		}
+		if (tl == 10 && strncmp(t, "@wallpaper", 10) == 0 && (strcmp(name, "PosterBoard") == 0 ||
+		    sweet_sample_ends(name, n, "Poster") || sweet_sample_ends(name, n, "PosterExtension") ||
+		    sweet_sample_ends(name, n, "PosterProvider"))) {
+			return true;
+		}
 		if (!end) {
 			break;
 		}
@@ -77,7 +90,7 @@ sweet_sample_thread(__unused void *arg, __unused wait_result_t wr)
 {
 	static int chan;
 	if (!PE_parse_boot_argn("sweetsample", sweet_sample_names, sizeof(sweet_sample_names))) {
-		strlcpy(sweet_sample_names, "SpringBoard,backboardd", sizeof(sweet_sample_names));
+		strlcpy(sweet_sample_names, "SpringBoard,backboardd,@wallpaper", sizeof(sweet_sample_names));
