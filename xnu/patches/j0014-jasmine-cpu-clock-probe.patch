 extern "C" void sweet_rtc_set(uint64_t secs);
 /* bsd/dev/sweet_nvt.c: jasmine touch (ADT /sweet-touch) */
 extern "C" void sweet_nvt_init(void);
+/* osfmk/arm64/sweet_cpuclk.c: measured CPU clock, logged 20 s and 120 s in */
+extern "C" void sweet_cpuclk_start(void);
 
 class SweetPlatformExpert : public IODTPlatformExpert {
 	OSDeclareDefaultStructors(SweetPlatformExpert);
@@ -240,6 +242,7 @@ SweetPlatformExpert::start(IOService *provider)
 	if (rtc) {
 		publishResource("IORTC", this);
 	}
+	sweet_cpuclk_start();
 	return true;
 }
 
diff --git a/osfmk/arm64/sweet_cpuclk.c b/osfmk/arm64/sweet_cpuclk.c
new file mode 100644
index 0000000..da5fc31
--- /dev/null
+++ b/osfmk/arm64/sweet_cpuclk.c
@@ -0,0 +1,150 @@
+/*
+ * CPU clock probe (jasmine bring-up, read only): how fast do the cores really
+ * run? Nothing sets the Kryo 260 clocks after the bootloader (no cpufreq in
+ * the DT, none in Linux either). For each CPU: the PMU cycle counter
+ * (PMCCNTR_EL0) and a chain of dependent adds (1 per cycle on an A73-class
+ * core) against the 19.2 MHz system counter, 100 ms with interrupts off,
+ * bound to that CPU. Runs 20 s and 120 s after start. sweetclk=0 disables it.
+ */
+#include <pexpert/arm64/board_config.h>
+
+#if defined(SWEET)
+#include <stdint.h>
+#include <kern/misc_protos.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/processor.h>
+#include <kern/sched_prim.h>
+#include <arm/machine_routines.h>
+#include <arm/cpu_internal.h>
+#include <pexpert/pexpert.h>
+
+void sweet_cpuclk_start(void);
+
+static int sweet_cpuclk_chan;
+
+static void
+cpuclk_sleep(uint32_t secs)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(secs, NSEC_PER_SEC, &deadline);
+	(void)assert_wait_deadline(&sweet_cpuclk_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static inline uint64_t
+cntvct(void)
+{
+	uint64_t v;
+	__asm__ volatile ("isb; mrs %0, cntvct_el0" : "=r"(v));
+	return v;
+}
+
+/* one CPU: cycles and dependent adds per counter tick over ~100 ms */
+static void
+cpuclk_measure(int cpu, uint64_t freq)
+{
+	uint64_t pmcr, en, c0, c1, t0, t1, adds = 0, x = 0;
+	boolean_t istate = ml_set_interrupts_enabled(FALSE);
+
+	__asm__ volatile ("mrs %0, pmcr_el0" : "=r"(pmcr));
+	__asm__ volatile ("mrs %0, pmcntenset_el0" : "=r"(en));
+	__asm__ volatile ("msr pmcr_el0, %0; msr pmcntenset_el0, %1; isb" :: "r"(pmcr | 1), "r"(1ull << 31));
+	__asm__ volatile ("isb; mrs %0, pmccntr_el0" : "=r"(c0));
+	t0 = cntvct();
+	do {
+		t1 = cntvct();
+	} while (t1 - t0 < freq / 10);
+	__asm__ volatile ("isb; mrs %0, pmccntr_el0" : "=r"(c1));
+
+	/* 32 dependent adds per pass: the chain, not the loop, sets the pace */
+	uint64_t a0 = cntvct(), a1;
+	do {
+		__asm__ volatile (
+			".rept 32\n add %0, %0, #1\n .endr" : "+r"(x));
+		adds += 32;
+		a1 = cntvct();
+	} while (a1 - a0 < freq / 10);
+
+	if (!(en & (1ull << 31))) {
+		__asm__ volatile ("msr pmcntenclr_el0, %0" :: "r"(1ull << 31));
+	}
+	__asm__ volatile ("msr pmcr_el0, %0; isb" :: "r"(pmcr));
+	ml_set_interrupts_enabled(istate);
+
+	uint64_t mpidr;
+	__asm__ volatile ("mrs %0, mpidr_el1" : "=r"(mpidr));
+	printf("SWEET CLK: cpu %d (mpidr %#llx): cycles %llu in %llu ticks, adds %llu in %llu ticks, freq %llu, pmcr %#llx\n",
+	    cpu, mpidr & 0xffffff, c1 - c0, t1 - t0, adds, a1 - a0, freq, pmcr);
+	(void)x;
+}
+
+/*
+ * The clock hardware itself (downstream msm-4.4 clk-cpu-osm.c / sdm660.dtsi,
+ * read only): per cluster the APCS PLL (MODE, L = MHz / 19.2, USER_CTL,
+ * STATUS), the cluster RCG (CMD, CFG: source 10:8 = 3 main PLL / 4 GPLL0 /
+ * 5 early PLL, divider 4:0), the OSM (version, enable 0x1004, desired perf
+ * state 0x1f10, pstate status 0x1c00) and the speed-bin fuse.
+ */
+static uint32_t
+cpuclk_rd(uint64_t pa)
+{
+	volatile uint32_t *v = (volatile uint32_t *)ml_io_map((vm_offset_t)(pa & ~0x3fffull), 0x4000);
+	return v ? v[(pa & 0x3fff) / 4] : 0xdeadbeef;
+}
+
+static void
+cpuclk_regs(void)
+{
+	static const struct { const char *name; uint64_t pll, rcg, osm; } cl[] = {
+		{ "silver", 0x17916000, 0x17911050, 0x179c0000 },
+		{ "gold", 0x17816000, 0x17811050, 0x179c2000 },
+	};
+	for (int i = 0; i < 2; i++) {
+		uint32_t l = cpuclk_rd(cl[i].pll + 0x4), cfg = cpuclk_rd(cl[i].rcg + 4);
+		printf("SWEET CLK: %s PLL mode %#x L %#x (%u MHz) user %#x status %#x; RCG cmd %#x cfg %#x (src %u div %u); "
+		    "OSM ver %#x enable %#x desired %#x pstate %#x\n", cl[i].name,
+		    cpuclk_rd(cl[i].pll), l, (l & 0xff) * 192 / 10, cpuclk_rd(cl[i].pll + 0xc), cpuclk_rd(cl[i].pll + 0x2c),
+		    cpuclk_rd(cl[i].rcg), cfg, (cfg >> 8) & 7, cfg & 0x1f,
+		    cpuclk_rd(cl[i].osm), cpuclk_rd(cl[i].osm + 0x1004), cpuclk_rd(cl[i].osm + 0x1f10), cpuclk_rd(cl[i].osm + 0x1c00));
+	}
+	printf("SWEET CLK: speed-bin fuse 0x784130 = %#x %#x\n", cpuclk_rd(0x784130), cpuclk_rd(0x784134));
+}
+
+static void
+cpuclk_thread(void *arg, wait_result_t result)
+{
+	(void)arg;
+	(void)result;
+	uint64_t freq;
+	__asm__ volatile ("mrs %0, cntfrq_el0" : "=r"(freq));
+	if (freq == 0) {
+		freq = 19200000;
+	}
+	for (int round = 0; round < 2; round++) {
+		cpuclk_sleep(round == 0 ? 20 : 100);
+		cpuclk_regs();
+		for (int cpu = 0; cpu < (int)real_ncpus; cpu++) {
+			processor_t p = cpu_to_processor(cpu);
+			if (p == PROCESSOR_NULL) {
+				continue;
+			}
+			thread_bind(p);
+			thread_block(THREAD_CONTINUE_NULL);     /* move onto that CPU */
+			cpuclk_measure(cpu, freq);
+		}
+		thread_bind(PROCESSOR_NULL);
+	}
+}
+
+void
+sweet_cpuclk_start(void)
+{
+	int on = 1;
+	thread_t thread;
+	(void)PE_parse_boot_argn("sweetclk", &on, sizeof(on));
+	if (on && kernel_thread_start(cpuclk_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+#endif /* SWEET */
