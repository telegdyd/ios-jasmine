 bsd/dev/sweet_netfs.c | 420 ++++++++++++++++++++++++++++++++++++++++++
 bsd/dev/sweet_usb.c   |   4 +
 3 files changed, 425 insertions(+)
 create mode 100644 bsd/dev/sweet_netfs.c

diff --git a/bsd/conf/files b/bsd/conf/files
index f43a900..782517e 100644
--- a/bsd/conf/files
+++ b/bsd/conf/files
@@ -114,6 +114,7 @@ bsd/dev/sweet_sample.c			standard
 bsd/dev/sweet_keys.c			standard
 bsd/dev/sweet_pmic.c			standard
 bsd/dev/sweet_gpu.c			standard
