+	if (p[0] == '0' && (p[1] == 'x' || p[1] == 'X')) {
+		for (p += 2;; p++) {
+			uint32_t d = *p >= '0' && *p <= '9' ? (uint32_t)(*p - '0') : *p >= 'a' && *p <= 'f' ?
+			    (uint32_t)(*p - 'a' + 10) : *p >= 'A' && *p <= 'F' ? (uint32_t)(*p - 'A' + 10) : 16;
+			if (d == 16) {
+				return v;
+			}
+			v = v * 16 + d;
+		}
+	}
+	for (; *p >= '0' && *p <= '9'; p++) {
+		v = v * 10 + (uint32_t)(*p - '0');
+	}
+	return v;
+}
