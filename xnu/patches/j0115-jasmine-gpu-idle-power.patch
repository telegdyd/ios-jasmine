+	volatile uint64_t last;         /* mach time of the last submit or pre-wake */
+	uint32_t hold_ms, cx_off;       /* sweetgpupc_hold=, sweetgpupc_cx= (0: the CX vote stays) */
+	bool cx_low;                    /* CX voted down to cx_off while collapsed */
+	uint32_t keep;                  /* command holders that need GX on */
+	uint64_t entered, resid_on, resid_off;
+	uint32_t collapses, resumes, res_ok, prewakes, failures, smmu_fixes, scm_resumes;
+	uint32_t res_us_last, res_us_min, res_us_max, off_us_last, off_us_max;
+	uint64_t res_us_sum;
+	struct {
+		uint32_t ms, us;
+		uint8_t on, why;
+	} hist[PC_HIST];
+	unsigned nhist;
