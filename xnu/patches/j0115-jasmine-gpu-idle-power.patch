-	cc_wr(GPUCC_GFX3D_RCG, cc_rd(GPUCC_GFX3D_RCG) | RCG_UPDATE);
-	err = poll32(&sg.gpucc[GPUCC_GFX3D_RCG / 4], RCG_UPDATE, 0, 500);
-	if (err == 0 && from != ~0u) {
-		io_wr(&sg.gpucc[from / 4], 0);          /* the old PLL off */
+	uint32_t to;
