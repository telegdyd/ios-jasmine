+/*
+ * Measurement aid (j0115, "batt icl MA SECS"): a low USBIN limit for SECS
+ * seconds, so the battery carries the load above it while USB data stays up
+ * and load changes show 1:1 in the battery current (tools/g2/fgab.py). The
+ * charger thread restores the plug-in limit when the time is up.
+ */
+static volatile uint32_t icl_test_ua;
+static volatile uint64_t icl_test_until;
+
+int sweet_chg_icl_test(uint32_t ma, uint32_t secs);
+int
+sweet_chg_icl_test(uint32_t ma, uint32_t secs)
+{
+	uint64_t until = 0;
+	if (ma == 0 || secs == 0) {
+		icl_test_until = 0;             /* the thread restores within 2 s */
+		return 0;
+	}
+	ma = ma < 100 ? 100 : (ma > 500 ? 500 : ma);
+	secs = secs > 3600 ? 3600 : secs;
+	clock_interval_to_deadline(secs, NSEC_PER_SEC, &until);
+	icl_test_until = until;
+	icl_test_ua = ma * 1000;
+	return chg_set_icl(ma * 1000);
+}
