+static void
+gpu_pc_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	for (;;) {
+		uint64_t deadline = 0;
+		lck_mtx_lock(gpu_lock);
+		pc.kick = false;
+		if (gpu_ready && !pc.on && (pc.want_on || pc.mode == 0)) {
+			(void)gpu_resume(pc.want_on ? PCW_PREWAKE : PCW_CMD);
+			pc.kick = false;
+		}
+		pc.want_on = false;
+		uint64_t now = mach_absolute_time();
+		if (gpu_ready && pc.on && (pc.mode == 1 || (pc.mode == 2 && !pc.display_on))) {
+			uint64_t due = pc.last + (pc.display_on ? pc_abs(pc.hold_ms) : 0);
+			if (now >= due && pc.keep == 0 && gpu_idle_now()) {
+				gpu_collapse(pc.display_on ? PCW_IDLE : PCW_DISPLAY);
+			} else {
+				deadline = now >= due ? now + pc_abs(5) : due;
+			}
+		}
+		lck_mtx_unlock(gpu_lock);
+		if (deadline != 0) {
+			(void)assert_wait_deadline(PC_EVENT, THREAD_UNINT, deadline);
+		} else {
+			(void)assert_wait(PC_EVENT, THREAD_UNINT);
+		}
+		if (pc.kick) {
+			thread_wakeup(PC_EVENT);        /* came before the wait */
+		}
+		thread_block(THREAD_CONTINUE_NULL);
+	}
