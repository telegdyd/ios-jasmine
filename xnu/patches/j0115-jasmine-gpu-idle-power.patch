+/* "gpu pc ..." and "gpu cg 0|1" (sweet_gpu_cmd) */
+static const char *
+gpu_pc_cmd(const char *a)
+{
+	static char reply[2048];
+	if (strncmp(a, "cg ", 3) == 0) {
+		bool on = a[3] == '1';
+		lck_mtx_lock(gpu_lock);
+		gpu_hold_on();
+		int err = ETIMEDOUT;
+		for (int i = 0; i < 100000 && pc.on && (err = gpu_idle_now() ? 0 : ETIMEDOUT); i++) {
+			delay(10);
+		}
+		if (err == 0) {
+			pc.cg = on;
+			gpu_hwcg(on);
+		}
+		gpu_hold_off();
+		lck_mtx_unlock(gpu_lock);
+		snprintf(reply, sizeof(reply), "gpu cg: %s%s\n", pc.cg ? "on" : "off", err ? " (GPU busy, unchanged)" : "");
+		return reply;
+	}
+	a += 2;                                 /* after "pc" */
+	if (*a == ' ') {
+		a++;
+		lck_mtx_lock(gpu_lock);
+		if (strcmp(a, "on") == 0 || strcmp(a, "off") == 0 || strcmp(a, "offonly") == 0) {
+			pc.mode = a[1] == 'n' ? 1 : a[3] == 'o' ? 2 : 0;
+			pc.last = mach_absolute_time();
+		} else if (strncmp(a, "hold ", 5) == 0) {
+			pc.hold_ms = pc_num(a + 5);
+		} else if (strncmp(a, "cx ", 3) == 0) {
+			pc.cx_off = pc_num(a + 3);
+		} else if (strncmp(a, "log ", 4) == 0) {
+			pc.log = a[4] == '1';
+		} else if (strncmp(a, "stress ", 7) == 0) {
+			uint32_t n = pc_num(a + 7), bad = 0, done = 0;
+			lck_mtx_unlock(gpu_lock);
+			for (; done < n && gpu_ready; done++) {
+				(void)sweet_gpu_wait(gpu_seqno, 1000);
+				lck_mtx_lock(gpu_lock);
+				if (pc.on && pc.keep == 0 && gpu_idle_now()) {
+					gpu_collapse(PCW_CMD);
+				}
+				lck_mtx_unlock(gpu_lock);
+				if (gpu_vm_selftest(true) != 0) {
+					bad++;
+				}
+			}
+			lck_mtx_lock(gpu_lock);
+			int k = snprintf(reply, sizeof(reply), "gpu pc stress: %u cycles, %u self-test failures, ready %d\n",
+			    done, bad, gpu_ready);
+			gpu_pc_status(reply + k, sizeof(reply) - (size_t)k);
+			lck_mtx_unlock(gpu_lock);
+			return reply;
+		} else {
+			lck_mtx_unlock(gpu_lock);
+			return "gpu pc: ? (on, off, offonly, hold MS, cx LEVEL, log 0|1, stress N)\n";
+		}
+		pc.kick = true;
+		thread_wakeup(PC_EVENT);
+		lck_mtx_unlock(gpu_lock);
+	}
+	lck_mtx_lock(gpu_lock);
+	gpu_pc_status(reply, sizeof(reply));
+	lck_mtx_unlock(gpu_lock);
+	return reply;
+}
