+	    pc.mode, pc.mode == 0 ? "off" : pc.mode == 1 ? "on" : "display off only", pc.on ? "on" : "off", pc.hold_ms,
+	    pc.display_on ? "on" : "off", pc.cg ? "on" : "off", pc.cx_off, pc.cx_low ? " (low now)" : "",
