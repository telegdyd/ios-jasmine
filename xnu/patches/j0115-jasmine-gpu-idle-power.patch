+/*
+ * GX GDSC on with gfx3d's root on XO (boot and every resume, j0115): block
+ * reset, AON (GMEM) reset, unclamp, power on (gdsc.c, CLAMP_IO | SW_RESET |
+ * AON_RESET), then the GX-side branches.
+ */
+static int
+gpu_gx_on(void)
+{
+	int err;
+	uint32_t g;
 	cc_wr(GPUCC_GX_BCR, 1);
 	delay(1);
 	cc_wr(GPUCC_GX_BCR, 0);
@@ -415,11 +476,10 @@ gpu_power_on(void)
 		gpu_state("a GPU clock did not start with GX on");
 		return err;
 	}
-	gpu_state("GX on");
 	return 0;
 }
 
-static int gpu_vm_selftest(void);
+static int gpu_vm_selftest(bool quiet);
 
 /*
  * GPU levels (j0060), from the stock DT: kgsl's qcom,gpu-pwrlevels, the gfx
@@ -634,6 +694,29 @@ gpu_pll_start(uint32_t off, uint32_t mhz)
 	return 0;
 }
 
+/*
+ * gfx3d to mhz through the GPU PLL it is not running on (from XO: PLL0); the
+ * old PLL stops. *to is the PLL now used. ENXIO: the PLL did not lock and
+ * nothing changed; another error: the RCG switch timed out.
+ */
+static int
+gpu_pll_switch(uint32_t mhz, uint32_t *to)
+{
+	uint32_t src = (cc_rd(GPUCC_GFX3D_RCG + 4) >> 8) & 7;
+	uint32_t from = src == 1 ? GPU_PLL0 : src == 3 ? GPU_PLL1 : ~0u;
+	*to = from == GPU_PLL0 ? GPU_PLL1 : GPU_PLL0;
+	if (gpu_pll_start(*to, mhz) != 0) {
+		return ENXIO;
+	}
+	cc_wr(GPUCC_GFX3D_RCG + 4, ((*to == GPU_PLL0 ? 1u : 3u) << 8) | 3);     /* CFG: source, divide by 2 (SRC_DIV 3) */
+	cc_wr(GPUCC_GFX3D_RCG, cc_rd(GPUCC_GFX3D_RCG) | RCG_UPDATE);
+	int err = poll32(&sg.gpucc[GPUCC_GFX3D_RCG / 4], RCG_UPDATE, 0, 500);
+	if (err == 0 && from != ~0u) {
+		io_wr(&sg.gpucc[from / 4], 0);          /* the old PLL off */
+	}
+	return err;
+}
+
 /*
  * gpumhz= and "gpu clk": gfx3d at one of gpu_levels (up to the speed bin's
  * top). Ping-pong between GPU PLL0 (RCG source 1) and PLL1 (source 3) like
@@ -674,17 +757,9 @@ gpu_set_clock(uint32_t mhz)
 		return err;
 	}
 
-	uint32_t src = (cc_rd(GPUCC_GFX3D_RCG + 4) >> 8) & 7;
