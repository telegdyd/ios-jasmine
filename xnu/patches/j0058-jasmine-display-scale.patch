+			frames = scaled = sweet_fb_wait_calls = sweet_fb_wait_busy = 0;
+			sweet_fb_wait_us = 0;
+		}
 		return;
 	}
 	if (directEligible(rec, held) && fQLock != NULL) {
@@ -1213,6 +1340,7 @@ AppleCLCD::showDirect(const uint8_t *rec, SweetSurface **heldIn)
 		}
