 }
 
+/* j0058: VIG0 scans a whole 1125x2436 frame and its scaler fits it into the panel window */
+void
+AppleCLCD::scanScaled(uint64_t pa, uint32_t stride)
+{
+	if (!fScaled) {
+		pipeLayout(true);
+	}
+	fVig0[0x14 / 4] = (uint32_t)pa;
+	fVig0[0x24 / 4] = stride;
+	__asm__ volatile("dsb sy" ::: "memory");
+	fCtl0[0x18 / 4] = fFlushMask;
+	__asm__ volatile("dsb sy" ::: "memory");
+	fScanPhys = pa;
+	fScanStride = stride;
+}
+
+/*
+ * j0058: swap completion. CoreAnimation renders into a swap surface again once
+ * IOMobileFramebufferSwapWait says the swap that replaced it is done (IOMFBDisplay::can_update_
+ * polls it for each queued swap); ours said "done" at once, so CoreAnimation drew into the
+ * surface still on the panel (j0056's held draws, the dock flicker). A swap is done once the
+ * MDP latched its flip; one with no flip pending (CPU copy into the scanned buffer) at once.
+ */
+void
+AppleCLCD::noteShown(uint32_t id)
+{
+	IOLockLock(fLock);
+	if (fCtl0 != NULL && (fCtl0[0x18 / 4] & fFlushMask) != 0) {
+		fLatchID = id;
+		fLatchAt = mach_absolute_time();
+	} else {
+		fDoneID = id;
+		fLatchID = 0;
+	}
+	IOLockUnlock(fLock);
+}
+
+/* The flip latched (its CTL_FLUSH bits clear, or 50 ms passed): its swap is done, what it replaced is free */
+void
+AppleCLCD::retireLatched(void)
+{
+	SweetSurface *gone[4];
+	uint64_t ns = 0;
+	IOLockLock(fLock);
+	if (fLatchID != 0) {
+		absolutetime_to_nanoseconds(mach_absolute_time() - fLatchAt, &ns);
+	}
+	if (fLatchID == 0 || ((fCtl0[0x18 / 4] & fFlushMask) != 0 && ns < 50 * NSEC_PER_MSEC)) {
+		IOLockUnlock(fLock);
+		return;
+	}
+	fDoneID = fLatchID;
+	fLatchID = 0;
+	memcpy(gone, fRetireHold, sizeof(gone));
+	bzero(fRetireHold, sizeof(fRetireHold));
+	IOLockUnlock(fLock);
+	sweet_hold_set(gone, false);
+}
+
+/* timeout: the top bit set for CoreAnimation's polls, the rest ms (0x80000001: up to 1 ms) */
+IOReturn
+AppleCLCD::swapWait(uint32_t id, uint32_t timeout)
+{
+	uint64_t start = mach_absolute_time(), ns = 0;
+	uint32_t ms = timeout & 0x7fffffff;
+	if (ms > 100) {
+		ms = 100;
+	}
+	sweet_fb_wait_calls++;
+	for (;;) {
+		retireLatched();
+		IOLockLock(fLock);
+		/* (a swap never shown -- lost, cancelled -- is done once nothing waits to reach the panel) */
+		bool done = !fSwapWait || (int32_t)(fDoneID - id) >= 0 || (int32_t)(id - fSwapID) > 0 ||
+		    (fLatchID == 0 && !fDirty);
+		IOLockUnlock(fLock);
+		absolutetime_to_nanoseconds(mach_absolute_time() - start, &ns);
+		if (done || ns >= (uint64_t)ms * NSEC_PER_MSEC) {
+			sweet_fb_wait_us += ns / 1000;
+			sweet_fb_wait_busy += !done;
+			return done ? kIOReturnSuccess : kIOReturnTimeout;
+		}
+		IODelay(100);
+	}
+}
+
 /*
  * DCS long write through the DSI command DMA path (topaz-woa: the TPG FIFO
  * path is a no-op on this DSI 2.4.1). The packet lives in a contiguous
@@ -1577,6 +1794,28 @@ AppleCLCD::directPresent(const uint8_t *rec)
 	}
 	bool ok = false;
 	(void)topaz_surface_drawn(s, 100);
+	if (fFitW != 0) {
+		/*
+		 * jasmine (j0058): the frame is fitted, not cropped. A whole GPU-pool frame at the logical
+		 * size goes to VIG0's scaler as it is (no CPU copy); anything else is composed by the
+		 * CPU (composeFit).
+		 */
+		const uint8_t *a = rec + 0x64 + 16 * layer, *b = rec + 0xc4 + 16 * layer;
+		bool whole = get32(a, 0) == 0 && get32(a, 4) == 0 && get32(b, 0) == 0 && get32(b, 4) == 0 &&
+		    (get32(a, 8) == 0 || get32(a, 8) == fLogicalW) && (get32(a, 12) == 0 || get32(a, 12) == fLogicalH) &&
+		    ((int32_t)get32(b, 8) <= 0 || get32(b, 8) == fLogicalW) &&
+		    ((int32_t)get32(b, 12) <= 0 || get32(b, 12) == fLogicalH);
+		uint64_t pa = s->scanoutPhys + s->offset;
+		if (fScaler && s->gpuPool && whole && s->bytesPerElement == 4 && s->width == fLogicalW &&
+		    s->height == fLogicalH && (pa & 0xf) == 0 && (s->bytesPerRow & 0xf) == 0 &&
+		    pa + (uint64_t)fLogicalH * s->bytesPerRow < (1ull << 32)) {
+			sweet_surface_cpu_access(s);    /* the GPU's last job on it is done (j0055) */
+			scanScaled(pa, s->bytesPerRow);
+			ok = true;
+		}
+		s->release();
+		return ok;
+	}
 	if (s->scanoutPhys != 0 && s->bytesPerElement == 4 &&
 	    s->width >= fWidth && s->height >= fHeight) {
 		/* full-screen surface: panel window at the logical offset */
@@ -1623,7 +1862,8 @@ AppleCLCD::directPresent(const uint8_t *rec)
 	return ok;
 }
 
