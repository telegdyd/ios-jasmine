 	if (console_only > 0 && fConsShown) {
 		(void)mask;
-		return;
+		return false;
 	}
 	fConsShown = false;
 	if (directPresent(rec)) {
@@ -1647,7 +1887,7 @@ AppleCLCD::present(const uint8_t *rec)
 				sweet_console_muted = 1;
 			}
 		}
-		return;
+		return fScanPhys != fFlipPhys[0] && fScanPhys != fFlipPhys[1];
 	}
 	IOLockLock(fLock);
 	fLastVA = NULL;
@@ -1778,6 +2018,7 @@ AppleCLCD::present(const uint8_t *rec)
 	if (fFlipVA[0] != NULL) {
 		flipBack();
 	}
+	return false;
 }
 
