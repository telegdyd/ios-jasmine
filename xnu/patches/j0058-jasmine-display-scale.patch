+/* MMIO store through a register: never "str wzr" (the hypervisor's emulation hangs on it, j0018) */
+static inline void
+sweet_mmio_wr(volatile uint32_t *base, uint32_t off, uint32_t v)
+{
+	__asm__ volatile ("str %w0, [%1]" : : "r"(v), "r"((volatile uint8_t *)base + off) : "memory");
+}
+
+/*
+ * j0058: VIG0's registers the scaled layout changes (msm-4.4 mdss_mdp_hwio.h): the SSPP's
+ * source and output rectangles, its software pixel extension per plane (C0, C1/C2, C3) and
+ * the QSEED3 scaler at +0xa00 (stock DT qcom,mdss-vig-scaler-off). All double buffered:
+ * they take effect together at the latch after the pipe's CTL_FLUSH bit.
+ */
+static const uint16_t sweet_vig_layout[] = {
+	0x000, 0x004, 0x008, 0x00c, 0x010,              /* SRC_SIZE, SRC_IMG_SIZE, SRC_XY, OUT_SIZE, OUT_XY */
+	0x100, 0x104, 0x108, 0x110, 0x114, 0x118, 0x120, 0x124, 0x128,  /* PIX_EXT LR, TB, REQ_PIXELS */
+	0xa0c, 0xa10, 0xa14, 0xa18, 0xa1c, 0xa20,       /* QSEED3 PHASE_INIT, PHASE_STEP Y_H/Y_V/UV_H/UV_V, PRELOAD */
+	0xa40, 0xa44, 0xa48, 0xa04,                     /* SRC_SIZE_Y_RGB_A, SRC_SIZE_UV, DST_SIZE, OP_MODE */
+};
+
+/*
+ * The scaled layout as msm-4.4 programs a VIG pipe that scales RGB with QSEED3 and no
+ * user LUT (mdss_mdp_overlay_setup_scaling -> mdss_mdp_pipe_calc_qseed3_cfg ->
+ * mdss_mdp_qseed3_setup, bilinear): phase steps src/dst in 21-bit fixed point, preload
+ * 4 x 3, pixel extension only the requested size, no fetch or repeat.
+ */
+bool
+AppleCLCD::scalerInit(void)
+{
+	static_assert(sizeof(sweet_vig_layout) / sizeof(sweet_vig_layout[0]) <= sizeof(fPlain) / sizeof(fPlain[0]), "layout");
+	const uint32_t n = sizeof(sweet_vig_layout) / sizeof(sweet_vig_layout[0]);
+	uint32_t on = 1;
+	(void)PE_parse_boot_argn("sweetfb_scale", &on, sizeof(on));
+	uint32_t version = fVig0[0xa00 / 4];
+	for (uint32_t i = 0; i < n; i++) {
+		fPlain[i] = fVig0[sweet_vig_layout[i] / 4];
+	}
+	uint32_t sw = fLogicalW, sh = fLogicalH, dw = fFitW, dh = fHeight;
+	uint32_t req = (sh << 16) | sw;
+	uint32_t op = (1u << 0) | (1u << 14) | (3u << 16) | (1u << 31);   /* EN, 8-bit, Y/RGB bilinear, blend cfg 1 */
+	if (fVig0[0x30 / 4] & (1u << 8)) {
+		op |= (1u << 10) | (1u << 30);          /* the format has alpha (SRCC3_EN): alpha bilinear */
+	}
+	const uint32_t fit[] = {
+		req, req, 0, (dh << 16) | dw, fFitX,
+		0, 0, req, 0, 0, req, 0, 0, req,
+		0, (uint32_t)(((uint64_t)sw << 21) / dw), (uint32_t)(((uint64_t)sh << 21) / dh), 0, 0, 0x03040304,
+		sw | (sh << 16), sw | (sh << 16), dw | (dh << 16), op,
+	};
+	static_assert(sizeof(fit) == sizeof(sweet_vig_layout) * 2, "fit");
+	memcpy(fFit, fit, sizeof(fit));
+	fScaler = on && version != 0 && dw != 0 && dh != 0;
+	IOLog("SWEET MDP: VIG0 QSEED3 version %#x, ABL: src %#x out %#x at %#x, req %#x, scaler op %#x; steps %#x %#x: %s\n",
+	    version, fPlain[0], fPlain[3], fPlain[4], fPlain[7], fPlain[n - 1], fit[15], fit[16],
+	    fScaler ? "the MDP scales pool frames" : on ? "no scaler, CPU fit" : "CPU fit (sweetfb_scale=0)");
+	return fScaler;
+}
+
+/* VIG0 laid out for the scaled frame or for panel-size buffers (ABL's values); the caller flushes */
+void
+AppleCLCD::pipeLayout(bool scaled)
+{
+	const uint32_t *v = scaled ? fFit : fPlain;
+	for (uint32_t i = 0; i < sizeof(sweet_vig_layout) / sizeof(sweet_vig_layout[0]); i++) {
+		sweet_mmio_wr(fVig0, sweet_vig_layout[i], v[i]);
+	}
+	fScaled = scaled;
+}
