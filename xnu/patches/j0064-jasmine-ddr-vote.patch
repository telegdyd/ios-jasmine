+
+/*
+ * One raw request (j0064, command port "rpm"): sets bit 0 the active set,
+ * bit 1 the sleep set (sleep first, as Linux). For live experiments with
+ * RPM resources without a kernel build each.
+ */
+bool
+sweet_rpm_kvp(unsigned sets, uint32_t type, uint32_t id, uint32_t key, uint32_t value)
+{
+	uint32_t kv[2] = {key, value};
+	bool ok = true;
+	lck_mtx_lock(&sweet_rpm_lock);
+	if (sets & 2u) {
+		ok = rpm_request("kvp sleep", 1, type, id, kv, 1);
+	}
+	if (ok && (sets & 1u)) {
+		ok = rpm_request("kvp active", 0, type, id, kv, 1);
+	}
+	lck_mtx_unlock(&sweet_rpm_lock);
+	printf("SWEET RPM: %.4s %u %.4s %u (sets %u): %s\n", (const char *)&type, id, (const char *)&key, value, sets,
+	    ok ? "ok" : "FAILED");
+	return ok;
+}
+
+/*
+ * Clock rate vote in the sleep and the active set (clk-smd-rpm.c, a clock
+ * without an _a twin): "KHz ", rate in kHz, the RPM rounds to a supported
+ * rate. "clk2" id 0 is bimc_clk = the DDR rate (GCC's debug mux counts half
+ * of it, sel 0x19d). Takes effect only once scaling is on.
+ */
+bool
+sweet_rpm_clk(uint32_t type, uint32_t id, uint32_t khz)
+{
+	uint32_t kv[2] = {KEY_KHZ, khz};
+	lck_mtx_lock(&sweet_rpm_lock);
+	bool ok = rpm_request("clk sleep", 1, type, id, kv, 1) && rpm_request("clk active", 0, type, id, kv, 1);
+	lck_mtx_unlock(&sweet_rpm_lock);
+	printf("SWEET RPM: clock %.4s id %u %u kHz: %s\n", (const char *)&type, id, khz, ok ? "ok" : "FAILED");
+	return ok;
+}
+
+/*
+ * RPM clock scaling on, as msm-4.4 clk-smd-rpm.c rpm_smd_clk_probe does for
+ * qcom,rpmcc-sdm660 (sailfish 0147 did the same for MSM8996). Until then the
+ * RPM acks rate votes and ignores them; from then on it goes by the AP's
+ * votes for every RPM clock, so first each sdm660 RPM clock is handed off
+ * at its maximum in both sets, as clk_smd_rpm_handoff does: rate clocks
+ * "KHz " DIV_ROUND_UP(INT_MAX, 1000) (the RPM clamps), qdss "STAT" the
+ * same, branches "Enab" 1, XO buffers "swen" 1, their pin-controlled twins
+ * "pccb" 1. Then "clk0" id 2 "Enab" 1 (sleep, active). Linux's keepalives
+ * (cxo_a, cnoc_periph 19.2 MHz) are covered: both stay at the handoff vote,
+ * and nothing votes any clock down later but bimc (sweet_rpm_clk). Returns
+ * the number of failed requests, 0 when scaling is on.
+ */
+#define RPM_KHZ_MAX     2147484u
+static const struct {
+	uint32_t type, id, key, value;
+} rpm_handoff_660[] = {
+	{TYPE_CLK2, 0, KEY_KHZ, RPM_KHZ_MAX},           /* bimc (first, as the probe's INT_MAX vote) */
+	{TYPE_CLK0, 0, KEY_ENAB, 1},                    /* cxo */
+	{TYPE_CLK1, 1, KEY_KHZ, RPM_KHZ_MAX},           /* snoc */
+	{TYPE_CLK0, 1, KEY_STAT, RPM_KHZ_MAX},          /* qdss */
+	{TYPE_CLKA, 4, KEY_SWEN, 1},                    /* rf_clk1 */
+	{TYPE_CLKA, 4, KEY_PCCB, 1},                    /* rf_clk1_pin */
+	{0x72676761u, 2, KEY_KHZ, RPM_KHZ_MAX},         /* aggr: aggre2_noc */
+	{TYPE_CLK1, 2, KEY_KHZ, RPM_KHZ_MAX},           /* cnoc */
+	{0x00617069u, 0, KEY_KHZ, RPM_KHZ_MAX},         /* ipa */
+	{0x00006563u, 0, KEY_KHZ, RPM_KHZ_MAX},         /* ce: ce1 */
+	{TYPE_CLKA, 0xb, KEY_SWEN, 1},                  /* div_clk1 */
+	{TYPE_CLKA, 1, KEY_SWEN, 1},                    /* ln_bb_clk1 */
+	{TYPE_CLKA, 1, KEY_PCCB, 1},                    /* ln_bb_clk1_pin */
+	{TYPE_CLKA, 2, KEY_SWEN, 1},                    /* ln_bb_clk2 */
+	{TYPE_CLKA, 2, KEY_PCCB, 1},                    /* ln_bb_clk2_pin */
+	{TYPE_CLKA, 3, KEY_SWEN, 1},                    /* ln_bb_clk3 */
+	{TYPE_CLKA, 3, KEY_PCCB, 1},                    /* ln_bb_clk3_pin */
+	{TYPE_CLK1, 0, KEY_KHZ, RPM_KHZ_MAX},           /* cnoc_periph */
+	{0x69786d6du, 0, KEY_KHZ, RPM_KHZ_MAX},         /* mmxi: mmssnoc_axi */
+};
+
+static int rpm_scaling_failed = -1;     /* -1: not tried yet */
+
+int
+sweet_rpm_clk_scaling(void)
+{
+	uint32_t en[2] = {KEY_ENAB, 1u};
+	unsigned failed = 0;
+	lck_mtx_lock(&sweet_rpm_lock);
+	if (rpm_scaling_failed == 0) {
+		lck_mtx_unlock(&sweet_rpm_lock);
+		return 0;
+	}
+	for (unsigned i = 0; i < sizeof(rpm_handoff_660) / sizeof(rpm_handoff_660[0]); i++) {
+		uint32_t kv[2] = {rpm_handoff_660[i].key, rpm_handoff_660[i].value};
+		char what[32];
+		snprintf(what, sizeof(what), "handoff %.4s %u %.4s", (const char *)&rpm_handoff_660[i].type,
+		    rpm_handoff_660[i].id, (const char *)&rpm_handoff_660[i].key);
+		failed += !rpm_request(what, 0, rpm_handoff_660[i].type, rpm_handoff_660[i].id, kv, 1);
+		failed += !rpm_request(what, 1, rpm_handoff_660[i].type, rpm_handoff_660[i].id, kv, 1);
+	}
+	if (failed == 0) {
+		failed += !rpm_request("scaling sleep", 1, TYPE_CLK0, 2, en, 1);
+		failed += !rpm_request("scaling active", 0, TYPE_CLK0, 2, en, 1);
+	}
+	rpm_scaling_failed = (int)failed;
+	lck_mtx_unlock(&sweet_rpm_lock);
+	printf("SWEET RPM: clock handoff of %u resources, scaling on: %s (%u requests failed)\n",
+	    (unsigned)(sizeof(rpm_handoff_660) / sizeof(rpm_handoff_660[0])), failed ? "FAILED" : "ok", failed);
+	return (int)failed;
+}
