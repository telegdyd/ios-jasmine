From: telegdyd <telegdyd93@gmail.com>
Date: Tue, 27 Oct 2026 14:54:10 +0100
Subject: [PATCH] jasmine-j0105: bounded cross-core memory check and surface
 creator counters

---
 iokit/Kernel/arm/SweetSurface.cpp |  41 +++++++++++
 iokit/Kernel/arm/SweetSurface.h   |   2 +
 osfmk/arm64/sweet_memcheck.h      | 113 ++++++++++++++++++++++++++++++
 osfmk/arm64/sweet_osm.c           |   8 +++
 4 files changed, 164 insertions(+)
 create mode 100644 osfmk/arm64/sweet_memcheck.h

diff --git a/iokit/Kernel/arm/SweetSurface.cpp b/iokit/Kernel/arm/SweetSurface.cpp
index 9bfceda..ae70273 100644
--- a/iokit/Kernel/arm/SweetSurface.cpp
+++ b/iokit/Kernel/arm/SweetSurface.cpp
@@ -436,6 +436,8 @@ sweet_surface_alloc(void)
 		OSSafeReleaseNULL(s);
 		return NULL;
 	}
+	s->creatorPID = proc_selfpid();
+	proc_selfname(s->creatorName, sizeof(s->creatorName));
 	s->state = IOBufferMemoryDescriptor::inTaskWithOptions(kernel_task,
 	    kIODirectionInOut | kIOMemoryKernelUserShared, SWEET_UPAGE, SWEET_UPAGE);
 	if (s->state == NULL) {
@@ -1835,3 +1837,42 @@ IOSurfaceRootUserClient::getTargetAndTrapForIndex(IOService **targetP, UInt32 in
 	return &sweet_surface_traps[index];
 }
 #endif /* SWEET */
+
+#if defined(SWEET)
+/* Creator attribution only: a creator is not necessarily the current holder. */
+extern "C" int sweet_surface_stats(char *out, int len);
+int
+sweet_surface_stats(char *out, int len)
+{
+    struct row { int pid; uint32_t count, wrapped; uint64_t bytes; char name[32]; } rows[32] = {};
+    uint32_t used = 0, overflow = 0, count = 0;
+    uint64_t bytes = 0, overflow_bytes = 0;
+    if (sweet_surface_lock == NULL) return snprintf(out, len, "surfaces: not initialized\n");
+    IOLockLock(sweet_surface_lock);
+    for (uint32_t id = 1; id < SWEET_SURFACE_MAX_ID; id++) {
+        SweetSurface *s = sweet_surface_table[id];
+        if (s == NULL) continue;
+        count++; bytes += s->allocSize;
+        uint32_t i;
+        for (i = 0; i < used; i++) if (rows[i].pid == s->creatorPID) break;
+        if (i == used) {
+            if (used == 32) { overflow++; overflow_bytes += s->allocSize; continue; }
+            rows[i].pid = s->creatorPID;
+            memcpy(rows[i].name, s->creatorName, sizeof(rows[i].name));
+            used++;
+        }
+        rows[i].count++; rows[i].bytes += s->allocSize;
+        if (s->wrapped) rows[i].wrapped++;
+    }
+    IOLockUnlock(sweet_surface_lock);
+    int n = snprintf(out, len, "surfaces: %u live, %llu requested bytes; grouped by creator, not holder\n",
+        count, (unsigned long long)bytes);
+    for (uint32_t i = 0; i < used && n < len; i++)
+        n += snprintf(out+n, len-n, " creator %d %s: %u surfaces, %llu bytes, %u wrapped\n",
+            rows[i].pid, rows[i].name, rows[i].count, (unsigned long long)rows[i].bytes, rows[i].wrapped);
+    if (n < len) n += snprintf(out+n, len-n, " overflow: %u surfaces, %llu bytes\n", overflow,
+        (unsigned long long)overflow_bytes);
+    return n;
+}
+
+#endif
