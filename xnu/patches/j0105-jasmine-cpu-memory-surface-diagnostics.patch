 	uint8_t  elementWidth, elementHeight;
diff --git a/osfmk/arm64/sweet_memcheck.h b/osfmk/arm64/sweet_memcheck.h
new file mode 100644
index 0000000..c4f7eee
--- /dev/null
+++ b/osfmk/arm64/sweet_memcheck.h
@@ -0,0 +1,113 @@
+/* Bounded CPU/cache/RAM diagnostic. No hardware registers or storage writes. */
+#include <kern/kalloc.h>
+#define MEMCHECK_BYTES (1u << 20)
+#define MEMCHECK_WORDS (MEMCHECK_BYTES / sizeof(uint64_t))
+static LCK_GRP_DECLARE(memcheck_grp, "cpu_memcheck");
+static LCK_MTX_DECLARE(memcheck_lock, &memcheck_grp);
+static struct {
+    uint64_t *buffer;
+    unsigned cpus, round, phase;
+    uint32_t done;
+    uint64_t errors[MAX_CPUS];
+    int ran[MAX_CPUS];
+} memcheck;
+
+/* Address-dependent, complementary and all-zero/all-one patterns. */
+static uint64_t
+memcheck_pattern(uint64_t index, unsigned round)
+{
+    if (round == 0) return 0;
+    if (round == 1) return UINT64_MAX;
+    uint64_t v = index + 0x9e3779b97f4a7c15ull;
+    v = (v ^ (v >> 30)) * 0xbf58476d1ce4e5b9ull;
+    v = (v ^ (v >> 27)) * 0x94d049bb133111ebull;
+    v ^= v >> 31;
+    return round == 2 ? v : ~v;
+}
+
+static void
+memcheck_thread(void *arg, __unused wait_result_t result)
+{
+    unsigned cpu = (unsigned)(uintptr_t)arg;
+    processor_t p = cpu_to_processor(cpu);
+    if (p == PROCESSOR_NULL) {
+        memcheck.ran[cpu] = -1;
+        __atomic_fetch_add(&memcheck.done, 1, __ATOMIC_RELEASE);
+        return;
+    }
+    thread_bind(p);
+    thread_block(THREAD_CONTINUE_NULL);
+    memcheck.ran[cpu] = cpu_number();
+    /* A different CPU checks each writer's region, across cluster boundaries. */
+    unsigned region = memcheck.phase ? (cpu + memcheck.cpus / 2) % memcheck.cpus : cpu;
+    uint64_t base = (uint64_t)region * MEMCHECK_WORDS;
+    volatile uint64_t *words = memcheck.buffer + base;
+    for (uint64_t i = 0; i < MEMCHECK_WORDS; i++) {
+        uint64_t expected = memcheck_pattern(base + i, memcheck.round);
+        if (!memcheck.phase) words[i] = expected;
+        else if (words[i] != expected) memcheck.errors[cpu]++;
+    }
+    __atomic_fetch_add(&memcheck.done, 1, __ATOMIC_RELEASE);
+}
+
+static bool
+memcheck_phase(void)
+{
+    unsigned started = 0;
+    __atomic_store_n(&memcheck.done, 0, __ATOMIC_RELAXED);
+    for (unsigned cpu = 0; cpu < memcheck.cpus; cpu++) {
+        memcheck.ran[cpu] = -1;
+        thread_t t;
+        if (kernel_thread_start(memcheck_thread, (void *)(uintptr_t)cpu, &t) == KERN_SUCCESS) {
+            thread_deallocate(t);
+            started++;
+        }
+    }
+    /* Never free memory until every successfully started worker has returned. */
+    while (__atomic_load_n(&memcheck.done, __ATOMIC_ACQUIRE) < started) delay(1000);
+    bool ok = started == memcheck.cpus;
+    for (unsigned cpu = 0; cpu < memcheck.cpus; cpu++)
+        if (memcheck.ran[cpu] != (int)cpu) ok = false;
+    return ok;
+}
+
+static int
+memcheck_command(int argc, char *out, int len)
+{
+    if (argc != 1) return snprintf(out, len, "checkmem: no arguments\n");
+    lck_mtx_lock(&memcheck_lock);
+    unsigned cpus = real_ncpus;
+    if (!cpus || cpus > MAX_CPUS) {
+        lck_mtx_unlock(&memcheck_lock);
+        return snprintf(out, len, "checkmem: invalid CPU count\n");
+    }
+    size_t bytes = (size_t)cpus * MEMCHECK_BYTES;
+    memcheck.buffer = kalloc_data(bytes, Z_WAITOK | Z_ZERO);
+    if (!memcheck.buffer) {
+        lck_mtx_unlock(&memcheck_lock);
+        return snprintf(out, len, "checkmem: allocation failed\n");
+    }
+    memcheck.cpus = cpus;
+    bzero(memcheck.errors, sizeof(memcheck.errors));
+    bool ok = true;
+    uint64_t errors = 0, ns, begin = mach_absolute_time();
+    for (unsigned round = 0; round < 4 && ok; round++) {
+        memcheck.round = round;
+        for (unsigned phase = 0; phase < 2 && ok; phase++) {
+            memcheck.phase = phase;
+            ok = memcheck_phase();
+        }
+    }
+    for (unsigned cpu = 0; cpu < cpus; cpu++) errors += memcheck.errors[cpu];
+    absolutetime_to_nanoseconds(mach_absolute_time() - begin, &ns);
+    kfree_data(memcheck.buffer, bytes);
+    memcheck.buffer = NULL;
+    int n = snprintf(out, len, "checkmem: %s %u CPUs x 1 MiB x 4 patterns, %llu errors, %llu us\n",
+        ok && !errors ? "OK" : "FAILED", cpus, (unsigned long long)errors,
+        (unsigned long long)(ns / 1000));
+    for (unsigned cpu = 0; cpu < cpus && n < len; cpu++)
+        n += snprintf(out+n, len-n, " cpu %u on cpu %d: %llu errors\n", cpu,
+            memcheck.ran[cpu], (unsigned long long)memcheck.errors[cpu]);
+    lck_mtx_unlock(&memcheck_lock);
+    return n;
+}
