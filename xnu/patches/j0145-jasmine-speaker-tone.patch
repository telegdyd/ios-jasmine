+/* ---- the tone: ASM -> ADM (NULL COPP) -> AFE PRI_MI2S_RX -> TFA9894 */
+
+#define J_BUFS              4
+#define J_BUF_FRAMES        4800                /* 100 ms */
+#define J_BUF_BYTES         (J_BUF_FRAMES * 4)
+
+static bool
+jas_tone(unsigned seconds, bool amp)
+{
+	uint64_t pa = 0;
+	uint32_t bytes = (J_BUFS * J_BUF_BYTES + 0xfff) & ~0xfffu;
+	int16_t *pcm = (int16_t *)topaz_pool_alloc(bytes, &pa);
+	static const int16_t q[13] = { 0, 428, 848, 1253, 1638, 1997, 2317, 2604, 2838, 3020, 3165, 3240, 3277 };
+	uint16_t copp = 0;
+	bool ok = false;
+
+	if (pcm == NULL) {
+		LOG("tone: no pool memory");
+		return false;
+	}
+	for (uint32_t f = 0; f < J_BUFS * J_BUF_FRAMES; f++) {  /* 1 kHz at -20 dBFS, both channels */
+		uint32_t k = f % 48, a = k % 24;
+		int16_t v = a <= 12 ? q[a] : q[24 - a];
+		v = k < 24 ? v : (int16_t)-v;
+		pcm[2 * f] = v;
+		pcm[2 * f + 1] = v;
+	}
+	mb();
+	LOG("tone: %u bytes of PCM at %llx, address msw %x", bytes, pa, j_msw);
+
+	struct __attribute__((packed)) { uint16_t pool, nreg; uint32_t prop; uint32_t lsw, msw, size; } mm =
+	{ 3, 1, 0, (uint32_t)pa, (uint32_t)(pa >> 32) | j_msw, bytes };
+	if (!apr_call("asm mem map", APR_SVC_ASM, 0, ASM_CMD_SHARED_MEM_MAP_REGIONS, &mm, sizeof(mm),
+	    ASM_CMDRSP_SHARED_MEM_MAP_REGIONS)) {
+		return false;
+	}
+	asm_handle = acall_rsp[0];
+	struct __attribute__((packed)) { uint32_t mode; uint16_t sink, bps; uint32_t popp, fmt; } ow =
+	{ 0, 0, 16, ASM_STREAM_POSTPROCOPO_ID_NONE, ASM_MEDIA_FMT_MULTI_CHANNEL_PCM_V2 };
+	if (!apr_call("asm open write", APR_SVC_ASM, ASM_PORT, ASM_STREAM_CMD_OPEN_WRITE_V3, &ow, sizeof(ow), 0)) {
+		return false;
+	}
+	struct __attribute__((packed)) {
+		uint16_t flags, mode, ep1, ep2;
+		uint32_t topology;
+		uint16_t channels, bit_width;
+		uint32_t rate;
+		uint8_t map[8];
+	} ao = { 0, 1 /* RX */, AFE_PORT_PRI_MI2S_RX, 0xFFFF, NULL_COPP_TOPOLOGY, 2, 16, 48000, { 1, 2 } };
+	if (!apr_call("adm open", APR_SVC_ADM, AFE_PORT_PRI_MI2S_RX, ADM_CMD_DEVICE_OPEN_V5, &ao, sizeof(ao),
+	    ADM_CMDRSP_DEVICE_OPEN_V5) || acall_rsp[0] != 0) {
+		goto close_asm;
+	}
+	copp = (uint16_t)acall_rsp[1];
+	{
+		struct __attribute__((packed)) { uint32_t matrix, nsess; uint16_t sess, ncopp, copp, pad; } mx =
+		{ 0, 1, ASM_SESSION, 1, copp, 0 };
+		if (!apr_call("adm matrix map", APR_SVC_ADM, 0, ADM_CMD_MATRIX_MAP_ROUTINGS_V5, &mx, sizeof(mx), 0)) {
+			goto close_adm;
+		}
+	}
+	{
+		struct __attribute__((packed)) { uint32_t blk; uint16_t ch, bps; uint32_t rate; uint16_t sgn, rsvd; uint8_t map[8]; } mf =
+		{ 20, 2, 16, 48000, 1, 0, { 1, 2 } };
+		apr_data(APR_SVC_ASM, ASM_PORT, ASM_DATA_CMD_MEDIA_FMT_UPDATE_V2, 0x7000, &mf, sizeof(mf));
+	}
+	asm_done = asm_underruns = 0;
+	{
+		uint32_t run[3] = { 0, 0, 0 };
+		if (!apr_call("asm run", APR_SVC_ASM, ASM_PORT, ASM_SESSION_CMD_RUN_V2, run, sizeof(run), 0)) {
+			goto close_adm;
+		}
+	}
+	if (amp) {
+		(void)tfa_start();
+	}
+	{
+		uint32_t sent = 0, want = seconds * 10;     /* 100 ms buffers */
+		unsigned t0ms = ms(), last_log = ms();
+		while (ms() - t0ms < seconds * 1000 + 500) {
+			while (sent < want && sent - asm_done < J_BUFS) {
+				uint32_t b = sent % J_BUFS;
+				uint64_t ba = pa + (uint64_t)b * J_BUF_BYTES;
+				uint32_t wr[8] = { (uint32_t)ba, (uint32_t)(ba >> 32) | j_msw, asm_handle, J_BUF_BYTES, sent, 0, 0, 0 };
+				apr_data(APR_SVC_ASM, ASM_PORT, ASM_DATA_CMD_WRITE_V2, sent, wr, sizeof(wr));
+				sent++;
+			}
+			if (!glink_poll()) {
+				IOSleep(2);
+			}
+			if (ms() - last_log >= 1000) {
+				last_log = ms();
+				LOG("t=%u.%03u tone: %u buffers sent, %u done, %u underruns", T, sent, asm_done, asm_underruns);
+				if (amp && last_log - t0ms < 2500) {
+					tfa_status("playing");
+				}
+			}
+		}
+		ok = asm_done > 0;
+		LOG("t=%u.%03u tone: end, %u sent, %u done, %u underruns -> %s", T, sent, asm_done, asm_underruns,
+		    ok ? "the ADSP consumed PCM" : "NOTHING consumed");
+	}
+	if (amp) {
+		tfa_stop();
+	}
+close_adm:
+	{
+		(void)apr_call("adm close", APR_SVC_ADM, copp, ADM_CMD_DEVICE_CLOSE_V5, NULL, 0, 0);
+	}
+close_asm:
+	(void)apr_call("asm close", APR_SVC_ASM, ASM_PORT, ASM_STREAM_CMD_CLOSE, NULL, 0, 0);
+	return ok;
+}
