+/* after q6core READY (adsp=1); boot-arg adsp_tone=N plays N s of 1 kHz through the speaker (default 3, 0 = none) */
+static void
+jas_speaker(void)
+{
+	uint32_t tone = 3;                          /* the command line is full: on by default for now */
+	int amp;
+
+	(void)PE_parse_boot_argn("adsp_tone", &tone, sizeof(tone));
+	(void)PE_parse_boot_argn("adsp_msw", &j_msw, sizeof(j_msw));
+	amp = j_i2c_init() ? amp_probe() : -1;
+	LOG("speaker: amplifier %s", amp == 0 ? "TFA98xx @34" : amp == 1 ? "TAS2557 @4c" : amp == 2 ? "MAX98927 @3a" : "not found");
+	j_mi2s_pins();
+	srn_register();
+	for (unsigned t = ms(); srn_state != SRN_UP && ms() - t < 20000;) {
+		if (!glink_poll()) {
+			IOSleep(5);
+		}
+		qrtr_poll();
+	}
+	LOG("t=%u.%03u speaker: %s %s", T, SRN_PATH, srn_state == SRN_UP ? "UP" : "not UP (going on anyway)");
+	/* diagnostics: which APR services the ADSP has, whether ASM and AFE answer at all */
+	if (apr_call("core versions", APR_SVC_CORE, 0, 0x00012905u, NULL, 0, 0x00012906u) && acall_words >= 2) {
+		LOG("avcs: words %u: %08x %08x %08x %08x", acall_words, acall_rsp[0], acall_rsp[1], acall_rsp[2], acall_rsp[3]);
+		for (uint32_t i = 0; i + 1 < acall_words && i < 38; i += 2) {
+			LOG("avcs:   %08x %08x", acall_rsp[i], acall_rsp[i + 1]);
+		}
+	}
+	{
+		uint64_t tpa = 0;
+		void *tb = topaz_pool_alloc(0x1000, &tpa);
+		struct __attribute__((packed)) { uint16_t pool, nreg; uint32_t prop; uint32_t lsw, msw, size; } tm =
+		{ 3, 1, 0, (uint32_t)tpa, (uint32_t)(tpa >> 32) | j_msw, 0x1000 };
+		if (tb != NULL) {
+			(void)apr_call("asm mem map probe", APR_SVC_ASM, 0, ASM_CMD_SHARED_MEM_MAP_REGIONS, &tm, sizeof(tm),
+			    ASM_CMDRSP_SHARED_MEM_MAP_REGIONS);
+		}
+		uint16_t st[2] = { AFE_PORT_PRI_MI2S_RX, 0 };
+		acall_op = 0;
+		(void)apr_call("afe stop probe", APR_SVC_AFE, 0, AFE_PORT_CMD_DEVICE_STOP, st, sizeof(st), 0);
+		if (acall_op == 0) {
+			afe_chan = "apr_apps2";
+			LOG("speaker: apr_apps2 %s; AFE commands go there now", glink_chan_up("apr_apps2") ? "up" : "down");
+			acall_op = 0;
+			(void)apr_call("afe stop probe (apr_apps2)", APR_SVC_AFE, 0, AFE_PORT_CMD_DEVICE_STOP, st, sizeof(st), 0);
+			if (acall_op == 0) {
+				afe_chan = ACHAN;
+			}
+		}
+	}
+	{
+		/* ADM answers? (a COPP on a port that is not started: expect an error, but an answer) */
+		struct __attribute__((packed)) {
+			uint16_t flags, mode, ep1, ep2;
+			uint32_t topology;
+			uint16_t channels, bit_width;
+			uint32_t rate;
+			uint8_t map[8];
+		} ao = { 0, 1, AFE_PORT_PRI_MI2S_RX, 0xFFFF, NULL_COPP_TOPOLOGY, 2, 16, 48000, { 1, 2 } };
+		acall_op = 0;
+		(void)apr_call("adm open probe", APR_SVC_ADM, AFE_PORT_PRI_MI2S_RX, ADM_CMD_DEVICE_OPEN_V5, &ao, sizeof(ao),
+		    ADM_CMDRSP_DEVICE_OPEN_V5);
+		if (acall_op == ADM_CMDRSP_DEVICE_OPEN_V5 && acall_rsp[0] == 0) {
+			(void)apr_call("adm close probe", APR_SVC_ADM, (uint16_t)acall_rsp[1], ADM_CMD_DEVICE_CLOSE_V5, NULL, 0, 0);
+		}
+	}
+	if (slim_node != 0xFFFFFFFFu) {
+		static const uint16_t msgs[2] = { 0x20, 0x21 };
+		for (unsigned k = 0; k < 2; k++) {
+			uint8_t t[32];
+			uint32_t n = 0, inst = 1, mode = 2 /* ADSP is master */, pm = 2 /* active */;
+			if (k == 0) {
+				n = (uint32_t)qm_tlv(t, n, 0x01, &inst, 4);
+				n = (uint32_t)qm_tlv(t, n, 0x10, &mode, 4);
+			} else {
+				n = (uint32_t)qm_tlv(t, n, 0x01, &pm, 4);
+			}
+			slim_rsp_msg = 0;
+			slim_send(msgs[k], t, n);
+			for (unsigned w = ms(); slim_rsp_msg == 0 && ms() - w < 2000;) {
+				if (!glink_poll()) {
+					IOSleep(2);
+				}
+			}
+			LOG("t=%u.%03u slimbus qmi %s: %s", T, k == 0 ? "select instance 1 (master)" : "power active",
+			    slim_rsp_msg == 0 ? "no answer" : slim_rsp_res == 0 ? "ok" : "error");
+		}
+	} else {
+		LOG("speaker: no SLIMbus QMI service seen");
+	}
+	bool clk = false;
+	for (unsigned i = 0; i < 3 && !clk; i++) {
+		clk = afe_clock(true);
+	}
+	if (!clk) {
+		LOG("t=%u.%03u speaker: AFE silent; trying again in 30 s", T);
+		for (unsigned t = ms(); ms() - t < 30000;) {
+			if (!glink_poll()) {
+				IOSleep(5);
+			}
+		}
+		clk = afe_clock(true);
+	}
+	if (!clk) {
+		return;
+	}
+	if (!afe_start()) {
+		(void)afe_clock(false);
+		return;
+	}
+	if (tone != 0) {
+		(void)jas_tone(MIN(tone, 10u), amp == 0);
+	} else if (amp == 0) {
+		bool up = tfa_start();
+		LOG("tfa: bypass start %s (no tone: adsp_tone=0)", up ? "OK" : "FAILED");
+		tfa_stop();
+	}
+	afe_stop();
+	(void)afe_clock(false);
+	LOG("t=%u.%03u speaker: done", T);
+}
