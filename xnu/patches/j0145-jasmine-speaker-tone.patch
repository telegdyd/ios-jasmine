+/*
+ * j0145: servreg notifier client (mainline pdr_interface.c): the stock kernel waits for the
+ * ADSP's msm/adsp/audio_pd to be UP (audio_notifier -> apr_adsp_up) before AFE/ASM/ADM.
+ * REGISTER_LISTENER (0x20) to service 0x42 answers the current state; STATE_UPDATED (0x22)
+ * indications are acked (0x23).
+ */
+#define SVC_SRN             0x42
+#define PORT_SRN            0x4002
+#define SRN_UP              0x1FFFFFFFu
+#define SRN_PATH            "msm/adsp/audio_pd"
+static uint32_t srn_node = 0xFFFFFFFFu, srn_port, srn_state = 0xFFFFFFFFu;
+static uint16_t srn_txn = 1;
+static bool srn_asked;
+
+static void
+srn_send(uint16_t msg, const uint8_t *tlvs, uint32_t n)
+{
+	uint8_t m[128];
+	if (n + 7 > sizeof(m)) {
+		return;
+	}
+	m[0] = QMI_REQ;
+	*(uint16_t *)(m + 1) = srn_txn++;
+	*(uint16_t *)(m + 3) = msg;
+	*(uint16_t *)(m + 5) = (uint16_t)n;
+	memcpy(m + 7, tlvs, n);
+	qrtr_send(QRTR_TYPE_DATA, PORT_SRN, srn_node, srn_port, m, n + 7);
+}
+
+/*
+ * j0145: SLIMbus QMI (service 0x301, slim-msm.c): the stock ngd driver for slim@15240000
+ * (cell-index 3, BT/FM) selects ADSP instance 1 as master and asks for power. Tried because
+ * AFE alone does not answer.
+ */
+#define SVC_SLIM            0x301
+#define PORT_SLIM           0x4003
+static uint32_t slim_node = 0xFFFFFFFFu, slim_port;
+static volatile uint32_t slim_rsp_msg, slim_rsp_res = 0xFFFFFFFFu;
+
+static void
+slim_send(uint16_t msg, const uint8_t *tlvs, uint32_t n)
+{
+	uint8_t m[64];
+	m[0] = QMI_REQ;
+	*(uint16_t *)(m + 1) = srn_txn++;
+	*(uint16_t *)(m + 3) = msg;
+	*(uint16_t *)(m + 5) = (uint16_t)n;
+	memcpy(m + 7, tlvs, n);
+	qrtr_send(QRTR_TYPE_DATA, PORT_SLIM, slim_node, slim_port, m, n + 7);
+}
+
+static void
+slim_rx(uint16_t msg, const uint8_t *d, uint32_t len)
+{
+	uint16_t l = 0;
+	const uint8_t *v = qm_find(d, len, 0x02, &l);
+	slim_rsp_res = v != NULL && l >= 4 ? *(const uint32_t *)v : 0xFFFFFFFEu;
+	slim_rsp_msg = msg;
+	LOG("t=%u.%03u slimbus qmi: msg %x result %08x", T, msg, slim_rsp_res);
+}
+
+static void
+srn_register(void)
+{
+	uint8_t t[96];
+	uint32_t n = 0;
+	uint8_t on = 1;
+
+	if (srn_node == 0xFFFFFFFFu || srn_asked) {
+		return;
+	}
+	srn_asked = true;
+	n = (uint32_t)qm_tlv(t, n, 0x01, &on, 1);
+	n = (uint32_t)qm_tlv(t, n, 0x02, SRN_PATH, (uint16_t)strlen(SRN_PATH));
+	srn_send(0x20, t, n);
+	LOG("t=%u.%03u servreg: register listener for %s (node %u port %x)", T, SRN_PATH, srn_node, srn_port);
+}
+
+static void
+srn_rx(uint8_t type, uint16_t msg, const uint8_t *d, uint32_t len)
+{
+	uint16_t l = 0;
+	const uint8_t *v;
+
+	if (type == QMI_RESP && msg == 0x20) {
+		v = qm_find(d, len, 0x02, &l);
+		uint32_t res = v != NULL && l >= 4 ? *(const uint32_t *)v : 0xFFFFFFFFu;
+		v = qm_find(d, len, 0x10, &l);
+		if (v != NULL && l >= 4) {
+			srn_state = *(const uint32_t *)v;
+		}
+		LOG("t=%u.%03u servreg: register listener: result %08x, %s state %08x%s", T, res, SRN_PATH, srn_state,
+		    srn_state == SRN_UP ? " UP" : "");
+	} else if (msg == 0x22) {
+		uint16_t txn = 0, pl = 0;
+		const uint8_t *path;
+		v = qm_find(d, len, 0x01, &l);
+		if (v != NULL && l >= 4) {
+			srn_state = *(const uint32_t *)v;
+		}
+		path = qm_find(d, len, 0x02, &pl);
+		v = qm_find(d, len, 0x03, &l);
+		if (v != NULL && l >= 2) {
+			txn = *(const uint16_t *)v;
+		}
+		LOG("t=%u.%03u servreg: state update %08x%s (txn %u)", T, srn_state, srn_state == SRN_UP ? " UP" : "", txn);
+		if (path != NULL) {
+			uint8_t t[96];
+			uint32_t n = 0;
+			n = (uint32_t)qm_tlv(t, n, 0x01, path, (uint16_t)MIN(pl, (uint16_t)64));
+			n = (uint32_t)qm_tlv(t, n, 0x02, &txn, 2);
+			srn_send(0x23, t, n);
+		}
+	} else {
+		LOG("t=%u.%03u servreg: type %u msg %x, %u B", T, type, msg, len);
+	}
+}
