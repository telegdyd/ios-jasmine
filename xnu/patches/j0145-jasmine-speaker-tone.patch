+static bool
+afe_start(void)
+{
+	struct __attribute__((packed)) {
+		uint16_t port, payload_size;
+		uint32_t lsw, msw, handle;
+		uint32_t module, param;
+		uint16_t psize, rsvd;
+		uint32_t minor;
+		uint16_t bit_width, channel_mode, mono_stereo, ws_src;
+		uint32_t rate;
+		uint16_t data_format, rsvd2;
+	} cfg = { AFE_PORT_PRI_MI2S_RX, 12 + 20, 0, 0, 0, AFE_MODULE_AUDIO_DEV_INTERFACE, AFE_PARAM_ID_I2S_CONFIG, 20, 0,
+		      1, 16, 1 /* SD0 */, 1 /* stereo */, 1 /* WS internal */, 48000, 0, 0 };
+	uint16_t st[2] = { AFE_PORT_PRI_MI2S_RX, 0 };
+
+	return apr_call("afe i2s config", APR_SVC_AFE, 0, AFE_PORT_CMD_SET_PARAM_V2, &cfg, sizeof(cfg), 0) &&
+	       apr_call("afe port start", APR_SVC_AFE, 0, AFE_PORT_CMD_DEVICE_START, st, sizeof(st), 0);
+}
