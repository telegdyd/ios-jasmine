+/* ---- AFE: PRI_MI2S_RX, 48 kHz 16-bit stereo, SD0, SoC master */
+
+static bool
+afe_clock(bool on)
+{
+	uint32_t p[15] = { 36, 0, 0, 0, AFE_MODULE_CLOCK_SET, AFE_PARAM_ID_CLOCK_SET, 24,
+		               1, LPASS_CLK_ID_PRI_MI2S_IBIT, 1536000, 1 /* attri COUPLE_NO, root 0 */, on ? 1u : 0u };
+	return apr_call(on ? "afe clock on" : "afe clock off", APR_SVC_AFE, 0, AFE_SVC_CMD_SET_PARAM, p, 12 * 4, 0);
+}
