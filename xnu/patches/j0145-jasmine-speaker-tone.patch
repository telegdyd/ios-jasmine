+/* ---------------------------------------------------------------- jasmine speaker (j0145) */
+
+/*
+ * The loudspeaker is not on the SDM660 internal codec: stock mixer_paths routes "speaker" to
+ * PRI_MI2S_RX ("smart PA TFA 9894"). Stock DT (Android boot_a dtb): i2c@c1b6000 (BLSP2 QUP2 =
+ * "i2c6", GPIO 22/23 blsp_i2c6) carries tfa98xx@34, tas2557@4c and max98927@3a (one is fitted),
+ * reset GPIO 77, irq GPIO 73, supply pm660l L6 (also the DSI 3.3 V rail: already on). Pins
+ * GPIO 12-15 pri_mi2s, the SoC is I2S master (qcom,msm-mi2s-master), rx-lines SD0.
+ *
+ * TFA9894 is set up as the NXP driver does for the container's (vendor tfa98xx.cnt) "bypass"
+ * profile: tfa98xx_init (I2CR, DSP reset, tfa9894_specific), the device list's registers and
+ * bitfields, the profile's bitfields (DSP off, amplifier input straight from I2S), INIT_CF,
+ * OPERATING. No CoolFlux patch or speaker model is loaded, so there is no speaker protection:
+ * keep the level low (adsp_tone uses -20 dBFS).
+ *
+ * Playback as the stock qdsp6v2 stack: AFE clock (PRI_MI2S_IBIT 1.536 MHz) + I2S config +
+ * port start (0x1000), ASM shared memory map, ASM open write (PCM v2), ADM open (NULL COPP)
+ * + matrix map, media format, run, ASM writes. Buffers live in the modem pool; the ADSP
+ * reaches them through the LPASS SMMU (0x5100000) stream 1, given an identity bank here
+ * (stock: msm-audio-ion iommus <&lpass_smmu 1>, address msw = SID bits).
+ */
+extern "C" vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+
+#define J_GCC_PA            0x00100000ull
+#define J_TLMM_NORTH        0x03900000ull
+#define J_TLMM_CENTER       0x03500000ull
+#define J_QUP6_PA           0x0C1B6000ull
+#define J_LSMMU_PA          0x05100000ull
+#define J_LSMMU_SIZE        0x00040000u
+#define J_TLMM_DRV(ma)      ((((ma) / 2u) - 1u) << 6)
+#define J_TLMM_OE           (1u << 9)
+
+#define APR_SVC_AFE         4
+#define APR_SVC_ASM         7
+#define APR_SVC_ADM         8
+#define AFE_PORT_PRI_MI2S_RX            0x1000u
+#define AFE_PORT_CMD_SET_PARAM_V2       0x000100EFu
+#define AFE_PORT_CMD_DEVICE_START       0x000100E5u
+#define AFE_PORT_CMD_DEVICE_STOP        0x000100E6u
+#define AFE_SVC_CMD_SET_PARAM           0x000100F3u
+#define AFE_MODULE_AUDIO_DEV_INTERFACE  0x0001020Cu
+#define AFE_PARAM_ID_I2S_CONFIG         0x0001020Du
+#define AFE_MODULE_CLOCK_SET            0x0001028Fu
+#define AFE_PARAM_ID_CLOCK_SET          0x00010290u
+#define LPASS_CLK_ID_PRI_MI2S_IBIT      0x100u
+#define ADM_CMD_DEVICE_OPEN_V5          0x00010326u
+#define ADM_CMD_DEVICE_CLOSE_V5         0x00010327u
+#define ADM_CMDRSP_DEVICE_OPEN_V5       0x00010329u
+#define ADM_CMD_MATRIX_MAP_ROUTINGS_V5  0x00010325u
+#define NULL_COPP_TOPOLOGY              0x00010312u
+#define ASM_CMD_SHARED_MEM_MAP_REGIONS  0x00010D92u
+#define ASM_CMDRSP_SHARED_MEM_MAP_REGIONS 0x00010D93u
+#define ASM_STREAM_CMD_OPEN_WRITE_V3    0x00010DB3u
+#define ASM_STREAM_CMD_CLOSE            0x00010BCDu
+#define ASM_MEDIA_FMT_MULTI_CHANNEL_PCM_V2 0x00010DA5u
+#define ASM_STREAM_POSTPROCOPO_ID_NONE  0x00010C68u
+#define ASM_DATA_CMD_MEDIA_FMT_UPDATE_V2 0x00010D98u
+#define ASM_SESSION_CMD_RUN_V2          0x00010DAAu
+#define ASM_DATA_CMD_WRITE_V2           0x00010DABu
+#define ASM_DATA_EVENT_WRITE_DONE_V2    0x00010D99u
+#define ASM_SESSION_EVENT_RX_UNDERFLOW  0x00010C17u
+#define ASM_SESSION                     1
+#define ASM_PORT                        ((ASM_SESSION << 8) | 1)
+
+static volatile uint8_t *j_gcc, *j_qup;
+static uint32_t j_i2c_addr, j_in_fifo, j_out_fifo;
+static uint32_t j_msw = 1;                      /* boot-arg adsp_msw: upper address word (stock: SID 1) */
+
+static volatile uint32_t *
+j_map(uint64_t pa)
+{
+	return (volatile uint32_t *)(ml_io_map((vm_offset_t)(pa & ~0xfffull), 0x1000) + (pa & 0xfff));
+}
+
+static void
+j_pin(unsigned gpio, uint32_t cfg)
+{
+	uint64_t tile = gpio >= 22 && gpio <= 23 ? J_TLMM_CENTER : J_TLMM_NORTH;
+	volatile uint32_t *p = j_map(tile + 0x1000ull * gpio);
+	p[0] = cfg;
+	mb();
+}
+
+static void
+j_gpio_out(unsigned gpio, bool high)
+{
+	volatile uint32_t *p = j_map(J_TLMM_NORTH + 0x1000ull * gpio);
+	p[1] = high ? 2 : 0;
+	p[0] = J_TLMM_OE | J_TLMM_DRV(2);
+	mb();
+}
+
+/* ---- polled QUP v2 I2C (as bsd/dev/sweet_nvt.c, BLSP2 QUP2) */
+
+#define QUP_CONFIG              0x000
+#define QUP_STATE               0x004
+#define QUP_IO_MODE             0x008
+#define QUP_SW_RESET            0x00c
+#define QUP_OPERATIONAL         0x018
+#define QUP_ERROR_FLAGS         0x01c
+#define QUP_HW_VERSION          0x030
+#define QUP_MX_OUTPUT_CNT       0x100
+#define QUP_OUT_FIFO_BASE       0x110
+#define QUP_MX_WRITE_CNT        0x150
+#define QUP_MX_INPUT_CNT        0x200
+#define QUP_MX_READ_CNT         0x208
+#define QUP_IN_FIFO_BASE        0x218
+#define QUP_I2C_CLK_CTL         0x400
+#define QUP_I2C_STATUS          0x404
+#define QUP_I2C_MASTER_GEN      0x408
+#define QUP_CONFIG_I2C          ((2u << 8) | 7)
+#define QUP_REPACK_EN           (3u << 14)
+#define QUP_I2C_ERRS            0x38000fcu
+#define QUP_I2C_BUS_ACTIVE      (1u << 8)
+#define QUP_ERRS                0x7cu
+#define QUP_CLK_400K            ((14u << 16) | (3u << 8) | 28u)
+
+static inline uint32_t qr(uint32_t o) { return *(volatile uint32_t *)(j_qup + o); }
+static inline void qw(uint32_t o, uint32_t v) { *(volatile uint32_t *)(j_qup + o) = v; }
+
+static int
+qup_wait(uint32_t state, uint32_t mask)
+{
+	for (int i = 0; i < 1000; i++) {
+		uint32_t s = qr(QUP_STATE);
+		if ((s & 4) && (s & mask) == state) {
+			return 0;
+		}
+		IODelay(1);
+	}
+	return -1;
+}
+
+static int
+qup_state(uint32_t state)
+{
+	if (qup_wait(0, 0) != 0) {
+		return -1;
+	}
+	qw(QUP_STATE, state);
+	return qup_wait(state, 3);
+}
+
+static int
+j_i2c(const uint8_t *wbuf, uint32_t wlen, uint8_t *rbuf, uint32_t rlen)
+{
+	uint8_t tags[16];
+	uint32_t nt = 0, got = 0, need = rlen ? rlen + 2 : 0;
+	int err = 0;
+
+	if (wlen + 8 > sizeof(tags) || need > j_in_fifo) {
+		return -1;
+	}
+	tags[nt++] = 0x81;
+	tags[nt++] = (uint8_t)(j_i2c_addr << 1);
+	tags[nt++] = rlen ? 0x82 : 0x83;            /* DATAWR / DATAWR_STOP */
+	tags[nt++] = (uint8_t)wlen;
+	for (uint32_t i = 0; i < wlen; i++) {
+		tags[nt++] = wbuf[i];
+	}
+	if (rlen) {
+		tags[nt++] = 0x81;
+		tags[nt++] = (uint8_t)(j_i2c_addr << 1 | 1);
+		tags[nt++] = 0x87;                      /* DATARD_STOP */
+		tags[nt++] = (uint8_t)rlen;
+	}
+	qw(QUP_SW_RESET, 1);
+	if (qup_wait(0, 3) != 0) {
+		return -3;
+	}
+	qw(QUP_CONFIG, QUP_CONFIG_I2C);
+	qw(QUP_I2C_MASTER_GEN, 1);
+	if (qup_wait(1u << 4, 1u << 4) != 0) {
+		return -4;
+	}
+	qw(QUP_MX_OUTPUT_CNT, 0);
+	qw(QUP_MX_INPUT_CNT, 0);
+	qw(QUP_IO_MODE, QUP_REPACK_EN);
+	qw(QUP_MX_WRITE_CNT, nt);
+	qw(QUP_MX_READ_CNT, need);
+	qw(QUP_CONFIG, QUP_CONFIG_I2C | (rlen ? 0 : (1u << 7)));
+	if (qup_state(1) != 0) {
+		return -5;
+	}
+	qw(QUP_I2C_CLK_CTL, QUP_CLK_400K);
+	if (qup_state(3) != 0) {
+		return -6;
+	}
+	for (uint32_t i = 0; i < nt; i += 4) {
+		uint32_t w = 0;
+		for (uint32_t j = 0; j < 4 && i + j < nt; j++) {
+			w |= (uint32_t)tags[i + j] << (8 * j);
+		}
+		qw(QUP_OUT_FIFO_BASE, w);
+	}
+	if (qup_state(1) != 0) {
+		return -7;
+	}
+	for (int t = 0; t < 400; t++) {
+		uint32_t st = qr(QUP_I2C_STATUS) & QUP_I2C_ERRS, qe = qr(QUP_ERROR_FLAGS) & QUP_ERRS;
+		if (st || qe) {
+			err = (int)(st | qe << 24) | 0x40000000;
+			break;
+		}
+		while (got < need && (qr(QUP_OPERATIONAL) & (1u << 5))) {
+			uint32_t w = qr(QUP_IN_FIFO_BASE);
+			for (int j = 0; j < 4 && got < need; j++, got++, w >>= 8) {
+				if (got >= 2) {
+					rbuf[got - 2] = (uint8_t)w;
+				}
+			}
+		}
+		if (got >= need && !(qr(QUP_I2C_STATUS) & QUP_I2C_BUS_ACTIVE)) {
+			break;
+		}
+		IODelay(50);
+	}
+	if (!err && (got < need || (qr(QUP_I2C_STATUS) & QUP_I2C_BUS_ACTIVE))) {
+		err = -8;
+	}
+	qw(QUP_STATE, 0);
+	return err;
+}
+
+static bool
+j_i2c_init(void)
+{
+	volatile uint32_t *vote = j_map(J_GCC_PA + 0x52004), *rcg = j_map(J_GCC_PA + 0x28020), *cbcr = j_map(J_GCC_PA + 0x28008);
+
+	*vote |= 1u << 15;                          /* gcc_blsp2_ahb_clk */
+	rcg[1] = 1;                                 /* blsp2_qup2_i2c_apps_clk_src: XO, div 1 */
+	rcg[0] |= 1;
+	for (int i = 0; i < 1000 && (rcg[0] & 1); i++) {
+		IODelay(1);
+	}
+	*cbcr |= 1;
+	for (int i = 0; i < 1000 && (*cbcr & (1u << 31)); i++) {
+		IODelay(1);
+	}
+	if (*cbcr & (1u << 31)) {
+		LOG("i2c6: QUP core clock stays off (cbcr %08x)", *cbcr);
+		return false;
+	}
+	j_pin(22, 3u << 2 | J_TLMM_DRV(2));         /* blsp_i2c6 */
+	j_pin(23, 3u << 2 | J_TLMM_DRV(2));
+	j_qup = (volatile uint8_t *)ml_io_map((vm_offset_t)J_QUP6_PA, 0x1000);
+	uint32_t io = qr(QUP_IO_MODE);
+	static const uint32_t blk[] = { 4, 16, 32 };
+	uint32_t ob = (io & 3) < 3 ? blk[io & 3] : 4, ib = ((io >> 5) & 3) < 3 ? blk[(io >> 5) & 3] : 4;
+	j_out_fifo = ob * (2u << ((io >> 2) & 7));
+	j_in_fifo = ib * (2u << ((io >> 7) & 7));
+	LOG("i2c6: QUP version %08x io_mode %08x fifo out %u in %u", qr(QUP_HW_VERSION), io, j_out_fifo, j_in_fifo);
+	return j_in_fifo >= 8 && j_out_fifo >= 12;
+}
+
+/* ---- TFA9894: 16-bit big-endian registers, bitfield 0xRRPL (reg, bit pos, len - 1) */
+
+static int
+tfa_rd(uint8_t reg, uint16_t *v)
+{
+	uint8_t b[2] = { 0, 0 };
+	int r = j_i2c(&reg, 1, b, 2);
+	*v = (uint16_t)(b[0] << 8 | b[1]);
+	return r;
+}
+
+static int
+tfa_wr(uint8_t reg, uint16_t v)
+{
+	uint8_t b[3] = { reg, (uint8_t)(v >> 8), (uint8_t)v };
+	return j_i2c(b, 3, NULL, 0);
+}
+
+static int
+tfa_bf(uint16_t field, uint16_t value)
+{
+	uint8_t reg = (uint8_t)(field >> 8);
+	uint32_t pos = (field >> 4) & 0xF, len = (field & 0xF) + 1;
+	uint16_t mask = (uint16_t)(((1u << len) - 1) << pos), v = 0;
+	int r = tfa_rd(reg, &v);
+	if (r == 0) {
+		r = tfa_wr(reg, (uint16_t)((v & ~mask) | ((value << pos) & mask)));
+	}
+	return r;
+}
+
+static uint16_t
+tfa_bf_get(uint16_t field)
+{
+	uint16_t v = 0;
+	(void)tfa_rd((uint8_t)(field >> 8), &v);
+	return (uint16_t)((v >> ((field >> 4) & 0xF)) & ((1u << ((field & 0xF) + 1)) - 1));
+}
+
+/* vendor tfa98xx.cnt, device "left": bitfields after the 0x0f/0xa1/0xa0 key writes (tfaContWriteRegsDev) */
+static const uint16_t tfa_dev_bf[][2] = {
+	{ 0x2103, 0 }, { 0x2204, 15 }, { 0x22a4, 15 }, { 0x2010, 1 }, { 0x2020, 1 }, { 0x2030, 1 }, { 0x2040, 1 },
+	{ 0x2303, 0 }, { 0x2343, 1 }, { 0x2403, 0 }, { 0x2443, 1 }, { 0x0255, 20 }, { 0x7160, 1 }, { 0x5287, 190 },
+	{ 0x7304, 8 }, { 0x7180, 0 }, { 0x7101, 3 }, { 0x6152, 1 }, { 0x8105, 21 }, { 0x8164, 28 }, { 0x8263, 4 },
+	{ 0x8001, 0 }, { 0x5690, 0 }, { 0x6102, 2 }, { 0x00d0, 0 }, { 0x8901, 2 }, { 0x8310, 1 }, { 0x8250, 0 },
+	{ 0x5743, 4 }, { 0x5703, 4 }, { 0x7204, 9 }, { 0x7254, 5 }, { 0x72a4, 13 }, { 0x7005, 30 }, { 0x7065, 63 },
+};
+/* profile "bypass", items before its Default marker: DCA, AMPINSEL, DCINSEL, HPFBYP, CFE, AMPC, AMPE, MTPEX, LPM1MODE, LNMODE */
+static const uint16_t tfa_bypass_bf[][2] = {
+	{ 0x0040, 1 }, { 0x0101, 0 }, { 0x5781, 0 }, { 0x00d0, 1 }, { 0x0020, 0 }, { 0x0060, 0 }, { 0x0030, 1 },
+	{ 0xf010, 1 }, { 0x5ac1, 0 }, { 0x5881, 0 },
+};
+
+#define TFA_PWDN            0x0000
+#define TFA_SBSL            0x0050
+#define TFA_MANSCONF        0x0120
+#define TFA_CLKS            0x1060
+#define TFA_MANSTATE        0x1433
+#define TFA_CFSM            0x5130
+#define TFA_RST             0x9000
+
+static uint16_t tfa_rev;
+
+static void
+tfa_status(const char *when)
+{
+	uint16_t s0 = 0, s1 = 0, s2 = 0, r0 = 0;
+	(void)tfa_rd(0x10, &s0);
+	(void)tfa_rd(0x11, &s1);
+	(void)tfa_rd(0x13, &s2);
+	(void)tfa_rd(0x00, &r0);
+	LOG("t=%u.%03u tfa %s: SYS_CTRL0 %04x STATUS 10=%04x 11=%04x 13=%04x (CLKS %u MANSTATE %u)", T, when, r0, s0, s1,
+	    s2, (s0 >> 6) & 1, tfa_bf_get(TFA_MANSTATE));
+}
+
+extern "C" int sweet_pmic_peek(uint32_t sid, uint32_t addr, unsigned n, uint32_t *out);
+
+/*
+ * Which amplifier answers. Reset GPIO 77: TFA98xx reset is active high (tfa98xx_reset: high
+ * 10 ms, low 10 ms), TAS2557/MAX98927 reset is active low; try low then high. Pull-ups: the
+ * amps' DT "i2c-pull-up" + vcc_i2c = pm660l L6; second round with the TLMM pull-ups too.
+ */
+static int amp_probe_once(void);
+
+static int
+amp_probe(void)
+{
+	uint32_t a = 0, b = 0, c = 0, d = 0;
+	int r1 = sweet_pmic_peek(3, 0x4508, 4, &a), r2 = sweet_pmic_peek(3, 0x4540, 4, &b);
+	int r3 = sweet_pmic_peek(2, 0x4508, 4, &c), r4 = sweet_pmic_peek(2, 0x4540, 4, &d);
+	LOG("pm660l L6 (0x4500): sid3 status %08x (%d) vset/mode/en %08x (%d); sid2 status %08x (%d) vset %08x (%d)", a, r1,
+	    b, r2, c, r3, d, r4);
+	for (unsigned round = 0; round < 4; round++) {
+		bool high = round & 1, pull = round >= 2;
+		if (pull) {
+			j_pin(22, 3u << 2 | J_TLMM_DRV(2) | 3u);    /* + pull-up */
+			j_pin(23, 3u << 2 | J_TLMM_DRV(2) | 3u);
+		}
+		j_gpio_out(77, !high);
+		IOSleep(10);
+		j_gpio_out(77, high);
+		IOSleep(10);
+		LOG("amp probe round %u: reset gpio77 %s, %s", round, high ? "high" : "low", pull ? "TLMM pull-ups" : "no pull-ups");
+		int f = amp_probe_once();
+		if (f >= 0) {
+			return f;
+		}
+	}
+	j_gpio_out(77, false);
+	return -1;
+}
+
+static int
+amp_probe_once(void)
+{
+	static const uint8_t addr[3] = { 0x34, 0x4c, 0x3a };
+	int found = -1;
+
+	for (unsigned i = 0; i < 3; i++) {
+		uint8_t reg = i == 2 ? 0x01 : 0x03, b[2] = { 0, 0 };
+		j_i2c_addr = addr[i];
+		static const uint8_t max_rev[2] = { 0x01, 0xff };
+		int r = i == 2 ? j_i2c(max_rev, 2, b, 1) : j_i2c(&reg, 1, b, i == 0 ? 2 : 1);
+		LOG("amp probe %02x: %s (%d) %02x %02x", addr[i], r == 0 ? "ACK" : "no answer", r, b[0], b[1]);
+		if (r == 0 && found < 0) {
+			found = i;
+			if (i == 0) {
+				tfa_rev = (uint16_t)(b[0] << 8 | b[1]);
+			}
+		}
+	}
+	return found;
+}
+
+static bool
+tfa_start(void)
+{
+	uint16_t v = 0;
+	int err = 0;
+
+	j_i2c_addr = 0x34;
+	LOG("tfa: rev %04x%s", tfa_rev, (tfa_rev & 0xff) == 0x94 ? " (TFA9894)" : " (not a TFA9894: stop)");
+	if ((tfa_rev & 0xff) != 0x94) {
+		return false;
+	}
+	err |= tfa_wr(0x00, 0x0002);                /* I2CR (whole register, as tfa98xx_init) */
+	IOSleep(2);
+	err |= tfa_bf(TFA_RST, 1);                  /* CoolFlux in reset */
+	err |= tfa_wr(0x0F, 0x5A6B);                /* tfa9894_specific: unlock keys */
+	err |= tfa_rd(0xFB, &v);
+	err |= tfa_wr(0xA0, (uint16_t)(v ^ 0x005A));
+	if (tfa_rev == 0x0a94 || tfa_rev == 0x1a94) {
+		bool v7 = tfa_rev == 0x1a94;
+		err |= tfa_wr(0x00, 0xa245);
+		err |= tfa_wr(0x02, v7 ? 0x5288 : 0x51e8);
+		err |= tfa_wr(0x52, 0xbe17);
+		if (v7) {
+			err |= tfa_wr(0x56, 0x05c3);
+		}
+		err |= tfa_wr(0x57, 0x0344);
+		err |= tfa_wr(0x61, v7 ? 0x0032 : 0x0033);
+		err |= tfa_wr(0x71, 0x00cf);
+		err |= tfa_wr(0x72, 0x34a9);
+		err |= tfa_wr(0x73, 0x3808);
+		err |= tfa_wr(0x76, 0x0067);
+		err |= tfa_wr(0x80, 0x0000);
+		err |= tfa_wr(0x81, 0x5715);
+		err |= tfa_wr(0x82, 0x0104);
+	}
+	err |= tfa_wr(0x0F, 0x5A6B);                /* device list: registers */
+	err |= tfa_wr(0xA1, 0x005A);
+	err |= tfa_wr(0xA0, 0x005A);
+	for (unsigned i = 0; i < sizeof(tfa_dev_bf) / sizeof(tfa_dev_bf[0]); i++) {
+		err |= tfa_bf(tfa_dev_bf[i][0], tfa_dev_bf[i][1]);
+	}
+	for (unsigned i = 0; i < sizeof(tfa_bypass_bf) / sizeof(tfa_bypass_bf[0]); i++) {
+		err |= tfa_bf(tfa_bypass_bf[i][0], tfa_bypass_bf[i][1]);
+	}
+	if (err != 0) {
+		LOG("tfa: register writes failed (%x)", err);
+		return false;
+	}
+	tfa_status("configured");
+	/* INIT_CF: SBSL 0, MANSCONF 1, PWDN 0, wait for CLKS (needs the I2S bit clock) */
+	(void)tfa_bf(TFA_SBSL, 0);
+	(void)tfa_bf(TFA_MANSCONF, 1);
+	(void)tfa_bf(TFA_PWDN, 0);
+	unsigned n;
+	for (n = 0; n < 100 && tfa_bf_get(TFA_CLKS) != 1; n++) {
+		IOSleep(1);
+	}
+	LOG("tfa: clocks %s after %u ms", n < 100 ? "stable" : "NOT stable", n);
+	/* OPERATING, unmuted */
+	(void)tfa_bf(TFA_PWDN, 0);
+	(void)tfa_bf(TFA_MANSCONF, 1);
+	(void)tfa_bf(TFA_SBSL, 1);
+	(void)tfa_bf(TFA_CFSM, 0);
+	IOSleep(20);
+	tfa_status("operating");
+	return n < 100;
+}
+
+static void
+tfa_stop(void)
+{
+	j_i2c_addr = 0x34;
+	(void)tfa_bf(0x0030, 0);                    /* AMPE */
+	(void)tfa_bf(TFA_PWDN, 1);
+	tfa_status("powered down");
+}
+
+/* ---- LPASS SMMU: identity bank for stream 1 (port of TopazModem smmu_identity) */
+
+static bool
+lpass_smmu_identity(uint32_t sid)
+{
+	volatile uint32_t *vote = j_map(J_GCC_PA + 0x7d014), *gdsc = j_map(J_GCC_PA + 0x7d034);
+
+	LOG("lpass smmu: before: clk vote %08x gdsc %08x", *vote, *gdsc);
+	*gdsc &= ~1u;                               /* hlos1_vote_lpass_adsp_gdsc: SW_COLLAPSE off */
+	*vote |= 1u;                                /* hlos1_vote_lpass_adsp_smmu_clk */
+	IOSleep(1);
+	LOG("lpass smmu: after: clk vote %08x gdsc %08x", *vote, *gdsc);
+	volatile uint8_t *s = (volatile uint8_t *)ml_io_map((vm_offset_t)J_LSMMU_PA, J_LSMMU_SIZE);
+#define SR(o)       (*(volatile uint32_t *)(s + (o)))
+	uint32_t cr0 = SR(0x0), id0 = SR(0x20), id1 = SR(0x24);
+	uint32_t nsmr = id0 & 0xFF, ncb = id1 & 0xFF;
+	uint32_t psize = (id1 & (1u << 31)) ? 0x10000 : 0x1000, npage = 1u << (((id1 >> 28) & 7) + 1);
+	uint32_t slot = ~0u, cb = ~0u;
+	uint64_t used = 0;
+
+	LOG("lpass smmu: sCR0 %08x (CLIENTPD %u USFCFG %u) ID0 %08x ID1 %08x: %u SMRs %u CBs page %x x%u", cr0, cr0 & 1,
+	    (cr0 >> 10) & 1, id0, id1, nsmr, ncb, psize, npage);
+	for (uint32_t i = 0; i < nsmr && i < 64; i++) {
+		uint32_t smr = SR(0x800 + 4 * i), s2cr = SR(0xC00 + 4 * i);
+		if (smr >> 31) {
+			LOG("lpass smmu: SMR%u %08x S2CR %08x", i, smr, s2cr);
+			if (((s2cr >> 16) & 3) == 0) {
+				used |= 1ull << (s2cr & 0x3F);
+			}
+			if ((smr & 0x7FFF) == sid) {
+				LOG("lpass smmu: stream %u already has SMR%u: left as it is", sid, i);
+				return true;
+			}
+		} else if (slot == ~0u) {
+			slot = i;
+		}
+	}
+	if (cr0 & 1) {
+		LOG("lpass smmu: client port disabled: bypass, physical addresses");
+		j_msw = 0;
+		return true;
+	}
+	for (uint32_t i = 1; i < ncb && i < 64; i++) {
+		if ((used & (1ull << i)) == 0) {
+			cb = i;
+			break;
+		}
+	}
+	if (slot == ~0u || cb == ~0u || (uint64_t)(npage + cb + 1) * psize > J_LSMMU_SIZE) {
+		LOG("lpass smmu: no free SMR/CB (slot %u cb %u)", slot, cb);
+		return false;
+	}
+	volatile uint8_t *gr1 = s + psize, *cbp = s + (uint64_t)npage * psize + (uint64_t)cb * psize;
+#define W(b, o, v)  do { mb(); *(volatile uint32_t *)((b) + (o)) = (v); } while (0)
+	W(cbp, 0x58, 0xFFFFFFFF);
+	W(cbp, 0x20, 0);
+	W(cbp, 0x24, 0);
+	W(cbp, 0x30, 0);
+	W(cbp, 0x10, 0);
+	W(cbp, 0x38, 0);
+	W(cbp, 0x3C, 0);
+	W(gr1, 0x800 + 4 * cb, 0x00000001);         /* CBA2R VA64 */
+	W(gr1, 0x000 + 4 * cb, 0x0001f000);         /* CBAR S1 trans / S2 fault, WB */
+	W(cbp, 0x0, 0x000000e0);                    /* SCTLR, M=0: no translation */
+	W(s, 0xC00 + 4 * slot, cb);
+	W(s, 0x800 + 4 * slot, (1u << 31) | sid);
+#undef W
+	uint32_t smr = SR(0x800 + 4 * slot), s2cr = SR(0xC00 + 4 * slot);
+	LOG("lpass smmu: stream %u -> identity CB%u via SMR%u: SMR %08x S2CR %08x SCTLR %08x", sid, cb, slot, smr, s2cr,
+	    *(volatile uint32_t *)cbp);
+#undef SR
+	return (smr >> 31) != 0 && (s2cr & 0x3F) == cb;
+}
+
+/* ---- APR calls: wait for the reply with our token */
+
+static uint32_t acall_token, acall_op, acall_rsp[40], acall_words;
+static volatile bool acall_done;
+static const char *afe_chan = ACHAN;          /* the glink channel AFE commands go on */
+static uint32_t asm_done, asm_underruns, asm_events;
+static uint32_t asm_handle;
+
+static bool
+apr_reply(const struct apr_hdr *h, const uint8_t *data, uint32_t len)
+{
+	uint32_t hlen = ((h->hdr_field >> 4) & 0xF) * 4;
+
+	if (h->opcode == ASM_DATA_EVENT_WRITE_DONE_V2) {
+		asm_done++;
+		return true;
+	}
+	if (h->opcode == ASM_SESSION_EVENT_RX_UNDERFLOW) {
+		asm_underruns++;
+		return true;
+	}
+	if (acall_token == 0 || h->token != acall_token || len < hlen) {
+		return false;
+	}
+	acall_op = h->opcode;
+	acall_words = MIN((len - hlen) / 4, (uint32_t)(sizeof(acall_rsp) / 4));
+	memcpy(acall_rsp, data + hlen, acall_words * 4);
+	acall_done = true;
+	return true;
+}
+
+/* a command; true if the ADSP answered with status 0 (APR_BASIC_RSP_RESULT) or the expected response */
+static bool
+apr_call(const char *what, uint8_t svc, uint16_t port, uint32_t opcode, const void *payload, uint32_t len, uint32_t rsp_op)
+{
+	uint8_t buf[sizeof(struct apr_hdr) + 128];
+	struct apr_hdr *h = (struct apr_hdr *)buf;
+
+	if (len > 128) {
+		return false;
+	}
+	bzero(buf, sizeof(buf));
+	h->hdr_field = APR_HDR_FIELD_CMD;
+	h->pkt_size = (uint16_t)(sizeof(struct apr_hdr) + len);
+	h->src_svc = svc;
+	h->src_domain = APR_DOMAIN_APPS;
+	h->src_port = port;
+	h->dest_svc = svc;
+	h->dest_domain = APR_DOMAIN_ADSP;
+	h->dest_port = port;
+	h->token = acall_token = apr_token++;
+	h->opcode = opcode;
+	memcpy(buf + sizeof(struct apr_hdr), payload, len);
+	acall_done = false;
+	glink_send(svc == APR_SVC_AFE ? afe_chan : ACHAN, buf, (uint32_t)sizeof(struct apr_hdr) + len);
+	for (unsigned t = ms(); !acall_done && ms() - t < 1000;) {
+		if (!glink_poll()) {
+			IOSleep(1);
+		}
+	}
+	acall_token = 0;
+	bool ok;
+	if (!acall_done) {
+		LOG("t=%u.%03u apr %s (%08x): no reply", T, what, opcode);
+		return false;
+	}
+	if (acall_op == APR_BASIC_RSP_RESULT) {
+		ok = rsp_op == 0 && acall_words >= 2 && acall_rsp[1] == 0;
+		LOG("t=%u.%03u apr %s: result opcode %08x status %x%s", T, what, acall_rsp[0], acall_rsp[1], ok ? "" : " FAILED");
+	} else {
+		ok = acall_op == rsp_op;
+		LOG("t=%u.%03u apr %s: rsp %08x %08x %08x%s", T, what, acall_op, acall_rsp[0], acall_words > 1 ? acall_rsp[1] : 0,
+		    ok ? "" : " (unexpected)");
+	}
+	return ok;
+}
+
+/* a data command: no reply, the ADSP answers with an event */
+static void
+apr_data(uint8_t svc, uint16_t port, uint32_t opcode, uint32_t token, const void *payload, uint32_t len)
+{
+	uint8_t buf[sizeof(struct apr_hdr) + 64];
+	struct apr_hdr *h = (struct apr_hdr *)buf;
+
+	bzero(buf, sizeof(buf));
+	h->hdr_field = APR_HDR_FIELD_CMD;
+	h->pkt_size = (uint16_t)(sizeof(struct apr_hdr) + len);
+	h->src_svc = svc;
+	h->src_domain = APR_DOMAIN_APPS;
+	h->src_port = port;
+	h->dest_svc = svc;
+	h->dest_domain = APR_DOMAIN_ADSP;
+	h->dest_port = port;
+	h->token = token;
+	h->opcode = opcode;
+	memcpy(buf + sizeof(struct apr_hdr), payload, MIN(len, 64u));
+	glink_send(ACHAN, buf, (uint32_t)sizeof(struct apr_hdr) + len);
+}
