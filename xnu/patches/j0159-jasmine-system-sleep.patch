+static boolean_t sweet_meter_running;
+
+static void
+sweet_meter_thread(void *arg, wait_result_t wr)
+{
+	(void)arg; (void)wr;
+	struct sweet_fg_ab f;
+	delay_for_interval(sweet_meter_wait, NSEC_PER_SEC);
+	int s0 = sweet_fg_read(&f) == 0 ? f.fg_soc : -1, t0 = f.temp_dc;
+	uint64_t xo0 = sweet_rpm_xo_ms(0), sys0 = sweet_sys.t_abs, t_start = mach_absolute_time();
+	int64_t sum = 0;
+	int n = 0, mv = 0, online = 0, min_ma = 0, max_ma = 0;
+	boolean_t dark = TRUE;
+	for (uint32_t t = 0; t < sweet_meter_secs; t++) {
+		delay_for_interval(1, NSEC_PER_SEC);
+		dark = dark && sweet_sys_display_off;
+		if (sweet_fg_read(&f) != 0) {
+			continue;
+		}
+		if (n == 0 || f.ma < min_ma) {
+			min_ma = f.ma;
+		}
+		if (n == 0 || f.ma > max_ma) {
+			max_ma = f.ma;
+		}
+		sum += f.ma;
+		n++;
+		online |= f.online;
+		mv = f.mv;
+	}
+	uint64_t ns, sys_ns;
+	absolutetime_to_nanoseconds(mach_absolute_time() - t_start, &ns);
+	absolutetime_to_nanoseconds(sweet_sys.t_abs - sys0, &sys_ns);
+	uint64_t xo = sweet_rpm_xo_ms(0) - xo0;
+	snprintf(sweet_meter_out, sizeof(sweet_meter_out),
+	    "cpuidle meter: %u s after %u s: mean %lld mA (min %d, max %d, %d samples) at %d mV; screen %s, USB %s; "
+	    "AP XO off %llu ms of %llu ms (%llu %%), system level %llu ms; soc %d -> %d %%, %d.%d -> %d.%d C\n",
+	    sweet_meter_secs, sweet_meter_wait, n ? sum / n : 0, min_ma, max_ma, n, mv,
+	    dark ? "off throughout" : "ON at some point", online ? "CONNECTED at some point" : "unplugged throughout",
+	    xo, ns / NSEC_PER_MSEC, ns ? xo * 100 / (ns / NSEC_PER_MSEC) : 0, sys_ns / NSEC_PER_MSEC,
+	    s0, f.fg_soc, t0 / 10, t0 % 10, f.temp_dc / 10, f.temp_dc % 10);
+	printf("SWEET METER: %s", sweet_meter_out);
+	sweet_meter_running = FALSE;
+}
