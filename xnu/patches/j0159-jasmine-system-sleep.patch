 }
+
+/*
+ * j0159: the AP's sleep set, which the RPM applies only while the AP is in the system level
+ * (cpu.c). 0: as the active set (the handoff maxima, rails at their active level: XO stays on).
+ * 1: as Linux after boot with nothing awake, so the RPM may shut XO down: every RPM clock off in
+ * the sleep set (cxo, the bus and memory clocks, qdss, the XO buffers' software enables and the
+ * unused pin-controlled ones) but rf_clk1_pin, which the WCN3990 drives itself (icnss
+ * cxo_ref_clk_pin). 2: also VDD_CX and VDD_MX at retention in the sleep set (VDD min). The
+ * active set never changes. Returns the failed requests.
+ */
+int sweet_rpm_sleep_votes(unsigned level);
+int
+sweet_rpm_sleep_votes(unsigned level)
+{
+	unsigned failed = 0;
+	lck_mtx_lock(&sweet_rpm_lock);
+	if (rpm_scaling_failed != 0) {
+		lck_mtx_unlock(&sweet_rpm_lock);
+		printf("SWEET RPM: sleep votes %u: clock scaling is not on\n", level);
+		return -1;
+	}
+	for (unsigned i = 0; i < sizeof(rpm_handoff_660) / sizeof(rpm_handoff_660[0]); i++) {
+		uint32_t v = rpm_handoff_660[i].value;
+		if (rpm_handoff_660[i].type == TYPE_CLK2 && rpm_handoff_660[i].id == 0) {
+			v = rpm_bimc_khz;
+		}
+		if (level >= 1 && !(rpm_handoff_660[i].type == TYPE_CLKA && rpm_handoff_660[i].id == 4 &&
+		    rpm_handoff_660[i].key == KEY_PCCB)) {
+			v = 0;
+		}
+		uint32_t kv[2] = {rpm_handoff_660[i].key, v};
+		failed += !rpm_request("sleep vote", 1, rpm_handoff_660[i].type, rpm_handoff_660[i].id, kv, 1);
+	}
+	for (unsigned r = 0; r < 2; r++) {
+		if (rpm_rails[r].sent != 0) {
+			uint32_t kv[4] = {KEY_SWEN, 1u, KEY_VLVL, level >= 2 ? RPM_LEVEL_RETENTION : rpm_rails[r].sent};
+			failed += !rpm_request("rail sleep vote", 1, rpm_rails[r].type, 0, kv, 2);
+		}
+	}
+	if (failed == 0) {
+		rpm_sleep_level = level;
+	}
+	lck_mtx_unlock(&sweet_rpm_lock);
+	printf("SWEET RPM: sleep votes level %u (%s): %s (%u failed); rails cx %#x mx %#x\n", level,
+	    level == 0 ? "as active" : level == 1 ? "XO shutdown" : "XO shutdown + rails retention",
+	    failed ? "FAILED" : "ok", failed, rpm_rails[0].sent, rpm_rails[1].sent);
+	return (int)failed;
+}
+
+/*
+ * j0159: RPM master stats (DT qcom,rpm-master-stats@778150, version 2, one per 0x1000:
+ * APSS, MPSS, ADSP, CDSP, TZ): shutdowns and XO shutdowns while each master slept.
+ * Message RAM: 32-bit reads only.
+ */
+/* j0159: a master's total XO-shutdown time (ms) from its RPM master stats, 0 if unknown */
+uint64_t sweet_rpm_xo_ms(unsigned master);
+uint64_t
+sweet_rpm_xo_ms(unsigned master)
+{
+	if (!rpm.mapped || master >= 5) {
+		return 0;
+	}
+	volatile uint32_t *w = (volatile uint32_t *)(rpm.ram + 0x150 + 0x1000 * master);
+	uint32_t hi = w[19], lo = w[18];
+	if (hi != w[19]) {
+		lo = w[18];
+		hi = w[19];
+	}
+	return (((uint64_t)hi << 32) | lo) / 19200;
+}
+
+int sweet_rpm_master_stats(char *out, size_t len);
+int
+sweet_rpm_master_stats(char *out, size_t len)
+{
+	static const char *names[5] = {"APSS", "MPSS", "ADSP", "CDSP", "TZ"};
+	int n = 0;
+	if (!rpm.mapped) {
+		return snprintf(out, len, "  rpm: message RAM not mapped\n");
+	}
+	for (unsigned m = 0; m < 5 && n >= 0 && (size_t)n < len; m++) {
+		volatile uint32_t *w = (volatile uint32_t *)(rpm.ram + 0x150 + 0x1000 * m);
+		uint64_t xo_acc = ((uint64_t)w[19] << 32) | w[18];
+		uint64_t xo_last_in = ((uint64_t)w[15] << 32) | w[14], xo_last_out = ((uint64_t)w[17] << 32) | w[16];
+		n += snprintf(out + n, len - (size_t)n,
+		    "  rpm %s: active cores %#x, shutdowns %u, wakeup reason %u (1 scheduled), XO shutdowns %u (%llu ms total, last %llu ms)\n",
+		    names[m], w[0], w[1], w[10], w[13], xo_acc / 19200,
+		    xo_last_out > xo_last_in ? (xo_last_out - xo_last_in) / 19200 : 0);
+	}
+	return n;
+}
 #endif /* ARM64_BOARD_CONFIG_SWEET */
