+/* Lock held: what keeps the system level away (the earliest sleeper's timer). */
+static void
+sweet_sys_note_locked(unsigned who)
+{
+	uintptr_t f = sweet_cpu_tfunc[who];
+	uint64_t tid = sweet_cpu_ttid[who];
+	for (unsigned k = 0; k < SWEET_SYS_WHO; k++) {
+		if (sweet_sys_who[k].n != 0 && sweet_sys_who[k].func == f && sweet_sys_who[k].tid == tid) {
+			sweet_sys_who[k].n++;
+			return;
+		}
+	}
+	for (unsigned k = 0; k < SWEET_SYS_WHO; k++) {
+		if (sweet_sys_who[k].n == 0) {
+			sweet_sys_who[k].func = f;
+			sweet_sys_who[k].tid = tid;
+			sweet_sys_who[k].n = 1;
+			return;
+		}
+	}
+	sweet_sys_who_other++;
+}
+
+/*
+ * Lock held, the last core going down with every other core in pc: TRUE to ask for the system
+ * level (as lpm-levels cluster_select for the "system" cluster: every child in sync, both L2s at
+ * pc, the sleep long enough, sys_pm_ops->sleep_allowed).
+ */
+static boolean_t
+sweet_sys_pick_locked(uint32_t cl, boolean_t our_l2, uint64_t now)
+{
+	sweet_sys.all_down++;
+	for (unsigned c = 0; c < 4; c++) {
+		if (c != cl && sweet_cluster_cpus[c] != 0 && !sweet_bc_l2[c]) {
+			sweet_sys.other_up++;
+			return FALSE;
+		}
+	}
+	if (!our_l2) {
+		sweet_sys.short_l2++;
+		return FALSE;
+	}
+	uint64_t first = 0;
+	unsigned who = 0;
+	for (unsigned i = 0; i < MAX_CPUS; i++) {
+		uint64_t d = sweet_bc_deadline[i];
+		if (d != 0 && (first == 0 || d < first)) {
+			first = d;
+			who = i;
+		}
+	}
+	if (first <= now || first - now < sweet_sys_res_abs) {
+		sweet_sys.short_sys++;
+		sweet_sys_note_locked(who);
+		return FALSE;
+	}
+	sweet_sys.long_ok++;
+	if (sweet_sys_mode == 0 || sweet_mpm == 0) {
+		return FALSE;
+	}
+	if (!sweet_sys_display_off) {
+		sweet_sys.screen_on++;
+		return FALSE;
+	}
+	if (sweet_rpm_busy()) {
+		sweet_sys.rpm_busy++;
+		return FALSE;
+	}
+	return TRUE;
+}
