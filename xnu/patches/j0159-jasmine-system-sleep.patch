+static const char *
+sweet_meter_start(const char *p)
+{
+	uint32_t v[2] = { 0, 60 };
+	for (int k = 0; k < 2; k++) {
+		while (*p == ' ') {
+			p++;
+		}
+		if (*p < '0' || *p > '9') {
+			break;
+		}
+		uint32_t x = 0;
+		for (; *p >= '0' && *p <= '9'; p++) {
+			x = x * 10 + (uint32_t)(*p - '0');
+		}
+		v[k] = x;
+	}
+	if (v[0] == 0) {
+		return NULL;            /* show the result */
+	}
+	if (sweet_meter_running) {
+		return "meter already running";
+	}
+	sweet_meter_secs = v[0] < 10 ? 10 : (v[0] > 7200 ? 7200 : v[0]);
+	sweet_meter_wait = v[1] > 600 ? 600 : v[1];
+	snprintf(sweet_meter_out, sizeof(sweet_meter_out), "cpuidle meter: running, %u s after %u s\n",
+	    sweet_meter_secs, sweet_meter_wait);
+	thread_t thread;
+	sweet_meter_running = TRUE;
+	if (kernel_thread_start(sweet_meter_thread, NULL, &thread) != KERN_SUCCESS) {
+		sweet_meter_running = FALSE;
+		return "no thread";
+	}
+	thread_deallocate(thread);
+	return NULL;
+}
