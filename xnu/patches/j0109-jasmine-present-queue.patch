+		uint32_t done = sweet_gpu_completed();
+		ready = true;
+		for (unsigned i = 0; i < 4; i++) {
+			if (seq[i] && (int32_t)(done - seq[i]) < 0) { ready = false; }
+		}
+		if (ready || mach_absolute_time() >= until) { break; }
+		sweet_fb_pause(1000);
+	}
