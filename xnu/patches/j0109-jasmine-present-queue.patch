+	IOLockLock(fb->fLock);
+	uint64_t value = 4 | (sweet_fb_sleeping ? 1 : 0) | (fb->fQueueActive && !fb->terminal() ? 2 : 0);
+	IOLockUnlock(fb->fLock);
+	return value;
