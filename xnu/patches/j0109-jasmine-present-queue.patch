+	IOLockUnlock(fLock);
+	if (valid) {
+		unsigned layer = 0;
+		while (layer < 4 && !held[layer]) { layer++; }
+		SweetSurface *source = held[layer];
+		/* Pool storage is stable under this retain; do not resolve its ID again. */
+		sweet_surface_cpu_access(source, false);
+		sweet_bench_event(13, get32(rec, 0x50), source->id, seq[layer], 1);
+		scanScaled(source->scanoutPhys + source->offset, source->bytesPerRow);
+		if (terminal()) { return; }
+		IOLockLock(fLock);
+		memcpy(fRetireHold, fShowHold, sizeof(fRetireHold));
+		memcpy(fShowHold, held, sizeof(fShowHold));
+		IOLockUnlock(fLock);
+		noteShown(get32(rec, 0x50));
+	} else {
+		sweet_bench_event(34, get32(rec, 0x50), epoch, ready ? 3 : 2, 0);
+		IOLockLock(fLock);
+		fDrops++;
+		fDropReason[ready ? 3 : 2]++;
+		for (unsigned i = 0; i < 128; i++) {
+			if (fTokens[i].id == get32(rec, 0x50) && fTokens[i].owner) { fTokens[i].cancelled = ready; }
+		}
