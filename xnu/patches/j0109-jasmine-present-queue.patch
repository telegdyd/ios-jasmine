+/* Only whole jasmine scaler frames use the asynchronous path. */
+bool
+AppleCLCD::queueCandidate(const uint8_t *rec, SweetSurface **held)
+{
+	uint32_t mask = get32(rec, 0x104);
+	if (mask == 0 || (mask & (mask - 1)) != 0) { return false; }
+	if (!fScaler || !directEligible(rec, held)) { return false; }
+	unsigned layer = 0;
+	while (layer < 4 && !(get32(rec, 0x104) & (1u << layer))) { layer++; }
+	if (layer == 4) { return false; }
+	SweetSurface *v = held[layer];
+	const uint8_t *a = rec + 0x64 + 16 * layer, *b = rec + 0xc4 + 16 * layer;
+	uint64_t pa = v->scanoutPhys + v->offset;
+	return v->bytesPerElement == 4 && v->width == fLogicalW && v->height == fLogicalH &&
+	    (pa & 15) == 0 && (v->bytesPerRow & 15) == 0 &&
+	    pa + (uint64_t)fLogicalH * v->bytesPerRow < (1ull << 32) &&
+	    get32(a, 0) == 0 && get32(a, 4) == 0 && get32(b, 0) == 0 && get32(b, 4) == 0 &&
+	    (get32(a, 8) == 0 || get32(a, 8) == fLogicalW) &&
+	    (get32(a, 12) == 0 || get32(a, 12) == fLogicalH) &&
+	    ((int32_t)get32(b, 8) <= 0 || get32(b, 8) == fLogicalW) &&
+	    ((int32_t)get32(b, 12) <= 0 || get32(b, 12) == fLogicalH);
+}
+
+IOReturn
+AppleCLCD::rejectFrame(uint32_t id, uint32_t reason, IOReturn error)
+{
+	IOLockLock(fLock);
+	fDrops++;
+	if (reason < 16) { fDropReason[reason]++; }
+	sweet_bench_event(34, id, fEpoch, reason, 0);
+	queueFallback(reason);
+	IOLockUnlock(fLock);
+	return error;
+}
+
+void
+AppleCLCD::queueFallback(uint32_t reason)
+{
+	if (fQueueActive) {
+		fQueueActive = false;
+		fSwapWait = 1;
+		fEpoch++;
+		fFallbacks++;
+		sweet_fb_force_sync = true;
+		sweet_bench_event(35, fEpoch, reason, 0, 0);
+		IOLog("SWEET FB: QUEUE FALLBACK reason %u, epoch %u; synchronous for rest of boot\n", reason, fEpoch);
+		IOLockWakeup(fLock, fQueueRec, false);
+	}
+}
+
+void
+AppleCLCD::releasePresent(void)
+{
+	IOLockLock(fLock);
+	fPresentBusy = false;
+	bzero(fSyncHold, sizeof(fSyncHold));
+	IOLockWakeup(fLock, &fPresentBusy, false);
+	IOLockWakeup(fLock, fQueueRec, false);
+	IOLockUnlock(fLock);
+}
+
+bool
+AppleCLCD::drainPresent(void)
+{
+	uint64_t until;
+	clock_interval_to_deadline(200, kMillisecondScale, &until);
+	for (;;) {
+		IOLockLock(fLock);
+		if (!fPresentBusy && !fQueueWaiting) {
+			fPresentBusy = true;
+			IOLockUnlock(fLock);
+			if (waitLatch()) { return true; }
+			releasePresent();
+			return false;
+		}
+		IOLockUnlock(fLock);
+		if (mach_absolute_time() >= until) { return false; }
+		sweet_fb_pause(1000);
+	}
+}
+
+bool
+AppleCLCD::waitLatch(void)
+{
+	for (;;) {
+		retireLatched();
+		IOLockLock(fLock);
+		bool pending = fLatchValid;
+		bool stopped = terminal();
+		IOLockUnlock(fLock);
+		if (!pending || stopped) { return !stopped; }
+		sweet_fb_pause(1000);
+	}
+}
+
+extern "C" uint32_t sweet_gpu_completed(void);
+
+void
+AppleCLCD::queuePresent(void)
+{
+	uint8_t rec[SWEET_FB_SWAP_REC_SIZE];
+	SweetSurface *held[4];
