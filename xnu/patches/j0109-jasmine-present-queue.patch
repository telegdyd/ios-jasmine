+			/* Bounded quarantine: only one admitted record; never free unfinished GPU storage. */
+			memcpy(fFaultHold, held, sizeof(fFaultHold));
+			uint64_t bytes = 0;
+			uint32_t objects = 0;
+			for (unsigned i = 0; i < 4; i++) {
+				if (held[i]) { objects++; bytes += held[i]->allocSize; }
+			}
+			IOLog("SWEET FB: quarantine %u layer objects, %llu bytes held for boot\n", objects, bytes);
+			bzero(held, sizeof(held));
+		}
+		IOLockUnlock(fLock);
+		sweet_hold_set(held, false);
+	}
+	IOLockLock(fLock);
+	bzero(fQueueHold, sizeof(fQueueHold));
+	fQueueWaiting = false;
+	IOLockWakeup(fLock, fQueueRec, false);
+	if (fAdmissions && fAdmissions % 600 == 0) {
+		IOLog("SWEET FB: queue admitted %u depth 0 high-water 1, drops %u fallback %u, admission %llu us; guard q/s/r %u/%u/%u; sleep %llu spin %llu us\n",
+		    fAdmissions, fDrops, fFallbacks, fAdmissionUS, fGuard[1], fGuard[2], fGuard[3], sweet_fb_slept_us, sweet_fb_spun_us);
+		IOLog("SWEET FB: guard rejected q/s/r %u/%u/%u, wait us %llu/%llu/%llu, latch checks %u; drops admission/GPU/epoch/record %u/%u/%u/%u\n",
+		    fGuardReject[1], fGuardReject[2], fGuardReject[3], fGuardUS[1], fGuardUS[2], fGuardUS[3], fLatchTimeoutChecks,
+		    fDropReason[1], fDropReason[2], fDropReason[3], fDropReason[12]);
+	}
+	IOLockUnlock(fLock);
+}
+
+/* State numbers in GUARD: 1 queued, 2 scanning, 3 retiring, 4 quarantine. */
+uint32_t
+AppleCLCD::writeState(SweetSurface *s)
+{
+	if (!fQueueActive) { return 0; }
+	for (unsigned i = 0; i < 4; i++) {
+		if (fFaultHold[i] == s) { return 4; }
+	}
+	for (unsigned i = 0; i < 4; i++) {
+		if (fQueueHold[i] == s || fSyncHold[i] == s) { return 1; }
+		if (fQueueActive && fShowHold[i] == s) { return 2; }
+		if (fRetireHold[i] == s) { return 3; }
+	}
+	return 0;
+}
+
+/* 1: reserved, 0: queue off, -1: rejected. End only a reservation actually acquired. */
+extern "C" int
+sweet_fb_write_begin(SweetSurface **surfaces, uint32_t count)
+{
+	AppleCLCD *fb = sweet_fb_main;
+	if (!fb) { return 0; }
+	IOLockLock(fb->fLock);
+	if (!fb->fQueueActive) { IOLockUnlock(fb->fLock); return 0; }
+	for (unsigned i = 0; i < count; i++) {
+		uint32_t state = surfaces[i] ? fb->writeState(surfaces[i]) : 0;
+		if (state == 4 || fb->terminal()) {
+			if (state) { fb->fGuard[state]++; fb->fGuardReject[state]++; }
+			sweet_bench_event(36, surfaces[i] ? surfaces[i]->id : 0, state, 1, 0);
+			fb->queueFallback(5);
+			IOLockUnlock(fb->fLock);
+			return -1;
+		}
+	}
+	for (unsigned i = 0; i < count; i++) { if (surfaces[i]) { surfaces[i]->displayWriters++; } }
+	fb->fWriters++;
+	IOLockUnlock(fb->fLock);
+	return 1;
+}
+
+/* Also balance reservations acquired before queue fallback. */
+extern "C" void
+sweet_fb_write_end(SweetSurface *s)
+{
+	AppleCLCD *fb = sweet_fb_main;
+	if (!fb || !fb->fProtocol) { return; }
+	IOLockLock(fb->fLock);
+	if (s && s->displayWriters) { s->displayWriters--; }
+	if (fb->fWriters) { fb->fWriters--; }
+	IOLockWakeup(fb->fLock, fb->fQueueRec, false);
+	IOLockUnlock(fb->fLock);
+}
+
+extern "C" void
+sweet_fb_submit_fault(uint32_t reason)
+{
+	AppleCLCD *fb = sweet_fb_main;
+	if (!fb || !fb->fProtocol) { return; }
+	IOLockLock(fb->fLock);
+	fb->queueFallback(reason);
+	IOLockUnlock(fb->fLock);
+}
+
+extern "C" uint32_t
+sweet_fb_write_state(SweetSurface *surface)
+{
+	AppleCLCD *fb = sweet_fb_main;
+	if (!fb || !fb->fProtocol) { return 0; }
+	IOLockLock(fb->fLock);
+	uint32_t state = fb->fQueueActive ? fb->writeState(surface) : 0;
+	IOLockUnlock(fb->fLock);
+	return state;
+}
+
+extern "C" bool
+sweet_fb_queue_boot(void)
+{
+	return sweet_fb_main && sweet_fb_main->fProtocol;
+}
