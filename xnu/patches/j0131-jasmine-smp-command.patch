Subject: [PATCH] jasmine-j0131: USB command port "smp NAME|PID" dumps a process's threads

The command port (TCP 5141, bsd/dev/sweet_usb.c) gets "smp NAME" and
"smp PID": every process whose proc_name is NAME (exact, at most 31
characters as proc_name truncates) or whose pid is PID is dumped with the
periodic sampler's sweet_sample_task (osfmk/kern/exception.c), i.e. the
shared region slide and mach header, then pc/lr/sp and up to 16 frame
pointers per thread. The reply is "smp: N process(es) dumped" or
"smp: no process NAME".

The command runs in the command port's kernel thread, which holds no lock
there; that is the same context the sampler's own kernel thread uses for
proc_iterate. Sampling is skipped during a reboot (sweet_sample_off) and
for an exiting process (P_LEXIT), both from j0097's sampler hang.

diff --git a/bsd/dev/sweet_sample.c b/bsd/dev/sweet_sample.c
--- a/bsd/dev/sweet_sample.c
+++ b/bsd/dev/sweet_sample.c
@@ -249,3 +249,83 @@ sweet_shutdown_step(const char *what)
 		}
 	}
 }
+
+/*
+ * j0131: command port "smp NAME" / "smp PID" (bsd/dev/sweet_usb.c): dump
+ * every thread of every process whose proc_name is NAME (31 characters at
+ * most, as proc_name truncates) or whose pid is PID, with the periodic
+ * sampler's sweet_sample_task (osfmk/kern/exception.c): header with the
+ * shared region slide and the mach header, then pc/lr/sp and up to 16 frame
+ * pointers per thread. The command port's kernel thread calls this with no
+ * lock held, the context the sampler's own thread uses for proc_iterate.
+ * j0097: no sampling during a reboot or of an exiting process.
+ */
+struct sweet_sample_cmd_req {
+	const char *name;
+	int pid;
+	bool by_pid;
+	int dumped;
+};
+
+static int
+sweet_sample_cmd_proc(proc_t p, void *arg)
+{
+	struct sweet_sample_cmd_req *req = arg;
+	task_t task;
+	char name[32];
+
+	if (sweet_sample_off || (p->p_lflag & P_LEXIT) != 0) {
+		return PROC_RETURNED;
+	}
+	proc_name(proc_pid(p), name, sizeof(name));
+	if (req->by_pid ? proc_pid(p) != req->pid : strcmp(name, req->name) != 0) {
+		return PROC_RETURNED;
+	}
+	task = proc_task(p);
+	if (task != TASK_NULL) {
+		sweet_sample_task(name, proc_pid(p), task);
+		req->dumped++;
+	}
+	return PROC_RETURNED;
+}
+
+const char *
+sweet_sample_cmd(const char *line)
+{
+	static char reply[128];
+	struct sweet_sample_cmd_req req;
+	const char *arg, *p;
+	bool numeric;
+
+	if (strncmp(line, "smp ", 4) != 0) {
+		return NULL;
+	}
+	arg = line + 4;
+	bzero(&req, sizeof(req));
+	req.name = arg;
+	numeric = *arg != 0;
+	for (p = arg; *p != 0; p++) {
+		if (*p < '0' || *p > '9') {
+			numeric = false;
+			break;
+		}
+		/* (a pid is 32 bits; all digits that do not fit are no pid) */
+		if (req.pid > (0x7fffffff - (*p - '0')) / 10) {
+			numeric = true;
+			req.pid = -1;
+			break;
+		}
+		req.pid = req.pid * 10 + (*p - '0');
+	}
+	req.by_pid = numeric;
+	/* (a name longer than proc_name's 31 characters cannot match; a number is a pid) */
+	if (*arg != 0 && (numeric || strlen(arg) <= 31)) {
+		proc_iterate(PROC_ALLPROCLIST, sweet_sample_cmd_proc, &req, NULL, NULL);
+	}
+	if (req.dumped == 0) {
+		snprintf(reply, sizeof(reply), "smp: no process %s\n", arg);
+	} else {
+		snprintf(reply, sizeof(reply), "smp: %d process(es) dumped\n", req.dumped);
+	}
+	return reply;
+}
diff --git a/bsd/dev/sweet_usb.c b/bsd/dev/sweet_usb.c
--- a/bsd/dev/sweet_usb.c
+++ b/bsd/dev/sweet_usb.c
@@ -1856,6 +1856,7 @@ extern const char *sweet_prof_cmd(const char *line);     /* osfmk/arm64/sweet_pr
 extern const char *sweet_gpu_cmd(const char *line);      /* bsd/dev/sweet_gpu.c (j0060) */
 extern const char *sweet_ddr_cmd(const char *line);      /* bsd/dev/sweet_ddr.c (j0064) */
 extern const char *sweet_ddrgov_cmd(const char *line);   /* bsd/dev/sweet_ddrgov.c (j0114) */
+extern const char *sweet_sample_cmd(const char *line);   /* bsd/dev/sweet_sample.c (j0131) */
 extern void topaz_modem_stop(bool panic);                /* iokit/Kernel/arm/TopazModem.cpp (j0080x) */
 static char ud_cmd_line[2048], ud_cmd_reply[8192];
 extern const char *sweet_bench_blob(const char *, const void **, size_t *);
@@ -1954,6 +1955,9 @@ ud_cmd_thread(void *arg __unused, wait_result_t wr __unused)
 		}
 		const char *reply = reboot ? "rebooting\n" : vcycle ? "VBUS session off in 1 s for the time asked\n" : "?\n";
 		const char *prof = binary_header != NULL ? binary_header : reboot ? NULL : sweet_prof_cmd(line);
+		if (prof == NULL && !reboot) {
+			prof = sweet_sample_cmd(line);
+		}
 		if (prof == NULL && !reboot && (strcmp(line, "pollE 0") == 0 || strcmp(line, "pollE 1") == 0)) {
 			sweet_poll_e = line[6] - '0';           /* j0120: the polling threads follow on their next poll */
 			prof = sweet_poll_e ? "OK polling threads to the E cluster\n" : "OK polling threads unbound\n";
