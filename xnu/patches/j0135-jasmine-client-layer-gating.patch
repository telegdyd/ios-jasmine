+/* fLock held: a swap began; until its SwapEnd arrives its layer composition is unknown. */
+void
+AppleCLCD::swapBegun(uint32_t id)
+{
+	SwapInfo &s = fSwapInfo[id % 128];
+	s.id = id;
+	s.known = false;
+	s.client = false;
+}
+
+/* fLock held: SwapEnd ran; record whether any layer of this swap came from another process. */
+void
+AppleCLCD::swapEnded(uint32_t id, bool client, IOMobileFramebufferUserClient *swapClient)
+{
+	SwapInfo &s = fSwapInfo[id % 128];
+	s.id = id;
+	s.known = true;
+	s.client = client;
+	if (client && (!fClientSwapValid || (int32_t)(id - fClientSwapID) > 0)) {
+		fClientSwapID = id;
+		fClientSwapValid = true;
+	}
+	for (unsigned i = 0; i < 128; i++) {
+		Token &t = fTokens[i];
+		if (t.owner == swapClient && t.id == id && t.epoch == fEpoch) {
+			t.client = client;
+		}
+	}
+}
+
+/*
+ * fLock held: did the waited swap, or any newer swap whose composition is known, carry a
+ * layer created by another process?  A begun-but-not-ended swap is not counted: its
+ * composition is not known yet, and guessing "client" would let an own-only wait take a
+ * j0133/j0134 recovery it must not take.
+ */
+bool
+AppleCLCD::swapClientInvolved(uint32_t from, uint32_t to)
+{
+	/* The ring can lose an old entry to a newer begun swap; the highest client id cannot. */
+	if (fClientSwapValid && (fClientSwapID == from ||
+	    ((int32_t)(fClientSwapID - from) > 0 && (int32_t)(fClientSwapID - to) <= 0))) {
+		return true;
+	}
+	for (unsigned i = 0; i < 128; i++) {
+		SwapInfo &s = fSwapInfo[i];
+		if (!s.known || !s.client) {
+			continue;
+		}
+		if (s.id == from || ((int32_t)(s.id - from) > 0 && (int32_t)(s.id - to) <= 0)) {
+			return true;
+		}
+	}
+	return false;
+}
