+/*
+ * j0146: did an LPASS master fault in the SMMU (unmatched stream with USFCFG=1, or a context fault on our CB)?
+ * Returns the faulting stream id of an unmatched-stream fault, or ~0u. Clears what it reports.
+ */
+static uint32_t
+lpass_smmu_faults(const char *when)
+{
+	volatile uint8_t *s = (volatile uint8_t *)ml_io_map((vm_offset_t)J_LSMMU_PA, J_LSMMU_SIZE);
+	volatile uint32_t *g = (volatile uint32_t *)s;
+	uint32_t id1 = g[0x24 / 4], ncb = id1 & 0xFF;
+	uint32_t psize = (id1 & (1u << 31)) ? 0x10000 : 0x1000, npage = 1u << (((id1 >> 28) & 7) + 1);
+	uint32_t gfsr = g[0x48 / 4], syn0 = g[0x50 / 4], syn1 = g[0x54 / 4], syn2 = g[0x58 / 4];
+	uint32_t sid = ~0u;
+
+	LOG("lpass smmu %s: sGFSR %08x sGFSYNR0 %08x SYNR1 %08x SYNR2 %08x sGFAR %08x%08x", when, gfsr, syn0, syn1, syn2,
+	    g[0x44 / 4], g[0x40 / 4]);
+	if (gfsr != 0) {
+		if (gfsr & 2) {
+			sid = syn1 & 0xFFFF;
+		}
+		mb();
+		g[0x48 / 4] = gfsr;
+	}
+	/* only CB1 (ours): reading the other banks from here stalls the thread (afe146b) */
+	for (uint32_t i = 1; i < 2 && i < ncb && (uint64_t)(npage + i + 1) * psize <= J_LSMMU_SIZE; i++) {
+		volatile uint32_t *c = (volatile uint32_t *)(s + (uint64_t)npage * psize + (uint64_t)i * psize);
+		uint32_t fsr = c[0x58 / 4] & ~0x600u;   /* FORMAT [10:9] is not a fault */
+		if (fsr != 0) {
+			LOG("lpass smmu %s: CB%u FSR %08x FAR %08x%08x FSYNR0 %08x SCTLR %08x", when, i, fsr, c[0x64 / 4],
+			    c[0x60 / 4], c[0x68 / 4], c[0]);
+			mb();
+			c[0x58 / 4] = fsr;
+		}
+	}
+	return sid;
+}
