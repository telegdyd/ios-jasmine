+/* j0146: hold pd-mapper answers until the diag link is up, so the ADSP's APR PDR init shows in its F3 log */
+static struct { uint32_t node, port, len; uint16_t txn, msg; uint8_t d[200]; } pdm_q[6];
+static uint32_t pdm_qn;
+
+static void
+pdm_rx(uint32_t node, uint32_t port, uint16_t txn, uint16_t msg, const uint8_t *d, uint32_t len)
+{
+	if (!dg_masks_sent && ms() < 3000 && pdm_qn < 6 && len <= sizeof(pdm_q[0].d)) {
+		pdm_q[pdm_qn].node = node;
+		pdm_q[pdm_qn].port = port;
+		pdm_q[pdm_qn].txn = txn;
+		pdm_q[pdm_qn].msg = msg;
+		pdm_q[pdm_qn].len = len;
+		memcpy(pdm_q[pdm_qn].d, d, len);
+		pdm_qn++;
+		return;
+	}
+	pdm_answer(node, port, txn, msg, d, len);
+}
+
+static void
+pdm_flush(void)
+{
+	if (pdm_qn == 0 || !(dg_masks_sent || ms() >= 3000)) {
+		return;
+	}
+	LOG("t=%u.%03u pd-mapper: answering %u held request(s) now", T, pdm_qn);
+	for (uint32_t i = 0; i < pdm_qn; i++) {
+		pdm_answer(pdm_q[i].node, pdm_q[i].port, pdm_q[i].txn, pdm_q[i].msg, pdm_q[i].d, pdm_q[i].len);
+	}
+	pdm_qn = 0;
+}
