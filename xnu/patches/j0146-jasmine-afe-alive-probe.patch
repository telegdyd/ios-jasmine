 /* a command; true if the ADSP answered with status 0 (APR_BASIC_RSP_RESULT) or the expected response */
+/* j0146: send an APR packet with the ADSP's own 32-byte version-1 header (12 extension bytes) */
+static bool
+apr_call_v1(const char *what, uint8_t svc, uint16_t port, uint32_t opcode, const void *payload, uint32_t len,
+    const uint8_t ext[12])
+{
+	uint8_t buf[32 + 128];
+	struct apr_hdr *h = (struct apr_hdr *)buf;
+
+	if (len > 128) {
+		return false;
+	}
+	bzero(buf, sizeof(buf));
+	h->hdr_field = 0x0181;                      /* version 1, 8-word header, SEQ_CMD */
+	h->pkt_size = (uint16_t)(32 + len);
+	h->src_svc = svc;
+	h->src_domain = APR_DOMAIN_APPS;
+	h->src_port = port;
+	h->dest_svc = svc;
+	h->dest_domain = APR_DOMAIN_ADSP;
+	h->dest_port = port;
+	h->token = acall_token = apr_token++;
+	h->opcode = opcode;
+	memcpy(buf + 20, ext, 12);
+	memcpy(buf + 32, payload, len);
+	acall_done = false;
+	acall_op = 0;
+	glink_send(ACHAN, buf, 32 + len);
+	for (unsigned t = ms(); !acall_done && ms() - t < 1000;) {
+		if (!glink_poll()) {
+			IOSleep(1);
+		}
+	}
+	acall_token = 0;
+	LOG("t=%u.%03u apr v1 %s (%08x): %s op %08x %08x %08x", T, what, opcode, acall_done ? "REPLY" : "no reply", acall_op,
+	    acall_rsp[0], acall_rsp[1]);
+	return acall_done;
+}
