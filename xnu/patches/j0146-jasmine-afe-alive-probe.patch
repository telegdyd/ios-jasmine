+/* ---------------------------------------------------------------- DIAG over QRTR (j0146: read the ADSP's F3 log) */
+
+/*
+ * msm-4.4 drivers/char/diag/diagfwd_socket.c: apps is the server for the LPASS control (svc 0x1001 inst 64) and
+ * data (inst 66) sockets; the ADSP connects, sends its feature mask / SSID ranges on control and HDLC-framed
+ * diag packets (0x79 extended F3 messages with format string and file name) on data.
+ */
+#define SVC_DIAG            0x1001
+#define DIAG_INST_CNTL      64
+#define DIAG_INST_DATA      66
+#define PORT_DIAG_CNTL      0x4010
+#define PORT_DIAG_DATA      0x4011
+
+static uint32_t dg_node = 0xFFFFFFFFu, dg_port, dg_ctrl_n, dg_frames, dg_printed, dg_budget = 1500, dg_other;
+static bool dg_feat_sent, dg_masks_sent;
+static uint8_t dg_frame[4096];
+static uint32_t dg_flen;
+static bool dg_esc;
+
+static void
+diag_cntl_send(const void *p, uint32_t len)
+{
+	if (dg_node != 0xFFFFFFFFu) {
+		qrtr_send(QRTR_TYPE_DATA, PORT_DIAG_CNTL, dg_node, dg_port, p, len);
+	}
+}
+
+static void
+diag_send_f3_all(uint16_t first, uint16_t last)
+{
+	struct __attribute__((packed)) {
+		uint32_t cmd_type, data_len;
+		uint8_t stream_id, status, msg_mode;
+		uint16_t ssid_first, ssid_last;
+		uint32_t msg_mask_size, mask;
+	} m = { 11, 11 + 4, 1, 2 /* ALL_ENABLED */, 0, first, last, 1, 0xFFFFFFFFu };
+	diag_cntl_send(&m, sizeof(m));
+}
+
+static void
+diag_cntl_rx(uint32_t node, uint32_t port, const uint8_t *d, uint32_t n)
+{
+	bool ranges = false;
+
+	dg_node = node;
+	dg_port = port;
+	if (!dg_feat_sent) {
+		struct __attribute__((packed)) { uint32_t id, len, flen; uint8_t f[4]; } fm =
+		{ 8, 4 + 4, 4, { 0x05 /* bits 0, 2 */, 0x28 /* bits 11, 13 */, 0, 0 } };
+		struct __attribute__((packed)) { uint32_t id, len, version, sleep_vote, real_time, nrt, ct, st, stime, drain, stale; } dm =
+		{ 3, 36, 1, 1, 1, 0, 0, 0, 0, 0, 0 };
+		diag_cntl_send(&fm, sizeof(fm));
+		diag_cntl_send(&dm, sizeof(dm));
+		dg_feat_sent = true;
+		LOG("t=%u.%03u diag: ADSP control socket %u:%x connected; sent feature mask + real-time mode", T, node, port);
+	}
+	for (uint32_t o = 0; o + 8 <= n;) {
+		uint32_t id = *(const uint32_t *)(d + o), len = *(const uint32_t *)(d + o + 4);
+		if (o + 8 + len > n) {
+			break;
+		}
+		if (dg_ctrl_n++ < 40) {
+			LOG("t=%u.%03u diag cntl rx: pkt %u len %u: %08x %08x %08x", T, id, len,
+			    len >= 4 ? *(const uint32_t *)(d + o + 8) : 0, len >= 8 ? *(const uint32_t *)(d + o + 12) : 0,
+			    len >= 12 ? *(const uint32_t *)(d + o + 16) : 0);
+		}
+		if (id == 24 && len >= 8) {             /* SSID_RANGE_REPORT: version, count, {u16 first, last}[] */
+			uint32_t count = *(const uint32_t *)(d + o + 12);
+			for (uint32_t i = 0; i < count && 16 + 4 * i + 4 <= len + 8; i++) {
+				uint16_t f = *(const uint16_t *)(d + o + 16 + 4 * i), l = *(const uint16_t *)(d + o + 18 + 4 * i);
+				diag_send_f3_all(f, l);
+			}
+			LOG("t=%u.%03u diag: %u SSID ranges, all F3 messages enabled", T, count);
+			ranges = true;
+			dg_masks_sent = true;
+		}
+		o += 8 + len;
+	}
+	if (!ranges && dg_ctrl_n <= 2) {
+		diag_send_f3_all(0, 0);
+	}
+}
+
+static void
+diag_str(char *out, uint32_t cap, const uint8_t *s, uint32_t avail)
+{
+	uint32_t i = 0;
+	for (; i + 1 < cap && i < avail && s[i] != 0; i++) {
+		out[i] = (s[i] >= 0x20 && s[i] < 0x7F) ? (char)s[i] : '.';
+	}
+	out[i] = 0;
+}
+
+static void
+diag_frame_done(const uint8_t *f, uint32_t n)
+{
+	if (n < 3) {
+		return;
+	}
+	n -= 2;                                     /* CRC */
+	dg_frames++;
+	if (dg_printed >= dg_budget) {
+		return;
+	}
+	if (f[0] == 0x79 && n >= 20) {
+		uint32_t na = f[2], line = *(const uint16_t *)(f + 12), ssid = *(const uint16_t *)(f + 14);
+		uint32_t a[4] = { 0, 0, 0, 0 };
+		for (uint32_t i = 0; i < na && i < 4 && 20 + 4 * i + 4 <= n; i++) {
+			a[i] = *(const uint32_t *)(f + 20 + 4 * i);
+		}
+		uint32_t so = 20 + 4 * na;
+		char fmt[160], file[48];
+		fmt[0] = file[0] = 0;
+		if (so < n) {
+			diag_str(fmt, sizeof(fmt), f + so, n - so);
+			uint32_t fo = so;
+			while (fo < n && f[fo] != 0) {
+				fo++;
+			}
+			fo++;
+			if (fo < n) {
+				diag_str(file, sizeof(file), f + fo, n - fo);
+			}
+		}
+		dg_printed++;
+		LOG("adsp f3 [%x] %s:%u %s | %x %x %x %x", ssid, file, line, fmt, a[0], a[1], a[2], a[3]);
+	} else if ((f[0] == 0x92 || f[0] == 0x99) && n >= 24) {
+		uint32_t na = f[2], line = *(const uint16_t *)(f + 12), ssid = *(const uint16_t *)(f + 14);
+		uint32_t hash = *(const uint32_t *)(f + 20), a[4] = { 0, 0, 0, 0 };
+		for (uint32_t i = 0; i < na && i < 4 && 24 + 4 * i + 4 <= n; i++) {
+			a[i] = *(const uint32_t *)(f + 24 + 4 * i);
+		}
+		dg_printed++;
+		LOG("adsp f3 [%x] line %u hash %08x (%x) | %x %x %x %x", ssid, line, hash, f[0], a[0], a[1], a[2], a[3]);
+	} else if (dg_other++ < 30) {
+		dg_printed++;
+		LOG("adsp diag pkt %02x len %u: %02x%02x%02x%02x %02x%02x%02x%02x %02x%02x%02x%02x", f[0], n, f[0], f[1], f[2],
+		    f[3], n > 4 ? f[4] : 0, n > 5 ? f[5] : 0, n > 6 ? f[6] : 0, n > 7 ? f[7] : 0, n > 8 ? f[8] : 0,
+		    n > 9 ? f[9] : 0, n > 10 ? f[10] : 0, n > 11 ? f[11] : 0);
+	}
+}
+
+static void
+diag_data_rx(const uint8_t *d, uint32_t n)
+{
+	for (uint32_t i = 0; i < n; i++) {
+		uint8_t c = d[i];
+		if (c == 0x7E) {
+			diag_frame_done(dg_frame, dg_flen);
+			dg_flen = 0;
+			dg_esc = false;
+		} else if (c == 0x7D) {
+			dg_esc = true;
+		} else {
+			if (dg_esc) {
+				c ^= 0x20;
+				dg_esc = false;
+			}
+			if (dg_flen < sizeof(dg_frame)) {
+				dg_frame[dg_flen++] = c;
+			}
+		}
+	}
+}
