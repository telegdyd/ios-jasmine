+/*
+ * jasmine (j0120, task 19): the port's polling kernel threads (modem watch and USB device at 1 ms, the live log,
+ * the command port, the Wi-Fi net poll, the PMIC keys) are kernel threads, so they prefer the Gold (P) cluster
+ * and preempt the UI there (~70 ms/s of Gold CPU during Control Center motion) while Silver idles.
+ * sweet_poll_e = 1 (the default; boot-arg sweetpollE=0 or "pollE 0" on the command port turns it off) soft-binds each of them to the
+ * E cluster on its next poll (soft: it still runs on Gold when no Silver CPU is available); 0 unbinds them.
+ * Default on since the task 19 install (2026-10-31). force: always on the E cluster (the profiler's census thread, a measurement thread).
+ */
+int sweet_poll_e = -1;
+void sweet_poll_thread_to_e(bool *on_e);
+void sweet_thread_to_e(bool *on_e, bool force);
+
+void
+sweet_thread_to_e(bool *on_e, bool force)
+{
+	if (sweet_poll_e < 0) {
+		uint32_t v = 1;
+		(void)PE_parse_boot_argn("sweetpollE", &v, sizeof(v));
+		sweet_poll_e = v != 0;
+	}
+	bool want = force || sweet_poll_e > 0;
+	if (want == *on_e) {
+		return;
+	}
+#if __AMP__
+	if (want) {
+		processor_set_t e = pset0.pset_cluster_type == PSET_AMP_E ? &pset0 :
+		    (pset_node1.psets != PROCESSOR_SET_NULL && pset_node1.pset_cluster_type == PSET_AMP_E ? pset_node1.psets : PROCESSOR_SET_NULL);
+		if (e == PROCESSOR_SET_NULL || os_atomic_load(&e->online_processor_count, relaxed) == 0) {
+			return;         /* Silver not up yet: ask again on the next poll */
+		}
+	}
+	*on_e = want;
+	thread_bind_cluster_type(current_thread(), want ? 'E' : '-', want);
+	printf("SWEET POLL: thread %llu %s, now on cpu %d\n", thread_tid(current_thread()),
+	    want ? "soft-bound to the E cluster" : "unbound", cpu_number());
+#else
+	*on_e = want;
+#endif /* __AMP__ */
+}
+
+void
+sweet_poll_thread_to_e(bool *on_e)
+{
+	sweet_thread_to_e(on_e, false);
+}
