From 7643db08d7ae9339a719e639f78da2891b7c898d Mon Sep 17 00:00:00 2001
From: telegdyd <telegdyd93@gmail.com>
Date: Sun, 25 Oct 2026 02:44:14 +0100
Subject: [PATCH] jasmine-j0097: no process samples during a reboot or of an
 exiting process (j83/j85-wlan: a sample in the reboot's process kill was the
 last line); sdw_sample=1 forces one into the kill phase as a test

---
 bsd/dev/sweet_sample.c | 35 ++++++++++++++++++++++++++++++++++-
 1 file changed, 34 insertions(+), 1 deletion(-)

diff --git a/bsd/dev/sweet_sample.c b/bsd/dev/sweet_sample.c
index a33299e..7289186 100644
--- a/bsd/dev/sweet_sample.c
+++ b/bsd/dev/sweet_sample.c
@@ -11,6 +11,11 @@
  * syscall stub in pc and its caller in lr/bt.
  *
  * First sample 90 s after start, then every 120 s, 40 samples at most.
+ *
+ * j0097: no samples once a reboot starts (sweet_shutdown_step) and never of an
+ * exiting process: a sample during the reboot's process kill hung j83/j85-wlan
+ * (the "SMP --- sample" line was the last one). Boot-arg sdw_sample=1 still
+ * forces one sample into the kill phase, to test that.
  */
 #include <sys/param.h>
 #include <sys/systm.h>
@@ -27,6 +32,8 @@ extern int hz;
 extern void sweet_sample_start(void);
 
 static char sweet_sample_names[128];
+static volatile bool sweet_sample_off;          /* j0097: a reboot runs */
+static bool sweet_sample_force;                 /* j0097: sdw_sample=1 test pass */
 
 static bool
 sweet_sample_wanted(const char *name)
@@ -52,6 +59,9 @@ static int
 sweet_sample_proc(proc_t p, __unused void *arg)
 {
 	char name[32];
+	if (!sweet_sample_force && (sweet_sample_off || (p->p_lflag & P_LEXIT) != 0)) {
+		return PROC_RETURNED;
+	}
 	proc_name(proc_pid(p), name, sizeof(name));
 	if (sweet_sample_wanted(name)) {
 		task_t task = proc_task(p);
@@ -73,7 +83,7 @@ sweet_sample_thread(__unused void *arg, __unused wait_result_t wr)
 		return;
 	}
 	(void)tsleep(&chan, PZERO, "sweetsmp", 90 * hz);
-	for (int i = 0; i < 40; i++) {
+	for (int i = 0; i < 40 && !sweet_sample_off; i++) {
 		printf("SMP --- sample %d\n", i);
 		proc_iterate(PROC_ALLPROCLIST, sweet_sample_proc, NULL, NULL, NULL);
 		(void)tsleep(&chan, PZERO, "sweetsmp", 120 * hz);
@@ -118,6 +128,18 @@ sdw_ms(uint64_t abs)
 	return ns / 1000000;
 }
 
+static void
+sdw_forced_sample(__unused void *arg, __unused wait_result_t wr)
+{
+	static int chan;
+	(void)tsleep(&chan, PZERO, "sweetsdw", hz / 10);
+	printf("SDW forced sample (sdw_sample=1)\n");
+	sweet_sample_force = true;
+	proc_iterate(PROC_ALLPROCLIST, sweet_sample_proc, NULL, NULL, NULL);
+	sweet_sample_force = false;
+	printf("SDW forced sample done\n");
+}
+
 static int
 sdw_proc(proc_t p, __unused void *arg)
 {
@@ -182,6 +204,7 @@ sweet_shutdown_step(const char *what)
 		sdw_start = now;
 		sdw_thread = current_thread();
 	}
+	sweet_sample_off = true;
 	sdw_step_at = now;
 	sdw_step = what;
 	printf("SDW step %s at +%llu ms\n", what, sdw_ms(now - sdw_start));
@@ -191,4 +214,14 @@ sweet_shutdown_step(const char *what)
 			thread_deallocate(thread);
 		}
 	}
+	int force = 0;
+	static bool forced;
+	if (!forced && strcmp(what, "SIGTERM wait") == 0 &&
+	    PE_parse_boot_argn("sdw_sample", &force, sizeof(force)) && force) {
+		thread_t thread;
+		forced = true;
+		if (kernel_thread_start(sdw_forced_sample, NULL, &thread) == KERN_SUCCESS) {
+			thread_deallocate(thread);
+		}
+	}
 }
-- 
