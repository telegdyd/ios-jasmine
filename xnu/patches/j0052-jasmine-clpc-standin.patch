 }
 
+#if CONFIG_SCHED_EDGE && SCHED_EDGE_SWEET_CLPC
+/*
+ * jasmine (j0052): the CLPC stand-in's per-QoS clusters for every thread group
+ * created so far; under tg_lock, so a group created meanwhile gets them in
+ * thread_group_create_and_retain() instead.
+ */
+void
+thread_group_sweet_clpc_start(void)
+{
+	struct thread_group *tg;
+
+	lck_mtx_lock(&tg_lock);
+	sched_edge_sweet_clpc_enable();
+	qe_foreach_element(tg, &tg_queue, tg_queue_chain) {
+		sched_edge_sweet_clpc_tg_apply(tg);
+	}
+	lck_mtx_unlock(&tg_lock);
+}
+#endif /* CONFIG_SCHED_EDGE && SCHED_EDGE_SWEET_CLPC */
