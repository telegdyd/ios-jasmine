@@ -280,6 +300,9 @@ thread_group_create_and_retain(uint32_t flags)
 	tg_count++;
 	enqueue_tail(&tg_queue, &tg->tg_queue_chain);
 
+#if CONFIG_SCHED_EDGE && SCHED_EDGE_SWEET_CLPC
+	sched_edge_sweet_clpc_tg_init(tg);
+#endif /* CONFIG_SCHED_EDGE && SCHED_EDGE_SWEET_CLPC */
 	// call machine layer init before this thread group becomes visible
 	machine_thread_group_init(tg);
 	lck_mtx_unlock(&tg_lock);
