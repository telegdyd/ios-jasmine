diff --git a/pexpert/arm/pe_fiq.c b/pexpert/arm/pe_fiq.c
--- a/pexpert/arm/pe_fiq.c
+++ b/pexpert/arm/pe_fiq.c
@@ -340,6 +340,73 @@ sweet_gic_spi_route(uint32_t intid, uint64_t mpidr, uint32_t group_word[3])
 	}
 	return 0;
 }
+
+/*
+ * j0155: device SPIs for drivers without an IOInterruptController (touch, PMIC keys).
+ * sweet_spi_register() stores the handler, then routes and enables the SPI on the core
+ * with that MPIDR; sleh_irq calls sweet_spi_dispatch() for every SPI it does not know,
+ * interrupts masked, before the EOI. A handler must quiet its source (level SPIs).
+ */
+#define SWEET_SPI_MAX   4
+static struct {
+	uint32_t intid;
+	void (*fn)(void *);
+	void *arg;
+	uint64_t count;
+} sweet_spi_tab[SWEET_SPI_MAX];
+static uint32_t sweet_spi_n;
+
+int sweet_spi_register(uint32_t intid, void (*fn)(void *), void *arg, uint64_t mpidr);
+int
+sweet_spi_register(uint32_t intid, void (*fn)(void *), void *arg, uint64_t mpidr)
+{
+	if (gicd_base == 0 || fn == NULL || sweet_spi_n >= SWEET_SPI_MAX) {
+		return -1;
+	}
+	uint32_t i = sweet_spi_n;
+	sweet_spi_tab[i].intid = intid;
+	sweet_spi_tab[i].arg = arg;
+	sweet_spi_tab[i].fn = fn;
+	__builtin_arm_dmb(DMB_ISH);
+	sweet_spi_n = i + 1;
+	return sweet_gic_spi_route(intid, mpidr, NULL);
+}
+
+int sweet_spi_dispatch(uint32_t intid);
+int
+sweet_spi_dispatch(uint32_t intid)
+{
+	for (uint32_t i = 0; i < sweet_spi_n; i++) {
+		if (sweet_spi_tab[i].intid == intid) {
+			sweet_spi_tab[i].count++;
+			sweet_spi_tab[i].fn(sweet_spi_tab[i].arg);
+			return 1;
+		}
+	}
+	return 0;
