From 3602afd2e490847a664e11d9f100f0281c7479d0 Mon Sep 17 00:00:00 2001
From: telegdyd <telegdyd93@gmail.com>
Date: Sat, 24 Oct 2026 21:33:03 +0200
Subject: [PATCH] jasmine-j0080z: WCN3990 rails before the anoc2 SMMU setup
 (j80y hung in its TLB sync); rpm command takes short keys

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 bsd/dev/sweet_ddr.c             |  5 ++++-
 iokit/Kernel/arm/TopazModem.cpp | 11 ++++++++---
 2 files changed, 12 insertions(+), 4 deletions(-)

diff --git a/bsd/dev/sweet_ddr.c b/bsd/dev/sweet_ddr.c
index 16bfb86..f549d70 100755
--- a/bsd/dev/sweet_ddr.c
+++ b/bsd/dev/sweet_ddr.c
@@ -387,7 +387,10 @@ word4(const char **pp)
 	}
 	for (int i = 0; i < 4; i++, p++) {
 		if (*p == 0 || *p == ' ') {
-			return 0;
+			if (i == 0) {
+				return 0;
+			}
+			break;                  /* shorter words end in NULs: "KHz", "uv" */
 		}
 		v |= (uint32_t)(uint8_t)(*p == '_' ? ' ' : *p) << (8 * i);
 	}
diff --git a/iokit/Kernel/arm/TopazModem.cpp b/iokit/Kernel/arm/TopazModem.cpp
index 71ee45d..5ad7887 100644
--- a/iokit/Kernel/arm/TopazModem.cpp
+++ b/iokit/Kernel/arm/TopazModem.cpp
@@ -7965,14 +7965,19 @@ topaz_modem_thread(void *arg __unused, wait_result_t wr __unused)
 		return;
 	}
 	LOG("SMEM version %u", *(volatile uint32_t *)(smem + 64 + 7 * 4) >> 16);
+	/*
+	 * jasmine: the WCN3990 rails first (j0080z), as ath10k powers the chip before any DMA setup. With
+	 * the chip still unpowered the anoc2 SMMU's global TLB sync after the WLAN stream setup never
+	 * returned (j80y: SMR, S2CR and bank written and read back, then nothing).
+	 */
+	if (soc.jasmine) {
+		(void)wcn_power_on();
+	}
 	/* jasmine (j0080n): the WLAN stream sits on the anoc2 SMMU; the same identity bank as topaz */
 	if (wifi_enabled() && !smmu_identity(WLAN_SID, WLAN_SID_MASK, "WLAN")) {
 		LOG("wifi: no SMMU stream for WLAN, the radio stays off");
 		wifi_on = 0;
 	}
-	if (soc.jasmine) {
-		(void)wcn_power_on();
-	}
 	if (soc.jasmine ? modem_boot_mba() : modem_boot()) {
 		modem_watch(smem_partition(0, 1), watch);
 	}
-- 
2.47.3

